{
  "// Production configuration example for monitoring and resilience": "",
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "DurationOfBreakSeconds": 30,
    "SuccessThreshold": 3,
    "TimeoutSeconds": 30,
    "InitialRetryDelayMs": 500,
    "MaxRetryDelayMs": 5000,
    "MaxRetryAttempts": 3
  },
  "ExternalServices": {
    "CircuitBreaker": {
      "ArcGisRest": {
        "FailureThreshold": 3,
        "DurationOfBreakSeconds": 60,
        "SuccessThreshold": 2,
        "TimeoutSeconds": 45,
        "InitialRetryDelayMs": 1000,
        "MaxRetryDelayMs": 10000,
        "MaxRetryAttempts": 2
      },
      "GeoServerRest": {
        "FailureThreshold": 5,
        "DurationOfBreakSeconds": 30,
        "SuccessThreshold": 3,
        "TimeoutSeconds": 60,
        "InitialRetryDelayMs": 500,
        "MaxRetryDelayMs": 5000,
        "MaxRetryAttempts": 3
      },
      "Webhooks": {
        "FailureThreshold": 10,
        "DurationOfBreakSeconds": 120,
        "SuccessThreshold": 5,
        "TimeoutSeconds": 30,
        "InitialRetryDelayMs": 2000,
        "MaxRetryDelayMs": 30000,
        "MaxRetryAttempts": 5
      },
      "IdentityProvider": {
        "FailureThreshold": 3,
        "DurationOfBreakSeconds": 60,
        "SuccessThreshold": 2,
        "TimeoutSeconds": 30,
        "InitialRetryDelayMs": 1000,
        "MaxRetryDelayMs": 10000,
        "MaxRetryAttempts": 2
      }
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalRequestsPerMinute": 1000,
    "QueryRequestsPerMinute": 100,
    "UploadRequestsPerMinute": 10,
    "MetadataRequestsPerMinute": 200,
    "UseDistributedRateLimiting": true,
    "KeyPrefix": "honua:ratelimit:",
    "IncludeHeaders": true,
    "StatusCode": 429
  },
  "FileUpload": {
    "MaxFileSizeBytes": 104857600,
    "MaxConcurrentUploads": 5,
    "MaxQueuedUploads": 20
  },
  "Cache": {
    "Enabled": true,
    "DefaultTtlSeconds": 1800,
    "ServiceTtlSeconds": 3600,
    "LayerTtlSeconds": 1800,
    "QueryTtlSeconds": 30,
    "NegativeTtlSeconds": 60,
    "JitterPercentage": 0.2,
    "EnableFallback": true,
    "FallbackMaxEntries": 1000,
    "ResponseCacheMaxEntries": 10000,
    "RetryIntervalSeconds": 30,
    "KeyPrefix": "honua:",
    "BackgroundRefreshEnabled": true,
    "BackgroundRefreshThreshold": 0.25,
    "MaxConcurrentRefreshes": 10,
    "RefreshTimeoutSeconds": 30
  },
  "Limits": {
    "Connections": {
      "MaxPoolSize": 50,
      "CommandTimeoutSeconds": 30,
      "ConnectionTimeoutSeconds": 15
    },
    "Query": {
      "MaxRecordCount": 2000,
      "DefaultRecordCount": 1000,
      "MaxOffset": 1000000,
      "MaxBboxAreaSqKm": 100000000,
      "QueryTimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Honua.Server.Features.Infrastructure.Monitoring": "Debug",
      "Honua.Server.Features.Infrastructure.Resilience": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Metrics": {
    "Enabled": true,
    "CollectionIntervalSeconds": 30,
    "RetentionDays": 7
  },
  "HealthChecks": {
    "Enabled": true,
    "TimeoutSeconds": 30,
    "CacheDurationSeconds": 60
  }
}