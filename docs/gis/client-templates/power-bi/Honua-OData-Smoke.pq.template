let
    BaseUrl = "${HONUA_BASE_URL}",
    LayerId = "${HONUA_ODATA_LAYER_ID}",
    ApiKey = "${HONUA_API_KEY}",
    // The cross-layer /odata/Features feed requires a LayerId filter, so read the
    // layer-scoped feed. MoreColumns keeps the layer's dynamic attribute properties.
    FeedUrl = Text.TrimEnd(BaseUrl, "/") & "/odata/Layers(" & LayerId & ")/Features",
    Options =
        if Text.Length(Text.Trim(ApiKey)) = 0 then
            [Implementation = "2.0", MoreColumns = true]
        else
            [Implementation = "2.0", MoreColumns = true, Headers = [#"x-api-key" = ApiKey]],
    Source = OData.Feed(FeedUrl, null, Options),
    Result = Table.FirstN(Source, 5000)
in
    Result
