{
  "openapi": "3.0.3",
  "info": {
    "title": "Honua Studio API",
    "version": "1.0.0",
    "description": "Canonical contract for the Honua Studio package lifecycle and AI proxy surfaces."
  },
  "servers": [{ "url": "/api/v1/studio" }],
  "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
  "paths": {
    "/package-families": { "get": { "operationId": "listStudioPackageFamilies", "responses": { "200": { "$ref": "#/components/responses/PackageFamilies" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/package-drafts": {
      "get": { "operationId": "listStudioPackageDrafts", "parameters": [{ "$ref": "#/components/parameters/Family" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/OwnerId" }, { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/DraftList" }, "default": { "$ref": "#/components/responses/Problem" } } },
      "post": { "operationId": "createStudioPackageDraft", "requestBody": { "$ref": "#/components/requestBodies/CreateDraft" }, "responses": { "201": { "$ref": "#/components/responses/Draft" }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/package-drafts/{draftId}": {
      "parameters": [{ "$ref": "#/components/parameters/DraftId" }],
      "get": { "operationId": "getStudioPackageDraft", "responses": { "200": { "$ref": "#/components/responses/Draft" }, "default": { "$ref": "#/components/responses/Problem" } } },
      "put": { "operationId": "updateStudioPackageDraft", "requestBody": { "$ref": "#/components/requestBodies/UpdateDraft" }, "responses": { "200": { "$ref": "#/components/responses/Draft" }, "default": { "$ref": "#/components/responses/Problem" } } },
      "delete": { "operationId": "deleteStudioPackageDraft", "responses": { "204": { "description": "Draft deleted." }, "default": { "$ref": "#/components/responses/Problem" } } }
    },
    "/package-drafts/{draftId}/validate": { "post": { "operationId": "validateStudioPackageDraft", "parameters": [{ "$ref": "#/components/parameters/DraftId" }], "responses": { "200": { "$ref": "#/components/responses/Validation" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/package-drafts/{draftId}/preview-plan": { "post": { "operationId": "previewStudioPackageDraft", "parameters": [{ "$ref": "#/components/parameters/DraftId" }], "responses": { "200": { "$ref": "#/components/responses/PreviewPlan" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/package-drafts/{draftId}/content-versions": { "post": { "operationId": "createStudioContentVersion", "parameters": [{ "$ref": "#/components/parameters/DraftId" }], "requestBody": { "$ref": "#/components/requestBodies/SaveVersion" }, "responses": { "201": { "$ref": "#/components/responses/ContentVersion" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items": { "get": { "operationId": "listStudioContentItems", "parameters": [{ "$ref": "#/components/parameters/Family" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/OwnerId" }, { "$ref": "#/components/parameters/State" }, { "$ref": "#/components/parameters/Search" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }], "responses": { "200": { "$ref": "#/components/responses/ContentItemList" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/versions": { "get": { "operationId": "listStudioContentVersions", "parameters": [{ "$ref": "#/components/parameters/ItemId" }], "responses": { "200": { "$ref": "#/components/responses/ContentVersionList" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/versions/{versionId}": { "get": { "operationId": "getStudioContentVersion", "parameters": [{ "$ref": "#/components/parameters/ItemId" }, { "$ref": "#/components/parameters/VersionId" }], "responses": { "200": { "$ref": "#/components/responses/ContentVersion" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/version-comparisons": { "post": { "operationId": "compareStudioContentVersions", "parameters": [{ "$ref": "#/components/parameters/ItemId" }], "requestBody": { "$ref": "#/components/requestBodies/CompareVersions" }, "responses": { "200": { "$ref": "#/components/responses/VersionComparison" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/versions/{versionId}/publish-requests": { "post": { "operationId": "createStudioPublicationRequest", "parameters": [{ "$ref": "#/components/parameters/ItemId" }, { "$ref": "#/components/parameters/VersionId" }], "requestBody": { "$ref": "#/components/requestBodies/CreatePublicationRequest" }, "responses": { "201": { "$ref": "#/components/responses/PublicationRequest" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/versions/{versionId}/publish-requests/{requestId}": { "get": { "operationId": "getStudioPublicationRequest", "parameters": [{ "$ref": "#/components/parameters/ItemId" }, { "$ref": "#/components/parameters/VersionId" }, { "$ref": "#/components/parameters/RequestId" }], "responses": { "200": { "$ref": "#/components/responses/PublicationRequest" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/versions/{versionId}/reopen": { "post": { "operationId": "reopenStudioContentVersion", "parameters": [{ "$ref": "#/components/parameters/ItemId" }, { "$ref": "#/components/parameters/VersionId" }], "responses": { "201": { "$ref": "#/components/responses/Draft" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/content-items/{itemId}/rollback-requests": { "post": { "operationId": "createStudioRollbackRequest", "parameters": [{ "$ref": "#/components/parameters/ItemId" }], "requestBody": { "$ref": "#/components/requestBodies/CreateRollback" }, "responses": { "201": { "$ref": "#/components/responses/Rollback" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/map-packages/generate": { "post": { "operationId": "generateStudioMapPackage", "requestBody": { "$ref": "#/components/requestBodies/GeneratePackage" }, "responses": { "201": { "$ref": "#/components/responses/GeneratedPackage" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/app-packages/generate": { "post": { "operationId": "generateStudioAppPackage", "requestBody": { "$ref": "#/components/requestBodies/GeneratePackage" }, "responses": { "201": { "$ref": "#/components/responses/GeneratedPackage" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/{kind}/{id}/export": { "post": { "operationId": "exportStudioDeliverable", "parameters": [{ "name": "kind", "in": "path", "required": true, "schema": { "type": "string", "enum": ["map", "dashboard", "report"] } }, { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }, { "name": "format", "in": "query", "required": true, "schema": { "type": "string", "enum": ["pdf", "png"] } }, { "name": "versionId", "in": "query", "schema": { "$ref": "#/components/schemas/Uuid" } }, { "name": "store", "in": "query", "schema": { "type": "boolean", "default": false } }], "responses": { "200": { "$ref": "#/components/responses/Export" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/ai/capabilities": { "get": { "operationId": "getStudioAiCapabilities", "responses": { "200": { "$ref": "#/components/responses/AiCapabilities" }, "default": { "$ref": "#/components/responses/Problem" } } } },
    "/ai/chat": { "post": { "operationId": "streamStudioAiChat", "requestBody": { "$ref": "#/components/requestBodies/AiChat" }, "responses": { "200": { "description": "Server-sent Studio AI chat event stream.", "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/StudioAiChatEvent" } } } }, "default": { "$ref": "#/components/responses/Problem" } } } }
  },
  "components": {
    "securitySchemes": { "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }, "BearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "DraftId": { "name": "draftId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }, "ItemId": { "name": "itemId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }, "VersionId": { "name": "versionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }, "RequestId": { "name": "requestId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } },
      "Family": { "name": "family", "in": "query", "schema": { "$ref": "#/components/schemas/StudioPackageFamily" } }, "WorkspaceId": { "name": "workspaceId", "in": "query", "schema": { "type": "string", "maxLength": 200 } }, "OwnerId": { "name": "ownerId", "in": "query", "schema": { "type": "string", "maxLength": 200 } }, "State": { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["draft", "current", "published"] } }, "Search": { "name": "search", "in": "query", "schema": { "type": "string" } }, "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 } }, "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } }
    },
    "requestBodies": {
      "CreateDraft": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateStudioPackageDraftRequest" } } } }, "UpdateDraft": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateStudioPackageDraftRequest" } } } }, "SaveVersion": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SaveStudioContentVersionRequest" } } } }, "CompareVersions": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompareStudioContentVersionsRequest" } } } }, "CreatePublicationRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateStudioPublicationRequest" } } } }, "CreateRollback": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateStudioRollbackRequest" } } } }, "GeneratePackage": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateStudioPackageRequest" } } } }, "AiChat": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StudioAiChatRequest" } } } }
    },
    "responses": {
      "PackageFamilies": { "description": "Package family capabilities.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponsePackageFamilies" } } } }, "Draft": { "description": "Studio package draft.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseDraft" } } } }, "DraftList": { "description": "Cursor-paginated draft page.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseDraftList" } } } }, "Validation": { "description": "Validation result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseValidation" } } } }, "PreviewPlan": { "description": "Preview plan.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponsePreviewPlan" } } } }, "ContentItemList": { "description": "Cursor-paginated content-item page.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseContentItemList" } } } }, "ContentVersion": { "description": "Immutable content version.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseContentVersion" } } } }, "ContentVersionList": { "description": "Content versions.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseContentVersionList" } } } }, "VersionComparison": { "description": "Version comparison.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseVersionComparison" } } } }, "PublicationRequest": { "description": "Durable publication request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponsePublicationRequest" } } } }, "Rollback": { "description": "Rollback result.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseRollback" } } } }, "GeneratedPackage": { "description": "Generated draft package.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseGeneratedPackage" } } } }, "Export": { "description": "Export result or binary deliverable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseExport" } }, "application/pdf": { "schema": { "type": "string", "format": "binary" } }, "image/png": { "schema": { "type": "string", "format": "binary" } } } }, "AiCapabilities": { "description": "Studio AI provider capabilities.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponseAiCapabilities" } } } }, "Problem": { "description": "RFC 7807 error.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" }, "Timestamp": { "type": "string", "format": "date-time" }, "StudioPackageFamily": { "type": "string", "enum": ["query", "analysis", "map", "dashboard", "report", "form", "app", "workflow", "gp", "etl"] },
      "StudioPackageEnvelope": { "type": "object", "required": ["format", "family", "body"], "properties": { "format": { "type": "string" }, "family": { "$ref": "#/components/schemas/StudioPackageFamily" }, "body": { "type": "object", "additionalProperties": true }, "publicationIntent": { "type": "object", "additionalProperties": true } } },
      "StudioValidationSummary": { "type": "object", "required": ["status", "diagnostics"], "properties": { "status": { "type": "string", "enum": ["notValidated", "valid", "validWithWarnings", "invalid"] }, "diagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } },
      "StudioPackageDraft": { "type": "object", "required": ["draftId", "itemId", "packageKey", "family", "envelope", "validation", "generation", "createdAt", "updatedAt"], "properties": { "draftId": { "$ref": "#/components/schemas/Uuid" }, "itemId": { "$ref": "#/components/schemas/Uuid" }, "packageKey": { "type": "string" }, "workspaceId": { "type": "string", "nullable": true }, "ownerId": { "type": "string", "nullable": true }, "family": { "$ref": "#/components/schemas/StudioPackageFamily" }, "envelope": { "$ref": "#/components/schemas/StudioPackageEnvelope" }, "validation": { "$ref": "#/components/schemas/StudioValidationSummary" }, "generation": { "type": "integer", "format": "int64" }, "createdAt": { "$ref": "#/components/schemas/Timestamp" }, "updatedAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "StudioContentItemSummary": { "type": "object", "required": ["itemId", "packageKey", "family", "state", "createdAt", "updatedAt"], "properties": { "itemId": { "$ref": "#/components/schemas/Uuid" }, "packageKey": { "type": "string" }, "workspaceId": { "type": "string", "nullable": true }, "family": { "$ref": "#/components/schemas/StudioPackageFamily" }, "state": { "type": "string", "enum": ["draft", "current", "published"] }, "currentVersionId": { "$ref": "#/components/schemas/Uuid" }, "publishedVersionId": { "$ref": "#/components/schemas/Uuid" }, "ownerId": { "type": "string", "nullable": true }, "createdAt": { "$ref": "#/components/schemas/Timestamp" }, "updatedAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "StudioContentVersion": { "type": "object", "required": ["versionId", "itemId", "packageKey", "versionNumber", "contentHash", "envelope", "validation", "dependencies", "provenance", "createdAt"], "properties": { "versionId": { "$ref": "#/components/schemas/Uuid" }, "itemId": { "$ref": "#/components/schemas/Uuid" }, "packageKey": { "type": "string" }, "workspaceId": { "type": "string", "nullable": true }, "ownerId": { "type": "string", "nullable": true }, "versionNumber": { "type": "integer" }, "contentHash": { "type": "string" }, "envelope": { "$ref": "#/components/schemas/StudioPackageEnvelope" }, "validation": { "$ref": "#/components/schemas/StudioValidationSummary" }, "dependencies": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "provenance": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "StudioPublicationRequest": { "type": "object", "required": ["requestId", "itemId", "versionId", "status", "validation", "createdAt"], "properties": { "requestId": { "$ref": "#/components/schemas/Uuid" }, "itemId": { "$ref": "#/components/schemas/Uuid" }, "versionId": { "$ref": "#/components/schemas/Uuid" }, "intent": { "type": "object", "nullable": true, "additionalProperties": true }, "status": { "type": "string", "enum": ["accepted", "pending", "rejected"] }, "validation": { "$ref": "#/components/schemas/StudioValidationSummary" }, "warningAcknowledgement": { "type": "string", "nullable": true }, "requestedBy": { "type": "string", "nullable": true }, "createdAt": { "$ref": "#/components/schemas/Timestamp" } } },
      "CreateStudioPackageDraftRequest": { "type": "object", "required": ["packageKey", "envelope"], "properties": { "itemId": { "$ref": "#/components/schemas/Uuid" }, "packageKey": { "type": "string", "minLength": 1, "maxLength": 200 }, "workspaceId": { "type": "string", "maxLength": 200 }, "ownerId": { "type": "string", "maxLength": 200 }, "envelope": { "$ref": "#/components/schemas/StudioPackageEnvelope" } } },
      "UpdateStudioPackageDraftRequest": { "allOf": [{ "$ref": "#/components/schemas/CreateStudioPackageDraftRequest" }, { "type": "object", "properties": { "generation": { "type": "integer", "format": "int64" } } }] }, "SaveStudioContentVersionRequest": { "type": "object", "properties": { "changeNote": { "type": "string", "maxLength": 1000 } } }, "CompareStudioContentVersionsRequest": { "type": "object", "required": ["leftVersionId", "rightVersionId"], "properties": { "leftVersionId": { "$ref": "#/components/schemas/Uuid" }, "rightVersionId": { "$ref": "#/components/schemas/Uuid" } } }, "CreateStudioPublicationRequest": { "type": "object", "properties": { "intent": { "type": "object", "additionalProperties": true }, "warningAcknowledgement": { "type": "string", "maxLength": 1000 } } }, "CreateStudioRollbackRequest": { "type": "object", "required": ["targetVersionId"], "properties": { "targetVersionId": { "$ref": "#/components/schemas/Uuid" }, "pointer": { "type": "string", "enum": ["current", "published", "both"], "default": "current" }, "reason": { "type": "string", "maxLength": 1000 } } },
      "StudioContentItemListResponse": { "type": "object", "required": ["items", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/StudioContentItemSummary" } }, "total": { "type": "integer", "format": "int64", "minimum": 0 }, "nextCursor": { "type": "string", "nullable": true } } }, "StudioPackageDraftListResponse": { "type": "object", "required": ["items", "total"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/StudioPackageDraft" } }, "total": { "type": "integer", "format": "int64", "minimum": 0 }, "nextCursor": { "type": "string", "nullable": true } } }, "StudioContentVersionListResponse": { "type": "object", "required": ["itemId", "versions"], "properties": { "itemId": { "$ref": "#/components/schemas/Uuid" }, "versions": { "type": "array", "items": { "$ref": "#/components/schemas/StudioContentVersion" } } } },
      "GenerateStudioPackageRequest": { "type": "object", "additionalProperties": true }, "StudioAiChatRequest": { "type": "object", "required": ["messages"], "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "messages": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "tools": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } }, "StudioAiChatEvent": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "text": { "type": "string" }, "errorCode": { "type": "string" } } },
      "ProblemDetails": { "type": "object", "properties": { "type": { "type": "string", "format": "uri" }, "title": { "type": "string" }, "status": { "type": "integer" }, "detail": { "type": "string" }, "instance": { "type": "string" } } },
      "ApiResponsePackageFamilies": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponseDraft": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioPackageDraft" } } }, "ApiResponseDraftList": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioPackageDraftListResponse" } } }, "ApiResponseValidation": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponsePreviewPlan": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponseContentItemList": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioContentItemListResponse" } } }, "ApiResponseContentVersion": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioContentVersion" } } }, "ApiResponseContentVersionList": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioContentVersionListResponse" } } }, "ApiResponseVersionComparison": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponsePublicationRequest": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/StudioPublicationRequest" } } }, "ApiResponseRollback": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponseGeneratedPackage": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponseExport": { "$ref": "#/components/schemas/GenericApiResponse" }, "ApiResponseAiCapabilities": { "$ref": "#/components/schemas/GenericApiResponse" }, "GenericApiResponse": { "type": "object", "required": ["success"], "properties": { "success": { "type": "boolean" }, "data": { "type": "object", "additionalProperties": true } } }
    }
  }
}
