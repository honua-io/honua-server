<?xml version="1.0" encoding="UTF-8"?>
<qgis version="3.34.0" projectname="Honua Desktop Smoke" saveUser="true">
  <title>Honua Desktop Smoke</title>
  <homePath path=""/>
  <projectCrs>
    <spatialrefsys>
      <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
      <srsid>3452</srsid>
      <srid>4326</srid>
      <authid>EPSG:4326</authid>
      <description>WGS 84</description>
      <projectionacronym>longlat</projectionacronym>
      <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
      <geographicflag>true</geographicflag>
    </spatialrefsys>
  </projectCrs>
  <properties>
    <Variables>
      <variableNames type="QStringList">
        <value>honua_base_url</value>
        <value>honua_collection_id</value>
        <value>honua_api_key</value>
      </variableNames>
      <variableValues type="QStringList">
        <value>${HONUA_BASE_URL}</value>
        <value>${HONUA_COLLECTION_ID}</value>
        <value>${HONUA_API_KEY}</value>
      </variableValues>
    </Variables>
    <Paths>
      <Absolute>false</Absolute>
    </Paths>
  </properties>
  <layer-tree-group name="Honua Desktop Smoke" checked="Qt::Checked" expanded="1"/>
  <customproperties>
    <property key="honua.ogc_features_root" value="${HONUA_BASE_URL}/ogc/features"/>
    <property key="honua.ogc_collection_items" value="${HONUA_BASE_URL}/ogc/features/collections/${HONUA_COLLECTION_ID}/items"/>
  </customproperties>
</qgis>
