# Honua Server - Production Environment Template
# Use with Docker: docker run --env-file .env.production ...
# Use with Compose: docker compose -f docker-compose.production.yml --env-file .env.production up -d --wait
ASPNETCORE_ENVIRONMENT=Production
# Fill the immutable image and private secrets before starting. Empty values fail closed.
HONUA_IMAGE=
HONUA_HOST=honua.example.com
POSTGRES_PASSWORD=
HONUA_STORAGE_VOLUME_NAME=honua_production_storage
HONUA_CORS_ORIGIN=https://app.example.com

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Leave blank for the bundled Compose database; docker run requires an explicit connection.
ConnectionStrings__DefaultConnection=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
HONUA_OBSERVABILITY=true
HONUA_OPENTELEMETRY=true
Observability__Prometheus__Path=/metrics
HONUA_SKIP_MIGRATIONS=false
Database__MigrationSafety__ContractApplyPolicy=Gate

# =============================================================================
# SECURITY (Required for Production)
# =============================================================================
# Strong password for admin endpoints
HONUA_ADMIN_PASSWORD=

# Master key (minimum 32 characters) that encrypts stored data-connection
# credentials — required in production; startup fails without it.
Security__ConnectionEncryption__MasterKey=

# =============================================================================
# CACHE (Redis - recommended for production)
# =============================================================================
# Leave blank for bundled Compose Redis; set explicitly for docker run.
ConnectionStrings__Redis=
Cache__Enabled=true
Cache__DefaultTtlSeconds=300
Cache__ServiceTtlSeconds=300
Cache__LayerTtlSeconds=300
Cache__EnableFallback=true
Cache__FallbackMaxEntries=5000
Cache__RetryIntervalSeconds=30
Cache__KeyPrefix=honua:prod:

# =============================================================================
# EDGE RATE LIMITING
# =============================================================================
# Application-level rate limiting is deferred for MVP.
# Enforce rate limits at your edge proxy/load balancer/WAF.

# =============================================================================
# CORS (configure for your domains)
# =============================================================================
Cors__AllowedOrigins__0=https://app.example.com
Cors__AllowedOrigins__1=https://admin.example.com
Cors__AllowCredentials=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================
SecurityHeaders__EnableHsts=true
SecurityHeaders__HstsMaxAge=31536000

# =============================================================================
# QUERY LIMITS (production-tuned)
# =============================================================================
Limits__Query__MaxRecordCount=5000
Limits__Query__DefaultRecordCount=1000
Limits__Query__MaxOffset=1000000
Limits__Query__QueryTimeout=00:01:00

# =============================================================================
# CONNECTION LIMITS
# =============================================================================
Limits__Connections__MaxConcurrentQueries=200
Limits__Connections__MaxConnectionPoolSize=100
Limits__Connections__RequestTimeout=00:02:00

# =============================================================================
# TILE OPTIONS (production-tuned)
# =============================================================================
Limits__Tiles__MaxFeaturesPerTile=50000
Limits__Tiles__TileTimeout=00:00:30
Limits__Tiles__MaxTileZoom=22
Limits__Tiles__MinTileZoom=0
TileOptions__CacheMaxAge=3600
TileOptions__SimplifyZoom=10
