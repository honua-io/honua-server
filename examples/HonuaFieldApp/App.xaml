<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="HonuaFieldApp.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HonuaFieldApp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Honua Field App Branding -->
            <Color x:Key="HonuaPrimaryColor">#2E7D3E</Color>
            <Color x:Key="HonuaSecondaryColor">#4CAF50</Color>
            <Color x:Key="HonuaAccentColor">#FF9800</Color>
            <Color x:Key="HonuaBackgroundColor">#F5F5F5</Color>
            <Color x:Key="HonuaTextColor">#212121</Color>
            <Color x:Key="HonuaSecondaryTextColor">#757575</Color>

            <!-- Field Collection Specific Colors -->
            <Color x:Key="FieldPointColor">#FF4444</Color>
            <Color x:Key="FieldLineColor">#2196F3</Color>
            <Color x:Key="FieldPolygonColor">#9C27B0</Color>
            <Color x:Key="OfflineIndicatorColor">#FF9800</Color>
            <Color x:Key="OnlineIndicatorColor">#4CAF50</Color>

            <!-- Button Styles -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource HonuaPrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Button" x:Key="SecondaryButton">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource HonuaPrimaryColor}" />
                <Setter Property="BorderColor" Value="{StaticResource HonuaPrimaryColor}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- Map Controls -->
            <Style TargetType="Frame" x:Key="MapOverlayFrame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="True" />
            </Style>

            <!-- Status Indicators -->
            <Style TargetType="Label" x:Key="StatusLabel">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <!-- Field Collection Form Styles -->
            <Style TargetType="Entry" x:Key="FormEntry">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource HonuaTextColor}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource HonuaSecondaryTextColor}" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style TargetType="Label" x:Key="FormLabel">
                <Setter Property="TextColor" Value="{StaticResource HonuaTextColor}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>