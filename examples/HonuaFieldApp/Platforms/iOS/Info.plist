<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic app information -->
    <key>CFBundleName</key>
    <string>HonuaFieldApp</string>
    <key>CFBundleDisplayName</key>
    <string>Honua Field Data Collection</string>
    <key>CFBundleIdentifier</key>
    <string>com.honua.fieldapp</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Supported device families (iPhone and iPad) -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer> <!-- iPhone -->
        <integer>2</integer> <!-- iPad -->
    </array>

    <!-- Location permissions for field data collection -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>This app needs location access to collect GPS coordinates for field data points.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>This app needs continuous location access for field data collection and GPS tracking during surveys.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>This app needs background location access to track GPS coordinates during field work.</string>

    <!-- Camera permissions for photo capture -->
    <key>NSCameraUsageDescription</key>
    <string>This app needs camera access to capture photos for field data collection.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>This app needs photo library access to attach images to collected data.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>This app needs permission to save captured photos to your photo library.</string>

    <!-- Microphone for video recording -->
    <key>NSMicrophoneUsageDescription</key>
    <string>This app needs microphone access for recording field notes and videos.</string>

    <!-- Network usage -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Required device capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>location-services</string>
        <string>gps</string>
    </array>

    <!-- Interface orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Background modes for field data collection -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>background-fetch</string>
        <string>background-processing</string>
    </array>

    <!-- Maps and location accuracy -->
    <key>MKDirectionsApplicationSupportedModes</key>
    <array>
        <string>MKDirectionsModePlane</string>
        <string>MKDirectionsModeCar</string>
        <string>MKDirectionsModePedestrian</string>
    </array>

    <!-- Performance optimizations -->
    <key>UIMainStoryboardFile</key>
    <string></string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- File sharing for data export -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Prevent app backup (contains sensitive field data) -->
    <key>UIFileSharingEnabled</key>
    <false/>

    <!-- iOS 14+ location accuracy -->
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict>
        <key>FieldDataCollection</key>
        <string>This app needs precise location access to accurately record GPS coordinates for field data points.</string>
    </dict>

</dict>
</plist>