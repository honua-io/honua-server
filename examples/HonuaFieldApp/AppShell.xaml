<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HonuaFieldApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HonuaFieldApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Honua Field App">

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource HonuaPrimaryColor}" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
                <Setter Property="Shell.TitleColor" Value="White" />
                <Setter Property="Shell.DisabledColor" Value="#B4FFFFFF" />
                <Setter Property="Shell.UnselectedColor" Value="#95FFFFFF" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource HonuaPrimaryColor}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="White"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="#95FFFFFF"/>
                <Setter Property="Shell.TabBarTitleColor" Value="White"/>
            </Style>
            <Style TargetType="TabBar" BasedOn="{StaticResource BaseStyle}" />
            <Style TargetType="FlyoutItem" BasedOn="{StaticResource BaseStyle}" />
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Main navigation structure -->
    <TabBar>
        <ShellContent
            Title="Map"
            Icon="map_icon.png"
            ContentTemplate="{DataTemplate local:MapPage}"
            Route="map" />

        <ShellContent
            Title="Collect Data"
            Icon="collect_icon.png"
            ContentTemplate="{DataTemplate local:DataCollectionPage}"
            Route="datacollection" />

        <ShellContent
            Title="Sync"
            Icon="sync_icon.png"
            ContentTemplate="{DataTemplate local:SyncPage}"
            Route="sync" />

        <ShellContent
            Title="Settings"
            Icon="settings_icon.png"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="settings" />
    </TabBar>

    <!-- Flyout menu for additional options -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource HonuaPrimaryColor}"
              HeightRequest="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Source="honua_logo.png"
                   Aspect="AspectFit"
                   HeightRequest="100"
                   Grid.Row="0" />

            <Label Text="Field Data Collection"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Grid.Row="1"
                   Margin="0,0,0,16" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Flyout menu items -->
    <FlyoutItem Title="Field Operations" Icon="field_icon.png">
        <ShellContent Title="Map View" ContentTemplate="{DataTemplate local:MapPage}" />
        <ShellContent Title="Data Collection" ContentTemplate="{DataTemplate local:DataCollectionPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Data Management" Icon="data_icon.png">
        <ShellContent Title="Sync Status" ContentTemplate="{DataTemplate local:SyncPage}" />
        <ShellContent Title="Offline Data" ContentTemplate="{DataTemplate local:OfflineDataPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configuration" Icon="config_icon.png">
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
        <ShellContent Title="Performance" ContentTemplate="{DataTemplate local:PerformancePage}" />
    </FlyoutItem>

</Shell>