<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HonuaFieldApp.Views.MapPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:vm="clr-namespace:HonuaFieldApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Map View"
             Shell.TabBarIsVisible="True">

    <ContentPage.BindingContext>
        <vm:MapPageViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Map View -->
        <maps:Map x:Name="MapView"
                  Grid.Row="0"
                  MapType="{Binding SelectedMapType}"
                  IsShowingUser="{Binding IsShowingUser}"
                  IsZoomEnabled="True"
                  IsScrollEnabled="True">

            <!-- Map clicked behavior -->
            <maps:Map.Behaviors>
                <toolkit:EventToCommandBehavior
                    EventName="MapClicked"
                    Command="{Binding MapClickedCommand}" />
            </maps:Map.Behaviors>
        </maps:Map>

        <!-- Map Controls Overlay -->
        <Frame Grid.Row="0"
               Style="{StaticResource MapOverlayFrame}"
               HorizontalOptions="End"
               VerticalOptions="Start"
               WidthRequest="60"
               HeightRequest="200">
            <StackLayout Spacing="8">
                <!-- Location Button -->
                <Button Text="📍"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="{StaticResource HonuaPrimaryColor}"
                        TextColor="White"
                        Command="{Binding CenterOnLocationCommand}"
                        ToolTipProperties.Text="Center on current location" />

                <!-- Layer Toggle -->
                <Button Text="🗂️"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="{StaticResource HonuaSecondaryColor}"
                        TextColor="White"
                        Command="{Binding ToggleLayersCommand}"
                        ToolTipProperties.Text="Toggle map layers" />

                <!-- Zoom to Features -->
                <Button Text="🎯"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="{StaticResource HonuaAccentColor}"
                        TextColor="White"
                        Command="{Binding ZoomToFeaturesCommand}"
                        ToolTipProperties.Text="Zoom to all features" />

                <!-- Refresh Data -->
                <Button Text="🔄"
                        FontSize="20"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="{StaticResource HonuaPrimaryColor}"
                        TextColor="White"
                        Command="{Binding RefreshDataCommand}"
                        ToolTipProperties.Text="Refresh map data"
                        IsEnabled="{Binding IsNotLoading}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsLoading}"
                                     Value="True">
                            <Setter Property="Text" Value="⏳" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </StackLayout>
        </Frame>

        <!-- Status Information Overlay -->
        <Frame Grid.Row="0"
               Style="{StaticResource MapOverlayFrame}"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               WidthRequest="200">
            <StackLayout Spacing="4">
                <!-- Connection Status -->
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Grid.Column="0"
                             WidthRequest="12"
                             HeightRequest="12"
                             Fill="{Binding ConnectionStatusColor}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding ConnectionStatus}"
                           Style="{StaticResource StatusLabel}"
                           HorizontalOptions="Start"
                           Margin="8,0,0,0" />
                </Grid>

                <!-- GPS Status -->
                <Grid ColumnDefinitions="Auto,*">
                    <Ellipse Grid.Column="0"
                             WidthRequest="12"
                             HeightRequest="12"
                             Fill="{Binding GpsStatusColor}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding GpsStatus}"
                           Style="{StaticResource StatusLabel}"
                           HorizontalOptions="Start"
                           Margin="8,0,0,0" />
                </Grid>

                <!-- Feature Count -->
                <Label Text="{Binding FeatureCount, StringFormat='Features: {0}'}"
                       Style="{StaticResource StatusLabel}"
                       HorizontalOptions="Start" />

                <!-- Performance Metrics -->
                <Label Text="{Binding RenderTime, StringFormat='Render: {0}ms'}"
                       Style="{StaticResource StatusLabel}"
                       HorizontalOptions="Start"
                       FontSize="10" />

                <Label Text="{Binding MemoryUsage, StringFormat='Memory: {0:F1}MB'}"
                       Style="{StaticResource StatusLabel}"
                       HorizontalOptions="Start"
                       FontSize="10" />
            </StackLayout>
        </Frame>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource HonuaPrimaryColor}"
                               WidthRequest="50"
                               HeightRequest="50" />
            <Label Text="{Binding LoadingMessage}"
                   TextColor="White"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,60,0,0" />
        </Grid>

        <!-- Bottom Control Panel -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource HonuaPrimaryColor}"
              Padding="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Query Controls -->
            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Entry x:Name="WhereClauseEntry"
                       Text="{Binding WhereClause}"
                       Placeholder="Where clause (e.g., status='active')"
                       TextColor="White"
                       PlaceholderColor="#B4FFFFFF"
                       BackgroundColor="#40FFFFFF"
                       HorizontalOptions="FillAndExpand"
                       MinimumWidthRequest="200" />

                <Button Text="Query"
                        Style="{StaticResource SecondaryButton}"
                        BackgroundColor="White"
                        TextColor="{StaticResource HonuaPrimaryColor}"
                        Command="{Binding QueryFeaturesCommand}"
                        IsEnabled="{Binding IsNotLoading}" />
            </StackLayout>

            <!-- Action Buttons -->
            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Text="+ Point"
                        Style="{StaticResource SecondaryButton}"
                        BackgroundColor="White"
                        TextColor="{StaticResource FieldPointColor}"
                        Command="{Binding AddPointCommand}"
                        FontSize="12" />

                <Button Text="Download Area"
                        Style="{StaticResource SecondaryButton}"
                        BackgroundColor="White"
                        TextColor="{StaticResource HonuaPrimaryColor}"
                        Command="{Binding DownloadAreaCommand}"
                        IsEnabled="{Binding CanDownloadArea}"
                        FontSize="12" />
            </StackLayout>

            <!-- Settings -->
            <Button Grid.Column="2"
                    Text="⚙️"
                    FontSize="20"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="White"
                    TextColor="{StaticResource HonuaPrimaryColor}"
                    Command="{Binding ShowSettingsCommand}" />
        </Grid>
    </Grid>

</ContentPage>