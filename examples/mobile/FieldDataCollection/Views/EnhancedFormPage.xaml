<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FieldDataCollection.Views.EnhancedFormPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldDataCollection.ViewModels"
             xmlns:models="clr-namespace:FieldDataCollection.Models"
             x:DataType="vm:HybridFormViewModel"
             Title="{Binding CurrentGrpcForm.Title, FallbackValue={Binding CurrentXForm.FormTitle}}"
             x:Name="FormPageRoot">

    <!-- Collaboration Status Bar (gRPC only) -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CollaborationChipStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Success100}, Dark={StaticResource Success800}}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Loading Indicator -->
    <ActivityIndicator IsVisible="{Binding IsLoading}"
                      IsRunning="{Binding IsLoading}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

    <!-- Main Form Content -->
    <Grid IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- Form Type Indicator -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Info100}, Dark={StaticResource Info800}}"
                Padding="12,8"
                IsVisible="{Binding CurrentFormType, Converter={StaticResource IsNotNullConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding CurrentFormType, StringFormat='📋 {0} Form'}"
                       Style="{StaticResource CaptionStyle}"
                       VerticalOptions="Center" />

                <!-- gRPC Performance Badge -->
                <Border Grid.Column="2"
                        Style="{StaticResource CollaborationChipStyle}"
                        IsVisible="{Binding CurrentFormType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GrpcNative}">
                    <Label Text="⚡ gRPC Fast"
                           Style="{StaticResource CaptionStyle}"
                           TextColor="{StaticResource Success}"
                           FontAttributes="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- Collaboration Bar (gRPC only) -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Success100}, Dark={StaticResource Success800}}"
                Padding="12,8"
                IsVisible="{Binding IsCollaborationEnabled}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Text="👥 Live Collaboration"
                       Style="{StaticResource CaptionStyle}"
                       VerticalOptions="Center" />

                <CollectionView Grid.Column="1"
                               ItemsSource="{Binding ActiveCollaborators}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CollaborationChipStyle}">
                                <Label Text="{Binding .}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextColor="{StaticResource Success}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Column="2"
                        Text="⚙️"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ConfigureCollaborationCommand}" />
            </Grid>
        </Border>

        <!-- Form Header with Progress -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding CurrentGrpcForm.Title, FallbackValue={Binding CurrentXForm.FormTitle}}"
                           Style="{StaticResource HeadlineStyle}" />
                    <Label Text="{Binding CurrentGrpcForm.Description, FallbackValue={Binding CurrentXForm.Description}}"
                           Style="{StaticResource BodyStyle}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           IsVisible="{Binding CurrentGrpcForm.Description, Converter={StaticResource IsNotNullOrEmptyConverter}, FallbackValue={Binding CurrentXForm.Description, Converter={StaticResource IsNotNullOrEmptyConverter}}}" />
                    <Label Text="{Binding Progress.CompletedFields, StringFormat='Progress: {0}/{1} fields completed'}"
                           Style="{StaticResource CaptionStyle}" />
                </StackLayout>

                <StackLayout Grid.Column="1" Spacing="4">
                    <ProgressBar Progress="{Binding Progress.PercentComplete, Converter={StaticResource PercentToDecimalConverter}}"
                                ProgressColor="{StaticResource Success}"
                                VerticalOptions="Center"
                                WidthRequest="80" />

                    <!-- Real-time sync indicator for gRPC -->
                    <Label Text="🔄 Live Sync"
                           Style="{StaticResource CaptionStyle}"
                           TextColor="{StaticResource Success}"
                           HorizontalOptions="Center"
                           IsVisible="{Binding IsCollaborationEnabled}" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- Dynamic Form Fields ScrollView -->
        <ScrollView Grid.Row="3" Padding="16">
            <StackLayout x:Name="DynamicFormFieldsContainer" Spacing="16">
                <!-- Dynamic form fields will be generated here based on MobileControls -->
                <CollectionView ItemsSource="{Binding MobileControls}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MobileFormControl">
                            <StackLayout Spacing="8" Padding="0,8">
                                <!-- Field Label with gRPC optimization indicator -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Label}"
                                           Style="{StaticResource BodyStyle}" />

                                    <Border Grid.Column="1"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="4,2"
                                            IsVisible="{Binding Source={x:Reference FormPageRoot}, Path=BindingContext.CurrentFormType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GrpcNative}">
                                        <Label Text="⚡"
                                               Style="{StaticResource CaptionStyle}"
                                               TextColor="White" />
                                    </Border>
                                </Grid>

                                <!-- Hint Text -->
                                <Label Text="{Binding Hint}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                       IsVisible="{Binding Hint, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                                <!-- Dynamic Control Container -->
                                <ContentView x:Name="DynamicControlContainer" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Performance Metrics Footer (gRPC only) -->
        <Border Grid.Row="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary100}, Dark={StaticResource Primary800}}"
                Padding="16,8"
                IsVisible="{Binding CurrentFormType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GrpcNative}">
            <Grid ColumnDefinitions="*,*,*">
                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="⚡ 5x Faster"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold" />
                    <Label Text="vs XML parsing"
                           Style="{StaticResource MicroStyle}"
                           TextColor="{StaticResource Gray600}" />
                </StackLayout>

                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="📊 70% Less"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold" />
                    <Label Text="bandwidth usage"
                           Style="{StaticResource MicroStyle}"
                           TextColor="{StaticResource Gray600}" />
                </StackLayout>

                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="🔧 Type Safe"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold" />
                    <Label Text="no runtime errors"
                           Style="{StaticResource MicroStyle}"
                           TextColor="{StaticResource Gray600}" />
                </StackLayout>
            </Grid>
        </Border>

        <!-- Validation Summary -->
        <Border Grid.Row="5"
                BackgroundColor="{AppThemeBinding Light={StaticResource Warning100}, Dark={StaticResource Warning900}}"
                Padding="16,12"
                IsVisible="{Binding ValidationSummary, Converter={StaticResource IsNotNullOrEmptyConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Text="⚠️"
                       FontSize="18"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="{Binding ValidationSummary}"
                       Style="{StaticResource BodyStyle}"
                       VerticalOptions="Center"
                       Margin="8,0" />

                <Button Grid.Column="2"
                        Text="View Details"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding ShowValidationDetailsCommand}" />
            </Grid>
        </Border>
    </Grid>

    <!-- Enhanced Floating Action Buttons with gRPC indicators -->
    <Grid IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <!-- Submit Button with Protocol Indicator -->
        <Border BackgroundColor="{StaticResource Success}"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,120">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Border.Shadow>
            <Grid>
                <Button Text="{Binding CurrentFormType, Converter={StaticResource FormTypeToSubmitIconConverter}}"
                        FontSize="24"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Command="{Binding SubmitFormCommand}"
                        IsEnabled="{Binding CanSubmit}"
                        ToolTipProperties.Text="{Binding CurrentFormType, StringFormat='Submit via {0}'}" />
            </Grid>
        </Border>

        <!-- Collaboration Button (gRPC only) -->
        <Border BackgroundColor="{StaticResource Primary}"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,180"
                IsVisible="{Binding CurrentFormType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GrpcNative}">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Border.Shadow>
            <Button Text="{Binding IsCollaborationEnabled, Converter={StaticResource BoolToCollabIconConverter}}"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Command="{Binding ToggleCollaborationCommand}"
                    ToolTipProperties.Text="{Binding IsCollaborationEnabled, Converter={StaticResource BoolToCollabTooltipConverter}}" />
        </Border>

        <!-- Save Draft Button -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,60">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Border.Shadow>
            <Button Text="💾"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Command="{Binding SaveDraftCommand}"
                    ToolTipProperties.Text="Save Draft" />
        </Border>
    </Grid>
</ContentPage>