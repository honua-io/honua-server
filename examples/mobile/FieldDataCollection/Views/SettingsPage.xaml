<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FieldDataCollection.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldDataCollection.ViewModels"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Command="{Binding SaveSettingsCommand}"
                     IconImageSource="save.png" />
        <ToolbarItem Text="Diagnostics"
                     Command="{Binding ViewDiagnosticsCommand}"
                     IconImageSource="info.png" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="16" Spacing="32">

            <!-- Server Configuration -->
            <StackLayout Spacing="16">
                <Label Text="Server Configuration" FontAttributes="Bold" FontSize="18" />

                <StackLayout>
                    <Label Text="Server URL" FontAttributes="Bold" />
                    <Entry Text="{Binding ServerUrl}"
                           Placeholder="https://api.honua.com"
                           Keyboard="Url" />
                    <Label Text="The Honua server endpoint for data synchronization"
                           FontSize="12"
                           TextColor="Gray" />
                </StackLayout>

                <Button Text="🔍 Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="8" />

            </StackLayout>

            <!-- Authentication -->
            <StackLayout Spacing="16">
                <Label Text="Authentication" FontAttributes="Bold" FontSize="18" />

                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="Status:"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding HasCredentials, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Authenticated,Not Authenticated'}"
                           TextColor="{Binding HasCredentials, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green,Red'}"
                           Margin="8,0,0,0"
                           VerticalOptions="Center" />
                </Grid>

                <StackLayout IsVisible="{Binding HasCredentials}">
                    <Label Text="API Key" FontAttributes="Bold" />
                    <Label Text="{Binding ApiKey}"
                           FontFamily="Monospace"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                           Padding="8" />
                </StackLayout>

                <Button Text="🗑️ Clear Credentials"
                        Command="{Binding ClearCredentialsCommand}"
                        IsVisible="{Binding HasCredentials}"
                        BackgroundColor="Red"
                        TextColor="White"
                        CornerRadius="8" />

                <Label Text="API key is stored securely in the device keychain/keystore"
                       FontSize="12"
                       TextColor="Gray" />

            </StackLayout>

            <!-- Sync Settings -->
            <StackLayout Spacing="16">
                <Label Text="Sync Settings" FontAttributes="Bold" FontSize="18" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Enable automatic sync"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1"
                            IsToggled="{Binding AutoSyncEnabled}" />
                </Grid>

                <StackLayout IsVisible="{Binding AutoSyncEnabled}">
                    <Label Text="Sync Interval (minutes)" FontAttributes="Bold" />
                    <Stepper Value="{Binding SyncIntervalMinutes}"
                             Minimum="1"
                             Maximum="120"
                             Increment="5" />
                    <Label Text="{Binding SyncIntervalMinutes, StringFormat='Every {0} minutes'}"
                           FontSize="12"
                           TextColor="Gray" />
                </StackLayout>

            </StackLayout>

            <!-- Location Services -->
            <StackLayout Spacing="16">
                <Label Text="Location Services" FontAttributes="Bold" FontSize="18" />

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Label Grid.Column="0"
                           Text="Status:"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding LocationEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Enabled,Disabled'}"
                           TextColor="{Binding LocationEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green,Orange'}"
                           Margin="8,0,0,0"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="Enable"
                            Command="{Binding RequestLocationPermissionCommand}"
                            IsVisible="{Binding LocationEnabled, Converter={StaticResource InvertedBoolConverter}}"
                            FontSize="12"
                            BackgroundColor="{StaticResource Primary}" />
                </Grid>

                <Label Text="Location services are required for field data collection and GPS tagging"
                       FontSize="12"
                       TextColor="Gray" />

            </StackLayout>

            <!-- App Information -->
            <StackLayout Spacing="16">
                <Label Text="App Information" FontAttributes="Bold" FontSize="18" />

                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Version:"
                           FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding AppVersion}" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Platform:"
                           FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{x:Static DeviceInfo.Platform}" />

                    <Label Grid.Row="2" Grid.Column="0"
                           Text="Device:"
                           FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="{x:Static DeviceInfo.Model}" />

                </Grid>

                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Button Text="📋 View Diagnostics"
                            Command="{Binding ViewDiagnosticsCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            TextColor="{StaticResource Primary}"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand" />

                    <Button Text="📤 Export Diagnostics"
                            Command="{Binding ExportDiagnosticsCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            TextColor="{StaticResource Primary}"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand" />
                </StackLayout>

            </StackLayout>

            <!-- Loading Indicator -->
            <StackLayout IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  Color="{StaticResource Primary}" />
                <Label Text="Loading..."
                       HorizontalOptions="Center" />
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>