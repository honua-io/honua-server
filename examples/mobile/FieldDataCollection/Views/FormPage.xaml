<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FieldDataCollection.Views.FormPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldDataCollection.ViewModels"
             xmlns:models="clr-namespace:FieldDataCollection.Models"
             x:DataType="vm:FormViewModel"
             Title="{Binding CurrentForm.FormTitle}"
             x:Name="FormPageRoot">

    <!-- Loading Indicator -->
    <ActivityIndicator IsVisible="{Binding IsLoading}"
                      IsRunning="{Binding IsLoading}"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

    <!-- Main Form Content -->
    <Grid IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
          RowDefinitions="Auto,*,Auto">

        <!-- Form Header with Progress -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding CurrentForm.FormTitle}"
                           Style="{StaticResource HeadlineStyle}" />
                    <Label Text="{Binding CurrentForm.Description}"
                           Style="{StaticResource BodyStyle}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                           IsVisible="{Binding CurrentForm.Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    <Label Text="{Binding Progress.CompletedFields, StringFormat='Progress: {0}/{1} fields completed'}"
                           Style="{StaticResource CaptionStyle}" />
                </StackLayout>

                <ProgressBar Grid.Column="1"
                            Progress="{Binding Progress.PercentComplete, Converter={StaticResource PercentToDecimalConverter}}"
                            ProgressColor="{StaticResource Success}"
                            VerticalOptions="Center"
                            WidthRequest="80" />
            </Grid>
        </Border>

        <!-- Form Fields ScrollView -->
        <ScrollView Grid.Row="1" Padding="16">
            <StackLayout x:Name="FormFieldsContainer" Spacing="16">
                <!-- Dynamic form fields will be generated here in code-behind -->
            </StackLayout>
        </ScrollView>

        <!-- Validation Summary -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Warning100}, Dark={StaticResource Warning900}}"
                Padding="16,12"
                IsVisible="{Binding ValidationSummary, Converter={StaticResource IsNotNullOrEmptyConverter}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0"
                       Text="⚠️"
                       FontSize="18"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="{Binding ValidationSummary}"
                       Style="{StaticResource BodyStyle}"
                       VerticalOptions="Center"
                       Margin="8,0" />

                <Button Grid.Column="2"
                        Text="View Details"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding ShowValidationDetailsCommand}" />
            </Grid>
        </Border>
    </Grid>

    <!-- Floating Action Buttons -->
    <Grid IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <!-- Submit Button -->
        <Border BackgroundColor="{StaticResource Success}"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,120">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Border.Shadow>
            <Button Text="✓"
                    FontSize="24"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Command="{Binding SubmitFormCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    ToolTipProperties.Text="Submit Form" />
        </Border>

        <!-- Save Draft Button -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,60">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Border.Shadow>
            <Button Text="💾"
                    FontSize="20"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Command="{Binding SaveDraftCommand}"
                    ToolTipProperties.Text="Save Draft" />
        </Border>
    </Grid>
</ContentPage>