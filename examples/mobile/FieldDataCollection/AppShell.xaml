<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FieldDataCollection.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FieldDataCollection.Views"
    Title="Honua Field Data Collection">

    <!--
        Shell navigation structure with tabbed interface.
        Each ShellContent represents a main navigation tab.
    -->

    <!-- Map Tab - Main data collection interface -->
    <TabBar>
        <ShellContent
            Title="Map"
            Icon="map.png"
            ContentTemplate="{DataTemplate views:MapPage}"
            Route="MapPage" />

        <!-- Sync Tab - Data synchronization management -->
        <ShellContent
            Title="Sync"
            Icon="sync.png"
            ContentTemplate="{DataTemplate views:SyncCenterPage}"
            Route="SyncCenterPage" />

        <!-- Settings Tab - Configuration and diagnostics -->
        <ShellContent
            Title="Settings"
            Icon="settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>