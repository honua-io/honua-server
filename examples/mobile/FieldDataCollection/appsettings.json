{
  "HonuaMobileClient": {
    "ServerUrl": "https://api.honua.com",
    "EnableBackgroundSync": true,
    "SyncIntervalMinutes": 30,
    "RetainDataDays": 30,
    "MaxReceiveMessageSize": 16777216,
    "MaxSendMessageSize": 16777216,
    "AcceptInvalidCertificates": false
  },
  "LocalStorage": {
    "DatabasePath": null,
    "EnableAutoSync": true,
    "SyncIntervalMinutes": 30,
    "WifiOnlySync": false,
    "MaxDatabaseSizeMB": 500,
    "RetainCompletedSubmissionsDays": 30,
    "EnableDetailedLogging": false,
    "FormCacheTimeoutMinutes": 60,
    "EnableSpatialIndexing": true,
    "CompressMedia": true,
    "PhotoQuality": 85
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "FieldDataCollection": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Maps": {
    "DefaultZoomLevel": 15,
    "MaxCachedTiles": 1000,
    "OfflineMapPath": "maps/offline",
    "EnableCaching": true
  },
  "Camera": {
    "DefaultQuality": 85,
    "MaxResolution": "1920x1080",
    "EnableGPSTagging": true,
    "AutoBlurFaces": true
  },
  "Sync": {
    "RetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "BatchSize": 50,
    "TimeoutSeconds": 120,
    "ConflictResolution": "UserChoice"
  }
}