{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "_comment": "Source-path → server-tests shard mapping for selective PR execution. Owned by ADR-0035. The shard `name` MUST match the `shard_name` value in .github/workflows/ci.yml::server-tests. The `filter` MUST mirror the matrix entry's filter so this file stays the single source of truth. The `paths` are repo-relative directory prefixes that, when changed, scope the PR's targeted matrix to this shard. `infrastructure_paths` short-circuits to run_all on first match. `unmapped_source_run_all_prefixes` forces run_all when a changed file under one of those prefixes is not matched by any shard's `paths` — this prevents new feature directories from silently routing to the Core shard whose filter excludes Honua.Server.Tests.Features.*. `default_shards_when_no_match` is only consulted when no source code under those prefixes was touched (e.g. doc-only diffs).",
  "infrastructure_paths": [
    "tests/dotnet/Honua.TestKit/",
    "src/Honua.Core/",
    "src/Honua.Postgres/",
    "src/Honua.ServiceDefaults/",
    "src/Honua.Server/Features/Infrastructure/",
    "Honua.sln",
    ".github/",
    "scripts/ci/"
  ],
  "unmapped_source_run_all_prefixes": [
    "src/Honua.Server/",
    "src/Honua.DuckDB/",
    "tests/dotnet/Honua.Server.Tests/"
  ],
  "default_shards_when_no_match": ["Core"],
