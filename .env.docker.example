# Honua Server - Docker Compose Environment Template
# Use with: docker compose --env-file .env.docker up

# =============================================================================
# DATABASE (connects to compose service 'postgres')
# =============================================================================
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=honua_dev;Username=honua_user;Password=honua_password

# =============================================================================
# REDIS (connects to compose service 'redis')
# =============================================================================
# Redis connection is auto-configured via Aspire service defaults
# Cache settings below control behavior

# =============================================================================
# FEATURE FLAGS
# =============================================================================
HONUA_SERVE_ADMIN_UI=true
HONUA_ADMIN_UI=true
HONUA_OBSERVABILITY=true
HONUA_OPENTELEMETRY=false
Observability__Prometheus__Path=/metrics
HONUA_SKIP_MIGRATIONS=false

# =============================================================================
# SECURITY
# =============================================================================
HONUA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

# =============================================================================
# CACHE
# =============================================================================
Cache__Enabled=true
Cache__DefaultTtlSeconds=300
Cache__EnableFallback=true

# =============================================================================
# EDGE RATE LIMITING
# =============================================================================
# Application-level rate limiting is deferred for MVP.
# Enforce rate limits at your edge proxy/load balancer/WAF.

# =============================================================================
# CORS (allow localhost for development)
# =============================================================================
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# =============================================================================
# LIMITS (relaxed for development)
# =============================================================================
Limits__Query__MaxRecordCount=5000
Limits__Query__QueryTimeout=00:02:00
Limits__Tiles__MaxFeaturesPerTile=25000
Limits__Tiles__TileTimeout=00:00:20
TileOptions__CacheMaxAge=300
