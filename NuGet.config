<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-honua" value="https://nuget.pkg.github.com/honua-io/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Geospatial.Grpc" />
      <!-- Honua.Sdk.GeoServices 1.8.0 and its Honua.Sdk.* dependencies publish to nuget.org only (#4599). -->
      <package pattern="Honua.Sdk.GeoServices" />
      <package pattern="Honua.Sdk.Abstractions" />
      <package pattern="Honua.Sdk.Geometry" />
    </packageSource>
    <packageSource key="github-honua">
      <package pattern="Honua.Core" />
      <package pattern="Honua.Mobile.*" />
      <package pattern="Honua.Sdk.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
