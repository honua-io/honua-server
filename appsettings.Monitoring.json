{
  "Monitoring": {
    "AnomalyDetection": {
      "BaselineWindowMinutes": 60,
      "SensitivityThreshold": 0.3,
      "MinimumDataPoints": 30,
      "MaxHistoricalDataPoints": 1000,
      "EnableMachineLearning": true,
      "AlertCooldownMinutes": 15
    },
    "IntelligentAlerting": {
      "EnableSmartAlerting": true,
      "AlertSuppressionMinutes": 15,
      "MaxAlertsPerHour": 20,
      "EnablePredictiveAlerting": true,
      "PredictiveAlertThreshold": 0.7,
      "NotificationChannels": {
        "Email": {
          "Enabled": false,
          "SmtpServer": "",
          "SmtpPort": 587,
          "Username": "",
          "Password": "",
          "Recipients": []
        },
        "Slack": {
          "Enabled": false,
          "WebhookUrl": "",
          "Channel": "#alerts"
        },
        "Webhook": {
          "Enabled": false,
          "Url": "",
          "Headers": {
            "Authorization": "",
            "Content-Type": "application/json"
          }
        },
        "Sms": {
          "Enabled": false,
          "ApiKey": "",
          "PhoneNumbers": []
        }
      },
      "EscalationRules": [
        {
          "AlertTypes": ["PerformanceAnomaly", "SecurityThreat"],
          "Severities": ["Critical", "High"],
          "EscalationTimeMinutes": 30,
          "EscalationChannels": ["email", "sms"]
        }
      ]
    },
    "Integration": {
      "EnablePrometheusExport": true,
      "EnableOtlpExport": true,
      "EnableDataExport": true,
      "EnableWebhookIntegration": true,
      "EnableMultiTenant": false,
      "ExportIntervalMinutes": 5,
      "DataExportPath": "./exports",
      "PrometheusEndpoint": "/metrics",
      "OtlpEndpoint": {
        "Endpoint": "http://localhost:4317",
        "Headers": {
          "Authorization": ""
        },
        "Protocol": "grpc"
      },
      "Webhooks": [],
      "MultiTenant": {
        "TenantIdHeader": "X-Tenant-Id",
        "DefaultTenant": "default",
        "IsolateTenantData": true
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Honua.Core.Features.Infrastructure.Monitoring": "Information"
    }
  },

  "OpenTelemetry": {
    "ServiceName": "Honua-Server",
    "ServiceVersion": "1.0.0",
    "Exporters": {
      "Console": {
        "Enabled": false
      },
      "OTLP": {
        "Enabled": true,
        "Endpoint": "http://localhost:4317",
        "Protocol": "Grpc"
      }
    },
    "Instrumentation": {
      "AspNetCore": {
        "Enabled": true,
        "RecordException": true,
        "EnableGrpcAspNetCoreSupport": false
      },
      "Http": {
        "Enabled": true,
        "RecordException": true
      },
      "SqlClient": {
        "Enabled": true,
        "SetDbStatementForText": true,
        "RecordException": true
      }
    },
    "Metrics": {
      "Enabled": true,
      "Exporters": {
        "Console": {
          "Enabled": false
        },
        "OTLP": {
          "Enabled": true,
          "Endpoint": "http://localhost:4318/v1/metrics",
          "Protocol": "HttpProtobuf"
        },
        "Prometheus": {
          "Enabled": true,
          "ScrapeEndpointPath": "/metrics",
          "ScrapeResponseCacheDurationMilliseconds": 300
        }
      }
    }
  }
}