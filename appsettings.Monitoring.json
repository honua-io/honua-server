{
  "Monitoring": {
    "AnomalyDetection": {
      "BaselineWindowMinutes": 60,
      "SensitivityThreshold": 0.3,
      "MinimumDataPoints": 30,
      "MaxHistoricalDataPoints": 1000,
      "EnableMachineLearning": true,
      "AlertCooldownMinutes": 15
    },
    "IntelligentAlerting": {
      "EnableSmartAlerting": true,
      "AlertSuppressionMinutes": 15,
      "MaxAlertsPerHour": 20,
      "EnablePredictiveAlerting": true,
      "PredictiveAlertThreshold": 0.7,
      "NotificationChannels": {
        "Email": {
          "Enabled": false,
          "SmtpServer": "smtp.company.com",
          "SmtpPort": 587,
          "Username": "monitoring@company.com",
          "Password": "secure_password",
          "Recipients": [
            "devops@company.com",
            "alerts@company.com"
          ]
        },
        "Slack": {
          "Enabled": false,
          "WebhookUrl": "https://hooks.slack.com/services/...",
          "Channel": "#monitoring-alerts"
        },
        "Webhook": {
          "Enabled": false,
          "Url": "https://api.company.com/webhooks/alerts",
          "Headers": {
            "Authorization": "Bearer token123",
            "Content-Type": "application/json"
          }
        },
        "Sms": {
          "Enabled": false,
          "ApiKey": "sms_api_key",
          "PhoneNumbers": [
            "+1234567890",
            "+0987654321"
          ]
        }
      },
      "EscalationRules": [
        {
          "AlertTypes": ["PerformanceAnomaly", "SecurityThreat"],
          "Severities": ["Critical", "High"],
          "EscalationTimeMinutes": 30,
          "EscalationChannels": ["email", "sms"]
        }
      ]
    },
    "PerformanceIntelligence": {
      "EnableAutomaticAnalysis": true,
      "AnalysisIntervalMinutes": 30,
      "EnableOptimizationRecommendations": true,
      "EnableMemoryProfiling": true,
      "EnableDatabaseAnalysis": true,
      "EnableNetworkAnalysis": true,
      "PerformanceScoreThreshold": 80,
      "MaxRecommendations": 100
    },
    "BusinessAnalytics": {
      "EnableApiUsageTracking": true,
      "EnableUserBehaviorAnalytics": true,
      "EnableGeographicAnalytics": true,
      "EnableFeatureAdoptionTracking": true,
      "EnablePerformanceCorrelation": true,
      "DataRetentionDays": 90,
      "AggregationIntervalMinutes": 15,
      "MaxEventsInMemory": 10000
    },
    "Integration": {
      "EnablePrometheusExport": true,
      "EnableOtlpExport": true,
      "EnableDataExport": true,
      "EnableWebhookIntegration": true,
      "EnableMultiTenant": false,
      "ExportIntervalMinutes": 5,
      "DataExportPath": "./exports",
      "PrometheusEndpoint": "/metrics",
      "OtlpEndpoint": {
        "Endpoint": "http://localhost:4317",
        "Headers": {
          "Authorization": "Bearer otlp_token"
        },
        "Protocol": "grpc"
      },
      "Webhooks": [
        {
          "Name": "External Monitoring System",
          "Url": "https://monitoring.company.com/api/webhook",
          "Headers": {
            "Authorization": "Bearer webhook_token",
            "X-Source": "Honua-Server"
          },
          "EventTypes": ["anomaly_detected", "alert_triggered", "performance_degradation"],
          "TimeoutSeconds": 30
        }
      ],
      "MultiTenant": {
        "TenantIdHeader": "X-Tenant-Id",
        "DefaultTenant": "default",
        "IsolateTenantData": true
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Honua.Core.Features.Infrastructure.Monitoring": "Information"
    }
  },

  "OpenTelemetry": {
    "ServiceName": "Honua-Server",
    "ServiceVersion": "1.0.0",
    "Exporters": {
      "Console": {
        "Enabled": false
      },
      "OTLP": {
        "Enabled": true,
        "Endpoint": "http://localhost:4317",
        "Protocol": "Grpc"
      }
    },
    "Instrumentation": {
      "AspNetCore": {
        "Enabled": true,
        "RecordException": true,
        "EnableGrpcAspNetCoreSupport": false
      },
      "Http": {
        "Enabled": true,
        "RecordException": true
      },
      "SqlClient": {
        "Enabled": true,
        "SetDbStatementForText": true,
        "RecordException": true
      }
    },
    "Metrics": {
      "Enabled": true,
      "Exporters": {
        "Console": {
          "Enabled": false
        },
        "OTLP": {
          "Enabled": true,
          "Endpoint": "http://localhost:4318/v1/metrics",
          "Protocol": "HttpProtobuf"
        },
        "Prometheus": {
          "Enabled": true,
          "ScrapeEndpointPath": "/metrics",
          "ScrapeResponseCacheDurationMilliseconds": 300
        }
      }
    }
  }
}