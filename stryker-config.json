{
  "stryker-config": {
    "project": "Honua.sln",
    "test-projects": [
      "tests/Honua.Core.Tests/Honua.Core.Tests.csproj",
      "tests/Honua.Server.Tests/Honua.Server.Tests.csproj",
      "tests/Honua.Postgres.Tests/Honua.Postgres.Tests.csproj"
    ],
    "mutate": [
      "src/Honua.Core/**/*.cs",
      "src/Honua.Postgres/**/*.cs",
      "src/Honua.Server/**/*.cs"
    ],
    "ignore-files": [
      "**/Migrations/**/*.cs",
      "**/GlobalUsings.cs",
      "**/*JsonContext.cs",
      "**/Program.cs"
    ],
    "reporters": [
      "html",
      "json",
      "progress",
      "dashboard"
    ],
    "dashboard": {
      "project": "github.com/honua-io/honua-server",
      "version": "main"
    },
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "mutation-level": "Standard",
    "concurrency": 4,
    "timeout-ms": 30000,
    "ignore-mutations": [
      "StringLiteral",
      "InterpolatedStringLiteral"
    ],
    "mutators": {
      "arithmetic": true,
      "equality": true,
      "logical": true,
      "assignment": true,
      "unary": true,
      "update": true,
      "checked": true,
      "linq": true,
      "string": false,
      "interpolatedString": false
    },
    "test-runner": "dotnet",
    "coverage-analysis": "perTest",
    "disable-bail": false,
    "since": {
      "enabled": true,
      "ignore-changes-in": [
        "tests/**",
        "docs/**",
        "*.md"
      ]
    }
  }
}