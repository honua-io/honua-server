    "honua-sdk-dotnet": { "default": { "lane": "s-backlog-clients" } },
    "honua-sdk-python": { "default": { "lane": "s-backlog-clients" } },
    "honua-mobile": { "default": { "lane": "s-mobile-sdk" } },
    "honua-studio": { "default": { "lane": "s-rc2-studio" } },
    "honua-samples": { "default": { "lane": "s-site-release" } },
