    },
    "honua-console": {
      "default": { "lane": "s-console-ops" },
      "workflows": {
        "console-live-journey.yml": { "lane": "s-console-shell" },
        "console-aws-browser.yml": { "lane": "s-console-shell" },
        "console-live-llm-nightly.yml": { "lane": "s-console-shell" }
      }
    },
    "honua-sdk-js": {
      "default": { "lane": "s-backlog-clients" },
      "workflows": { "realtime-live-conformance.yml": { "lane": "s-realtime" } }
