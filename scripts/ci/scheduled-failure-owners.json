    "honua-helm": { "default": { "lane": "s-aws-marketplace" } },
    "honua-demo-infra": { "default": { "lane": "s-demos-2" } },
    "geospatial-mcp": { "default": { "lane": "s-mcp-upgrade" } },
    "geospatial-grpc": { "default": { "lane": "s-grpc-edit" } },
    "geobench": { "default": { "lane": "s-perf-wkb" } }
