{
  "lookbackHours": 72,
  "maxIssuesPerRun": 5,
  "defaultOwner": { "lane": "s-ci-doctors", "area": "area/ci" },
  "skipRepos": [],
  "downstreamJobPattern": "^(CI Gate|Test Suite Summary|.*[Ss]ummary|Open, update or close .*)$",
  "ignore": {
    "honua-server": ["trunk-signal-watchdog.yml"],
    "honua-iac": ["bootstrap-drift-plan.yml"],
    "honua-demo-infra": ["drift-plan.yml"]
  },
  "botDispatchWorkflows": {
    "honua-server": { "ci.yml": "^CI full" }
  },
  "repos": {
    "honua-server": {
      "default": { "lane": "s-trunk-green", "area": "area/ci" },
      "workflows": {
        "nightly-container-build.yml": { "lane": "s-net11", "area": "area/infrastructure" },
        "load-soak-nightly.yml": { "lane": "s-perf-wkb", "area": "area/server" },
        "release-migration-performance.yml": { "lane": "s-perf-wkb", "area": "area/migration" },
        "cloud-integration-harness.yml": { "lane": "s-aws-marketplace", "area": "area/infrastructure" },
        "cloud-post-apply-validation-nightly.yml": { "lane": "s-aws-marketplace", "area": "area/infrastructure" },
        "shipped-quickstart.yml": { "lane": "s-aws-marketplace", "area": "area/infrastructure" },
        "docs-quickstart-nightly.yml": { "lane": "s-aws-marketplace", "area": "area/infrastructure" },
        "client-interop-nightly.yml": { "lane": "s-rc2-ci", "area": "area/ci" },
        "pyqgis-client-compat-nightly.yml": { "lane": "s-rc2-ci", "area": "area/ci" },
        "client-compat-smoke-nightly.yml": { "lane": "s-rc2-ci", "area": "area/ci" },
        "cross-server-consume-nightly.yml": { "lane": "s-rc2-ci", "area": "area/ci" },
        "protocol-harness-certification.yml": { "lane": "s-rc2-ci", "area": "area/ci" },
        "mcp-client-contract.yml": { "lane": "s-mcp-tools", "area": "area/mcp" },
        "security-nightly.yml": { "lane": "s-sec-server", "area": "area/server" },
        "codeql.yml": { "lane": "s-sec-server", "area": "area/server" },
        "gdal-driver-e2e.yml": { "lane": "s-image-trim", "area": "area/server" },
        "multidim-raster-fixture.yml": { "lane": "s-image-trim", "area": "area/server" },
        "gp-buffer-canary.yml": { "lane": "s-image-trim", "area": "area/server" },
        "nightly-migration-evidence.yml": { "lane": "s-metadata", "area": "area/migration" }
