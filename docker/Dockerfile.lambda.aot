# syntax=docker/dockerfile:1.7
# AWS Lambda-targeted Honua image (AOT) with Lambda Web Adapter.

# Pin manifest digests to avoid intermittent MCR tag resolution failures in GitHub Actions buildx.
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:f061e5a7532b36fa1d1b684857fe1f504ba92115b9934f154643266613c44c62
ARG DOTNET_RUNTIME_DEPS_IMAGE=mcr.microsoft.com/dotnet/runtime-deps:10.0@sha256:a2bfa45d1d1b158c9374d010ccef889e245b5ac3713e48565d27845558fb2a93

FROM ${DOTNET_SDK_IMAGE} AS build
WORKDIR /src

RUN apt-get update && \
    apt-get install -y --no-install-recommends clang lld protobuf-compiler zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY Honua.sln Directory.Build.props .editorconfig ./
COPY src/Honua.Core/*.csproj src/Honua.Core/
COPY src/Honua.Postgres/*.csproj src/Honua.Postgres/
COPY src/Honua.ServiceDefaults/*.csproj src/Honua.ServiceDefaults/
COPY src/Honua.Server/*.csproj src/Honua.Server/

ARG TARGETARCH

RUN case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ;; \
      arm64) RUNTIME_ID="linux-arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    export PROTOBUF_PROTOC=/usr/bin/protoc && \
    dotnet restore src/Honua.Server/Honua.Server.csproj \
      --runtime "$RUNTIME_ID" \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      -p:HonuaIncludeAdminUi=false

COPY . .

ARG CONFIGURATION=Release
RUN case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ; ILC_SINGLE_THREADED="false" ;; \
      arm64) RUNTIME_ID="linux-arm64" ; ILC_SINGLE_THREADED="true" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    export PROTOBUF_PROTOC=/usr/bin/protoc && \
    dotnet publish src/Honua.Server/Honua.Server.csproj \
      --configuration "$CONFIGURATION" \
      --runtime "$RUNTIME_ID" \
      --self-contained true \
      --output /app \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      -p:HonuaIncludeAdminUi=false \
      -p:PublishAot=true \
      -p:DebugType=None \
      -p:DebugSymbols=false \
      -p:StripSymbols=true \
      -p:OptimizationPreference=Speed \
      -p:IlcOptimizationPreference=Speed \
      -p:IlcSingleThreaded="$ILC_SINGLE_THREADED" && \
    rm -rf /app/BlazorDebugProxy /app/wwwroot && \
    find /app -type f \( -name '*.pdb' -o -name '*.dbg' \) -delete

FROM ${DOTNET_RUNTIME_DEPS_IMAGE} AS runtime

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /var/task
COPY --from=build /app /var/task

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgssapi-krb5-2 && \
    rm -rf /var/lib/apt/lists/* && \
    chmod +x /var/task/Honua.Server

ENV PORT=8080 \
    AWS_LWA_PORT=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_EnableDiagnostics=0

EXPOSE 8080

ENTRYPOINT ["/var/task/Honua.Server"]
