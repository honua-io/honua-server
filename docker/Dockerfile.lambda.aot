# syntax=docker/dockerfile:1.7
# AWS Lambda-targeted Honua image (AOT) with Lambda Web Adapter.

# Pin manifest digests to avoid intermittent MCR tag resolution failures in GitHub Actions buildx
# and to keep Trivy scans deterministic. Refresh cadence + remediation rationale:
# docs/internal/security/code-scanning-2026-Q2-remediation.md.
# These ARG defaults are the single source of truth for the GHCR mirror of these
# bases (scripts/ci/base-image-mirrors.sh + the nightly `mirror-base-images` job).
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
# Lambda Web Adapter. The nightly build mirrors this digest to GHCR and passes the mirror here, because
# anonymous Public ECR pulls are rate limited (429) from shared runners.
ARG LAMBDA_ADAPTER_IMAGE=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1@sha256:46d6625e68cbbdd2efab4a20245977664513f13ffef47915b000d431adcea0b4
ARG DOTNET_RUNTIME_DEPS_IMAGE=mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled-extra@sha256:56b6c354a140e50e09d45a397b43f9f9d31012c325020239e602e06d1594f8ff

ARG HONUA_STORE_PROFILE=postgis

FROM ${DOTNET_RUNTIME_DEPS_IMAGE} AS chiseled-base

FROM ${DOTNET_SDK_IMAGE} AS restore
WORKDIR /src

RUN apt-get update && \
    apt-get install -y --no-install-recommends clang lld zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY Honua.sln Directory.Build.props Directory.Build.targets Directory.Packages.props NuGet.config .editorconfig ./
# eng/ carries Honua.BuildProfiles.props (HonuaIncludeAws/Azure defaults).
# Directory.Build.props imports it with an Exists() guard, so omitting it
# makes restore and publish evaluate DIFFERENT project graphs: restore sees
# the cloud providers off, publish (after COPY . .) sees them on, and the
# publish fails with NETSDK1004 for every project restore skipped.
COPY eng/ eng/
COPY scripts/docker/restore-dotnet-with-github-packages.sh scripts/docker/
# Copy ALL project files referenced (directly or transitively) by Honua.Server so
# that `dotnet restore` can generate obj/project.assets.json for every project before
# `COPY . .` and the --no-restore publish step.  Omitting any referenced .csproj here
# causes NuGet to skip it during restore; the subsequent publish then fails with
# NETSDK1004 ("Assets file not found") for those projects.
COPY src/Honua.Analyzers/*.csproj src/Honua.Analyzers/
COPY src/Honua.Core/Core/*.csproj src/Honua.Core/Core/
COPY src/Honua.Db/Postgres/*.csproj src/Honua.Db/Postgres/
COPY src/Honua.Db/Postgres.Shared/*.csproj src/Honua.Db/Postgres.Shared/
COPY src/Honua.ServiceDefaults/*.csproj src/Honua.ServiceDefaults/
COPY src/Honua.Server/*.csproj src/Honua.Server/
COPY src/Honua.Db/DuckDB/*.csproj src/Honua.Db/DuckDB/
COPY src/Honua.Db/SqlServer/*.csproj src/Honua.Db/SqlServer/
COPY src/Honua.Db/MySql/*.csproj src/Honua.Db/MySql/
COPY src/Honua.Db/Redshift/*.csproj src/Honua.Db/Redshift/
COPY src/Honua.Db/Snowflake/*.csproj src/Honua.Db/Snowflake/
COPY src/Honua.Db/Databricks/*.csproj src/Honua.Db/Databricks/
COPY src/Honua.Db/GeoServicesRest/*.csproj src/Honua.Db/GeoServicesRest/
COPY src/Honua.Db/Oracle/*.csproj src/Honua.Db/Oracle/
COPY src/Honua.Hosting/*.csproj src/Honua.Hosting/
COPY src/Honua.Jobs/*.csproj src/Honua.Jobs/
COPY src/Honua.Protocols/OData/*.csproj src/Honua.Protocols/OData/
COPY src/Honua.Geocoding/*.csproj src/Honua.Geocoding/
COPY src/Honua.Cloud/Aws/*.csproj src/Honua.Cloud/Aws/
COPY src/Honua.Cloud/Azure/*.csproj src/Honua.Cloud/Azure/
COPY src/Honua.Ai/*.csproj src/Honua.Ai/
COPY src/Honua.Geometry/*.csproj src/Honua.Geometry/
COPY src/Honua.Geoprocessing/Core/*.csproj src/Honua.Geoprocessing/Core/
COPY src/Honua.Io/*.csproj src/Honua.Io/
COPY src/Honua.Import/*.csproj src/Honua.Import/
COPY src/Honua.Protocols/Scene/*.csproj src/Honua.Protocols/Scene/
COPY src/Honua.Protocols/Ogc.Shared/*.csproj src/Honua.Protocols/Ogc.Shared/
COPY src/Honua.Protocols/OgcApi/*.csproj src/Honua.Protocols/OgcApi/
COPY src/Honua.Protocols/OgcClassic/*.csproj src/Honua.Protocols/OgcClassic/
COPY src/Honua.Protocols/Stac/*.csproj src/Honua.Protocols/Stac/
COPY src/Honua.Protocols/SensorThings/*.csproj src/Honua.Protocols/SensorThings/
COPY src/Honua.Protocols/GeoServices/*.csproj src/Honua.Protocols/GeoServices/
COPY src/Honua.Scene/*.csproj src/Honua.Scene/
COPY src/Honua.Core/Abstractions/*.csproj src/Honua.Core/Abstractions/
COPY src/Honua.Routing/*.csproj src/Honua.Routing/
COPY src/Honua.Plugins/Core/*.csproj src/Honua.Plugins/Core/
COPY src/Honua.Plugins/Abstractions/*.csproj src/Honua.Plugins/Abstractions/

ARG TARGETARCH
ARG HONUA_STORE_PROFILE

RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ;; \
      arm64) RUNTIME_ID="linux-arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    sh scripts/docker/restore-dotnet-with-github-packages.sh src/Honua.Server/Honua.Server.csproj \
      --runtime "$RUNTIME_ID" \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      -p:HonuaUseSkiaNoDependencies=true -p:HonuaStoreProfile=${HONUA_STORE_PROFILE:-postgis} -p:HonuaNobleRuntimePublish=true

FROM restore AS build

COPY . .

ARG CONFIGURATION=Release
# Empty VERSION preserves Directory.Build.props for local container builds.
ARG VERSION=
ARG HONUA_GIT_SHA=
# ILC (the native compiler) is single-threaded on BOTH arches and the publish is
# retried with backoff — mirroring the hardening already in docker/Dockerfile.aot
# (#1360). The Native AOT link peaks well above the hosted runner's memory ceiling,
# so parallel ILC (IlcSingleThreaded=false, previously used on amd64) gets OOM-killed
# mid-link: ilc exits with code -1 and surfaces only as Microsoft.NETCore.Native.targets
# error MSB3073 "...ilc... exited with code -1". Single-threaded linking trades
# wall-clock for a much lower memory peak; the retry loop additionally rides out an
# intermittent OOM kill (the regular AOT image relies on the same retry to stay green).
# Keep restore and publish in the same cached RUN, matching Dockerfile.aot. The
# earlier restore stage warms the NuGet cache, but the full source copy can change
# the evaluated project graph; refreshing the RID-specific assets here prevents
# --no-restore publish failures when a newly included package is absent.
ARG AOT_PUBLISH_MAX_ATTEMPTS=3
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ;; \
      arm64) RUNTIME_ID="linux-arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    attempt=1 && \
    max_attempts="${AOT_PUBLISH_MAX_ATTEMPTS:-3}" && \
    until \
        sh scripts/docker/restore-dotnet-with-github-packages.sh src/Honua.Server/Honua.Server.csproj \
          --runtime "$RUNTIME_ID" \
          -p:RuntimeIdentifier="$RUNTIME_ID" \
          -p:HonuaUseSkiaNoDependencies=true -p:HonuaStoreProfile=${HONUA_STORE_PROFILE:-postgis} -p:HonuaNobleRuntimePublish=true && \
        dotnet publish src/Honua.Server/Honua.Server.csproj \
          ${VERSION:+-p:Version="$VERSION"} \
          ${VERSION:+-p:InformationalVersion="$VERSION$(if [ -n "$HONUA_GIT_SHA" ]; then printf '+%.7s' "$HONUA_GIT_SHA"; fi)"} \
          ${VERSION:+-p:IncludeSourceRevisionInInformationalVersion=false} \
          --configuration "$CONFIGURATION" \
          --runtime "$RUNTIME_ID" \
          --no-restore \
          --self-contained true \
          --output /app \
          -p:RuntimeIdentifier="$RUNTIME_ID" \
          -p:HonuaUseSkiaNoDependencies=true -p:HonuaStoreProfile=${HONUA_STORE_PROFILE:-postgis} -p:HonuaNobleRuntimePublish=true \
          -p:PublishAot=true \
          -p:DebugType=None \
          -p:DebugSymbols=false \
          -p:StripSymbols=true \
          -p:OptimizationPreference=Speed \
          -p:IlcOptimizationPreference=Speed \
          -p:IlcSingleThreaded=true \
          -p:HonuaSkipOracleForAotVerification=true \
          -p:HonuaSkipSnowflakeForAotVerification=true ; \
    do \
        status=$? ; \
        if [ "$attempt" -ge "$max_attempts" ]; then \
            echo "AOT restore+publish failed after ${attempt} attempts (last exit ${status})" >&2 ; \
            exit "$status" ; \
        fi ; \
        echo "AOT restore+publish attempt ${attempt} failed (exit ${status}); retrying after backoff..." >&2 ; \
        sleep $((attempt * 15)) ; \
        attempt=$((attempt + 1)) ; \
    done && \
    rm -rf /app/wwwroot && \
    find /app -type f \( -name '*.pdb' -o -name '*.dbg' \) -delete

FROM ${LAMBDA_ADAPTER_IMAGE} AS lambda-adapter

FROM ${DOTNET_SDK_IMAGE} AS runtime-assets
WORKDIR /src
COPY docker/runtime/ docker/runtime/
COPY --from=chiseled-base / /runtime-root/
# hadolint ignore=DL3008
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends gcc libc6-dev libatomic1 libgssapi-krb5-2 fonts-dejavu-core && \
    sh docker/runtime/stage-runtime.sh /runtime-root /runtime-additions && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /app /runtime-root/var/task
RUN sh docker/runtime/verify-native.sh /runtime-root /var/task

FROM chiseled-base AS runtime
COPY --from=runtime-assets /runtime-additions/ /


# Immutable deployment identity (#3038). Keep the SHA in the runtime stage so revision-only
# changes do not invalidate publish layers; the pushed image digest is injected by deployment.
ARG HONUA_GIT_SHA=
ARG VERSION=
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${HONUA_GIT_SHA}"
ENV HONUA_GIT_SHA=${HONUA_GIT_SHA}

COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /var/task
COPY --from=build --chown=1001:1001 /app /var/task
USER 1001:1001


ENV PORT=8080 \
    AWS_LWA_PORT=8080 \
    HONUA_DEFAULT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    DOTNET_EnableDiagnostics=0

LABEL honua.runtime.profile="web" \
      honua.runtime.compilation="native-aot" \
      honua.runtime.entrypoint="/var/task/Honua.Server"

EXPOSE 8080

ENTRYPOINT ["/var/task/Honua.Server"]
