# syntax=docker/dockerfile:1.7
# Azure Functions-targeted Honua image.
# Packages Honua as a custom-handler container behind the Azure Functions host.

# Pin manifest digests to avoid mutable-tag noise in Trivy nightly scans.
# Refresh cadence + remediation rationale: docs/internal/security/code-scanning-2026-Q2-remediation.md.
#
# Base selection (honua-server#3036): the `azure-functions/base` repository is
# abandoned — its newest published tags (`4`/`4-appservice`, host 4.636.2,
# 2025-03-06; `4-nightly*`, host 4.637.1, 2025-04-22) are all still built from
# EOL Debian 11 (bullseye). The Functions host itself is very much alive, but
# Microsoft only republishes it under the language-worker repositories, and
# those moved to Debian 12 (bookworm). `dotnet-isolated:4-dotnet-isolated9.0-appservice`
# is the same `/azure-functions-host` with the same `/azure-functions-host/start.sh`
# entrypoint on a supported distro, ~15 months newer (host 4.1051.300.6).
# Custom handlers are a host feature, not a worker feature, so the bundled
# dotnet-isolated worker is simply unused once FUNCTIONS_WORKER_RUNTIME=custom
# is set below.
ARG AZURE_FUNCTIONS_BASE_IMAGE=mcr.microsoft.com/azure-functions/dotnet-isolated:4-dotnet-isolated9.0-appservice@sha256:cc14ce08d684cf5a39d231484cc6c48b616f59e01d02476834bd629a259dde73

FROM ${AZURE_FUNCTIONS_BASE_IMAGE} AS build
WORKDIR /src

ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="${DOTNET_ROOT}:${PATH}"

# The digest pins the package baseline; security updates are applied again in
# the final runtime layer so build-only package versions need not be duplicated.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    wget -nv https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --channel 10.0 --install-dir "$DOTNET_ROOT" && \
    ln -sf "$DOTNET_ROOT/dotnet" /usr/bin/dotnet && \
    rm -f /tmp/dotnet-install.sh && \
    rm -rf /var/lib/apt/lists/*

COPY Honua.sln Directory.Build.props Directory.Packages.props NuGet.config .editorconfig ./
# eng/ carries Honua.BuildProfiles.props (HonuaIncludeAws/Azure defaults).
# Directory.Build.props imports it with an Exists() guard, so omitting it
# makes restore and publish evaluate DIFFERENT project graphs: restore sees
# the cloud providers off, publish (after COPY . .) sees them on, and the
# publish fails with NETSDK1004 for every project restore skipped.
COPY eng/ eng/
COPY scripts/docker/restore-dotnet-with-github-packages.sh scripts/docker/
# Copy ALL project files referenced (directly or transitively) by Honua.Server so
# that `dotnet restore` can generate obj/project.assets.json for every project
# before `COPY . .` and the --no-restore publish step.
COPY src/Honua.Analyzers/*.csproj src/Honua.Analyzers/
COPY src/Honua.Core/*.csproj src/Honua.Core/
COPY src/Honua.Core.Abstractions/*.csproj src/Honua.Core.Abstractions/
COPY src/Honua.Postgres/*.csproj src/Honua.Postgres/
COPY src/Honua.Postgres.Shared/*.csproj src/Honua.Postgres.Shared/
COPY src/Honua.ServiceDefaults/*.csproj src/Honua.ServiceDefaults/
COPY src/Honua.Server/*.csproj src/Honua.Server/
COPY src/Honua.DuckDB/*.csproj src/Honua.DuckDB/
COPY src/Honua.SqlServer/*.csproj src/Honua.SqlServer/
COPY src/Honua.MySql/*.csproj src/Honua.MySql/
COPY src/Honua.Redshift/*.csproj src/Honua.Redshift/
COPY src/Honua.Snowflake/*.csproj src/Honua.Snowflake/
COPY src/Honua.Databricks/*.csproj src/Honua.Databricks/
COPY src/Honua.ArcGisRest/*.csproj src/Honua.ArcGisRest/
COPY src/Honua.Oracle/*.csproj src/Honua.Oracle/
COPY src/Honua.Hosting/*.csproj src/Honua.Hosting/
COPY src/Honua.Jobs/*.csproj src/Honua.Jobs/
COPY src/Honua.Protocols.OData/*.csproj src/Honua.Protocols.OData/
COPY src/Honua.Geocoding/*.csproj src/Honua.Geocoding/
COPY src/Honua.Aws/*.csproj src/Honua.Aws/
COPY src/Honua.Azure/*.csproj src/Honua.Azure/
COPY src/Honua.Ai/*.csproj src/Honua.Ai/
COPY src/Honua.Geometry/*.csproj src/Honua.Geometry/
COPY src/Honua.Geoprocessing/*.csproj src/Honua.Geoprocessing/
COPY src/Honua.Io/*.csproj src/Honua.Io/
COPY src/Honua.Import/*.csproj src/Honua.Import/
COPY src/Honua.Protocols.Scene/*.csproj src/Honua.Protocols.Scene/
COPY src/Honua.Protocols.Ogc.Shared/*.csproj src/Honua.Protocols.Ogc.Shared/
COPY src/Honua.Protocols.OgcApi/*.csproj src/Honua.Protocols.OgcApi/
COPY src/Honua.Protocols.OgcClassic/*.csproj src/Honua.Protocols.OgcClassic/
COPY src/Honua.Protocols.Stac/*.csproj src/Honua.Protocols.Stac/
COPY src/Honua.Protocols.SensorThings/*.csproj src/Honua.Protocols.SensorThings/
COPY src/Honua.Protocols.GeoServices/*.csproj src/Honua.Protocols.GeoServices/
COPY src/Honua.Scene/*.csproj src/Honua.Scene/
COPY src/Honua.Routing/*.csproj src/Honua.Routing/
COPY src/Honua.Plugins/*.csproj src/Honua.Plugins/
COPY src/Honua.Plugins.Abstractions/*.csproj src/Honua.Plugins.Abstractions/
COPY samples/Honua.StacOpsDemo/*.csproj samples/Honua.StacOpsDemo/

ARG TARGETARCH

RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ;; \
      arm64) RUNTIME_ID="linux-arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    sh scripts/docker/restore-dotnet-with-github-packages.sh src/Honua.Server/Honua.Server.csproj \
      --runtime "$RUNTIME_ID" \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      -p:HonuaIncludeStacOpsDemo=false

COPY . .

ARG CONFIGURATION=Release
RUN --mount=type=cache,target=/root/.nuget/packages \
    case "${TARGETARCH:-amd64}" in \
      amd64) RUNTIME_ID="linux-x64" ;; \
      arm64) RUNTIME_ID="linux-arm64" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    dotnet publish src/Honua.Server/Honua.Server.csproj \
      --configuration "$CONFIGURATION" \
      --runtime "$RUNTIME_ID" \
      --no-restore \
      --self-contained true \
      --output /out/app \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      -p:HonuaIncludeStacOpsDemo=false \
      -p:PublishAot=false \
      -p:DebugType=None \
      -p:DebugSymbols=false && \
    rm -rf /out/app/BlazorDebugProxy /out/app/wwwroot && \
    find /out/app -type f \( -name '*.pdb' -o -name '*.dbg' \) -delete

FROM ${AZURE_FUNCTIONS_BASE_IMAGE} AS runtime
WORKDIR /home/site/wwwroot

# The Functions base can lag its distro's security updates even when its tag
# digest is current. Patch the runtime layer, then remove compile-only headers
# and extension bundles excluded by this app's required 4.x bundle range.
#
# `libc6-dev`/`linux-libc-dev` are kernel/build headers: they are only needed to
# *compile* against glibc, never to run a published custom handler, and
# `linux-libc-dev` alone accounted for ~570 of the HIGH/CRITICAL records Trivy
# reported against this image (honua-server#3036). The bundle prune is matched by
# major version rather than by hardcoded 2.x/3.x paths so it keeps holding when
# the base image republishes with different bundle versions.
# hadolint ignore=DL3005,DL3008
RUN apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 -y --no-install-recommends upgrade && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 install -y --no-install-recommends libgssapi-krb5-2 libstdc++6 zlib1g && \
    apt-get purge -y libc6-dev linux-libc-dev && \
    apt-get autoremove -y && \
    { find /FuncExtensionBundles/Microsoft.Azure.Functions.ExtensionBundle \
        -mindepth 1 -maxdepth 1 -type d ! -name '4.*' -exec rm -rf {} + || true; } && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /out/app /home/site/wwwroot/app
COPY docker/cloud/azure-functions/ /home/site/wwwroot/

RUN chmod +x /home/site/wwwroot/handler.sh /home/site/wwwroot/app/Honua.Server

# InvariantGlobalization=false requires ICU (Microsoft.Data.SqlClient/Oracle fail to
# connect without it). The Azure Functions base image ships ICU. See honua-server#1369.
#
# ASPNETCORE_URLS is pinned rather than inherited: the base also sets
# ASPNETCORE_HTTP_PORTS=8080, which is the port handler.sh binds Honua to. URLS
# wins over HTTP_PORTS in ASP.NET Core, so the Functions host stays on :80 and
# the custom handler owns :8080 — but relying on that precedence implicitly
# would turn any future base reshuffle into a port collision between the host
# and the handler it supervises.
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true \
    ASPNETCORE_URLS=http://+:80 \
    FUNCTIONS_WORKER_RUNTIME=custom \
    FUNCTIONS_CUSTOMHANDLER_PORT=8080 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    DOTNET_EnableDiagnostics=0

LABEL honua.runtime.profile="web-debug" \
      honua.runtime.compilation="jit" \
      honua.runtime.distribution="non-production"

EXPOSE 80 8080
