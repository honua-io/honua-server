{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":maintainLockFilesWeekly",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
    ":semanticCommitTypeAll(chore)"
  ],
  "baseBranches": ["trunk"],
  "labels": ["dependencies", "automated"],
  "assignees": ["@honua-team"],
  "reviewers": ["@honua-team"],
  "nuget": {
    "enabled": true,
    "rangeStrategy": "bump"
  },
  "docker": {
    "enabled": true,
    "pinDigests": false
  },
  "github-actions": {
    "enabled": true,
    "pinDigests": false
  },
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"],
      "reviewers": ["@senior-developers"]
    },
    {
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchPackageNames": ["postgis/postgis"],
      "schedule": ["before 6am on monday"],
      "addLabels": ["infrastructure"]
    }
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prCreation": "immediate",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5
}