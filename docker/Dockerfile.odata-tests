# syntax=docker/dockerfile:1.7
# Protocol-only runner with lightweight TestKit.Abstractions; no Server or full TestKit reference.
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa

# Project and package-configuration inputs only. Ordinary source files, including
# JSON content, stay out of this stage so they do not invalidate NuGet restore.
FROM ${DOTNET_SDK_IMAGE} AS restore-inputs
RUN --mount=type=bind,target=/context \
    mkdir -p /restore-inputs && cd /context && \
    find . -type d \( -name bin -o -name obj -o -name .git \) -prune -o \
      -type f \( -name '*.csproj' -o -name '*.fsproj' -o -name '*.vbproj' \
        -o -name '*.props' -o -name '*.targets' \
        -o -name '*.sln' -o -name '*.slnx' -o -name '*.slnf' \
        -o -name '*.config' -o -name '.editorconfig' \
        -o -name 'global.json' -o -name 'packages.lock.json' -o -name 'dotnet-tools.json' \) \
      -exec cp --parents -p '{}' /restore-inputs/ \;

FROM ${DOTNET_SDK_IMAGE} AS test
WORKDIR /src
COPY --from=restore-inputs /restore-inputs/ ./
COPY scripts/docker/restore-dotnet-with-github-packages.sh scripts/docker/
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    sh scripts/docker/restore-dotnet-with-github-packages.sh \
      tests/dotnet/Honua.Protocols.OData.UnitTests/Honua.Protocols.OData.UnitTests.csproj \
      -p:UseCurrentRuntimeIdentifier=true -p:AppendRuntimeIdentifierToOutputPath=false
COPY . .
RUN dotnet build tests/dotnet/Honua.Protocols.OData.UnitTests/Honua.Protocols.OData.UnitTests.csproj \
      -c Release --no-restore -m:4 -p:TreatWarningsAsErrors=true -p:UseSharedCompilation=false \
      -p:UseCurrentRuntimeIdentifier=true -p:AppendRuntimeIdentifierToOutputPath=false
FROM ${DOTNET_SDK_IMAGE} AS runner
WORKDIR /tests
COPY --from=test /src/tests/dotnet/Honua.Protocols.OData.UnitTests/bin/Release/net10.0/ ./
ENTRYPOINT ["dotnet", "vstest", "/tests/Honua.Protocols.OData.UnitTests.dll"]
