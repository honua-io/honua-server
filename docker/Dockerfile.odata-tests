# syntax=docker/dockerfile:1.7
# Protocol-only test runner. It intentionally has no Honua.Server/TestKit reference.
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c
FROM ${DOTNET_SDK_IMAGE} AS test
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    sh scripts/docker/restore-dotnet-with-github-packages.sh \
      tests/dotnet/Honua.Protocols.OData.Unit.Tests/Honua.Protocols.OData.Unit.Tests.csproj && \
    dotnet build tests/dotnet/Honua.Protocols.OData.Unit.Tests/Honua.Protocols.OData.Unit.Tests.csproj \
      -c Release --no-restore -m:4 -p:TreatWarningsAsErrors=true
FROM ${DOTNET_SDK_IMAGE} AS runner
WORKDIR /tests
COPY --from=test /src/tests/dotnet/Honua.Protocols.OData.Unit.Tests/bin/Release/net10.0/ ./
ENTRYPOINT ["dotnet", "vstest", "/tests/Honua.Protocols.OData.Unit.Tests.dll"]
