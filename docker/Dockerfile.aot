# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for Honua Server
# Native AOT build for minimal image size and fast cold start
# Enhanced security: minimal attack surface, non-root user, read-only filesystem

# Pin manifest digests to avoid intermittent MCR tag resolution failures in GitHub Actions buildx.
# These ARG defaults are the single source of truth for the GHCR mirror of these
# bases (scripts/ci/base-image-mirrors.sh + the nightly `mirror-base-images` job).
#
# glibc, not Alpine/musl (honua-server#4912). The published graph ships glibc-only native
# libraries: ParquetSharp's ParquetSharpNative (the GeoParquet f=parquet encoder) and DuckDB's
# libduckdb have no musl asset, so a musl RID publish copies the glibc binaries and
# they cannot load. On Alpine every f=parquet request returned the typed 501, and gcompat +
# libatomic loaded the library but segfaulted the server on the first request. These are the
# same Ubuntu-based SDK/runtime-deps digests as docker/Dockerfile.lambda.aot.
ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b
ARG DOTNET_RUNTIME_DEPS_IMAGE=mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled-extra@sha256:56b6c354a140e50e09d45a397b43f9f9d31012c325020239e602e06d1594f8ff

ARG HONUA_STORE_PROFILE=postgis

FROM ${DOTNET_RUNTIME_DEPS_IMAGE} AS chiseled-base

# Extract restore inputs with their directory structure. Ordinary source edits,
# including JSON content, rerun this inexpensive extraction but leave the
# downstream restore input tree unchanged.
FROM ${DOTNET_SDK_IMAGE} AS restore-inputs
# Bind-mounted context. WORKDIR avoids `cd` (hadolint DL3003) without changing
# the relative paths `find` and `cp --parents` write under /restore-inputs.
WORKDIR /context
RUN --mount=type=bind,target=/context \
    mkdir -p /restore-inputs && \
    find . -type d \( -name bin -o -name obj -o -name .git \) -prune -o \
      -type f \( -name '*.csproj' -o -name '*.fsproj' -o -name '*.vbproj' \
        -o -name '*.props' -o -name '*.targets' \
        -o -name '*.sln' -o -name '*.slnx' -o -name '*.slnf' \
        -o -name '*.config' -o -name '.editorconfig' \
        -o -name 'global.json' -o -name 'packages.lock.json' -o -name 'dotnet-tools.json' \) \
      -exec cp --parents -p '{}' /restore-inputs/ \;

FROM ${DOTNET_SDK_IMAGE} AS build
WORKDIR /src

# Security: Create non-root build user
RUN groupadd --gid 1001 --system builduser && \
    useradd --uid 1001 --gid 1001 --system --no-create-home --shell /usr/sbin/nologin builduser

# Install native AOT build dependencies (ILC links with clang/lld against glibc).
# The base is digest-pinned; package versions follow that Ubuntu snapshot's repositories.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends clang lld zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy the full project graph (all .csproj) plus build/config files first so the
# RID-specific restore below covers every transitive project the publish needs.
# The extraction stage discovers project and package-configuration files only.
# Ordinary source and JSON content edits do not invalidate this restore-input tree.
COPY --from=restore-inputs /restore-inputs/ ./
COPY eng/Honua.BuildProfiles.props eng/
COPY eng/Honua.ProtocolProfiles.props eng/
COPY eng/protocol-profiles.v1.json eng/
COPY scripts/docker/restore-dotnet-with-github-packages.sh scripts/docker/

ARG TARGETARCH
ARG HONUA_STORE_PROFILE
ARG HONUA_BUILD_PROFILE=full
ARG HONUA_PROTOCOL_PROFILE=all
ARG HONUA_INCLUDE_AWS=
ARG HONUA_INCLUDE_AZURE=
# Match the other native-AOT images: these providers require the JIT runtime.
ARG HONUA_INCLUDE_ORACLE=false
ARG HONUA_INCLUDE_SNOWFLAKE=false

# SkiaSharp native asset (honua-server#4949): both RIDs publish
# SkiaSharp.NativeAssets.Linux.NoDependencies, like docker/Dockerfile.lambda.aot. The
# distro-linked linux-arm64 libSkiaSharp.so references uuid_* and FT_Get_BDF_Property but
# declares no NEEDED entry for libuuid, libfreetype or libfontconfig, so no installed package
# can satisfy it: the `ldd -r` gate below rejected every arm64 build. The NoDependencies asset
# links only libc/libm/libdl/libpthread on both arches and reads fonts from files, which the
# runtime stage ships and pins through HONUA_DEFAULT_FONT_PATH.

# Restore dependencies for the target runtime so the AOT self-contained publish
# (which runs --no-restore) finds obj/project.assets.json for every project in
# the Honua.Server graph at the RID it builds.
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    case "${TARGETARCH:-amd64}" in \
        amd64) RUNTIME_ID="linux-x64" ;; \
        arm64) RUNTIME_ID="linux-arm64" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    set -- "-p:HonuaStoreProfile=${HONUA_STORE_PROFILE:-postgis}" "-p:HonuaNobleRuntimePublish=true" "-p:HonuaBuildProfile=${HONUA_BUILD_PROFILE:-full}" "-p:HonuaUseSkiaNoDependencies=true" "-p:HonuaProtocolProfile=${HONUA_PROTOCOL_PROFILE:-all}" && \
    if [ -n "${HONUA_INCLUDE_AWS:-}" ]; then set -- "$@" "-p:HonuaIncludeAws=$HONUA_INCLUDE_AWS"; fi && \
    if [ -n "${HONUA_INCLUDE_AZURE:-}" ]; then set -- "$@" "-p:HonuaIncludeAzure=$HONUA_INCLUDE_AZURE"; fi && \
    if [ -n "${HONUA_INCLUDE_ORACLE:-}" ]; then set -- "$@" "-p:HonuaIncludeOracle=$HONUA_INCLUDE_ORACLE"; fi && \
    if [ -n "${HONUA_INCLUDE_SNOWFLAKE:-}" ]; then set -- "$@" "-p:HonuaIncludeSnowflake=$HONUA_INCLUDE_SNOWFLAKE"; fi && \
    sh scripts/docker/restore-dotnet-with-github-packages.sh src/Honua.Server/Honua.Server.csproj \
      --runtime "$RUNTIME_ID" \
      -p:RuntimeIdentifier="$RUNTIME_ID" \
      "$@"

# Copy source code
COPY . .

# Build Native AOT application for minimal image size.
# Re-restore for the target RID before publishing so the assets cover the full
# project graph as copied by `COPY . .` (the dedicated restore layer above
# warms the NuGet cache; this is a near-instant no-op cache hit on success).
# ILC (the native compiler) is single-threaded on BOTH arches. Parallel ILC on
# amd64 (IlcSingleThreaded=false) pushed peak RSS over the hosted runner's
# memory ceiling, and the kernel OOM-killer reaped ilc mid-link: it exits with
# code -1 and no diagnostic, surfacing only as
#   Microsoft.NETCore.Native.targets: error MSB3073: "...ilc..." exited with code -1.
# Single-threaded linking trades wall-clock for a much lower memory peak and
# fits comfortably inside the 90-minute job timeout. arm64 already used this.
#
# The restore+publish unit is retried with backoff so an intermittent
# GitHub-Packages/nuget.org blip, a restore-assets hiccup, or a transient ILC
# kill does not fail the nightly outright. Retries are cheap: a successful
# restore is an "up-to-date" no-op and successful publish output is reused.
ARG CONFIGURATION=Release
# Empty VERSION preserves Directory.Build.props for local container builds.
ARG VERSION=
ARG HONUA_GIT_SHA=
ARG AOT_PUBLISH_MAX_ATTEMPTS=3
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=secret,id=github_actor \
    --mount=type=secret,id=github_token \
    case "${TARGETARCH:-amd64}" in \
        amd64) RUNTIME_ID="linux-x64" ;; \
        arm64) RUNTIME_ID="linux-arm64" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH}" && exit 1 ;; \
    esac && \
    set -- "-p:HonuaStoreProfile=${HONUA_STORE_PROFILE:-postgis}" "-p:HonuaNobleRuntimePublish=true" "-p:HonuaBuildProfile=${HONUA_BUILD_PROFILE:-full}" "-p:HonuaUseSkiaNoDependencies=true" "-p:HonuaProtocolProfile=${HONUA_PROTOCOL_PROFILE:-all}" && \
    if [ -n "${HONUA_INCLUDE_AWS:-}" ]; then set -- "$@" "-p:HonuaIncludeAws=$HONUA_INCLUDE_AWS"; fi && \
    if [ -n "${HONUA_INCLUDE_AZURE:-}" ]; then set -- "$@" "-p:HonuaIncludeAzure=$HONUA_INCLUDE_AZURE"; fi && \
    if [ -n "${HONUA_INCLUDE_ORACLE:-}" ]; then set -- "$@" "-p:HonuaIncludeOracle=$HONUA_INCLUDE_ORACLE"; fi && \
    if [ -n "${HONUA_INCLUDE_SNOWFLAKE:-}" ]; then set -- "$@" "-p:HonuaIncludeSnowflake=$HONUA_INCLUDE_SNOWFLAKE"; fi && \
    attempt=1 && \
    max_attempts="${AOT_PUBLISH_MAX_ATTEMPTS:-3}" && \
    until \
        sh scripts/docker/restore-dotnet-with-github-packages.sh src/Honua.Server/Honua.Server.csproj \
          --runtime "$RUNTIME_ID" \
          -p:RuntimeIdentifier="$RUNTIME_ID" \
          "$@" && \
        dotnet publish src/Honua.Server/Honua.Server.csproj \
          ${VERSION:+-p:Version="$VERSION"} \
          ${VERSION:+-p:InformationalVersion="$VERSION$(if [ -n "$HONUA_GIT_SHA" ]; then printf '+%.7s' "$HONUA_GIT_SHA"; fi)"} \
          ${VERSION:+-p:IncludeSourceRevisionInInformationalVersion=false} \
          --configuration "$CONFIGURATION" \
          --runtime "$RUNTIME_ID" \
          --no-restore \
          --self-contained true \
          --output /app \
          -p:RuntimeIdentifier="$RUNTIME_ID" \
          -p:PublishAot=true \
          -p:DebugType=None \
          -p:DebugSymbols=false \
          -p:StripSymbols=true \
          -p:OptimizationPreference=Speed \
          -p:IlcOptimizationPreference=Speed \
          -p:IlcSingleThreaded=true \
          "$@" ; \
    do \
        status=$? ; \
        if [ "$attempt" -ge "$max_attempts" ]; then \
            echo "AOT restore+publish failed after ${attempt} attempts (last exit ${status})" >&2 ; \
            exit "$status" ; \
        fi ; \
        echo "AOT restore+publish attempt ${attempt} failed (exit ${status}); retrying after backoff..." >&2 ; \
        sleep $((attempt * 15)) ; \
        attempt=$((attempt + 1)) ; \
    done && \
    rm -rf /app/wwwroot && \
    find /app -type f \( -name '*.pdb' -o -name '*.dbg' \) -delete

RUN mkdir -p /store-evidence && \
    cp src/Honua.Server/obj/project.assets.json /store-evidence/ && \
    find src/Honua.Server/obj -name '*.ilc.rsp' -type f -exec cp {} /store-evidence/ \;

FROM scratch AS store-evidence
COPY --from=build /store-evidence/ /

FROM ${DOTNET_SDK_IMAGE} AS runtime-assets
WORKDIR /src
COPY docker/runtime/ docker/runtime/
COPY --from=chiseled-base / /runtime-root/
# hadolint ignore=DL3008
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends gcc libatomic1 libgssapi-krb5-2 fonts-dejavu-core && \
    sh docker/runtime/stage-runtime.sh /runtime-root /runtime-additions && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /app /runtime-root/app
RUN sh docker/runtime/verify-native.sh /runtime-root /app

FROM chiseled-base AS runtime
ARG HONUA_STORE_PROFILE
LABEL honua.store.profile=$HONUA_STORE_PROFILE
COPY --from=runtime-assets /runtime-additions/ /


WORKDIR /app
COPY --from=build --chown=1001:1001 /app .
COPY --chown=1001:1001 LICENSE THIRD-PARTY-NOTICES.md /app/

USER 1001:1001

# Security and compliance labels
LABEL security.non-root="true" \
      security.capabilities.drop="ALL" \
      security.read-only-root="true" \
      security.user="1001" \
      security.group="1001" \
      maintainer="Honua Development Team" \
      version="1.0" \
      description="Honua Geospatial Feature Server" \
      org.opencontainers.image.source="https://github.com/honua/honua-server" \
      org.opencontainers.image.description="Production-ready geospatial feature server" \
      org.opencontainers.image.licenses="LicenseRef-FCL-1.0-ALv2" \
      honua.runtime.profile="web" \
      honua.runtime.compilation="native-aot" \
      honua.runtime.entrypoint="/app/Honua.Server"

# Immutable deployment identity (#3038). `.dockerignore` excludes `.git/`, so SourceLink
# cannot stamp a commit into the published binary from inside the build context; the commit
# SHA is therefore injected here as a runtime environment variable. The build stage also uses the SHA
# to stamp the informational version when VERSION is provided.
# HONUA_IMAGE_DIGEST is intentionally not set here: an image cannot contain its own digest,
# so deployments inject it (Helm/Terraform/task definition) once the image has been pushed.
ARG HONUA_GIT_SHA=
ARG VERSION=
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.revision="${HONUA_GIT_SHA}"
ENV HONUA_GIT_SHA=${HONUA_GIT_SHA}

# Security: Minimal environment variables
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS= \
    Kestrel__Endpoints__Http__Url=http://+:8080 \
    Kestrel__Endpoints__Http__Protocols=Http1 \
    Kestrel__Endpoints__Grpc__Url=http://+:8081 \
    Kestrel__Endpoints__Grpc__Protocols=Http2 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    DOTNET_EnableDiagnostics=0 \
    HONUA_DEFAULT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# The compiled probe runs without a shell.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/app/honua-healthcheck", "--ready"]

# Security: Explicit port exposure
EXPOSE 8080/tcp 8081/tcp

# Security: Use exec form and explicit binary path
ENTRYPOINT ["/app/Honua.Server"]
