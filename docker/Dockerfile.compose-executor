# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Built from the exact serving candidate, never a moving channel tag.
ARG HONUA_SERVER_IMAGE
ARG DOCKER_CLI_IMAGE=docker:29.10.0-cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d
ARG GO_IMAGE=golang:1.27.4-alpine3.23@sha256:f70850ef6ce341e8b6427f677049145d63c0b7ce002d4d7e3d464828b1b96dcd
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
RUN mkdir -p /run/honua-compose && chown 1002:1001 /run/honua-compose && \
    docker --version
# The Compose plugin is compiled from the pinned upstream release commit with its Go module
# graph raised to current security releases, instead of copying the CLI image's prebuilt binary.
# Cross-compiled on the build platform: the plugin is a static Go binary (CGO off).
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS compose-plugin
ARG TARGETOS
ARG TARGETARCH
ARG COMPOSE_VERSION=v5.7.1
ARG COMPOSE_COMMIT=fb1fd129f86828359335477f82821525201d4a8c
ARG X_NET_VERSION=v0.62.0
ARG X_CRYPTO_VERSION=v0.59.0
ARG OTEL_VERSION=v1.47.0
RUN apk add --no-cache git
WORKDIR /src
RUN git init -q . && git remote add origin https://github.com/docker/compose.git && \
    git fetch -q --depth 1 origin "${COMPOSE_COMMIT}" && git checkout -q FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${COMPOSE_COMMIT}" && \
    go get "golang.org/x/net@${X_NET_VERSION}" "golang.org/x/crypto@${X_CRYPTO_VERSION}" \
        "go.opentelemetry.io/otel@${OTEL_VERSION}" \
        "go.opentelemetry.io/otel/sdk@${OTEL_VERSION}" \
        "go.opentelemetry.io/otel/trace@${OTEL_VERSION}" && go mod tidy && \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -trimpath \
      -ldflags "-s -w -X github.com/docker/compose/v5/internal.Version=${COMPOSE_VERSION}" \
      -o /out/docker-compose ./cmd && \
    go version -m /out/docker-compose > /out/modules.txt && \
    awk -v net="${X_NET_VERSION}" -v crypto="${X_CRYPTO_VERSION}" -v otel="${OTEL_VERSION}" \
        '$1 == "dep" { versions[$2] = $3 } END { \
            if (versions["golang.org/x/net"] != net || \
                versions["golang.org/x/crypto"] != crypto || \
                versions["go.opentelemetry.io/otel/sdk"] != otel || \
                versions["go.opentelemetry.io/otel/trace"] != otel) exit 1 \
        }' /out/modules.txt
FROM ${HONUA_SERVER_IMAGE} AS executor
# This image is an operations process, not an HTTP serving artifact.
LABEL honua.runtime.profile="compose-executor"
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=compose-plugin /out/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=docker-cli --chown=1002:1001 /run/honua-compose /run/honua-compose
RUN ["/usr/local/lib/docker/cli-plugins/docker-compose", "version"]
ENV HONUA_COMPOSE_EXECUTOR=true
ENV HOME=/tmp
USER 1002:1001
HEALTHCHECK --interval=5s --timeout=3s --retries=30 CMD ["/app/honua-healthcheck", "--unix", "/run/honua-compose/executor.sock"]
