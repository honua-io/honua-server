# syntax=docker/dockerfile:1.7
# Built from the exact serving candidate, never a moving channel tag.
ARG HONUA_SERVER_IMAGE
ARG DOCKER_CLI_IMAGE=docker:28.5.1-cli@sha256:9190b0613792e658a7783cf14b2d5ace5941bb68ede7276922ea36ee457d76ad
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
RUN mkdir -p /run/honua-compose && chown 1002:1001 /run/honua-compose && \
    docker --version && docker compose version
FROM ${HONUA_SERVER_IMAGE} AS executor
# This image is an operations process, not an HTTP serving artifact.
LABEL honua.runtime.profile="compose-executor"
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=docker-cli --chown=1002:1001 /run/honua-compose /run/honua-compose
ENV HONUA_COMPOSE_EXECUTOR=true
ENV HOME=/tmp
USER 1002:1001
HEALTHCHECK --interval=5s --timeout=3s --retries=30 CMD ["/app/honua-healthcheck", "--unix", "/run/honua-compose/executor.sock"]
