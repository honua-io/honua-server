  "description": "Serving-plane overview (#2463). GIS-aware p95/p99 by protocol+operation from honua_serving_request_duration_ms, in-band + transport error rate from honua_request_error_total, cache hit ratio from honua_cache_{hits,misses}_total, and DB connection-pool saturation from honua_db_* gauges.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_serving_request_duration_ms_bucket[5m])) by (le, honua_protocol, honua_operation))",
          "legendFormat": "{{honua_protocol}}/{{honua_operation}}",
          "refId": "A"
        }
      ],
      "title": "Serving p95 by Protocol + Operation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_serving_request_duration_ms_bucket[5m])) by (le, honua_protocol))",
          "legendFormat": "p99 {{honua_protocol}}",
          "refId": "A"
        }
      ],
      "title": "Serving p99 by Protocol",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "unit": "req/s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(honua_serving_request_duration_ms_count[5m])) by (honua_protocol)",
          "legendFormat": "{{honua_protocol}}",
          "refId": "A"
        }
      ],
      "title": "Request Throughput by Protocol",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Protocol error envelopes. in_band=true are errors delivered with a 2xx/3xx transport status (invisible to load-balancer 5xx SLOs).",
      "fieldConfig": { "defaults": { "min": 0, "unit": "err/s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(honua_request_error_total[5m])) by (service_type)",
          "legendFormat": "{{service_type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(honua_request_error_total{in_band=\"true\"}[5m]))",
          "legendFormat": "in-band (masked) errors",
          "refId": "B"
        }
      ],
      "title": "Error Rate by Protocol (incl. in-band)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Per-cache hit ratio from honua_cache_hits_total / (hits + misses) over 5m.",
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(honua_cache_hits_total[5m])) by (cache_name) / (sum(rate(honua_cache_hits_total[5m])) by (cache_name) + sum(rate(honua_cache_misses_total[5m])) by (cache_name))",
          "legendFormat": "{{cache_name}}",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Ratio by Cache",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "DB connection-pool saturation. Ratio approaching 1.0 means the pool is exhausted and requests queue on connection acquisition.",
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max(honua_db_pool_utilization_ratio)",
          "legendFormat": "pool utilization",
          "refId": "A"
        },
        {
          "expr": "max(honua_db_active_connections) / clamp_min(max(honua_db_pool_size), 1)",
          "legendFormat": "active / size",
          "refId": "B"
        }
      ],
      "title": "DB Connection-Pool Saturation",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
