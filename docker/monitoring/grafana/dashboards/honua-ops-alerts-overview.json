  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "options": {
        "content": "### Alert pipeline health\nThese panels consume `honua_alerts_*` metrics from the alerts-GA workstream (#2468). If they read **No data**, that build is not yet deployed — the panels are wired and will populate once the alert-dispatch meter is emitting. Metric names match the #2468 implementation (honua.alerts.* on the shared Honua meter, exported with underscore conversion).",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Undelivered alerts waiting in the dispatch queue (backlog). Sustained growth means the dispatcher cannot keep up or a channel is failing.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(honua_alerts_dispatch_backlog_count)",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "title": "Alert Dispatch Backlog",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Alerts routed to the dead-letter path after exhausting delivery retries.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(honua_alerts_deliveries_dead_lettered_total[5m])) by (channel)",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "title": "Alert Dead-Letters",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "End-to-end alert delivery latency percentiles.",
      "fieldConfig": { "defaults": { "min": 0, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_alerts_delivery_latency_bucket[5m])) by (le, channel))",
          "legendFormat": "p95 {{channel}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_alerts_delivery_latency_bucket[5m])) by (le))",
          "legendFormat": "p99 (all)",
          "refId": "B"
        }
      ],
      "title": "Alert Delivery Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Alert dispatch rate by outcome (delivered vs failed).",
      "fieldConfig": { "defaults": { "min": 0, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(honua_alerts_deliveries_succeeded_total[5m])) by (channel) or sum(rate(honua_alerts_deliveries_failed_total[5m])) by (channel)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Alert Dispatch Rate by Outcome",
      "type": "timeseries"
    }
  ],
