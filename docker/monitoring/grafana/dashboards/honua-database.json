      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_db_connection_acquisition_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_db_connection_acquisition_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
