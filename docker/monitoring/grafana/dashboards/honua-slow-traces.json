  },
  "description": "Slow span / slow trace investigation board. Per-ActivitySource span duration histograms are not natively exported to Prometheus by the OpenTelemetry SDK (spans flow over OTLP to a tracing backend, not as Prometheus histograms). These panels use the closest equivalents already emitted: the honua_* duration histograms (HTTP, database, operation, geometry) and wfs20_* transaction/operation histograms, plus OTel's http.server.request.duration.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 / p99 of HTTP request duration aggregated across the whole server (sourced from the Honua meter, equivalent to the root ASP.NET Core span on most paths).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "http p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "http p99",
          "refId": "B"
        }
      ],
      "title": "HTTP Span p95 / p99 (root)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Database query duration. Activity source equivalent: Npgsql instrumentation spans plus Honua's own database operations.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_database_query_duration_ms_bucket[5m])) by (le, query_type))",
          "legendFormat": "db p95 {{query_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_database_query_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "db p99 (all)",
          "refId": "B"
        }
      ],
      "title": "Database Span p95 / p99 by query_type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "WFS 2.0 Transaction operation latency from the Honua.Wfs20.Transactions meter. Mirrors the Honua.Wfs20.Transactions ActivitySource.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(wfs20_transaction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "wfs20 txn p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(wfs20_transaction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "wfs20 txn p99",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(wfs20_operation_duration_seconds_bucket[5m])) by (le, operation_type))",
          "legendFormat": "wfs20 op p95 {{operation_type}}",
          "refId": "C"
        }
      ],
      "title": "WFS 2.0 Transactions p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Generic operation latency (honua_operation_duration_ms) plus geometry-processing latency. Activity source equivalents are scattered across Honua, Honua.Core.Metadata, Honua.Spec.* and friends.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_operation_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "operation p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_geometry_operation_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "geometry p95",
          "refId": "B"
        }
      ],
      "title": "Operation / Geometry p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 of tile-render latency, carved out of honua_http_request_duration_ms by matching tile endpoints (/tiles, /wmts, /wms with GetMap).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_http_request_duration_ms_bucket{endpoint=~\".*/(tiles|wmts).*\"}[5m])) by (le))",
          "legendFormat": "tile p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_http_request_duration_ms_bucket{endpoint=~\".*/(tiles|wmts).*\"}[5m])) by (le))",
          "legendFormat": "tile p99",
          "refId": "B"
        }
      ],
      "title": "Tile Render p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 of STAC search latency, carved out of honua_http_request_duration_ms by matching /stac endpoints.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(honua_http_request_duration_ms_bucket{endpoint=~\".*/stac.*\"}[5m])) by (le))",
          "legendFormat": "stac p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(honua_http_request_duration_ms_bucket{endpoint=~\".*/stac.*\"}[5m])) by (le))",
          "legendFormat": "stac p99",
          "refId": "B"
        }
      ],
      "title": "STAC Search p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Slow request count (requests slower than 1s) per endpoint, derived from the cumulative bucket count: total - le=1000. Activity-source-keyed equivalent requires a histogram per ActivitySource (Honua, Honua.Server.Export, Honua.Wfs20.Transactions, Honua.Core.Metadata, Honua.MySql.FeatureDataAccess); see #1144.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "req/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (endpoint) (rate(honua_http_request_duration_ms_count[5m]) - rate(honua_http_request_duration_ms_bucket{le=\"1000\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Slow Requests (> 1s) by Endpoint",
      "type": "timeseries"
    }
  ],
