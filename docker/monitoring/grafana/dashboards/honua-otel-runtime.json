        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(process_memory_usage_bytes)",
          "legendFormat": "working set",
          "refId": "A"
        },
        {
          "expr": "max(process_memory_virtual_bytes)",
          "legendFormat": "virtual",
          "refId": "B"
        }
      ],
      "title": "Working Set",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
