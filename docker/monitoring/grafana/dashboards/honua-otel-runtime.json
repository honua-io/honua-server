  "description": ".NET runtime telemetry from OpenTelemetry.Instrumentation.Runtime plus process-level metrics (working set, CPU, threads) from OpenTelemetry.Instrumentation.Process.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(process_runtime_dotnet_gc_collections_count_total{generation=\"gen0\"}[5m]))",
          "legendFormat": "gen0",
          "refId": "A"
        },
        {
          "expr": "sum(rate(process_runtime_dotnet_gc_collections_count_total{generation=\"gen1\"}[5m]))",
          "legendFormat": "gen1",
          "refId": "B"
        },
        {
          "expr": "sum(rate(process_runtime_dotnet_gc_collections_count_total{generation=\"gen2\"}[5m]))",
          "legendFormat": "gen2",
          "refId": "C"
        }
      ],
      "title": "GC Collections per Generation",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(process_runtime_dotnet_gc_allocations_size_bytes_total[5m]))",
