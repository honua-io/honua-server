{
  "Exclude": [
    "[*.Tests]*",
    "[*.TestKit]*",
    "[*]*.Program",
    "[*]*.Startup",
    "[*]*Migrations*",
    "[*]*.Designer",
    "[*]*GlobalUsings",
    "[*]*AssemblyInfo"
  ],
  "ExcludeByAttribute": [
    "Obsolete",
    "GeneratedCodeAttribute",
    "CompilerGeneratedAttribute",
    "ExcludeFromCodeCoverageAttribute",
    "DebuggerStepThroughAttribute",
    "DebuggerNonUserCodeAttribute"
  ],
  "ExcludeByFile": [
    "**/obj/**/*.cs",
    "**/bin/**/*.cs",
    "**/*Program.cs",
    "**/*Startup.cs",
    "**/Migrations/**/*.cs",
    "**/*.Designer.cs",
    "**/*.g.cs",
    "**/*.g.i.cs",
    "**/Properties/AssemblyInfo.cs",
    "**/GlobalUsings.cs"
  ],
  "IncludeTestAssembly": false,
  "DeterministicReport": true,
  "Format": [
    "cobertura",
    "json",
    "lcov",
    "opencover"
  ]
}