<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1716;IL2026;IL3050</NoWarn>
    <WarningsNotAsErrors>CA2009;IDE0073</WarningsNotAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Elastic-2.0</PackageLicenseExpression>
    <!--
      Namespaces are preserved as Honua.ControlPlane so consumers
      (Server, Worker.Gdal, tests) keep their using clauses unchanged. This is the
      same approach used by Honua.Hosting (RootNamespace = Honua.Infrastructure).
    -->
    <RootNamespace>Honua.ControlPlane</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />

    <!--
      Durable job-execution substrate (ADR-0031). Hosts the shared claim/lease/
      heartbeat loop (JobExecutionService), the Redis-backed queue/stores, the
      reconciliation sweeper, and the small cancellation/metadata helpers. The
      AWS Batch / ECS / Lambda / Azure / Kubernetes provider backends stay in
      Honua.Server (and will be carved into Honua.Aws / Honua.Azure / Honua.K8s
      in follow-on splits). Realises ADR-0038's lean-worker boundary by letting
      Honua.Worker.Gdal reuse the substrate without taking a ProjectReference on
      Honua.Server.
    -->
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Polly" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Server" />
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Worker.Gdal" />
    <InternalsVisibleTo Include="Honua.Worker.Gdal.Tests" />
    <InternalsVisibleTo Include="Honua.Architecture.Tests" />
    <InternalsVisibleTo Include="Honua.TestKit" />
    <InternalsVisibleTo Include="Honua.Protocols.OData.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcClassic.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.GeoServices.Tests" />
    <InternalsVisibleTo Include="Honua.Ai.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.Scene.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.Stac.Tests" />
    <InternalsVisibleTo Include="Honua.Aws" />
    <InternalsVisibleTo Include="Honua.Azure" />
    <InternalsVisibleTo Include="Honua.Geoprocessing" />
    <InternalsVisibleTo Include="Honua.Geoprocessing.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Core.Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.ServiceDefaults\Honua.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
