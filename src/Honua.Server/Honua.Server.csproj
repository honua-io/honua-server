<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Globalization must NOT be invariant: Microsoft.Data.SqlClient and Oracle.ManagedDataAccess throw
         "Globalization Invariant Mode is not supported" at connect time, which breaks the provider-aware
         admin connection test for SQL Server and Oracle. The published/AOT image must therefore include ICU
         (e.g. libicu in the runtime base image). See honua-server#1369. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress trim warnings from Serilog and endpoint mapping for AOT compatibility -->
    <!-- Suppress analyzer warnings that are not critical for compilation -->
    <!-- Temporarily allow CS1591 while establishing warnings-as-errors framework -->
    <!-- CA1305/CA1310 (locale-sensitive ToString/StartsWith/EndsWith) are NOT suppressed: every call site uses
         CultureInfo.InvariantCulture for numeric/format and StringComparison.Ordinal for comparisons so the build
         stays green with InvariantGlobalization=false. See honua-server#1369. -->
    <NoWarn>$(NoWarn);CS1591;IL2104;IL2026;IL3002;IL3050;CA1041;CA1000;CA1862;IDE0051;IDE0052;IDE0005;CA1844;IL2075</NoWarn>
  </PropertyGroup>

  <!-- Build-profile defaults and compile constants for custom Docker images. -->
  <Import Project="..\..\eng\Honua.BuildProfiles.props" />
  <!-- Protocol profiles are a separate axis from provider/cloud presets. -->
  <Import Project="..\..\eng\Honua.ProtocolProfiles.props" />
  <PropertyGroup Condition="'$(HonuaIncludeGeoServices)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Features/Geocoding/GeocodingHandler.cs;Features/Geocoding/GeocodingEndpoints.cs;Features/PrintingTools/**/*.cs;Features/Protocols/SpatialAnalytics/SpatialAnalyticsRequestHandlers*.cs;Features/Protocols/SpatialAnalytics/SpatialAnalyticsEndpoints.cs;Features/Infrastructure/Analytics/AnalyticsFeatureQueryFactory.cs;Features/Infrastructure/Analytics/AnalyticsLayerSelectionFilterTranslator.cs;Features/Infrastructure/Hosting/Modules/GeoServicesProtocolModule.cs;Features/Protocols/Grpc/HonuaFeatureService.cs</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HonuaIncludeOgcApi)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Features/Infrastructure/Hosting/Modules/OgcApiProtocolModule.cs</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HonuaIncludeOgcClassic)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Features/Infrastructure/Hosting/Modules/OgcClassicProtocolModule.cs</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HonuaIncludeOData)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Features/Infrastructure/Hosting/Modules/ODataProtocolModule.cs</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HonuaIncludeScene)' != 'true'">
    <DefaultItemExcludes>$(DefaultItemExcludes);Features/Admin/SceneDatasetEndpoints.cs;Features/Admin/SceneGenerationEndpoints.cs;Features/Admin/SceneBimIngestEndpoints.cs;Features/Admin/ScenePointCloudIngestEndpoints.cs;Features/Admin/Scene/GeoprocessingPointCloudDecompressor.cs;Features/Infrastructure/Scene/SceneGenerationServiceCollectionExtensions.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Architecture.Tests" />
    <InternalsVisibleTo Include="Honua.CloudIntegration.Tests" />
    <InternalsVisibleTo Include="Honua.TestKit" />
    <InternalsVisibleTo Include="Honua.Protocols.OData.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcClassic.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.GeoServices.Tests" />
    <InternalsVisibleTo Include="Honua.Ai.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.Scene.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.Stac.Tests" />
    <!--
      The heavyweight GDAL worker (src/Honua.Worker.Gdal) reuses the internal
      durable job-execution substrate (JobExecutionService, RedisJobQueue, the
      Redis-backed stores, JobReconciliationService) rather than forking a
      parallel runtime. This grant exposes those internals to the worker host
      ONLY; it introduces NO GDAL dependency into the serving image — the worker
      is a standalone host that references Honua.Server, not the reverse.
    -->
    <InternalsVisibleTo Include="Honua.Worker.Gdal" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

