  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="SkiaSharp" />
    <!-- The distro-linked asset remains the default for JIT hosts and local development. The
         published native-AOT images (docker/Dockerfile.aot, docker/Dockerfile.lambda.aot) use
         the self-contained asset instead: the distro-linked linux-arm64 binary references
         uuid_* and FT_Get_BDF_Property without declaring the libraries that define them, so it
         fails `ldd -r` and can terminate the process on first render (#4949). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux"
                      Condition="'$(HonuaUseSkiaNoDependencies)' != 'true'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
                      Condition="'$(HonuaUseSkiaNoDependencies)' == 'true'" />
    <PackageReference Include="Apache.Arrow" />
    <EmbeddedResource Include="Migrations\*.sql" />
    <EmbeddedResource Include="MigrationContracts\attachment-schema-preamble.v1.sql.template"
                      LogicalName="Honua.Server.MigrationContracts.attachment-schema-preamble.v1.sql.template" />
    <EmbeddedResource Include="..\..\docs\gis\data\feature-catalog.json"
                      Link="DeploymentProfiles\feature-catalog.json"
                      LogicalName="Honua.Server.DeploymentProfiles.feature-catalog.json" />
    <EmbeddedResource Include="..\..\docs\gis\data\capability-manifest-crosswalk.v1.json"
                      Link="DeploymentProfiles\capability-manifest-crosswalk.v1.json"
                      LogicalName="Honua.Server.DeploymentProfiles.capability-manifest-crosswalk.v1.json" />
    <!-- honua-server#5378: the release resolver's declaration, advertised at /api/v1/admin/capabilities. -->
    <EmbeddedResource Include="..\..\release\component-versions.json"
                      Link="Release\component-versions.json"
                      LogicalName="Honua.Server.release.component-versions.json" />
  </ItemGroup>

