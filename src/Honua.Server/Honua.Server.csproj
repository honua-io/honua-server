  </ItemGroup>
  <ItemGroup Condition="'$(HonuaIncludeScene)' != 'true'">
    <Content Remove="fixtures\scenes\**\*" />
    <None Remove="fixtures\scenes\**\*" />
  </ItemGroup>

</Project>
