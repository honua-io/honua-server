    <ProjectReference Include="..\Honua.Import\Honua.Import.csproj" />

    <ProjectReference Include="..\..\samples\Honua.StacOpsDemo\Honua.StacOpsDemo.csproj" Condition="'$(HonuaIncludeStacOpsDemo)' != 'false' and '$(HonuaIncludeStac)' == 'true' and ('$(PublishAot)' != 'true' or '$(RuntimeIdentifier)' == '')" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained;StripSymbols" />

    <ProjectReference Include="..\Honua.Protocols.Scene\Honua.Protocols.Scene.csproj" Condition="'$(HonuaIncludeScene)' == 'true'" />

    <ProjectReference Include="..\Honua.Protocols.Ogc.Shared\Honua.Protocols.Ogc.Shared.csproj" />

    <ProjectReference Include="..\Honua.Protocols.OgcApi\Honua.Protocols.OgcApi.csproj" Condition="'$(HonuaIncludeOgcApi)' == 'true'" />

    <ProjectReference Include="..\Honua.Protocols.OgcClassic\Honua.Protocols.OgcClassic.csproj" Condition="'$(HonuaIncludeOgcClassic)' == 'true'" />

    <ProjectReference Include="..\Honua.Protocols.Stac\Honua.Protocols.Stac.csproj" Condition="'$(HonuaIncludeStac)' == 'true'" />

    <ProjectReference Include="..\Honua.Protocols.SensorThings\Honua.Protocols.SensorThings.csproj" Condition="'$(HonuaIncludeSensorThings)' == 'true'" />

    <ProjectReference Include="..\Honua.Protocols.GeoServices\Honua.Protocols.GeoServices.csproj" Condition="'$(HonuaIncludeGeoServices)' == 'true'" />

    <ProjectReference Include="..\Honua.Plugins\Honua.Plugins.csproj" />

    <ProjectReference Include="..\Honua.Routing\Honua.Routing.csproj" />

    <ProjectReference Include="..\Honua.Scene\Honua.Scene.csproj" Condition="'$(HonuaIncludeScene)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(HonuaIncludeGeoServices)' != 'true'">
    <Compile Remove="Features\Geocoding\GeocodingHandler.cs" />
    <Compile Remove="Features\Geocoding\GeocodingEndpoints.cs" />
    <Compile Remove="Features\PrintingTools\**\*.cs" />
    <Compile Remove="Features\Protocols\SpatialAnalytics\SpatialAnalyticsRequestHandlers*.cs" />
