    <ProjectReference Include="..\Honua.Db\Databricks\Honua.Databricks.csproj" />
    <ProjectReference Include="..\Honua.Db\Oracle\Honua.Oracle.csproj" Condition="'$(HonuaIncludeOracle)' == 'true'" />
    <ProjectReference Include="..\Honua.Snowflake\Honua.Snowflake.csproj" Condition="'$(HonuaIncludeSnowflake)' == 'true'" />
    <ProjectReference Include="..\Honua.ServiceDefaults\Honua.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.Jobs\Honua.Jobs.csproj" />
    <ProjectReference Include="..\Honua.Protocols.OData\Honua.Protocols.OData.csproj" Condition="'$(HonuaIncludeOData)' == 'true'" />
    <ProjectReference Include="..\Honua.Geocoding\Honua.Geocoding.csproj" />

    <ProjectReference Include="..\Honua.Cloud\Aws\Honua.Aws.csproj" Condition="'$(HonuaIncludeAws)' == 'true'" />
    <ProjectReference Include="..\Honua.Cloud\Azure\Honua.Azure.csproj" Condition="'$(HonuaIncludeAzure)' == 'true'" />

    <ProjectReference Include="..\Honua.Ai\Honua.Ai.csproj" />

    <ProjectReference Include="..\Honua.Geometry\Honua.Geometry.csproj" />
    <ProjectReference Include="..\Honua.Geoprocessing\Honua.Geoprocessing.csproj" />
