{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Enabled": true,
    "DefaultTtlSeconds": 300,
    "ServiceTtlSeconds": 300,
    "LayerTtlSeconds": 300,
    "EnableFallback": true,
    "FallbackMaxEntries": 1000,
    "RetryIntervalSeconds": 30,
    "KeyPrefix": "honua:"
  }
}
