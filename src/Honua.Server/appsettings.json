{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Honua.Postgres.Features.Infrastructure.Caching": "Warning",
      "Honua.Server.Features.Infrastructure.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Public": {
    "BaseUrl": ""
  },
  "Oidc": {
    "Enabled": false,
    "RequireHttps": true,
    "DefaultRole": "user",
    "AdminRoles": ["admin", "administrator"],
    "AzureAd": {
      "Enabled": false,
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc-azuread",
      "SignedOutCallbackPath": "/signout-callback-oidc-azuread",
      "Scopes": ["openid", "profile", "email"]
    },
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc-google",
      "Scopes": ["openid", "profile", "email"]
    },
    "Generic": {
      "Enabled": false,
      "DisplayName": "External Identity Provider",
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "Scopes": ["openid", "profile", "email"],
      "ResponseType": "code",
      "UsePkce": true,
      "SaveTokens": true,
      "GetClaimsFromUserInfoEndpoint": true
    },
    "ClaimsMapping": {
      "NameClaimType": "name",
      "RoleClaimType": "roles",
      "EmailClaimType": "email",
      "UserIdClaimType": "sub",
      "CustomMappings": {}
    },
    "TokenValidation": {
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateIssuerSigningKey": true,
      "ClockSkew": "00:05:00",
      "ValidIssuers": [],
      "ValidAudiences": [],
      "EnableTokenReplayProtection": true,
      "TokenReplayCacheDuration": "00:10:00"
    }
  },
  "Rbac": {
    "RoleClaimType": "roles",
    "DataEditorRoles": [],
    "DataEditorServicePrefix": "data-editor:"
  },
  "Cache": {
    "Enabled": true,
    "DefaultTtlSeconds": 300,
    "ServiceTtlSeconds": 300,
    "LayerTtlSeconds": 300,
    "NegativeTtlSeconds": 30,
    "JitterPercentage": 0.2,
    "EnableFallback": true,
    "FallbackMaxEntries": 1000,
    "RetryIntervalSeconds": 30,
    "KeyPrefix": "honua:"
  },
  "Deployment": {
    "Mode": "SingleInstance"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalStorage": {
      "BasePath": "/tmp/honua-storage",
      "CreateDirectoryIfNotExists": true
    },
    "DefaultTimeToLive": "24:00:00",
    "MaxFileSizeBytes": 1073741824,
    "EnableAutomaticCleanup": true,
    "CleanupInterval": "01:00:00"
  },
  "TemporaryFiles": {
    "StorageDirectory": "/tmp/honua-temp",
    "DefaultExpiration": "01:00:00",
    "MaxFileSizeBytes": 52428800,
    "BaseUrl": "/temp"
  },
  "Database": {
    "QueryCache": {
      "MaxCachedStatements": 100,
      "StatementLifetimeMinutes": 30,
      "MinExecutionsForCaching": 3,
      "EnableAutomaticCaching": true,
      "EnablePerformanceLogging": false,
      "CleanupIntervalMinutes": 10
    }
  },
  "Tracing": {
    "Enabled": true,
    "SamplingRatio": 0.1,
    "IncludeDbStatementText": false,
    "TraceHealthEndpoints": false,
    "RecordExceptionStackTraces": true,
    "MaxAttributesPerSpan": 128,
    "MaxEventsPerSpan": 128
  },
  "AdaptiveSampling": {
    "Enabled": true,
    "BaseSamplingRate": 0.1,
    "MinSamplingRate": 0.01,
    "MaxSamplingRate": 0.5,
    "EvaluationWindow": "00:02:00",
    "Load": {
      "CpuThreshold": 70.0,
      "MemoryThreshold": 80.0,
      "ActiveRequestThreshold": 50,
      "ResponseTimeThresholdMs": 1000
    },
    "Error": {
      "ErrorRateThreshold": 5.0,
      "ErrorMultiplier": 3.0,
      "ErrorWindowMinutes": 5
    },
    "Operations": {
      "Enabled": true,
      "CriticalRate": 1.0,
      "ImportantRate": 0.5,
      "NormalRate": 0.1,
      "BackgroundRate": 0.01
    }
  }
}
