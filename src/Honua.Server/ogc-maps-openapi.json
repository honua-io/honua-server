{
  "openapi": "3.0.3",
  "info": {
    "title": "Honua OGC API Maps",
    "description": "OGC API Maps implementation for server-rendered imagery",
    "version": "1.0.0"
  },
  "paths": {
    "/ogc/maps": {
      "get": {
        "summary": "Get OGC API Maps landing page",
        "responses": {
          "200": {
            "description": "Landing page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandingPage"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/conformance": {
      "get": {
        "summary": "Get OGC API Maps conformance declaration",
        "responses": {
          "200": {
            "description": "Conformance declaration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OgcMapsConformance"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/openapi.json": {
      "get": {
        "summary": "Get OGC API Maps OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/vnd.oai.openapi+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/map": {
      "get": {
        "summary": "Render a dataset map",
        "security": [
          {},
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/collections" },
          { "$ref": "#/components/parameters/bbox" },
          { "$ref": "#/components/parameters/bboxCrs" },
          { "$ref": "#/components/parameters/crs" },
          { "$ref": "#/components/parameters/width" },
          { "$ref": "#/components/parameters/height" },
          { "$ref": "#/components/parameters/f" },
          { "$ref": "#/components/parameters/quality" },
          { "$ref": "#/components/parameters/datetime" }
        ],
        "responses": {
          "200": {
            "description": "Rendered map image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid map request parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required for at least one requested collection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "402": {
            "description": "Payment required when datetime rendering needs the raster.temporal-mosaic entitlement",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Requested collections are not accessible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No renderable collections were found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/collections/{collectionId}/map": {
      "get": {
        "summary": "Render a collection map",
        "security": [
          {},
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          { "$ref": "#/components/parameters/bbox" },
          { "$ref": "#/components/parameters/bboxCrs" },
          { "$ref": "#/components/parameters/crs" },
          { "$ref": "#/components/parameters/width" },
          { "$ref": "#/components/parameters/height" },
          { "$ref": "#/components/parameters/f" },
          { "$ref": "#/components/parameters/quality" },
          { "$ref": "#/components/parameters/datetime" }
        ],
        "responses": {
          "200": {
            "description": "Rendered map image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid collection identifier or map request parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required for the requested collection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "402": {
            "description": "Payment required when datetime rendering needs the raster.temporal-mosaic entitlement",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Requested collection is not accessible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found or has no renderable map data",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/collections/{collectionId}/styles/{styleId}/map": {
      "get": {
        "summary": "Render a styled collection map",
        "security": [
          {},
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "styleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          { "$ref": "#/components/parameters/bbox" },
          { "$ref": "#/components/parameters/bboxCrs" },
          { "$ref": "#/components/parameters/crs" },
          { "$ref": "#/components/parameters/width" },
          { "$ref": "#/components/parameters/height" },
          { "$ref": "#/components/parameters/f" },
          { "$ref": "#/components/parameters/quality" }
        ],
        "responses": {
          "200": {
            "description": "Rendered styled map image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid collection identifier or map request parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required for the requested collection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Requested collection is not accessible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found or has no renderable map data",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "Styled map rendering is not implemented for this collection type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/collections/{collectionId}/map/tiles": {
      "get": {
        "summary": "Get collection map tilesets",
        "security": [
          {},
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tileset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TileSetsList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid collection identifier",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required for the requested collection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Requested collection is not accessible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/ogc/maps/collections/{collectionId}/map/tiles/{tileMatrixSetId}": {
      "get": {
        "summary": "Get collection map tileset",
        "security": [
          {},
          { "ApiKeyAuth": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "tileMatrixSetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tileset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TileSet"
                }
              }
            }
          },
          "400": {
            "description": "Invalid collection identifier",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required for the requested collection",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Requested collection is not accessible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Collection or tile matrix set not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "collections": {
        "name": "collections",
        "in": "query",
        "description": "Comma-separated collection identifiers to include in a dataset map request. When omitted, all accessible map-enabled collections are considered.",
        "schema": {
          "type": "string"
        }
      },
      "bbox": {
        "name": "bbox",
        "in": "query",
        "description": "Bounding box as minX,minY,maxX,maxY in the bbox-crs coordinate reference system.",
        "schema": {
          "type": "string"
        }
      },
      "bboxCrs": {
        "name": "bbox-crs",
        "in": "query",
        "description": "Coordinate reference system for bbox coordinates. Supports EPSG codes and OGC CRS URIs.",
        "schema": {
          "type": "string"
        }
      },
      "crs": {
        "name": "crs",
        "in": "query",
        "description": "Coordinate reference system for the rendered map response. Supports EPSG codes and OGC CRS URIs.",
        "schema": {
          "type": "string"
        }
      },
      "width": {
        "name": "width",
        "in": "query",
        "description": "Rendered image width in pixels.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "height": {
        "name": "height",
        "in": "query",
        "description": "Rendered image height in pixels.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "f": {
        "name": "f",
        "in": "query",
        "description": "Short output image format. When omitted, HTTP Accept negotiation is used.",
        "schema": {
          "type": "string",
          "enum": ["png", "jpeg", "jpg", "tiff", "tif"]
        }
      },
      "quality": {
        "name": "quality",
        "in": "query",
        "description": "Lossy compression quality for JPEG output.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "datetime": {
        "name": "datetime",
        "in": "query",
        "description": "RFC 3339 instant or interval used to select temporal raster mosaic frames. Accepts a single instant (e.g. 2024-02-15T00:00:00Z), a closed interval (start/end), and half-open intervals (start/.., ../end). Honua selects the newest effective acquisition batch within the bounded range across the addressed collection or dataset, then applies bbox windowing and renders rasters from that batch only. Requires the raster.temporal-mosaic entitlement; inactive entitlements return 402 Payment Required.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "LandingPage": {
        "type": "object",
        "required": [
          "title",
          "links"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "Link": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "OgcMapsConformance": {
        "type": "object",
        "required": [
          "conformsTo"
        ],
        "properties": {
          "conformsTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "TileSetsList": {
        "type": "object",
        "required": [
          "tilesets"
        ],
        "properties": {
          "tilesets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TileSetItem"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "TileSetItem": {
        "type": "object",
        "required": [
          "dataType",
          "crs",
          "tileMatrixSetId",
          "links"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "crs": {
            "type": "string",
            "format": "uri"
          },
          "tileMatrixSetId": {
            "type": "string"
          },
          "tileMatrixSetURI": {
            "type": "string"
          },
          "tileMatrixSetLimits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetLimit"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "TileSet": {
        "type": "object",
        "required": [
          "dataType",
          "crs",
          "tileMatrixSetId",
          "links"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "crs": {
            "type": "string",
            "format": "uri"
          },
          "tileMatrixSetId": {
            "type": "string"
          },
          "tileMatrixSetURI": {
            "type": "string"
          },
          "tileMatrixSetLimits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetLimit"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "mediaTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TileMatrixSetLimit": {
        "type": "object",
        "required": [
          "tileMatrix",
          "minTileRow",
          "maxTileRow",
          "minTileCol",
          "maxTileCol"
        ],
        "properties": {
          "tileMatrix": {
            "type": "string"
          },
          "minTileRow": {
            "type": "integer",
            "minimum": 0
          },
          "maxTileRow": {
            "type": "integer",
            "minimum": 0
          },
          "minTileCol": {
            "type": "integer",
            "minimum": 0
          },
          "maxTileCol": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
