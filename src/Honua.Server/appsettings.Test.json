{
  "SecurityHeaders": {
    "EnableHsts": false,
    "CrossOriginEmbedderPolicy": "unsafe-none",
    "Csp": {
      "AllowDevelopmentFeatures": true,
      "ReportOnly": true
    }
  },
  "Capabilities": {
    "Experimental": {
      "Enabled": true
    }
  },
  "Experimental": {
    "Features": {
      "SensorThings": true,
      "FederatedQuery": true,
      "RedshiftProvider": true,
      "SnowflakeProvider": true
    }
  }
}
