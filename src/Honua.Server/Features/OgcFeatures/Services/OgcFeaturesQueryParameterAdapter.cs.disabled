using System.Collections.Immutable;
using System.Globalization;
using Honua.Core.Features.Catalog.Domain;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Query;
using Honua.Core.Features.Shared.Models;
using Honua.Core.Queries.Filters;
using Honua.Core.Queries.Filters.Cql2;
using Honua.Server.Features.Infrastructure.Validation;
using Microsoft.Extensions.Logging;

namespace Honua.Server.Features.OgcFeatures.Services;

/// <summary>
/// Parameters for OGC API Features query operations.
/// </summary>
public readonly record struct OgcFeaturesQueryParameters
{
    public string? Filter { get; init; }
    public string? FilterLang { get; init; }
    public string? FilterCrs { get; init; }
    public int? Limit { get; init; }
    public int? Offset { get; init; }
    public string? Bbox { get; init; }
    public string? Datetime { get; init; }
    public string? Ids { get; init; }
    public string? Properties { get; init; }
    public string? Sortby { get; init; }
    public string? Crs { get; init; }
    public string? F { get; init; }
}

/// <summary>
/// Adapter that converts OGC API Features parameters to UnifiedQuery.
/// </summary>
public sealed class OgcFeaturesQueryParameterAdapter : IQueryParameterAdapter<OgcFeaturesQueryParameters>
{
    private readonly IFilterExpressionService _filterExpressionService;
    private readonly ICrsRegistry _crsRegistry;
    private readonly ICommonQueryValidator _queryValidator;
    private readonly ILogger<OgcFeaturesQueryParameterAdapter> _logger;

    public string ProtocolName => "OGC-API-Features";

    public ProtocolLimits DefaultLimits => ProtocolLimits.OgcFeatures;

    public OgcFeaturesQueryParameterAdapter(
        IFilterExpressionService filterExpressionService,
        ICrsRegistry crsRegistry,
        ICommonQueryValidator queryValidator,
        ILogger<OgcFeaturesQueryParameterAdapter> logger)
    {
        _filterExpressionService = filterExpressionService ?? throw new ArgumentNullException(nameof(filterExpressionService));
        _crsRegistry = crsRegistry ?? throw new ArgumentNullException(nameof(crsRegistry));
        _queryValidator = queryValidator ?? throw new ArgumentNullException(nameof(queryValidator));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    public async Task<QueryAdapterResult> ConvertAsync(
        OgcFeaturesQueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken = default)
    {
        try
        {
            // Validate pagination first
            var paginationResult = _queryValidator.ValidateAndNormalizePagination(parameters.Offset, parameters.Limit);
            if (!paginationResult.IsValid)
            {
                return QueryAdapterResult.Failure(paginationResult.ErrorMessage ?? "Invalid pagination parameters.");
            }

            // Convert filters
            var filterResult = await ConvertFiltersAsync(parameters, layer, cancellationToken);
            if (filterResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(filterResult.ErrorMessage);
            }

            // Convert object IDs
            var objectIdsResult = ConvertObjectIds(parameters.Ids);
            if (objectIdsResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(objectIdsResult.ErrorMessage);
            }

            // Convert properties selection
            var propertiesResult = ConvertProperties(parameters.Properties, layer);
            if (propertiesResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(propertiesResult.ErrorMessage);
            }

            // Convert sorting
            var sortByResult = ConvertSortBy(parameters.Sortby, layer);
            if (sortByResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(sortByResult.ErrorMessage);
            }

            // Convert output CRS
            var outputCrsResult = await ConvertOutputCrsAsync(parameters.Crs, layer, cancellationToken);
            if (outputCrsResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(outputCrsResult.ErrorMessage);
            }

            var effectiveOffset = paginationResult.Value!.Offset;
            var effectiveLimit = paginationResult.Value.Limit;

            // Build query hints
            var hints = QueryHints.Create(
                preferStreaming: ShouldPreferStreaming(effectiveLimit),
                enableCaching: ShouldEnableCache(parameters),
                requireExactCount: true // OGC API Features typically requires exact counts
            );

            // Create unified query
            var unifiedQuery = new UnifiedQuery
            {
                Filter = filterResult.Filter,
                SpatialFilter = filterResult.SpatialFilter,
                TemporalFilter = filterResult.TemporalFilter,
                ObjectIds = objectIdsResult.ObjectIds,
                OutFields = propertiesResult.Properties,
                Offset = effectiveOffset,
                Limit = effectiveLimit,
                OrderBy = sortByResult.OrderBy,
                OutputCrs = outputCrsResult.OutputCrs,
                Hints = hints
            };

            // Collect metadata for response formatting
            var metadata = new Dictionary<string, object>
            {
                ["f"] = parameters.F ?? "json",
                ["includeNumberMatched"] = true,
                ["includeNumberReturned"] = true
            };

            if (outputCrsResult.CrsDefinition != null)
            {
                metadata["crsDefinition"] = outputCrsResult.CrsDefinition;
            }

            return QueryAdapterResult.Success(unifiedQuery, metadata);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to convert OGC API Features query parameters");
            return QueryAdapterResult.Failure("Invalid query parameters.");
        }
    }

    private async Task<FilterConversionResult> ConvertFiltersAsync(
        OgcFeaturesQueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken)
    {
        QueryFilter? combinedFilter = null;
        SpatialFilter? spatialFilter = null;
        TemporalFilter? temporalFilter = null;

        // Convert attribute filter
        if (!string.IsNullOrWhiteSpace(parameters.Filter))
        {
            var filterLanguage = DetermineFilterLanguage(parameters.FilterLang);
            var parseResult = _filterExpressionService.Parse(filterLanguage, parameters.Filter);
            if (!parseResult.IsSuccess)
            {
                return new FilterConversionResult
                {
                    ErrorMessage = parseResult.ErrorMessage ?? "Invalid filter expression."
                };
            }

            if (parseResult.Expression != null)
            {
                var source = new FilterSource(parameters.Filter, filterLanguage, ProtocolName);
                combinedFilter = QueryFilter.FromExpression(parseResult.Expression, source);
            }
        }

        // Convert spatial filter (bbox)
        if (!string.IsNullOrWhiteSpace(parameters.Bbox))
        {
            var bboxResult = await ConvertBboxAsync(parameters.Bbox, parameters.Crs, layer, cancellationToken);
            if (bboxResult.ErrorMessage != null)
            {
                return new FilterConversionResult { ErrorMessage = bboxResult.ErrorMessage };
            }
            spatialFilter = bboxResult.SpatialFilter;
        }

        // Convert temporal filter (datetime)
        if (!string.IsNullOrWhiteSpace(parameters.Datetime))
        {
            var temporalResult = ConvertDatetime(parameters.Datetime);
            if (temporalResult.ErrorMessage != null)
            {
                return new FilterConversionResult { ErrorMessage = temporalResult.ErrorMessage };
            }
            temporalFilter = temporalResult.TemporalFilter;
        }

        return new FilterConversionResult
        {
            Filter = combinedFilter,
            SpatialFilter = spatialFilter,
            TemporalFilter = temporalFilter
        };
    }

    private async Task<(SpatialFilter? SpatialFilter, string? ErrorMessage)> ConvertBboxAsync(
        string bbox,
        string? crs,
        LayerDefinition layer,
        CancellationToken cancellationToken)
    {
        try
        {
            var parts = bbox.Split(',');
            if (parts.Length != 4 && parts.Length != 6)
            {
                return (null, "Bbox must have 4 or 6 coordinates.");
            }

            if (!double.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var minX) ||
                !double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var minY) ||
                !double.TryParse(parts[2], NumberStyles.Float, CultureInfo.InvariantCulture, out var maxX) ||
                !double.TryParse(parts[3], NumberStyles.Float, CultureInfo.InvariantCulture, out var maxY))
            {
                return (null, "Invalid bbox coordinates.");
            }

            // Create envelope geometry (simplified - would use proper geometry library)
            var envelope = CreateEnvelopeWkb(minX, minY, maxX, maxY);

            // Resolve CRS
            var supportedCrs = await OgcFeaturesUtilities.GetSupportedCrsDefinitionsAsync(layer, _crsRegistry, cancellationToken);
            if (!OgcFeaturesUtilities.TryResolveCrs(crs, supportedCrs, out var crsDefinition, out var crsError))
            {
                return (null, crsError);
            }

            var spatialFilter = SpatialFilter.Create(envelope, SpatialRelationship.Intersects, crsDefinition.Srid);
            return (spatialFilter, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse bbox: {Bbox}", bbox);
            return (null, "Invalid bbox format.");
        }
    }

    private (TemporalFilter? TemporalFilter, string? ErrorMessage) ConvertDatetime(string datetime)
    {
        try
        {
            // Parse ISO 8601 datetime interval
            // Format: "2023-01-01T00:00:00Z/2023-12-31T23:59:59Z" or single datetime
            DateTimeOffset? start = null, end = null;

            if (datetime.Contains('/'))
            {
                var parts = datetime.Split('/');
                if (parts.Length == 2)
                {
                    if (!string.IsNullOrEmpty(parts[0]) && parts[0] != "..")
                    {
                        if (!DateTimeOffset.TryParse(parts[0], out var startTime))
                        {
                            return (null, "Invalid start datetime format.");
                        }
                        start = startTime;
                    }

                    if (!string.IsNullOrEmpty(parts[1]) && parts[1] != "..")
                    {
                        if (!DateTimeOffset.TryParse(parts[1], out var endTime))
                        {
                            return (null, "Invalid end datetime format.");
                        }
                        end = endTime;
                    }
                }
            }
            else
            {
                if (!DateTimeOffset.TryParse(datetime, out var singleTime))
                {
                    return (null, "Invalid datetime format.");
                }
                start = end = singleTime;
            }

            if (!start.HasValue && !end.HasValue)
            {
                return (null, null);
            }

            return (new TemporalFilter
            {
                PropertyName = "created_at", // Default temporal property
                PropertyType = TemporalPropertyType.DateTime,
                Start = start,
                End = end
            }, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse datetime: {Datetime}", datetime);
            return (null, "Invalid datetime format.");
        }
    }

    private (ImmutableArray<long>? ObjectIds, string? ErrorMessage) ConvertObjectIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return (null, null);
        }

        try
        {
            var idList = new List<long>();
            var seen = new HashSet<long>();

            foreach (var idStr in ids.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = idStr.Trim();
                if (string.IsNullOrEmpty(trimmed))
                {
                    return (null, "Empty ID value in ids parameter.");
                }

                if (!long.TryParse(trimmed, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) || id <= 0)
                {
                    return (null, $"Invalid ID value: {trimmed}");
                }

                if (seen.Add(id))
                {
                    idList.Add(id);
                }
            }

            return (idList.Count > 0 ? idList.ToImmutableArray() : null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse object IDs: {Ids}", ids);
            return (null, "Invalid ids format.");
        }
    }

    private (ImmutableArray<string>? Properties, string? ErrorMessage) ConvertProperties(string? properties, LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(properties))
        {
            return (null, null);
        }

        if (string.Equals(properties.Trim(), "*", StringComparison.Ordinal))
        {
            return (null, null); // All properties
        }

        try
        {
            var availableFields = layer.AttributeFields.ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);
            var selectedFields = new List<string>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var prop in properties.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = prop.Trim();
                if (string.IsNullOrEmpty(trimmed))
                {
                    return (null, "Empty property name in properties parameter.");
                }

                if (!availableFields.ContainsKey(trimmed))
                {
                    return (null, $"Unknown property: {trimmed}");
                }

                if (seen.Add(trimmed))
                {
                    selectedFields.Add(availableFields[trimmed].Name); // Use canonical name
                }
            }

            return (selectedFields.Count > 0 ? selectedFields.ToImmutableArray() : null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse properties: {Properties}", properties);
            return (null, "Invalid properties format.");
        }
    }

    private (ImmutableArray<OrderByClause>? OrderBy, string? ErrorMessage) ConvertSortBy(string? sortby, LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(sortby))
        {
            return (null, null);
        }

        try
        {
            var clauses = new List<OrderByClause>();
            var availableFields = layer.AttributeFields.ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);

            foreach (var item in sortby.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = item.Trim();
                if (string.IsNullOrEmpty(trimmed))
                {
                    continue;
                }

                var ascending = true;
                var fieldName = trimmed;

                // Handle +/- prefix
                if (trimmed.StartsWith('+') || trimmed.StartsWith('-'))
                {
                    ascending = trimmed.StartsWith('+');
                    fieldName = trimmed[1..].Trim();
                }
                else
                {
                    // Handle space-separated field and direction
                    var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    if (parts.Length > 1)
                    {
                        fieldName = parts[0];
                        if (parts[1].Equals("DESC", StringComparison.OrdinalIgnoreCase))
                        {
                            ascending = false;
                        }
                        else if (!parts[1].Equals("ASC", StringComparison.OrdinalIgnoreCase))
                        {
                            return (null, $"Invalid sort direction: {parts[1]}");
                        }
                    }
                }

                if (string.IsNullOrEmpty(fieldName))
                {
                    return (null, "Empty field name in sortby.");
                }

                // Check if field exists (allow system fields)
                FieldType? fieldType = null;
                if (availableFields.TryGetValue(fieldName, out var field))
                {
                    fieldType = field.Type;
                    fieldName = field.Name; // Use canonical name
                }
                else if (!IsSystemField(fieldName))
                {
                    return (null, $"Unknown sortby field: {fieldName}");
                }

                clauses.Add(new OrderByClause(fieldName, ascending, fieldType));
            }

            return (clauses.Count > 0 ? clauses.ToImmutableArray() : null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse sortby: {Sortby}", sortby);
            return (null, "Invalid sortby format.");
        }
    }

    private async Task<(QueryCrs? OutputCrs, CrsDefinition? CrsDefinition, string? ErrorMessage)> ConvertOutputCrsAsync(
        string? crs,
        LayerDefinition layer,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(crs))
        {
            return (null, null, null);
        }

        try
        {
            var supportedCrs = await OgcFeaturesUtilities.GetSupportedCrsDefinitionsAsync(layer, _crsRegistry, cancellationToken);
            if (!OgcFeaturesUtilities.TryResolveCrs(crs, supportedCrs, out var crsDefinition, out var crsError))
            {
                return (null, null, crsError);
            }

            var outputCrs = QueryCrs.Create(crsDefinition.Srid, crsDefinition.AxisOrder, crsDefinition.Uri);
            return (outputCrs, crsDefinition, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to resolve CRS: {Crs}", crs);
            return (null, null, "Invalid CRS.");
        }
    }

    private static FilterLanguage DetermineFilterLanguage(string? filterLang)
    {
        return filterLang?.ToLowerInvariant() switch
        {
            "cql2-text" => FilterLanguage.Cql2Text,
            "cql2-json" => FilterLanguage.Cql2Json,
            _ => FilterLanguage.Cql2Text // Default to CQL2 text for OGC API Features
        };
    }

    private static bool ShouldPreferStreaming(int limit)
    {
        return limit > 200;
    }

    private static bool ShouldEnableCache(OgcFeaturesQueryParameters parameters)
    {
        // Enable caching for most OGC API Features requests
        return true;
    }

    private static bool IsSystemField(string fieldName)
    {
        var systemFields = new[]
        {
            FieldNames.ObjectId,
            "object_id",
            "id",
            "created_at",
            "updated_at",
            "geometry"
        };

        return systemFields.Contains(fieldName, StringComparer.OrdinalIgnoreCase);
    }

