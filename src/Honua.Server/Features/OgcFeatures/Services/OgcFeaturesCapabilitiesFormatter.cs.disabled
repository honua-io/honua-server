using System.Collections.Immutable;
using System.Diagnostics;
using Honua.Core.Features.Metadata.Abstractions;
using Honua.Core.Features.Metadata.Domain;
using Honua.Server.Features.Infrastructure.Helpers;
using Honua.Server.Features.Ogc.Common;
using Honua.ServiceDefaults;

namespace Honua.Server.Features.OgcFeatures.Services;

/// <summary>
/// OGC API Features capabilities formatter that converts unified metadata to OGC API specifications.
/// Implements OpenAPI 3.0 generation and OGC API Features conformance declarations.
/// </summary>
internal sealed class OgcFeaturesCapabilitiesFormatter : IGlobalCapabilitiesFormatter<LandingPage>, IMultiFormatCapabilitiesFormatter<object>
{
    private readonly ILogger<OgcFeaturesCapabilitiesFormatter> _logger;

    public OgcFeaturesCapabilitiesFormatter(ILogger<OgcFeaturesCapabilitiesFormatter> logger)
    {
        _logger = logger;
    }

    public string Protocol => "OgcApiFeatures";

    public IReadOnlyList<string> SupportedMediaTypes => ["application/json", "text/html", "application/openapi+json;version=3.0"];

    public async Task<LandingPage> FormatServiceCapabilitiesAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "ogc_features.format_service_capabilities", ActivityKind.Internal);
        activity?.SetTag(HonuaTelemetry.Tags.Protocol, "OgcApiFeatures");
        activity?.SetTag("service.name", serviceMetadata.Identity.Name);

        OgcFeaturesLog.FormatCapabilitiesRequested(_logger, serviceMetadata.Identity.Name);

        try
        {
            var baseUrl = serviceMetadata.Links.BaseUrl;
            var basePath = $"{baseUrl}/ogc/features";

            var links = new List<Link>
            {
                // Self reference
                Link.Create(
                    href: basePath,
                    rel: RelationTypes.Self,
                    type: MediaTypes.Json,
                    title: "Landing page"),

                // Alternative formats
                Link.Create(
                    href: $"{basePath}?f=html",
                    rel: RelationTypes.Alternate,
                    type: MediaTypes.Html,
                    title: "Landing page as HTML"),

                // API definition
                Link.Create(
                    href: $"{baseUrl}/openapi.json",
                    rel: RelationTypes.ServiceDesc,
                    type: MediaTypes.OpenApi,
                    title: "API definition"),

                // Conformance declaration
                Link.Create(
                    href: $"{baseUrl}/ogc/features/conformance",
                    rel: RelationTypes.Conformance,
                    type: MediaTypes.Json,
                    title: "Conformance declaration"),

                // Collections for this service
                Link.Create(
                    href: $"{baseUrl}/ogc/features/collections",
                    rel: RelationTypes.Data,
                    type: MediaTypes.Json,
                    title: "Feature collections")
            };

            // Add service-specific collections
            foreach (var layer in serviceMetadata.Layers.Where(l => l.SpatialInfo.HasGeometry))
            {
                links.Add(Link.Create(
                    href: $"{baseUrl}/ogc/features/collections/{layer.Identity.Name}",
                    rel: RelationTypes.Child,
                    type: MediaTypes.Json,
                    title: layer.Identity.Title));
            }

            var landingPage = new LandingPage
            {
                Title = serviceMetadata.Identity.Title,
                Description = serviceMetadata.Identity.Description,
                Supports3d = serviceMetadata.Capabilities.Spatial.Supports3D,
                Links = links.ToImmutable()
            };

            OgcFeaturesLog.FormatCapabilitiesCompleted(_logger, serviceMetadata.Identity.Name);
            return landingPage;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            OgcFeaturesLog.FormatCapabilitiesFailed(_logger, serviceMetadata.Identity.Name, ex.Message, ex);
            throw;
        }
    }

    public async Task<LandingPage> FormatLayerCapabilitiesAsync(
        LayerMetadata layerMetadata,
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        // For OGC API Features, layer capabilities are typically presented as collection metadata
        return await FormatServiceCapabilitiesAsync(serviceMetadata, globalCapabilities, context, cancellationToken);
    }

    public async Task<LandingPage> FormatGlobalCapabilitiesAsync(
        GlobalCapabilities globalCapabilities,
        IReadOnlyList<ServiceMetadata> availableServices,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "ogc_features.format_global_capabilities", ActivityKind.Internal);
        activity?.SetTag(HonuaTelemetry.Tags.Protocol, "OgcApiFeatures");

        OgcFeaturesLog.FormatGlobalCapabilitiesRequested(_logger);

        try
        {
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var basePath = $"{baseUrl}/ogc/features";

            var links = new List<Link>
            {
                // Self reference
                Link.Create(
                    href: basePath,
                    rel: RelationTypes.Self,
                    type: MediaTypes.Json,
                    title: "Landing page"),

                // Alternative formats
                Link.Create(
                    href: $"{basePath}?f=html",
                    rel: RelationTypes.Alternate,
                    type: MediaTypes.Html,
                    title: "Landing page as HTML"),

                // API definition
                Link.Create(
                    href: $"{baseUrl}/openapi.json",
                    rel: RelationTypes.ServiceDesc,
                    type: MediaTypes.OpenApi,
                    title: "API definition"),

                // Conformance declaration
                Link.Create(
                    href: $"{baseUrl}/ogc/features/conformance",
                    rel: RelationTypes.Conformance,
                    type: MediaTypes.Json,
                    title: "Conformance declaration"),

                // Global collections
                Link.Create(
                    href: $"{baseUrl}/ogc/features/collections",
                    rel: RelationTypes.Data,
                    type: MediaTypes.Json,
                    title: "Feature collections")
            };

            // Add collections from all available services
            foreach (var service in availableServices.Where(IsOgcFeaturesEnabled))
            {
                foreach (var layer in service.Layers.Where(l => l.SpatialInfo.HasGeometry))
                {
                    links.Add(Link.Create(
                        href: $"{baseUrl}/ogc/features/collections/{layer.Identity.Name}",
                        rel: RelationTypes.Child,
                        type: MediaTypes.Json,
                        title: layer.Identity.Title));
                }
            }

            var landingPage = new LandingPage
            {
                Title = globalCapabilities.Server.Title,
                Description = globalCapabilities.Server.Description,
                Supports3d = globalCapabilities.Spatial.Supports3D,
                Links = links.ToImmutable()
            };

            OgcFeaturesLog.FormatGlobalCapabilitiesCompleted(_logger, landingPage.Links.Count);
            return landingPage;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            OgcFeaturesLog.FormatGlobalCapabilitiesFailed(_logger, ex.Message, ex);
            throw;
        }
    }

    public async Task<object> FormatCapabilitiesAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        string outputFormat,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        return outputFormat.ToLowerInvariant() switch
        {
            "json" or "application/json" => await FormatServiceCapabilitiesAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            "conformance" => await FormatConformanceDeclarationAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            "collections" => await FormatCollectionsAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            "openapi" or "openapi.json" => await FormatOpenApiAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            _ => throw new ArgumentException($"Unsupported output format: {outputFormat}", nameof(outputFormat))
        };
    }

    public IReadOnlyList<string> GetSupportedFormats()
    {
        return new[] { "json", "conformance", "collections", "openapi" };
    }

    public async Task<ConformanceDeclaration> FormatConformanceDeclarationAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "ogc_features.format_conformance", ActivityKind.Internal);

        OgcFeaturesLog.FormatConformanceRequested(_logger);

        try
        {
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var conformanceClasses = BuildConformanceClasses(serviceMetadata, globalCapabilities);

            var conformance = new ConformanceDeclaration
            {
                ConformsTo = conformanceClasses,
                Links = new[]
                {
                    Link.Create(
                        href: $"{baseUrl}/ogc/features/conformance",
                        rel: RelationTypes.Self,
                        type: MediaTypes.Json,
                        title: "Conformance declaration"),
                    Link.Create(
                        href: $"{baseUrl}/ogc/features/conformance?f=html",
                        rel: RelationTypes.Alternate,
                        type: MediaTypes.Html,
                        title: "Conformance declaration as HTML")
                }.ToImmutable()
            };

            OgcFeaturesLog.FormatConformanceCompleted(_logger, conformance.ConformsTo.Length);
            return conformance;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            OgcFeaturesLog.FormatConformanceFailed(_logger, ex.Message, ex);
            throw;
        }
    }

    public async Task<Collections> FormatCollectionsAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "ogc_features.format_collections", ActivityKind.Internal);

        OgcFeaturesLog.FormatCollectionsRequested(_logger, serviceMetadata.Identity.Name);

        try
        {
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var collections = new List<Collection>();

            foreach (var layerMetadata in serviceMetadata.Layers.Where(l => l.SpatialInfo.HasGeometry))
            {
                var collection = await FormatCollectionAsync(layerMetadata, baseUrl, cancellationToken);
                collections.Add(collection);
            }

            var collectionsResponse = new Collections
            {
                CollectionList = collections.ToImmutable(),
                Links = new[]
                {
                    Link.Create(
                        href: $"{baseUrl}/ogc/features/collections",
                        rel: RelationTypes.Self,
                        type: MediaTypes.Json,
                        title: "Feature collections"),
                    Link.Create(
                        href: $"{baseUrl}/ogc/features/collections?f=html",
                        rel: RelationTypes.Alternate,
                        type: MediaTypes.Html,
                        title: "Feature collections as HTML")
                }.ToImmutable()
            };

            OgcFeaturesLog.FormatCollectionsCompleted(_logger, serviceMetadata.Identity.Name, collections.Count);
            return collectionsResponse;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            OgcFeaturesLog.FormatCollectionsFailed(_logger, serviceMetadata.Identity.Name, ex.Message, ex);
            throw;
        }
    }

    public async Task<object> FormatOpenApiAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "ogc_features.format_openapi", ActivityKind.Internal);

        OgcFeaturesLog.FormatOpenApiRequested(_logger);

        try
        {
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);

            // Generate OpenAPI 3.0 specification
            var openApi = new
            {
                openapi = "3.0.3",
                info = new
                {
                    title = globalCapabilities.Server.Title,
                    description = globalCapabilities.Server.Description,
                    version = globalCapabilities.Server.Version,
                    contact = globalCapabilities.Server.Contact != null ? new
                    {
                        name = globalCapabilities.Server.Contact.Name,
                        email = globalCapabilities.Server.Contact.Email,
                        url = globalCapabilities.Server.Contact.Website
                    } : null,
                    license = globalCapabilities.Server.License != null ? new
                    {
                        name = globalCapabilities.Server.License,
                        url = DetermineLicenseUrl(globalCapabilities.Server.License)
                    } : null
                },
                servers = new[]
                {
                    new { url = baseUrl, description = "Production server" }
                },
                paths = await GenerateOpenApiPathsAsync(serviceMetadata, baseUrl, cancellationToken),
                components = GenerateOpenApiComponents(serviceMetadata, globalCapabilities)
            };

            OgcFeaturesLog.FormatOpenApiCompleted(_logger);
            return openApi;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            OgcFeaturesLog.FormatOpenApiFailed(_logger, ex.Message, ex);
            throw;
        }
    }

    private async Task<Collection> FormatCollectionAsync(LayerMetadata layerMetadata, string baseUrl, CancellationToken cancellationToken)
    {
        var layerName = layerMetadata.Identity.Name;

        var links = new List<Link>
        {
            Link.Create(
                href: $"{baseUrl}/ogc/features/collections/{layerName}",
                rel: RelationTypes.Self,
                type: MediaTypes.Json,
                title: "Collection metadata"),
            Link.Create(
                href: $"{baseUrl}/ogc/features/collections/{layerName}/items",
                rel: RelationTypes.Items,
                type: MediaTypes.GeoJson,
                title: "Features in the collection"),
            Link.Create(
                href: $"{baseUrl}/ogc/features/collections/{layerName}/queryables",
                rel: RelationTypes.Queryables,
                type: MediaTypes.Json,
                title: "Queryable properties")
        };

        // Add schema link if available
        links.Add(Link.Create(
            href: $"{baseUrl}/ogc/features/collections/{layerName}/schema",
            rel: RelationTypes.DescribedBy,
            type: MediaTypes.Json,
            title: "Collection schema"));

        var collection = new Collection
        {
            Id = layerName,
            Title = layerMetadata.Identity.Title,
            Description = layerMetadata.Identity.Description,
            Keywords = layerMetadata.Identity.Keywords.ToImmutable(),
            Links = links.ToImmutable(),
            Extent = FormatExtent(layerMetadata),
            ItemType = "feature",
            Crs = FormatCrs(layerMetadata.SpatialInfo.SpatialReference)
        };

        return collection;
    }

    private ImmutableArray<string> BuildConformanceClasses(ServiceMetadata serviceMetadata, GlobalCapabilities globalCapabilities)
    {
        var conformanceClasses = new List<string>
        {
            // OGC API Features Part 1 - Core
            "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/core",
            "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/oas30",
            "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/html",
            "http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/geojson"
        };

        // Add GML support if configured
        if (serviceMetadata.Capabilities.Formats.QueryFormats.Contains("GML", StringComparer.OrdinalIgnoreCase))
        {
            conformanceClasses.Add("http://www.opengis.net/spec/ogcapi-features-1/1.0/conf/gml-sf0");
        }

        // Add CRS support if multiple CRS are supported
        if (serviceMetadata.Capabilities.Spatial.SupportedSrs.Length > 1)
        {
            conformanceClasses.Add("http://www.opengis.net/spec/ogcapi-features-2/1.0/conf/crs");
        }

        // Add filtering support
        if (serviceMetadata.Capabilities.Query.Filter.SupportsWhere)
        {
            conformanceClasses.AddRange(new[]
            {
                "http://www.opengis.net/spec/ogcapi-features-3/1.0/conf/queryables",
                "http://www.opengis.net/spec/ogcapi-features-3/1.0/conf/filter",
                "http://www.opengis.net/spec/cql2/1.0/conf/cql2-text",
                "http://www.opengis.net/spec/cql2/1.0/conf/cql2-json",
                "http://www.opengis.net/spec/cql2/1.0/conf/basic-cql2"
            });
        }

        // Add spatial filtering if supported
        if (serviceMetadata.Capabilities.Query.Filter.SupportsGeometry)
        {
            conformanceClasses.Add("http://www.opengis.net/spec/cql2/1.0/conf/basic-spatial-operators");
        }

        // Add transaction support if editing is enabled
        if (serviceMetadata.Capabilities.Edit != null)
        {
            conformanceClasses.Add("http://www.opengis.net/spec/ogcapi-features-4/1.0/conf/create-replace-delete");
        }

        // Add common conformance classes
        conformanceClasses.AddRange(OgcConformanceUris.Common);

        return conformanceClasses.ToImmutableArray();
    }

    private static bool IsOgcFeaturesEnabled(ServiceMetadata serviceMetadata)
    {
        var enabledProtocols = serviceMetadata.Definition.Metadata?.EnabledProtocols;
        return enabledProtocols == null || enabledProtocols.Contains("OgcFeatures", StringComparer.OrdinalIgnoreCase);
    }

    private SpatialExtent? FormatExtent(LayerMetadata layerMetadata)
    {
        if (layerMetadata.SpatialInfo.Extent == null)
            return null;

        var extent = layerMetadata.SpatialInfo.Extent;
        return new SpatialExtent
        {
            Bbox = new[] { new[] { extent.MinX, extent.MinY, extent.MaxX, extent.MaxY } }.ToImmutableArray(),
            Crs = $"http://www.opengis.net/def/crs/EPSG/0/{extent.SpatialReference.Wkid}"
        };
    }

    private static string[] FormatCrs(SpatialReference spatialReference)
    {
        return new[] { $"http://www.opengis.net/def/crs/EPSG/0/{spatialReference.Wkid}" };
    }

    private async Task<object> GenerateOpenApiPathsAsync(ServiceMetadata serviceMetadata, string baseUrl, CancellationToken cancellationToken)
    {
        var paths = new Dictionary<string, object>
        {
            ["/ogc/features"] = GenerateLandingPagePath(),
            ["/ogc/features/conformance"] = GenerateConformancePath(),
            ["/ogc/features/collections"] = GenerateCollectionsPath()
        };

        foreach (var layer in serviceMetadata.Layers.Where(l => l.SpatialInfo.HasGeometry))
        {
            var collectionPath = $"/ogc/features/collections/{layer.Identity.Name}";
            var itemsPath = $"/ogc/features/collections/{layer.Identity.Name}/items";
            var itemPath = $"/ogc/features/collections/{layer.Identity.Name}/items/{{featureId}}";

            paths[collectionPath] = GenerateCollectionPath(layer);
            paths[itemsPath] = GenerateItemsPath(layer);
            paths[itemPath] = GenerateItemPath(layer);
        }

        return paths;
    }

    private object GenerateOpenApiComponents(ServiceMetadata serviceMetadata, GlobalCapabilities globalCapabilities)
    {
        return new
        {
            schemas = new Dictionary<string, object>
            {
                ["LandingPage"] = GenerateLandingPageSchema(),
                ["ConformanceDeclaration"] = GenerateConformanceSchema(),
                ["Collections"] = GenerateCollectionsSchema(),
                ["Collection"] = GenerateCollectionSchema(),
                ["FeatureCollectionGeoJSON"] = GenerateFeatureCollectionSchema(),
                ["Feature"] = GenerateFeatureSchema()
            },
            parameters = new Dictionary<string, object>
            {
                ["limit"] = new { name = "limit", @in = "query", required = false, schema = new { type = "integer", minimum = 1, maximum = 10000, @default = 10 } },
                ["offset"] = new { name = "offset", @in = "query", required = false, schema = new { type = "integer", minimum = 0, @default = 0 } },
                ["bbox"] = new { name = "bbox", @in = "query", required = false, schema = new { type = "array", items = new { type = "number" } } },
                ["datetime"] = new { name = "datetime", @in = "query", required = false, schema = new { type = "string" } },
                ["filter"] = new { name = "filter", @in = "query", required = false, schema = new { type = "string" } }
            },
            responses = new Dictionary<string, object>
            {
                ["ServerError"] = new { description = "A server error occurred", content = new { } },
                ["InvalidParameter"] = new { description = "A query parameter has an invalid value", content = new { } },
                ["NotFound"] = new { description = "The requested resource was not found", content = new { } }
            }
        };
    }

    // Helper methods for generating OpenAPI path definitions
    private object GenerateLandingPagePath()
    {
        return new
        {
            get = new
            {
                summary = "Landing page",
                description = "The landing page provides links to the API definition and other resources",
                operationId = "getLandingPage",
                tags = new[] { "Capabilities" },
                parameters = new[]
                {
                    new { name = "f", @in = "query", required = false, schema = new { type = "string", @enum = new[] { "json", "html" }, @default = "json" } }
                },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "The landing page", content = new { "application/json" = new { schema = new { @ref = "#/components/schemas/LandingPage" } } } }
                }
            }
        };
    }

    private object GenerateConformancePath()
    {
        return new
        {
            get = new
            {
                summary = "Conformance declaration",
                description = "A list of all conformance classes that the server conforms to",
                operationId = "getConformanceClasses",
                tags = new[] { "Capabilities" },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "The conformance declaration", content = new { "application/json" = new { schema = new { @ref = "#/components/schemas/ConformanceDeclaration" } } } }
                }
            }
        };
    }

    private object GenerateCollectionsPath()
    {
        return new
        {
            get = new
            {
                summary = "Feature collections",
                description = "The feature collections in the dataset",
                operationId = "getCollections",
                tags = new[] { "Capabilities" },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "The feature collections", content = new { "application/json" = new { schema = new { @ref = "#/components/schemas/Collections" } } } }
                }
            }
        };
    }

    private object GenerateCollectionPath(LayerMetadata layer)
    {
        return new
        {
            get = new
            {
                summary = $"Describe the {layer.Identity.Name} feature collection",
                description = layer.Identity.Description,
                operationId = $"getCollection{layer.Identity.Name}",
                tags = new[] { "Capabilities" },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "Collection metadata", content = new { "application/json" = new { schema = new { @ref = "#/components/schemas/Collection" } } } }
                }
            }
        };
    }

    private object GenerateItemsPath(LayerMetadata layer)
    {
        return new
        {
            get = new
            {
                summary = $"Get features from the {layer.Identity.Name} collection",
                description = $"Fetch features from the {layer.Identity.Name} collection",
                operationId = $"getFeatures{layer.Identity.Name}",
                tags = new[] { "Data" },
                parameters = new[]
                {
                    new { @ref = "#/components/parameters/limit" },
                    new { @ref = "#/components/parameters/offset" },
                    new { @ref = "#/components/parameters/bbox" },
                    new { @ref = "#/components/parameters/datetime" }
                },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "Feature collection", content = new { "application/geo+json" = new { schema = new { @ref = "#/components/schemas/FeatureCollectionGeoJSON" } } } }
                }
            }
        };
    }

    private object GenerateItemPath(LayerMetadata layer)
    {
        return new
        {
            get = new
            {
                summary = $"Get a feature from the {layer.Identity.Name} collection",
                description = $"Fetch a single feature from the {layer.Identity.Name} collection",
                operationId = $"getFeature{layer.Identity.Name}",
                tags = new[] { "Data" },
                parameters = new[]
                {
                    new { name = "featureId", @in = "path", required = true, schema = new { type = "string" } }
                },
                responses = new Dictionary<string, object>
                {
                    ["200"] = new { description = "Feature", content = new { "application/geo+json" = new { schema = new { @ref = "#/components/schemas/Feature" } } } },
                    ["404"] = new { @ref = "#/components/responses/NotFound" }
                }
            }
        };
    }

    // Helper methods for generating OpenAPI schemas
    private object GenerateLandingPageSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["title"] = new { type = "string" },
                ["description"] = new { type = "string" },
                ["links"] = new { type = "array", items = new { @ref = "#/components/schemas/Link" } }
            }
        };
    }

    private object GenerateConformanceSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["conformsTo"] = new { type = "array", items = new { type = "string" } }
            }
        };
    }

    private object GenerateCollectionsSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["collections"] = new { type = "array", items = new { @ref = "#/components/schemas/Collection" } },
                ["links"] = new { type = "array", items = new { @ref = "#/components/schemas/Link" } }
            }
        };
    }

    private object GenerateCollectionSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["id"] = new { type = "string" },
                ["title"] = new { type = "string" },
                ["description"] = new { type = "string" },
                ["links"] = new { type = "array", items = new { @ref = "#/components/schemas/Link" } },
                ["extent"] = new { @ref = "#/components/schemas/Extent" },
                ["itemType"] = new { type = "string" },
                ["crs"] = new { type = "array", items = new { type = "string" } }
            }
        };
    }

    private object GenerateFeatureCollectionSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["type"] = new { type = "string", @enum = new[] { "FeatureCollection" } },
                ["features"] = new { type = "array", items = new { @ref = "#/components/schemas/Feature" } },
                ["links"] = new { type = "array", items = new { @ref = "#/components/schemas/Link" } },
                ["numberMatched"] = new { type = "integer", minimum = 0 },
                ["numberReturned"] = new { type = "integer", minimum = 0 }
            }
        };
    }

    private object GenerateFeatureSchema()
    {
        return new
        {
            type = "object",
            properties = new Dictionary<string, object>
            {
                ["type"] = new { type = "string", @enum = new[] { "Feature" } },
                ["id"] = new { oneOf = new[] { new { type = "string" }, new { type = "integer" } } },
                ["geometry"] = new { @ref = "#/components/schemas/Geometry" },
                ["properties"] = new { type = "object" },
                ["links"] = new { type = "array", items = new { @ref = "#/components/schemas/Link" } }
            }
        };
    }

    private static string? DetermineLicenseUrl(string license)
    {
        return license switch
        {
            "MIT" => "https://opensource.org/licenses/MIT",
            "Apache-2.0" => "https://www.apache.org/licenses/LICENSE-2.0",
            "GPL-3.0" => "https://www.gnu.org/licenses/gpl-3.0.html",
            "BSD-3-Clause" => "https://opensource.org/licenses/BSD-3-Clause",
            "Elastic License 2.0" => "https://www.elastic.co/licensing/elastic-license",
            _ => null
        };
    }
}