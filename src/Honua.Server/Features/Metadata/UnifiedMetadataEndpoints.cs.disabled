    // Helper methods
    private static async Task<(ServiceMetadata?, GlobalCapabilities?)> GetUnifiedMetadataAsync(
        IMetadataProvider metadataProvider,
        IResourceValidator resourceValidator,
        string serviceId,
        HttpContext context)
    {
        var validationResult = await ValidateServiceAsync(resourceValidator, serviceId, context);
        if (!validationResult.IsValid)
        {
            return (null, null);
        }

        var service = validationResult.Service!;
        var baseUrl = BaseUrlResolver.GetBaseUrl(context);
        var options = MetadataProviderOptions.Fast(baseUrl);

        var serviceMetadata = await metadataProvider.GetServiceMetadataAsync(context, service, options);
        var globalCapabilities = await metadataProvider.GetGlobalCapabilitiesAsync(context, options);

        return (serviceMetadata, globalCapabilities);
    }

    private static async Task<ServiceValidationResult> ValidateServiceAsync(
        IResourceValidator resourceValidator,
        string serviceId,
        HttpContext context)
    {
        // This is a simplified validation - in real implementation, use proper validation helpers
        try
        {
            var layerCatalog = context.RequestServices.GetRequiredService<ILayerCatalog>();
            var services = await layerCatalog.ListServicesAsync();
            var service = services.FirstOrDefault(s => s.Name.Equals(serviceId, StringComparison.OrdinalIgnoreCase));

            if (service == null)
            {
                return new ServiceValidationResult
                {
                    IsValid = false,
                    ErrorResult = StandardErrorHelpers.CreateNotFound(context, $"Service '{serviceId}' not found")
                };
            }

            return new ServiceValidationResult
            {
                IsValid = true,
                Service = service
            };
        }
        catch (Exception)
        {
            return new ServiceValidationResult
            {
                IsValid = false,
                ErrorResult = StandardErrorHelpers.CreateInternalServerError(context, "Service validation failed")
            };
        }
    }

    private static async Task<ServiceLayerValidationResult> ValidateServiceLayerAsync(
        IResourceValidator resourceValidator,
        string serviceId,
        int layerId,
        HttpContext context)
    {
        var serviceResult = await ValidateServiceAsync(resourceValidator, serviceId, context);
        if (!serviceResult.IsValid)
        {
            return new ServiceLayerValidationResult
            {
                IsValid = false,
                ErrorResult = serviceResult.ErrorResult
            };
        }

        var service = serviceResult.Service!;
        var layer = service.GetLayer(layerId);

        if (layer == null)
        {
            return new ServiceLayerValidationResult
            {
                IsValid = false,
                ErrorResult = StandardErrorHelpers.CreateNotFound(context, $"Layer '{layerId}' not found in service '{serviceId}'")
            };
        }

        return new ServiceLayerValidationResult
        {
            IsValid = true,
            Service = service,
            Layer = layer
        };
    }

    private static string SerializeWfsCapabilities(WfsCapabilities capabilities)
    {
        // Simplified XML serialization for demonstration
        // In real implementation, use proper XML serialization with WFS schema
        return $@"<?xml version=""1.0"" encoding=""UTF-8""?>
<wfs:WFS_Capabilities version=""2.0.0"" xmlns:wfs=""http://www.opengis.net/wfs/2.0"">
  <ows:ServiceIdentification xmlns:ows=""http://www.opengis.net/ows/1.1"">
    <ows:Title>{capabilities.ServiceIdentification?.Title ?? "WFS Service"}</ows:Title>
    <ows:Abstract>{capabilities.ServiceIdentification?.Abstract ?? "WFS Service from unified metadata"}</ows:Abstract>
    <ows:ServiceType>WFS</ows:ServiceType>
    <ows:ServiceTypeVersion>2.0.0</ows:ServiceTypeVersion>
  </ows:ServiceIdentification>
  <ows:OperationsMetadata xmlns:ows=""http://www.opengis.net/ows/1.1"">
    <!-- Operations would be serialized here -->
  </ows:OperationsMetadata>
  <wfs:FeatureTypeList>
    <!-- Feature types would be serialized here -->
  </wfs:FeatureTypeList>
</wfs:WFS_Capabilities>";
    }

    private sealed record ServiceValidationResult
    {
        public bool IsValid { get; init; }
        public ServiceDefinition? Service { get; init; }
        public IResult? ErrorResult { get; init; }
    }

    private sealed record ServiceLayerValidationResult
    {
        public bool IsValid { get; init; }
        public ServiceDefinition? Service { get; init; }
        public LayerDefinition? Layer { get; init; }
        public IResult? ErrorResult { get; init; }
    }
}