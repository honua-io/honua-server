using Honua.Server.Features.OData.Services;
using Honua.ServiceDefaults;
using Microsoft.AspNetCore.Mvc;

namespace Honua.Server.Features.Metadata;

/// <summary>
/// Unified metadata endpoints that demonstrate the new metadata service unification.
/// Shows how protocol-specific formatters consume shared metadata from the unified provider.
/// </summary>
internal static class UnifiedMetadataEndpoints
{
    /// <summary>
    /// Maps unified metadata endpoints for demonstration and testing.
    /// </summary>
    public static IEndpointRouteBuilder MapUnifiedMetadataEndpoints(this IEndpointRouteBuilder endpoints)
    {
        var group = endpoints.MapGroup("/unified-metadata")
            .WithTags("Unified Metadata")
            .WithDisplayName("Unified Metadata System")
            .WithDescription("Demonstrates unified metadata generation with protocol-specific formatters");

        // Global capabilities endpoint
        group.MapGet("/capabilities", HandleGetGlobalCapabilities)
            .WithName("UnifiedGlobalCapabilities")
            .WithSummary("Get global server capabilities")
            .WithDescription("Unified global capabilities that can be formatted for any protocol")
            .Produces<GlobalCapabilities>(200, "application/json");

        // Service metadata endpoint
        group.MapGet("/services/{serviceId}", HandleGetServiceMetadata)
            .WithName("UnifiedServiceMetadata")
            .WithSummary("Get unified service metadata")
            .WithDescription("Service metadata that can be formatted for any protocol")
            .Produces<ServiceMetadata>(200, "application/json");

        // Layer metadata endpoint
        group.MapGet("/services/{serviceId}/layers/{layerId:int}", HandleGetLayerMetadata)
            .WithName("UnifiedLayerMetadata")
            .WithSummary("Get unified layer metadata")
            .WithDescription("Layer metadata that can be formatted for any protocol")
            .Produces<LayerMetadata>(200, "application/json");

        // Protocol-specific formatted capabilities
        group.MapGet("/services/{serviceId}/wfs-capabilities", HandleGetWfsCapabilities)
            .WithName("UnifiedWfsCapabilities")
            .WithSummary("Get WFS 2.0 capabilities from unified metadata")
            .WithDescription("Demonstrates WFS 2.0 formatting of unified metadata")
            .Produces<WfsCapabilities>(200, "application/xml");

        group.MapGet("/services/{serviceId}/featureserver-capabilities", HandleGetFeatureServerCapabilities)
            .WithName("UnifiedFeatureServerCapabilities")
            .WithSummary("Get FeatureServer capabilities from unified metadata")
            .WithDescription("Demonstrates FeatureServer formatting of unified metadata")
            .Produces<FeatureServerResponse>(200, "application/json");

        group.MapGet("/services/{serviceId}/ogc-features-capabilities", HandleGetOgcFeaturesCapabilities)
            .WithName("UnifiedOgcFeaturesCapabilities")
            .WithSummary("Get OGC API Features capabilities from unified metadata")
            .WithDescription("Demonstrates OGC API Features formatting of unified metadata")
            .Produces<LandingPage>(200, "application/json");

        group.MapGet("/services/{serviceId}/odata-capabilities", HandleGetODataCapabilities)
            .WithName("UnifiedODataCapabilities")
            .WithSummary("Get OData service document from unified metadata")
            .WithDescription("Demonstrates OData formatting of unified metadata")
            .Produces<ServiceDocument>(200, "application/json");

        return endpoints;
    }

    private static async Task<IResult> HandleGetGlobalCapabilities(
        HttpContext context,
        [FromServices] IMetadataProvider metadataProvider)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity("unified_metadata.get_global_capabilities");

        try
        {
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var options = MetadataProviderOptions.Fast(baseUrl);

            var capabilities = await metadataProvider.GetGlobalCapabilitiesAsync(context, options);

            return Results.Json(capabilities, options: new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            return StandardErrorHelpers.CreateInternalServerError(context, "Failed to get global capabilities");
        }
    }

    private static async Task<IResult> HandleGetServiceMetadata(
        HttpContext context,
        string serviceId,
        [FromServices] IMetadataProvider metadataProvider,
        [FromServices] IResourceValidator resourceValidator,
        [FromServices] ILogger<object> logger)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity("unified_metadata.get_service_metadata");
        activity?.SetTag("service.id", serviceId);

        try
        {
            // Validate and get service
            var validationResult = await ValidateServiceAsync(resourceValidator, serviceId, context);
            if (!validationResult.IsValid)
            {
                return validationResult.ErrorResult!;
            }

            var service = validationResult.Service!;
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var options = MetadataProviderOptions.Fast(baseUrl);

            var metadata = await metadataProvider.GetServiceMetadataAsync(context, service, options);

            logger.LogInformation("Generated unified metadata for service {ServiceId} with {LayerCount} layers",
                serviceId, metadata.Layers.Length);

            return Results.Json(metadata, options: new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            return StandardErrorHelpers.CreateInternalServerError(context, "Failed to get service metadata");
        }
    }

    private static async Task<IResult> HandleGetLayerMetadata(
        HttpContext context,
        string serviceId,
        int layerId,
        [FromServices] IMetadataProvider metadataProvider,
        [FromServices] IResourceValidator resourceValidator,
        [FromServices] ILogger<object> logger)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity("unified_metadata.get_layer_metadata");
        activity?.SetTag("service.id", serviceId);
        activity?.SetTag("layer.id", layerId);

        try
        {
            // Validate and get service and layer
            var validationResult = await ValidateServiceLayerAsync(resourceValidator, serviceId, layerId, context);
            if (!validationResult.IsValid)
            {
                return validationResult.ErrorResult!;
            }

            var service = validationResult.Service!;
            var layer = validationResult.Layer!;
            var baseUrl = BaseUrlResolver.GetBaseUrl(context);
            var options = MetadataProviderOptions.Comprehensive(baseUrl);

            var metadata = await metadataProvider.GetLayerMetadataAsync(context, service, layer, options);

            logger.LogInformation("Generated unified metadata for layer {ServiceId}/{LayerId} ({LayerName})",
                serviceId, layerId, layer.Name);

            return Results.Json(metadata, options: new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            return StandardErrorHelpers.CreateInternalServerError(context, "Failed to get layer metadata");
        }
    }

    private static async Task<IResult> HandleGetWfsCapabilities(
        HttpContext context,
        string serviceId,
        [FromServices] IMetadataProvider metadataProvider,
        [FromServices] Wfs20CapabilitiesFormatter wfsFormatter,
        [FromServices] IResourceValidator resourceValidator)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity("unified_metadata.get_wfs_capabilities");
        activity?.SetTag("service.id", serviceId);

        try
        {
            // Get unified metadata
            var (serviceMetadata, globalCapabilities) = await GetUnifiedMetadataAsync(
                metadataProvider, resourceValidator, serviceId, context);

            if (serviceMetadata == null || globalCapabilities == null)
            {
                return StandardErrorHelpers.CreateNotFound(context, "Service not found");
            }

            // Format using WFS formatter
            var wfsCapabilities = await wfsFormatter.FormatServiceCapabilitiesAsync(
                serviceMetadata, globalCapabilities, context);

            return Results.Content(
                SerializeWfsCapabilities(wfsCapabilities),
                "application/xml",
                System.Text.Encoding.UTF8);
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            return StandardErrorHelpers.CreateInternalServerError(context, "Failed to get WFS capabilities");
        }
    }

