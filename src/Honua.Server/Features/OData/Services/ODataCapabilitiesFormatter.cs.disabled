using System.Diagnostics;
using System.Xml;
using System.Xml.Linq;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Metadata.Abstractions;
using Honua.Core.Features.Metadata.Domain;
using Honua.Server.Features.OData.Models;
using Honua.ServiceDefaults;

namespace Honua.Server.Features.OData.Services;

/// <summary>
/// OData capabilities formatter that converts unified metadata to OData service documents and metadata documents.
/// Implements OData 4.0 compatible metadata generation.
/// </summary>
internal sealed class ODataCapabilitiesFormatter : IGlobalCapabilitiesFormatter<ServiceDocument>, IMultiFormatCapabilitiesFormatter<object>
{
    private readonly ILogger<ODataCapabilitiesFormatter> _logger;

    public ODataCapabilitiesFormatter(ILogger<ODataCapabilitiesFormatter> logger)
    {
        _logger = logger;
    }

    public string Protocol => "OData";

    public IReadOnlyList<string> SupportedMediaTypes => ["application/json", "application/xml"];

    public async Task<ServiceDocument> FormatServiceCapabilitiesAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "odata.format_service_capabilities", ActivityKind.Internal);
        activity?.SetTag(HonuaTelemetry.Tags.Protocol, "OData");
        activity?.SetTag("service.name", serviceMetadata.Identity.Name);

        ODataLog.FormatCapabilitiesRequested(_logger, serviceMetadata.Identity.Name);

        try
        {
            var baseUrl = serviceMetadata.Links.BaseUrl;
            var context = $"{baseUrl}/odata/$metadata";

            var entitySets = new List<EntitySet>();

            foreach (var layer in serviceMetadata.Layers)
            {
                var entitySet = new EntitySet
                {
                    Name = layer.Identity.Name,
                    Url = layer.Identity.Name
                };
                entitySets.Add(entitySet);
            }

            var serviceDocument = new ServiceDocument
            {
                Context = context,
                Value = entitySets.ToArray()
            };

            ODataLog.FormatCapabilitiesCompleted(_logger, serviceMetadata.Identity.Name, entitySets.Count);
            return serviceDocument;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            ODataLog.FormatCapabilitiesFailed(_logger, serviceMetadata.Identity.Name, ex.Message, ex);
            throw;
        }
    }

    public async Task<ServiceDocument> FormatLayerCapabilitiesAsync(
        LayerMetadata layerMetadata,
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        // For OData, layer capabilities are part of service capabilities
        return await FormatServiceCapabilitiesAsync(serviceMetadata, globalCapabilities, context, cancellationToken);
    }

    public async Task<ServiceDocument> FormatGlobalCapabilitiesAsync(
        GlobalCapabilities globalCapabilities,
        IReadOnlyList<ServiceMetadata> availableServices,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "odata.format_global_capabilities", ActivityKind.Internal);
        activity?.SetTag(HonuaTelemetry.Tags.Protocol, "OData");

        ODataLog.FormatGlobalCapabilitiesRequested(_logger);

        try
        {
            var baseUrl = context.Request.Scheme + "://" + context.Request.Host;
            var odataContext = $"{baseUrl}/odata/$metadata";

            var entitySets = new List<EntitySet>();

            foreach (var service in availableServices.Where(IsODataEnabled))
            {
                foreach (var layer in service.Layers)
                {
                    var entitySet = new EntitySet
                    {
                        Name = layer.Identity.Name,
                        Url = layer.Identity.Name
                    };
                    entitySets.Add(entitySet);
                }
            }

            var serviceDocument = new ServiceDocument
            {
                Context = odataContext,
                Value = entitySets.ToArray()
            };

            ODataLog.FormatGlobalCapabilitiesCompleted(_logger, entitySets.Count);
            return serviceDocument;
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            ODataLog.FormatGlobalCapabilitiesFailed(_logger, ex.Message, ex);
            throw;
        }
    }

    public async Task<object> FormatCapabilitiesAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        string outputFormat,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        return outputFormat.ToLowerInvariant() switch
        {
            "json" or "application/json" => await FormatServiceCapabilitiesAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            "metadata" or "$metadata" => await FormatMetadataDocumentAsync(serviceMetadata, globalCapabilities, context, cancellationToken),
            _ => throw new ArgumentException($"Unsupported output format: {outputFormat}", nameof(outputFormat))
        };
    }

    public IReadOnlyList<string> GetSupportedFormats()
    {
        return new[] { "json", "metadata" };
    }

    public async Task<string> FormatMetadataDocumentAsync(
        ServiceMetadata serviceMetadata,
        GlobalCapabilities globalCapabilities,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "odata.format_metadata_document", ActivityKind.Internal);

        ODataLog.FormatMetadataRequested(_logger, serviceMetadata.Identity.Name);

        try
        {
            var baseUrl = serviceMetadata.Links.BaseUrl;
            var xmlDoc = GenerateMetadataDocument(serviceMetadata, globalCapabilities, baseUrl);

            ODataLog.FormatMetadataCompleted(_logger, serviceMetadata.Identity.Name);
            return xmlDoc.ToString();
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            ODataLog.FormatMetadataFailed(_logger, serviceMetadata.Identity.Name, ex.Message, ex);
            throw;
        }
    }

    public async Task<string> FormatGlobalMetadataDocumentAsync(
        GlobalCapabilities globalCapabilities,
        IReadOnlyList<ServiceMetadata> availableServices,
        HttpContext context,
        CancellationToken cancellationToken = default)
    {
        using var activity = HonuaTelemetry.ActivitySource.StartActivity(
            "odata.format_global_metadata_document", ActivityKind.Internal);

        ODataLog.FormatGlobalMetadataRequested(_logger);

        try
        {
            var baseUrl = context.Request.Scheme + "://" + context.Request.Host;
            var xmlDoc = GenerateGlobalMetadataDocument(globalCapabilities, availableServices, baseUrl);

            ODataLog.FormatGlobalMetadataCompleted(_logger);
            return xmlDoc.ToString();
        }
        catch (Exception ex)
        {
            activity?.SetTag(HonuaTelemetry.Tags.Error, "true");
            activity?.SetTag(HonuaTelemetry.Tags.ErrorMessage, ex.Message);

            ODataLog.FormatGlobalMetadataFailed(_logger, ex.Message, ex);
            throw;
        }
    }

    private XDocument GenerateMetadataDocument(ServiceMetadata serviceMetadata, GlobalCapabilities globalCapabilities, string baseUrl)
    {
        var edmx = XNamespace.Get("http://docs.oasis-open.org/odata/ns/edmx");
        var edm = XNamespace.Get("http://docs.oasis-open.org/odata/ns/edm");

        var dataServices = new XElement(edmx + "DataServices");
        var schema = new XElement(edm + "Schema",
            new XAttribute("Namespace", "Honua.Model"),
            new XAttribute("xmlns", edm));

        var entityContainer = new XElement(edm + "EntityContainer",
            new XAttribute("Name", "Container"));

        // Generate entity types and entity sets for each layer
        foreach (var layer in serviceMetadata.Layers)
        {
            var entityType = GenerateEntityType(layer, edm);
            schema.Add(entityType);

            var entitySet = new XElement(edm + "EntitySet",
                new XAttribute("Name", layer.Identity.Name),
                new XAttribute("EntityType", $"Honua.Model.{SanitizeTypeName(layer.Identity.Name)}"));

            entityContainer.Add(entitySet);
        }

        schema.Add(entityContainer);
        dataServices.Add(schema);

        var edmxDoc = new XDocument(
            new XElement(edmx + "Edmx",
                new XAttribute("Version", "4.0"),
                dataServices));

        return edmxDoc;
    }

    private XDocument GenerateGlobalMetadataDocument(GlobalCapabilities globalCapabilities, IReadOnlyList<ServiceMetadata> availableServices, string baseUrl)
    {
        var edmx = XNamespace.Get("http://docs.oasis-open.org/odata/ns/edmx");
        var edm = XNamespace.Get("http://docs.oasis-open.org/odata/ns/edm");

        var dataServices = new XElement(edmx + "DataServices");
        var schema = new XElement(edm + "Schema",
            new XAttribute("Namespace", "Honua.Model"),
            new XAttribute("xmlns", edm));

        var entityContainer = new XElement(edm + "EntityContainer",
            new XAttribute("Name", "Container"));

        var processedTypes = new HashSet<string>();

        // Generate entity types and entity sets for all layers across all services
        foreach (var service in availableServices.Where(IsODataEnabled))
        {
            foreach (var layer in service.Layers)
            {
                var typeName = SanitizeTypeName(layer.Identity.Name);

                // Avoid duplicate type definitions
                if (!processedTypes.Contains(typeName))
                {
                    var entityType = GenerateEntityType(layer, edm);
                    schema.Add(entityType);
                    processedTypes.Add(typeName);
                }

                var entitySet = new XElement(edm + "EntitySet",
                    new XAttribute("Name", layer.Identity.Name),
                    new XAttribute("EntityType", $"Honua.Model.{typeName}"));

                entityContainer.Add(entitySet);
            }
        }

        schema.Add(entityContainer);
        dataServices.Add(schema);

        var edmxDoc = new XDocument(
            new XElement(edmx + "Edmx",
                new XAttribute("Version", "4.0"),
                dataServices));

        return edmxDoc;
    }

    private XElement GenerateEntityType(LayerMetadata layer, XNamespace edm)
    {
        var typeName = SanitizeTypeName(layer.Identity.Name);
        var entityType = new XElement(edm + "EntityType",
            new XAttribute("Name", typeName));

        // Find the key field (object ID)
        var keyField = layer.Fields.FirstOrDefault(f => f.Definition.Type == FieldType.ObjectId);
        if (keyField != null)
        {
            var key = new XElement(edm + "Key",
                new XElement(edm + "PropertyRef",
                    new XAttribute("Name", SanitizePropertyName(keyField.Definition.Name))));
            entityType.Add(key);
        }

        // Generate properties for each field
        foreach (var field in layer.Fields)
        {
            var property = GenerateProperty(field, edm);
            entityType.Add(property);
        }

        return entityType;
    }

    private XElement GenerateProperty(LayerFieldInfo field, XNamespace edm)
    {
        var propertyName = SanitizePropertyName(field.Definition.Name);
        var propertyType = MapFieldTypeToEdmType(field.Definition.Type);

        var property = new XElement(edm + "Property",
            new XAttribute("Name", propertyName),
            new XAttribute("Type", propertyType));

        // Add nullable attribute
        if (field.Definition.Nullable)
        {
            property.Add(new XAttribute("Nullable", "true"));
        }

        // Add max length for string fields
        if (field.Definition.Type == FieldType.String)
        {
            var maxLength = ExtractMaxLength(field) ?? 255;
            property.Add(new XAttribute("MaxLength", maxLength));
        }

        // Add precision and scale for numeric fields
        if (field.Definition.Type == FieldType.Double)
        {
            property.Add(new XAttribute("Precision", 15));
            property.Add(new XAttribute("Scale", 5));
        }

        return property;
    }

    private static string MapFieldTypeToEdmType(FieldType fieldType)
    {
        return fieldType switch
        {
            FieldType.ObjectId => "Edm.Int32",
            FieldType.String => "Edm.String",
            FieldType.Integer => "Edm.Int32",
            FieldType.BigInteger => "Edm.Int64",
            FieldType.Double => "Edm.Double",
            FieldType.Date => "Edm.DateTimeOffset",
            FieldType.Geometry => "Edm.GeometryPoint", // Default geometry type
            FieldType.Blob => "Edm.Binary",
            FieldType.Guid => "Edm.Guid",
            FieldType.GlobalId => "Edm.Guid",
            FieldType.Xml => "Edm.String",
            _ => "Edm.String"
        };
    }

    private static string SanitizeTypeName(string name)
    {
        // Remove invalid characters and ensure the name starts with a letter
        var sanitized = string.Concat(name.Where(c => char.IsLetterOrDigit(c) || c == '_'));
        if (sanitized.Length > 0 && char.IsDigit(sanitized[0]))
        {
            sanitized = "Type_" + sanitized;
        }
        return sanitized.Length > 0 ? sanitized : "Unknown";
    }

    private static string SanitizePropertyName(string name)
    {
        // Similar to type name sanitization but for properties
        var sanitized = string.Concat(name.Where(c => char.IsLetterOrDigit(c) || c == '_'));
        if (sanitized.Length > 0 && char.IsDigit(sanitized[0]))
        {
            sanitized = "Property_" + sanitized;
        }
        return sanitized.Length > 0 ? sanitized : "Unknown";
    }

    private static int? ExtractMaxLength(LayerFieldInfo field)
    {
        // Try to extract max length from field validation or default to 255 for strings
        return field.Validation?.MaxLength ?? (field.Definition.Type == FieldType.String ? 255 : null);
    }

    private static bool IsODataEnabled(ServiceMetadata serviceMetadata)
    {
        var enabledProtocols = serviceMetadata.Definition.Metadata?.EnabledProtocols;
        return enabledProtocols == null || enabledProtocols.Contains("OData", StringComparer.OrdinalIgnoreCase);
    }
}