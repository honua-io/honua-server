using System.Collections.Immutable;
using System.Globalization;
using Honua.Core.Features.Catalog.Domain;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Query;
using Honua.Core.Features.Shared.Models;
using Honua.Core.Queries.Filters;
using Microsoft.Extensions.Logging;

namespace Honua.Server.Features.Wfs20.Services;

/// <summary>
/// Parameters for WFS 2.0 query operations (GetFeature, etc.).
/// </summary>
public readonly record struct Wfs20QueryParameters
{
    public string? TypeNames { get; init; }
    public string? Filter { get; init; }
    public string? BBox { get; init; }
    public string? PropertyName { get; init; }
    public string? SortBy { get; init; }
    public string? Count { get; init; }
    public string? StartIndex { get; init; }
    public string? SrsName { get; init; }
    public string? OutputFormat { get; init; }
    public string? ResultType { get; init; }

    // For GetFeatureById stored query
    public string? FeatureId { get; init; }

    // Additional WFS parameters
    public string? FeatureVersion { get; init; }
    public string? MaxFeatures { get; init; }
    public string? Namespace { get; init; }
}

/// <summary>
/// Adapter that converts WFS 2.0 parameters to UnifiedQuery.
/// </summary>
public sealed class Wfs20QueryParameterAdapter : IQueryParameterAdapter<Wfs20QueryParameters>
{
    private readonly IFilterExpressionService _filterExpressionService;
    private readonly ILogger<Wfs20QueryParameterAdapter> _logger;

    public string ProtocolName => "WFS-2.0";

    public ProtocolLimits DefaultLimits => ProtocolLimits.Wfs20;

    public Wfs20QueryParameterAdapter(
        IFilterExpressionService filterExpressionService,
        ILogger<Wfs20QueryParameterAdapter> logger)
    {
        _filterExpressionService = filterExpressionService ?? throw new ArgumentNullException(nameof(filterExpressionService));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    public async Task<QueryAdapterResult> ConvertAsync(
        Wfs20QueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken = default)
    {
        try
        {
            // Handle GetFeatureById stored query
            if (!string.IsNullOrWhiteSpace(parameters.FeatureId))
            {
                return ConvertGetFeatureById(parameters, layer);
            }

            // Convert filter expression
            var filterResult = await ConvertFilterAsync(parameters, layer);
            if (filterResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(filterResult.ErrorMessage);
            }

            // Convert spatial filter (bbox)
            var spatialFilterResult = ConvertBboxFilter(parameters);
            if (spatialFilterResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(spatialFilterResult.ErrorMessage);
            }

            // Convert property selection
            var propertiesResult = ConvertPropertyName(parameters.PropertyName, layer);
            if (propertiesResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(propertiesResult.ErrorMessage);
            }

            // Convert pagination
            var paginationResult = ConvertPagination(parameters);
            if (paginationResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(paginationResult.ErrorMessage);
            }

            // Convert sorting
            var sortByResult = ConvertSortBy(parameters.SortBy, layer);
            if (sortByResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(sortByResult.ErrorMessage);
            }

            // Convert output CRS
            var outputCrsResult = ConvertOutputCrs(parameters.SrsName);
            if (outputCrsResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(outputCrsResult.ErrorMessage);
            }

            // Build query hints
            var hints = QueryHints.Create(
                preferStreaming: ShouldPreferStreaming(paginationResult.Limit),
                enableCaching: ShouldEnableCache(parameters),
                requireExactCount: !IsResultTypeHits(parameters.ResultType)
            );

            // Create unified query
            var unifiedQuery = new UnifiedQuery
            {
                Filter = filterResult.Filter,
                SpatialFilter = spatialFilterResult.SpatialFilter,
                OutFields = propertiesResult.Properties,
                Offset = paginationResult.Offset,
                Limit = paginationResult.Limit,
                OrderBy = sortByResult.OrderBy,
                OutputCrs = outputCrsResult.OutputCrs,
                Hints = hints
            };

            // Collect metadata for response formatting
            var metadata = new Dictionary<string, object>
            {
                ["outputFormat"] = parameters.OutputFormat ?? "application/gml+xml; version=3.2",
                ["resultType"] = parameters.ResultType ?? "results",
                ["typeNames"] = parameters.TypeNames ?? layer.Name
            };

            if (!string.IsNullOrWhiteSpace(parameters.FeatureVersion))
            {
                metadata["featureVersion"] = parameters.FeatureVersion;
            }

            return QueryAdapterResult.Success(unifiedQuery, metadata);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to convert WFS 2.0 query parameters");
            return QueryAdapterResult.Failure("Invalid WFS query parameters.");
        }
    }

    private QueryAdapterResult ConvertGetFeatureById(Wfs20QueryParameters parameters, LayerDefinition layer)
    {
        if (!long.TryParse(parameters.FeatureId, NumberStyles.Integer, CultureInfo.InvariantCulture, out var featureId))
        {
            return QueryAdapterResult.Failure($"Invalid feature ID: {parameters.FeatureId}");
        }

        var unifiedQuery = new UnifiedQuery
        {
            ObjectIds = ImmutableArray.Create(featureId),
            Limit = 1,
            Hints = QueryHints.Create(
                preferStreaming: false,
                enableCaching: true,
                requireExactCount: false
            )
        };

        var metadata = new Dictionary<string, object>
        {
            ["outputFormat"] = parameters.OutputFormat ?? "application/gml+xml; version=3.2",
            ["isGetFeatureById"] = true,
            ["featureId"] = parameters.FeatureId!
        };

        return QueryAdapterResult.Success(unifiedQuery, metadata);
    }

    private async Task<(QueryFilter? Filter, string? ErrorMessage)> ConvertFilterAsync(
        Wfs20QueryParameters parameters,
        LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(parameters.Filter))
        {
            return (null, null);
        }

        try
        {
            // WFS 2.0 uses FES (Filter Encoding Standard) which is similar to CQL2
            // For simplicity, we'll attempt to parse as CQL2 text first
            var parseResult = _filterExpressionService.Parse(FilterLanguage.Cql2Text, parameters.Filter);

            if (!parseResult.IsSuccess)
            {
                // Fallback: try to parse as raw SQL for simple cases
                _logger.LogWarning("Failed to parse WFS filter as CQL2, attempting fallback: {Filter}", parameters.Filter);
                return (null, parseResult.ErrorMessage ?? "Invalid filter expression.");
            }

            if (parseResult.Expression != null)
            {
                var source = new FilterSource(parameters.Filter, FilterLanguage.Cql2Text, ProtocolName);
                var filter = QueryFilter.FromExpression(parseResult.Expression, source);
                return (filter, null);
            }

            return (null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS filter: {Filter}", parameters.Filter);
            return (null, "Invalid filter expression.");
        }
    }

    private (SpatialFilter? SpatialFilter, string? ErrorMessage) ConvertBboxFilter(Wfs20QueryParameters parameters)
    {
        if (string.IsNullOrWhiteSpace(parameters.BBox))
        {
            return (null, null);
        }

        try
        {
            // Parse WFS bbox format: "minx,miny,maxx,maxy[,crs]"
            var parts = parameters.BBox.Split(',');
            if (parts.Length < 4 || parts.Length > 5)
            {
                return (null, "Invalid bbox format. Expected: minx,miny,maxx,maxy[,crs]");
            }

            if (!double.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var minX) ||
                !double.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var minY) ||
                !double.TryParse(parts[2], NumberStyles.Float, CultureInfo.InvariantCulture, out var maxX) ||
                !double.TryParse(parts[3], NumberStyles.Float, CultureInfo.InvariantCulture, out var maxY))
            {
                return (null, "Invalid bbox coordinates.");
            }

            // Extract CRS if provided
            int? srid = null;
            if (parts.Length == 5)
            {
                var crsStr = parts[4].Trim();
                if (!string.IsNullOrEmpty(crsStr))
                {
                    srid = ParseSrid(crsStr);
                }
            }

            // Create envelope geometry (simplified)
            var envelope = CreateEnvelopeWkb(minX, minY, maxX, maxY);
            var spatialFilter = SpatialFilter.Create(envelope, SpatialRelationship.Intersects, srid);

            return (spatialFilter, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS bbox: {BBox}", parameters.BBox);
            return (null, "Invalid bbox format.");
        }
    }

    private (ImmutableArray<string>? Properties, string? ErrorMessage) ConvertPropertyName(
        string? propertyName,
        LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(propertyName))
        {
            return (null, null); // Return all properties
        }

        try
        {
            var availableFields = layer.AttributeFields.ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);
            var selectedFields = new List<string>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            // WFS PropertyName can be comma-separated or space-separated
            var separators = new[] { ',', ' ' };
            foreach (var prop in propertyName.Split(separators, StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = prop.Trim();
                if (string.IsNullOrEmpty(trimmed))
                {
                    continue;
                }

                // Handle namespace prefixes (e.g., "app:property_name")
                var fieldName = trimmed;
                if (fieldName.Contains(':'))
                {
                    var colonIndex = fieldName.LastIndexOf(':');
                    fieldName = fieldName[(colonIndex + 1)..];
                }

                if (!availableFields.ContainsKey(fieldName))
                {
                    return (null, $"Unknown property: {trimmed}");
                }

                if (seen.Add(fieldName))
                {
                    selectedFields.Add(availableFields[fieldName].Name); // Use canonical name
                }
            }

            return (selectedFields.Count > 0 ? selectedFields.ToImmutableArray() : null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS PropertyName: {PropertyName}", propertyName);
            return (null, "Invalid PropertyName format.");
        }
    }

    private (int? Offset, int? Limit, string? ErrorMessage) ConvertPagination(Wfs20QueryParameters parameters)
    {
        try
        {
            int? offset = null;
            int? limit = null;

            // Parse startIndex
            if (!string.IsNullOrWhiteSpace(parameters.StartIndex))
            {
                if (!int.TryParse(parameters.StartIndex, NumberStyles.Integer, CultureInfo.InvariantCulture, out var startIndex) ||
                    startIndex < 0)
                {
                    return (null, null, "Invalid startIndex value.");
                }
                offset = startIndex;
            }

            // Parse count or maxFeatures
            var countStr = parameters.Count ?? parameters.MaxFeatures;
            if (!string.IsNullOrWhiteSpace(countStr))
            {
                if (!int.TryParse(countStr, NumberStyles.Integer, CultureInfo.InvariantCulture, out var count) ||
                    count <= 0)
                {
                    return (null, null, "Invalid count/maxFeatures value.");
                }
                limit = count;
            }

            return (offset, limit, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS pagination parameters");
            return (null, null, "Invalid pagination parameters.");
        }
    }

    private (ImmutableArray<OrderByClause>? OrderBy, string? ErrorMessage) ConvertSortBy(
        string? sortBy,
        LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(sortBy))
        {
            return (null, null);
        }

        try
        {
            // WFS SortBy format: "property1 A,property2 D" (A=Ascending, D=Descending)
            var clauses = new List<OrderByClause>();
            var availableFields = layer.AttributeFields.ToDictionary(f => f.Name, StringComparer.OrdinalIgnoreCase);

            foreach (var item in sortBy.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = item.Trim();
                if (string.IsNullOrEmpty(trimmed))
                {
                    continue;
                }

                var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length < 1 || parts.Length > 2)
                {
                    return (null, $"Invalid SortBy format: {trimmed}");
                }

                var fieldName = parts[0];
                var ascending = true;

                if (parts.Length == 2)
                {
                    var direction = parts[1].ToUpperInvariant();
                    if (direction == "D" || direction == "DESC")
                    {
                        ascending = false;
                    }
                    else if (direction != "A" && direction != "ASC")
                    {
                        return (null, $"Invalid sort direction: {parts[1]}");
                    }
                }

                // Handle namespace prefixes
                if (fieldName.Contains(':'))
                {
                    var colonIndex = fieldName.LastIndexOf(':');
                    fieldName = fieldName[(colonIndex + 1)..];
                }

                // Find field type
                FieldType? fieldType = null;
                if (availableFields.TryGetValue(fieldName, out var field))
                {
                    fieldType = field.Type;
                    fieldName = field.Name; // Use canonical name
                }
                else if (!IsSystemField(fieldName))
                {
                    return (null, $"Unknown SortBy field: {fieldName}");
                }

                clauses.Add(new OrderByClause(fieldName, ascending, fieldType));
            }

            return (clauses.Count > 0 ? clauses.ToImmutableArray() : null, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS SortBy: {SortBy}", sortBy);
            return (null, "Invalid SortBy format.");
        }
    }

    private (QueryCrs? OutputCrs, string? ErrorMessage) ConvertOutputCrs(string? srsName)
    {
        if (string.IsNullOrWhiteSpace(srsName))
        {
            return (null, null);
        }

        try
        {
            var srid = ParseSrid(srsName);
            if (!srid.HasValue)
            {
                return (null, $"Invalid or unsupported SRS: {srsName}");
            }

            var outputCrs = QueryCrs.Create(srid.Value, uri: srsName);
            return (outputCrs, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse WFS SRS: {SrsName}", srsName);
            return (null, "Invalid SRS format.");
        }
    }

    private static int? ParseSrid(string srsName)
    {
        if (string.IsNullOrWhiteSpace(srsName))
        {
            return null;
        }

        // Handle various SRID formats:
        // "EPSG:4326", "urn:ogc:def:crs:EPSG::4326", "http://www.opengis.net/def/crs/EPSG/0/4326"

        // Extract numeric SRID
        if (srsName.StartsWith("EPSG:", StringComparison.OrdinalIgnoreCase))
        {
            var sridStr = srsName[5..];
            if (int.TryParse(sridStr, out var srid))
            {
                return srid;
            }
        }
        else if (srsName.Contains("EPSG", StringComparison.OrdinalIgnoreCase))
        {
            // Handle URN or URL formats
            var parts = srsName.Split(':', '/', StringSplitOptions.RemoveEmptyEntries);
            for (int i = 0; i < parts.Length - 1; i++)
            {
                if (string.Equals(parts[i], "EPSG", StringComparison.OrdinalIgnoreCase))
                {
                    // Look for the numeric part after EPSG
                    for (int j = i + 1; j < parts.Length; j++)
                    {
                        if (int.TryParse(parts[j], out var srid) && srid > 0)
                        {
                            return srid;
                        }
                    }
                }
            }
        }

        return null;
    }

    private static bool IsResultTypeHits(string? resultType)
    {
        return string.Equals(resultType, "hits", StringComparison.OrdinalIgnoreCase);
    }

    private static bool ShouldPreferStreaming(int? limit)
    {
        return limit.HasValue && limit.Value > 200;
    }

    private static bool ShouldEnableCache(Wfs20QueryParameters parameters)
    {
        // Enable caching unless it's a hits-only query
        return !IsResultTypeHits(parameters.ResultType);
    }

    private static bool IsSystemField(string fieldName)
    {
        var systemFields = new[]
        {
            FieldNames.ObjectId,
            "object_id",
            "id",
            "fid",
            "gml_id",
            "created_at",
            "updated_at",
            "geometry"
        };

        return systemFields.Contains(fieldName, StringComparer.OrdinalIgnoreCase);
    }

