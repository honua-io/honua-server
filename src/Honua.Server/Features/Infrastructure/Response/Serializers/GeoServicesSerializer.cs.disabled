using System.Collections.Immutable;
using System.IO.Pipelines;
using System.Text.Json;
using Honua.Core.Features.Infrastructure.Response;
using Honua.Server.Features.FeatureServer.Models;
using Honua.Server.Features.FeatureServer.Services;
using Honua.Server.Features.Infrastructure.Services;

namespace Honua.Server.Features.Infrastructure.Response.Serializers;

/// <summary>
/// Serializes unified response data to GeoServices (ArcGIS REST) JSON format.
/// </summary>
internal sealed class GeoServicesSerializer : IProtocolSerializer<GeoServicesSerializationOptions>
{
    private readonly ILogger<GeoServicesSerializer> _logger;

    public GeoServicesSerializer(ILogger<GeoServicesSerializer> logger)
    {
        _logger = logger;
    }

    /// <inheritdoc />
    public string Protocol => "GeoServices";

    /// <inheritdoc />
    public ValueTask<SerializedResponse> SerializeAsync(
        ResponseData responseData,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(responseData);
        ArgumentNullException.ThrowIfNull(options);

        try
        {
            var result = responseData.Type switch
            {
                ResponseType.FeatureCollection => SerializeFeatureCollection(responseData, options),
                ResponseType.SingleFeature => SerializeSingleFeature(responseData, options),
                ResponseType.Error => SerializeError(responseData, options),
                _ => throw new NotSupportedException($"Response type {responseData.Type} is not supported")
            };

            var headers = GetHeaders(responseData, options);
            var statusCode = GetStatusCode(responseData);

            return ValueTask.FromResult(new SerializedResponse(
                result,
                GetContentType(responseData, options),
                headers,
                statusCode));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error serializing GeoServices response");
            throw;
        }
    }

    /// <inheritdoc />
    public async ValueTask<string> SerializeToStreamAsync(
        ResponseData responseData,
        PipeWriter outputStream,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(responseData);
        ArgumentNullException.ThrowIfNull(outputStream);
        ArgumentNullException.ThrowIfNull(options);

        using var writer = new Utf8JsonWriter(outputStream, new JsonWriterOptions
        {
            Indented = options.PrettyPrint,
            SkipValidation = false
        });

        switch (responseData.Type)
        {
            case ResponseType.FeatureCollection:
                await WriteFeatureCollectionAsync(writer, responseData, options, cancellationToken);
                break;

            case ResponseType.SingleFeature:
                await WriteSingleFeatureAsync(writer, responseData, options, cancellationToken);
                break;

            case ResponseType.Error:
                await WriteErrorAsync(writer, responseData, options, cancellationToken);
                break;

            default:
                throw new NotSupportedException($"Response type {responseData.Type} is not supported for streaming");
        }

        await writer.FlushAsync(cancellationToken);
        return GetContentType(responseData, options);
    }

    /// <inheritdoc />
    public async ValueTask<string> SerializeStreamingAsync(
        IAsyncEnumerable<StreamingResponseChunk> streamingResponse,
        PipeWriter outputStream,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(streamingResponse);
        ArgumentNullException.ThrowIfNull(outputStream);
        ArgumentNullException.ThrowIfNull(options);

        using var writer = new Utf8JsonWriter(outputStream, new JsonWriterOptions
        {
            Indented = options.PrettyPrint,
            SkipValidation = false
        });

        var headerWritten = false;
        var featureCount = 0;
        const int flushInterval = 32;

        await foreach (var chunk in streamingResponse.WithCancellation(cancellationToken))
        {
            switch (chunk.Type)
            {
                case StreamingChunkType.Header:
                    await WriteStreamingHeaderAsync(writer, chunk, options, cancellationToken);
                    headerWritten = true;
                    break;

                case StreamingChunkType.Feature when headerWritten:
                    await WriteStreamingFeatureAsync(writer, chunk, options, cancellationToken);
                    if (++featureCount % flushInterval == 0)
                    {
                        await writer.FlushAsync(cancellationToken);
                    }
                    break;

                case StreamingChunkType.Footer when headerWritten:
                    await WriteStreamingFooterAsync(writer, chunk, options, cancellationToken);
                    break;

                case StreamingChunkType.Error:
                    await WriteStreamingErrorAsync(writer, chunk, options, cancellationToken);
                    break;
            }
        }

        await writer.FlushAsync(cancellationToken);
        return "application/json";
    }

    /// <inheritdoc />
    public string GetContentType(ResponseData responseData, GeoServicesSerializationOptions options)
    {
        if (!string.IsNullOrEmpty(options.Callback))
        {
            return "application/javascript";
        }

        return "application/json";
    }

    /// <inheritdoc />
    public IReadOnlyDictionary<string, string> GetHeaders(ResponseData responseData, GeoServicesSerializationOptions options)
    {
        var headers = new Dictionary<string, string>();

        if (options.AdditionalHeaders != null)
        {
            foreach (var kvp in options.AdditionalHeaders)
            {
                headers[kvp.Key] = kvp.Value;
            }
        }

        return headers;
    }

    private object SerializeFeatureCollection(ResponseData responseData, GeoServicesSerializationOptions options)
    {
        var layer = responseData.Layer!;
        var features = responseData.Features.Select(rf => ConvertToGeoServicesFeature(rf, layer)).ToArray();
        var fields = BuildGeoServicesFields(layer, responseData);

        var response = new QueryResponse
        {
            ObjectIdFieldName = layer.ObjectIdFieldName,
            GeometryType = layer.HasGeometry ? MapGeometryType(layer.GeometryType) : null,
            SpatialReference = layer.HasGeometry ? new GeoServicesSpatialReference
            {
                Wkid = layer.SpatialReference.Wkid,
                LatestWkid = layer.SpatialReference.Wkid
            } : null,
            DisplayFieldName = DetermineDisplayFieldName(fields, layer.ObjectIdFieldName),
            Fields = options.IncludeFieldMetadata ? fields : null,
            HasZ = features.Any(f => f.Geometry?.HasZ == true),
            HasM = features.Any(f => f.Geometry?.HasM == true),
            Features = features,
            ExceededTransferLimit = responseData.Metadata.HasMoreResults
        };

        return WrapWithCallback(response, options.Callback);
    }

    private object SerializeSingleFeature(ResponseData responseData, GeoServicesSerializationOptions options)
    {
        var layer = responseData.Layer!;
        var feature = ConvertToGeoServicesFeature(responseData.Features.First(), layer);

        return WrapWithCallback(feature, options.Callback);
    }

    private object SerializeError(ResponseData responseData, GeoServicesSerializationOptions options)
    {
        var error = responseData.Error!;
        var geoServicesError = new
        {
            error = new
            {
                code = error.StatusCode,
                message = error.Message,
                details = error.AdditionalDetails?.ToArray()
            }
        };

        return WrapWithCallback(geoServicesError, options.Callback);
    }

    private GeoServicesFeature ConvertToGeoServicesFeature(ResponseFeature responseFeature, Core.Features.Catalog.Domain.LayerDefinition layer)
    {
        var geometry = responseFeature.Geometry != null
            ? ConvertResponseGeometryToGeoServices(responseFeature.Geometry)
            : null;

        var attributes = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

        // Add feature attributes
        foreach (var kvp in responseFeature.Attributes)
        {
            attributes[kvp.Key] = GeoServicesValueNormalizer.Normalize(kvp.Value);
        }

        // Add computed fields
        foreach (var kvp in responseFeature.ComputedFields)
        {
            attributes[kvp.Key] = GeoServicesValueNormalizer.Normalize(kvp.Value);
        }

        // Ensure object ID is present
        var objectIdField = layer.ObjectIdFieldName;
        if (!attributes.ContainsKey(objectIdField))
        {
            attributes[objectIdField] = responseFeature.Id;
        }

        return new GeoServicesFeature
        {
            Attributes = attributes,
            Geometry = geometry,
            IncludeGeometry = geometry != null
        };
    }

    private GeoServicesGeometry? ConvertResponseGeometryToGeoServices(ResponseGeometry responseGeometry)
    {
        if (responseGeometry.RawData == null)
            return null;

        // Check format cache first
        if (responseGeometry.FormatCache.TryGetValue("GeoServices", out var cached) &&
            cached is GeoServicesGeometry cachedGeometry)
        {
            return cachedGeometry;
        }

        // Convert from WKB
        return GeoServicesGeometryConverter.ConvertWkbToGeoServicesGeometry(
            responseGeometry.RawData,
            responseGeometry.Srid,
            new GeometryLimits(), // Use default limits as they were already applied
            responseGeometry.HasZ,
            responseGeometry.HasM);
    }

    private GeoServicesFieldInfo[] BuildGeoServicesFields(Core.Features.Catalog.Domain.LayerDefinition layer, ResponseData responseData)
    {
        var fields = layer.Fields
            .Where(f => !f.IsGeometry)
            .Select(f => new GeoServicesFieldInfo
            {
                Name = f.Name,
                Type = f.GeoServicesType,
                SqlType = f.SqlType,
                Alias = f.DisplayName,
                Length = f.Length,
                Nullable = f.Nullable,
                Editable = !f.IsGeometry,
                DefaultValue = f.DefaultValue
            })
            .ToList();

        // Ensure object ID field exists
        var objectIdField = layer.ObjectIdFieldName;
        if (!fields.Any(f => f.Name.Equals(objectIdField, StringComparison.OrdinalIgnoreCase)))
        {
            fields.Add(new GeoServicesFieldInfo
            {
                Name = objectIdField,
                Type = "esriFieldTypeOID",
                Alias = objectIdField,
                Nullable = false,
                Editable = false
            });
        }

        return fields.ToArray();
    }

    private string DetermineDisplayFieldName(GeoServicesFieldInfo[] fields, string objectIdFieldName)
    {
        // Look for common display field names
        var displayField = fields.FirstOrDefault(f =>
            f.Name.Equals("name", StringComparison.OrdinalIgnoreCase) ||
            f.Name.Equals("title", StringComparison.OrdinalIgnoreCase) ||
            f.Name.Equals("label", StringComparison.OrdinalIgnoreCase));

        if (displayField != null)
            return displayField.Name;

        // Fall back to first string field
        var stringField = fields.FirstOrDefault(f =>
            f.Type.Equals("esriFieldTypeString", StringComparison.OrdinalIgnoreCase));

        return stringField?.Name ?? objectIdFieldName;
    }

    private static string MapGeometryType(Core.Features.Catalog.Domain.GeometryType geometryType)
    {
        return geometryType switch
        {
            Core.Features.Catalog.Domain.GeometryType.Point => "esriGeometryPoint",
            Core.Features.Catalog.Domain.GeometryType.LineString => "esriGeometryPolyline",
            Core.Features.Catalog.Domain.GeometryType.Polygon => "esriGeometryPolygon",
            Core.Features.Catalog.Domain.GeometryType.MultiPoint => "esriGeometryMultipoint",
            Core.Features.Catalog.Domain.GeometryType.MultiLineString => "esriGeometryPolyline",
            Core.Features.Catalog.Domain.GeometryType.MultiPolygon => "esriGeometryPolygon",
            Core.Features.Catalog.Domain.GeometryType.GeometryCollection => "esriGeometryNull",
            _ => "esriGeometryPolygon"
        };
    }

    private static object WrapWithCallback(object data, string? callback)
    {
        if (string.IsNullOrEmpty(callback))
            return data;

        return new
        {
            callback,
            data
        };
    }

    private async Task WriteFeatureCollectionAsync(
        Utf8JsonWriter writer,
        ResponseData responseData,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        var serialized = SerializeFeatureCollection(responseData, options);
        JsonSerializer.Serialize(writer, serialized, FeatureServerJsonContext.Default.Object);
        await Task.CompletedTask;
    }

    private async Task WriteSingleFeatureAsync(
        Utf8JsonWriter writer,
        ResponseData responseData,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        var serialized = SerializeSingleFeature(responseData, options);
        JsonSerializer.Serialize(writer, serialized, FeatureServerJsonContext.Default.Object);
        await Task.CompletedTask;
    }

    private async Task WriteErrorAsync(
        Utf8JsonWriter writer,
        ResponseData responseData,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        var serialized = SerializeError(responseData, options);
        JsonSerializer.Serialize(writer, serialized, FeatureServerJsonContext.Default.Object);
        await Task.CompletedTask;
    }

    private async Task WriteStreamingHeaderAsync(
        Utf8JsonWriter writer,
        StreamingResponseChunk chunk,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        if (chunk.Metadata?.TryGetValue("Layer", out var layerObj) != true ||
            layerObj is not Core.Features.Catalog.Domain.LayerDefinition layer)
        {
            throw new InvalidOperationException("Layer information is required for streaming header");
        }

        writer.WriteStartObject();

        // Write basic metadata
        writer.WriteString("objectIdFieldName", layer.ObjectIdFieldName);
        writer.WriteString("geometryType", MapGeometryType(layer.GeometryType));

        if (layer.HasGeometry)
        {
            writer.WriteStartObject("spatialReference");
            writer.WriteNumber("wkid", layer.SpatialReference.Wkid);
            writer.WriteNumber("latestWkid", layer.SpatialReference.Wkid);
            writer.WriteEndObject();
        }

        // Write fields if requested
        if (options.IncludeFieldMetadata)
        {
            var fields = BuildGeoServicesFields(layer, new ResponseData { Layer = layer });
            writer.WritePropertyName("fields");
            JsonSerializer.Serialize(writer, fields, FeatureServerJsonContext.Default.GeoServicesFieldInfoArray);
        }

        // Start features array
        writer.WriteStartArray("features");

        await Task.CompletedTask;
    }

    private async Task WriteStreamingFeatureAsync(
        Utf8JsonWriter writer,
        StreamingResponseChunk chunk,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        if (chunk.Data is not ResponseFeature responseFeature ||
            chunk.Metadata?.TryGetValue("Layer", out var layerObj) != true ||
            layerObj is not Core.Features.Catalog.Domain.LayerDefinition layer)
        {
            throw new InvalidOperationException("Feature and layer information are required for streaming features");
        }

        var geoServicesFeature = ConvertToGeoServicesFeature(responseFeature, layer);
        JsonSerializer.Serialize(writer, geoServicesFeature, FeatureServerJsonContext.Default.GeoServicesFeature);

        await Task.CompletedTask;
    }

    private async Task WriteStreamingFooterAsync(
        Utf8JsonWriter writer,
        StreamingResponseChunk chunk,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        // End features array
        writer.WriteEndArray();

        // Write final metadata if available
        if (chunk.Data is ResponseMetadata metadata && metadata.HasMoreResults)
        {
            writer.WriteBoolean("exceededTransferLimit", true);
        }

        // End main object
        writer.WriteEndObject();

        await Task.CompletedTask;
    }

    private async Task WriteStreamingErrorAsync(
        Utf8JsonWriter writer,
        StreamingResponseChunk chunk,
        GeoServicesSerializationOptions options,
        CancellationToken cancellationToken)
    {
        if (chunk.Data is not ResponseError error)
        {
            error = ResponseError.InternalError("Unknown error occurred");
        }

        var geoServicesError = new
        {
            error = new
            {
                code = error.StatusCode,
                message = error.Message,
                details = error.AdditionalDetails?.ToArray()
            }
        };

        JsonSerializer.Serialize(writer, geoServicesError, FeatureServerJsonContext.Default.Object);

        await Task.CompletedTask;
    }

    private static int GetStatusCode(ResponseData responseData)
    {
        return responseData.Type switch
        {
            ResponseType.Error => responseData.Error?.StatusCode ?? 500,
            _ => 200
        };
    }
}