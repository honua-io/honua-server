using Honua.Core.Features.Catalog.Domain;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Infrastructure.Response;
using Honua.Core.Features.Shared.Models;
using Honua.Server.Features.FeatureServer.Services;
using Honua.Server.Features.OgcFeatures.Services;
using Honua.Server.Features.OData.Services;

namespace Honua.Server.Features.Infrastructure.Response;

/// <summary>
/// Helper class for migrating existing endpoints from protocol-specific formatters
/// to the unified response system. Provides backward-compatible methods that can
/// be used as drop-in replacements for existing formatting logic.
/// </summary>
internal static class LegacyResponseMigrationHelper
{
    /// <summary>
    /// Migrates from IQueryFormatter to unified response system for GeoServices.
    /// </summary>
    /// <param name="unifiedService">Unified response service</param>
    /// <param name="queryResult">Query result to format</param>
    /// <param name="layer">Layer definition</param>
    /// <param name="format">Requested format (json, geojson, etc.)</param>
    /// <param name="returnGeometry">Whether to include geometry</param>
    /// <param name="outputSrid">Output spatial reference ID</param>
    /// <param name="returnZ">Whether to include Z coordinates</param>
    /// <param name="returnM">Whether to include M coordinates</param>
    /// <param name="geometryPrecision">Coordinate precision</param>
    /// <param name="maxAllowableOffset">Generalization tolerance</param>
    /// <param name="outFields">Fields to include</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Formatted response result</returns>
    public static async ValueTask<IResult> FormatGeoServicesQueryResultAsync(
        IUnifiedResponseService unifiedService,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        string format,
        bool returnGeometry = true,
        int? outputSrid = null,
        bool returnZ = true,
        bool returnM = true,
        int? geometryPrecision = null,
        double? maxAllowableOffset = null,
        string[]? outFields = null,
        CancellationToken cancellationToken = default)
    {
        // Create build options matching legacy IQueryFormatter parameters
        var buildOptions = new ResponseBuildOptions
        {
            IncludeGeometry = returnGeometry,
            OutputSrid = outputSrid,
            IncludeZ = returnZ,
            IncludeM = returnM,
            GeometryPrecision = geometryPrecision,
            MaxAllowableOffset = maxAllowableOffset,
            OutFields = outFields
        };

        // Create serialization options
        var serializationOptions = new GeoServicesSerializationOptions
        {
            Format = format,
            IncludeFieldMetadata = true
        };

        // Route to appropriate format
        var protocol = format?.ToLowerInvariant() switch
        {
            "geojson" => "OGC API Features", // Use OGC API Features for GeoJSON
            _ => "GeoServices"
        };

        return await unifiedService.CreateFeatureCollectionResponseAsync(
            protocol, queryResult, layer, buildOptions, serializationOptions, cancellationToken);
    }

    /// <summary>
    /// Migrates from OgcResponseFormatter to unified response system.
    /// </summary>
    /// <param name="unifiedService">Unified response service</param>
    /// <param name="queryResult">Query result to format</param>
    /// <param name="layer">Layer definition</param>
    /// <param name="outputFormat">Requested output format</param>
    /// <param name="title">Response title</param>
    /// <param name="collectionId">Collection identifier</param>
    /// <param name="request">HTTP request context</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Formatted response result</returns>
    public static async ValueTask<IResult> FormatOgcApiFeaturesResponseAsync(
        IUnifiedResponseService unifiedService,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        string outputFormat,
        string title,
        string? collectionId = null,
        HttpRequest? request = null,
        CancellationToken cancellationToken = default)
    {
        // Create build options for OGC API Features
        var buildOptions = ResponseBuildOptions.ForOgcApiFeatures(
            includeGeometry: true,
            baseUrl: request != null ? $"{request.Scheme}://{request.Host}{request.PathBase}" : null);

        // Create serialization options
        var serializationOptions = new OgcApiFeaturesSerializationOptions
        {
            Format = outputFormat,
            CollectionId = collectionId,
            Request = request,
            IncludeBbox = true
        };

        return await unifiedService.CreateFeatureCollectionResponseAsync(
            "OGC API Features", queryResult, layer, buildOptions, serializationOptions, cancellationToken);
    }

    /// <summary>
    /// Migrates from ODataUtilityService response creation to unified response system.
    /// </summary>
    /// <param name="unifiedService">Unified response service</param>
    /// <param name="queryResult">Query result to format</param>
    /// <param name="layer">Layer definition</param>
    /// <param name="request">HTTP request context</param>
    /// <param name="format">Requested format</param>
    /// <param name="select">Selected fields</param>
    /// <param name="includeCount">Whether to include total count</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Formatted response result</returns>
    public static async ValueTask<IResult> CreateODataResponseAsync(
        IUnifiedResponseService unifiedService,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        HttpRequest request,
        string? format = null,
        string? select = null,
        bool includeCount = false,
        CancellationToken cancellationToken = default)
    {
        // Parse select fields
        var outFields = ODataUtilityService.ParseSelect(select);

        // Create build options for OData
        var buildOptions = ResponseBuildOptions.ForOData(
            includeGeometry: true,
            baseUrl: $"{request.Scheme}://{request.Host}{request.PathBase}",
            selectFields: outFields?.ToArray());

        // Create serialization options
        var serializationOptions = new ODataSerializationOptions
        {
            Format = format,
            Request = request,
            IncludeCount = includeCount,
            EntitySet = "Features",
            MetadataLevel = DetermineODataMetadataLevel(request, format)
        };

        return await unifiedService.CreateFeatureCollectionResponseAsync(
            "OData", queryResult, layer, buildOptions, serializationOptions, cancellationToken);
    }

    /// <summary>
    /// Migrates from WFS 2.0 GML serialization to unified response system.
    /// </summary>
    /// <param name="unifiedService">Unified response service</param>
    /// <param name="queryResult">Query result to format</param>
    /// <param name="layer">Layer definition</param>
    /// <param name="featureTypeName">WFS feature type name</param>
    /// <param name="namespaceUri">Target namespace URI</param>
    /// <param name="request">HTTP request context</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Formatted response result</returns>
    public static async ValueTask<IResult> CreateWfs20ResponseAsync(
        IUnifiedResponseService unifiedService,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        string? featureTypeName = null,
        string? namespaceUri = null,
        HttpRequest? request = null,
        CancellationToken cancellationToken = default)
    {
        // Create build options for WFS 2.0
        var buildOptions = ResponseBuildOptions.ForWfs20(
            includeGeometry: true,
            baseUrl: request != null ? $"{request.Scheme}://{request.Host}{request.PathBase}" : null);

        // Create serialization options
        var serializationOptions = new Wfs20SerializationOptions
        {
            FeatureTypeName = featureTypeName ?? layer.Name,
            NamespaceUri = namespaceUri ?? "http://honua.io/features",
            Request = request,
            IncludeSchemaLocation = true
        };

        return await unifiedService.CreateFeatureCollectionResponseAsync(
            "WFS 2.0", queryResult, layer, buildOptions, serializationOptions, cancellationToken);
    }

    /// <summary>
    /// Creates a unified error response that matches the protocol being used.
    /// </summary>
    /// <param name="unifiedService">Unified response service</param>
    /// <param name="protocol">Target protocol</param>
    /// <param name="statusCode">HTTP status code</param>
    /// <param name="message">Error message</param>
    /// <param name="detail">Additional error detail</param>
    /// <param name="request">HTTP request context</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Formatted error response result</returns>
    public static async ValueTask<IResult> CreateUnifiedErrorResponseAsync(
        IUnifiedResponseService unifiedService,
        string protocol,
        int statusCode,
        string message,
        string? detail = null,
        HttpRequest? request = null,
        CancellationToken cancellationToken = default)
    {
        var error = new ResponseError(statusCode, MapStatusCodeToErrorCode(statusCode), message, detail);

        // Create appropriate serialization options based on protocol
        object serializationOptions = protocol.ToLowerInvariant() switch
        {
            "geoservices" => new GeoServicesSerializationOptions { Request = request },
            "ogc api features" => new OgcApiFeaturesSerializationOptions { Request = request },
            "wfs 2.0" => new Wfs20SerializationOptions { Request = request },
            "odata" => new ODataSerializationOptions { Request = request },
            _ => new GeoServicesSerializationOptions { Request = request }
        };

        // Use reflection to call the generic method
        var method = typeof(IUnifiedResponseService).GetMethod(nameof(IUnifiedResponseService.CreateErrorResponseAsync));
        var genericMethod = method?.MakeGenericMethod(serializationOptions.GetType());

        if (genericMethod != null)
        {
            var task = (ValueTask<IResult>)genericMethod.Invoke(unifiedService, new[] { protocol, error, serializationOptions, cancellationToken })!;
            return await task;
        }

        // Fallback
        return Results.Json(new { error = new { code = statusCode, message } }, statusCode: statusCode);
    }

    private static string MapStatusCodeToErrorCode(int statusCode)
    {
        return statusCode switch
        {
            400 => "BadRequest",
            401 => "Unauthorized",
            403 => "Forbidden",
            404 => "NotFound",
            409 => "Conflict",
            422 => "UnprocessableEntity",
            500 => "InternalError",
            503 => "ServiceUnavailable",
            _ => "Error"
        };
    }

    private static string DetermineODataMetadataLevel(HttpRequest request, string? format)
    {
        // Check $format parameter
        if (format?.Contains("odata.metadata=", StringComparison.OrdinalIgnoreCase) == true)
        {
            var parts = format.Split(';');
            var metadataPart = parts.FirstOrDefault(p => p.Contains("odata.metadata=", StringComparison.OrdinalIgnoreCase));
            if (metadataPart != null)
            {
                var level = metadataPart.Split('=')[1].Trim();
                return level;
            }
        }

        // Check Accept header
        var acceptHeader = request.Headers.Accept.ToString();
        if (acceptHeader.Contains("odata.metadata=", StringComparison.OrdinalIgnoreCase))
        {
            // Extract metadata level from Accept header
            var segments = acceptHeader.Split(',', ';');
            var metadataSegment = segments.FirstOrDefault(s => s.Contains("odata.metadata=", StringComparison.OrdinalIgnoreCase));
            if (metadataSegment != null && metadataSegment.Contains('='))
            {
                var level = metadataSegment.Split('=')[1].Trim();
                return level;
            }
        }

        return "minimal"; // Default OData metadata level
    }
}

/// <summary>
/// Extension methods to make migration easier for existing endpoints.
/// </summary>
public static class UnifiedResponseServiceExtensions
{
    /// <summary>
    /// Creates a response using legacy GeoServices formatting parameters.
    /// </summary>
    public static ValueTask<IResult> CreateLegacyGeoServicesResponseAsync(
        this IUnifiedResponseService service,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        string format = "json",
        bool returnGeometry = true,
        int? outputSrid = null,
        string[]? outFields = null,
        CancellationToken cancellationToken = default)
    {
        return LegacyResponseMigrationHelper.FormatGeoServicesQueryResultAsync(
            service, queryResult, layer, format, returnGeometry, outputSrid,
            outFields: outFields, cancellationToken: cancellationToken);
    }

    /// <summary>
    /// Creates a response using legacy OGC API Features formatting parameters.
    /// </summary>
    public static ValueTask<IResult> CreateLegacyOgcApiFeaturesResponseAsync(
        this IUnifiedResponseService service,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        string outputFormat,
        string title,
        HttpRequest? request = null,
        CancellationToken cancellationToken = default)
    {
        return LegacyResponseMigrationHelper.FormatOgcApiFeaturesResponseAsync(
            service, queryResult, layer, outputFormat, title, request: request, cancellationToken: cancellationToken);
    }

    /// <summary>
    /// Creates a response using legacy OData formatting parameters.
    /// </summary>
    public static ValueTask<IResult> CreateLegacyODataResponseAsync(
        this IUnifiedResponseService service,
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        HttpRequest request,
        string? format = null,
        string? select = null,
        bool includeCount = false,
        CancellationToken cancellationToken = default)
    {
        return LegacyResponseMigrationHelper.CreateODataResponseAsync(
            service, queryResult, layer, request, format, select, includeCount, cancellationToken);
    }
}