using Honua.Core.Features.Infrastructure.Response;
using Honua.Server.Features.Infrastructure.Response.Serializers;

namespace Honua.Server.Features.Infrastructure.Response;

/// <summary>
/// Extension methods for registering unified response services in the DI container.
/// </summary>
internal static class ResponseServiceCollectionExtensions
{
    /// <summary>
    /// Adds unified response formatting services to the service collection.
    /// </summary>
    /// <param name="services">The service collection</param>
    /// <returns>The service collection for chaining</returns>
    public static IServiceCollection AddUnifiedResponseServices(this IServiceCollection services)
    {
        // Core response building services
        services.AddScoped<IResponseBuilder, ResponseBuilder>();
        services.AddSingleton<IProtocolSerializerRegistry, ProtocolSerializerRegistry>();
        services.AddScoped<IUnifiedResponseService, UnifiedResponseService>();

        // Protocol serializers
        services.AddScoped<GeoServicesSerializer>();
        services.AddScoped<OgcApiFeaturesSerializer>();
        services.AddScoped<Wfs20Serializer>();
        services.AddScoped<ODataSerializer>();

        return services;
    }

    /// <summary>
    /// Adds a custom protocol serializer to the service collection.
    /// </summary>
    /// <typeparam name="TSerializer">The serializer type</typeparam>
    /// <typeparam name="TOptions">The options type</typeparam>
    /// <param name="services">The service collection</param>
    /// <param name="lifetime">Service lifetime (defaults to Scoped)</param>
    /// <returns>The service collection for chaining</returns>
    public static IServiceCollection AddProtocolSerializer<TSerializer, TOptions>(
        this IServiceCollection services,
        ServiceLifetime lifetime = ServiceLifetime.Scoped)
        where TSerializer : class, IProtocolSerializer<TOptions>
        where TOptions : class
    {
        services.Add(new ServiceDescriptor(typeof(TSerializer), typeof(TSerializer), lifetime));
        return services;
    }

    /// <summary>
    /// Configures response formatting options for all protocols.
    /// </summary>
    /// <param name="services">The service collection</param>
    /// <param name="configure">Configuration action</param>
    /// <returns>The service collection for chaining</returns>
    public static IServiceCollection ConfigureResponseFormatting(
        this IServiceCollection services,
        Action<ResponseFormattingOptions> configure)
    {
        services.Configure(configure);
        return services;
    }
}

/// <summary>
/// Global options for response formatting across all protocols.
/// </summary>
public sealed class ResponseFormattingOptions
{
    /// <summary>
    /// Whether to enable performance metrics collection for response formatting.
    /// </summary>
    public bool EnableMetrics { get; set; } = true;

    /// <summary>
    /// Whether to enable caching of formatted geometry representations.
    /// </summary>
    public bool EnableGeometryFormatCache { get; set; } = true;

    /// <summary>
    /// Maximum size of the geometry format cache in MB.
    /// </summary>
    public int GeometryFormatCacheSizeMb { get; set; } = 100;

    /// <summary>
    /// Default streaming flush interval for all protocols.
    /// </summary>
    public int DefaultStreamingFlushInterval { get; set; } = 32;

    /// <summary>
    /// Whether to include debug information in responses when in Development environment.
    /// </summary>
    public bool IncludeDebugInfoInDevelopment { get; set; } = true;

    /// <summary>
    /// Default response timeout in seconds.
    /// </summary>
    public int DefaultTimeoutSeconds { get; set; } = 30;

    /// <summary>
    /// Protocol-specific configuration overrides.
    /// </summary>
    public Dictionary<string, ProtocolSpecificOptions> ProtocolOptions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
}

/// <summary>
/// Protocol-specific formatting options.
/// </summary>
public sealed class ProtocolSpecificOptions
{
    /// <summary>
    /// Whether this protocol is enabled.
    /// </summary>
    public bool Enabled { get; set; } = true;

    /// <summary>
    /// Custom streaming flush interval for this protocol.
    /// </summary>
    public int? StreamingFlushInterval { get; set; }

    /// <summary>
    /// Custom timeout for this protocol in seconds.
    /// </summary>
    public int? TimeoutSeconds { get; set; }

    /// <summary>
    /// Additional configuration properties specific to this protocol.
    /// </summary>
    public Dictionary<string, object?> Properties { get; set; } = new(StringComparer.OrdinalIgnoreCase);
}