using System.Collections.Concurrent;
using System.IO.Pipelines;
using Honua.Core.Features.Infrastructure.Response;
using Honua.Server.Features.Infrastructure.Response.Serializers;

namespace Honua.Server.Features.Infrastructure.Response;

/// <summary>
/// Registry for managing protocol-specific serializers.
/// Provides a centralized way to resolve and use the appropriate serializer for each protocol.
/// </summary>
internal sealed class ProtocolSerializerRegistry : IProtocolSerializerRegistry
{
    private readonly ConcurrentDictionary<string, object> _serializers = new(StringComparer.OrdinalIgnoreCase);
    private readonly IServiceProvider _serviceProvider;
    private readonly ILogger<ProtocolSerializerRegistry> _logger;

    public ProtocolSerializerRegistry(IServiceProvider serviceProvider, ILogger<ProtocolSerializerRegistry> logger)
    {
        _serviceProvider = serviceProvider;
        _logger = logger;
    }

    /// <inheritdoc />
    public TSerializer GetSerializer<TSerializer, TOptions>(string protocol)
        where TSerializer : class, IProtocolSerializer<TOptions>
        where TOptions : class
    {
        var key = $"{protocol}_{typeof(TSerializer).Name}";

        if (_serializers.TryGetValue(key, out var cached) && cached is TSerializer cachedSerializer)
        {
            return cachedSerializer;
        }

        var serializer = _serviceProvider.GetRequiredService<TSerializer>();
        _serializers[key] = serializer;

        _logger.LogDebug("Registered serializer {SerializerType} for protocol {Protocol}", typeof(TSerializer).Name, protocol);
        return serializer;
    }

    /// <inheritdoc />
    public async ValueTask<SerializedResponse> SerializeAsync<TOptions>(
        string protocol,
        ResponseData responseData,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class
    {
        var serializer = GetSerializerForProtocol<TOptions>(protocol);
        return await serializer.SerializeAsync(responseData, options, cancellationToken);
    }

    /// <inheritdoc />
    public async ValueTask<string> SerializeToStreamAsync<TOptions>(
        string protocol,
        ResponseData responseData,
        PipeWriter outputStream,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class
    {
        var serializer = GetSerializerForProtocol<TOptions>(protocol);
        return await serializer.SerializeToStreamAsync(responseData, outputStream, options, cancellationToken);
    }

    /// <inheritdoc />
    public async ValueTask<string> SerializeStreamingAsync<TOptions>(
        string protocol,
        IAsyncEnumerable<StreamingResponseChunk> streamingResponse,
        PipeWriter outputStream,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class
    {
        var serializer = GetSerializerForProtocol<TOptions>(protocol);
        return await serializer.SerializeStreamingAsync(streamingResponse, outputStream, options, cancellationToken);
    }

    /// <inheritdoc />
    public IReadOnlyList<string> GetSupportedProtocols()
    {
        return new[]
        {
            "GeoServices",
            "OGC API Features",
            "WFS 2.0",
            "OData"
        };
    }

    /// <inheritdoc />
    public string GetContentType<TOptions>(string protocol, ResponseData responseData, TOptions options)
        where TOptions : class
    {
        var serializer = GetSerializerForProtocol<TOptions>(protocol);
        return serializer.GetContentType(responseData, options);
    }

    /// <inheritdoc />
    public IReadOnlyDictionary<string, string> GetHeaders<TOptions>(
        string protocol,
        ResponseData responseData,
        TOptions options)
        where TOptions : class
    {
        var serializer = GetSerializerForProtocol<TOptions>(protocol);
        return serializer.GetHeaders(responseData, options);
    }

    /// <inheritdoc />
    public bool IsProtocolSupported(string protocol)
    {
        return GetSupportedProtocols().Contains(protocol, StringComparer.OrdinalIgnoreCase);
    }

    private IProtocolSerializer<TOptions> GetSerializerForProtocol<TOptions>(string protocol)
        where TOptions : class
    {
        return protocol.ToLowerInvariant() switch
        {
            "geoservices" => (IProtocolSerializer<TOptions>)GetSerializer<GeoServicesSerializer, GeoServicesSerializationOptions>("GeoServices"),
            "ogc api features" => (IProtocolSerializer<TOptions>)GetSerializer<OgcApiFeaturesSerializer, OgcApiFeaturesSerializationOptions>("OGC API Features"),
            "wfs 2.0" => (IProtocolSerializer<TOptions>)GetSerializer<Wfs20Serializer, Wfs20SerializationOptions>("WFS 2.0"),
            "odata" => (IProtocolSerializer<TOptions>)GetSerializer<ODataSerializer, ODataSerializationOptions>("OData"),
            _ => throw new NotSupportedException($"Protocol '{protocol}' is not supported")
        };
    }
}

/// <summary>
/// Interface for the protocol serializer registry.
/// </summary>
public interface IProtocolSerializerRegistry
{
    /// <summary>
    /// Gets a specific serializer for a protocol.
    /// </summary>
    /// <typeparam name="TSerializer">Type of serializer to retrieve</typeparam>
    /// <typeparam name="TOptions">Type of options the serializer accepts</typeparam>
    /// <param name="protocol">Protocol identifier</param>
    /// <returns>The requested serializer</returns>
    TSerializer GetSerializer<TSerializer, TOptions>(string protocol)
        where TSerializer : class, IProtocolSerializer<TOptions>
        where TOptions : class;

    /// <summary>
    /// Serializes response data using the appropriate protocol serializer.
    /// </summary>
    /// <typeparam name="TOptions">Type of serialization options</typeparam>
    /// <param name="protocol">Protocol to use for serialization</param>
    /// <param name="responseData">Data to serialize</param>
    /// <param name="options">Protocol-specific options</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Serialized response</returns>
    ValueTask<SerializedResponse> SerializeAsync<TOptions>(
        string protocol,
        ResponseData responseData,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class;

    /// <summary>
    /// Serializes response data to a stream using the appropriate protocol serializer.
    /// </summary>
    /// <typeparam name="TOptions">Type of serialization options</typeparam>
    /// <param name="protocol">Protocol to use for serialization</param>
    /// <param name="responseData">Data to serialize</param>
    /// <param name="outputStream">Target output stream</param>
    /// <param name="options">Protocol-specific options</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Content type of the serialized response</returns>
    ValueTask<string> SerializeToStreamAsync<TOptions>(
        string protocol,
        ResponseData responseData,
        PipeWriter outputStream,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class;

    /// <summary>
    /// Serializes streaming response data using the appropriate protocol serializer.
    /// </summary>
    /// <typeparam name="TOptions">Type of serialization options</typeparam>
    /// <param name="protocol">Protocol to use for serialization</param>
    /// <param name="streamingResponse">Streaming response data</param>
    /// <param name="outputStream">Target output stream</param>
    /// <param name="options">Protocol-specific options</param>
    /// <param name="cancellationToken">Cancellation token</param>
    /// <returns>Content type of the serialized response</returns>
    ValueTask<string> SerializeStreamingAsync<TOptions>(
        string protocol,
        IAsyncEnumerable<StreamingResponseChunk> streamingResponse,
        PipeWriter outputStream,
        TOptions options,
        CancellationToken cancellationToken = default)
        where TOptions : class;

    /// <summary>
    /// Gets all supported protocol identifiers.
    /// </summary>
    /// <returns>List of supported protocol names</returns>
    IReadOnlyList<string> GetSupportedProtocols();

    /// <summary>
    /// Gets the appropriate content type for a response in the specified protocol.
    /// </summary>
    /// <typeparam name="TOptions">Type of serialization options</typeparam>
    /// <param name="protocol">Protocol identifier</param>
    /// <param name="responseData">Response data to inspect</param>
    /// <param name="options">Protocol-specific options</param>
    /// <returns>MIME content type</returns>
    string GetContentType<TOptions>(string protocol, ResponseData responseData, TOptions options)
        where TOptions : class;

    /// <summary>
    /// Gets the appropriate HTTP headers for a response in the specified protocol.
    /// </summary>
    /// <typeparam name="TOptions">Type of serialization options</typeparam>
    /// <param name="protocol">Protocol identifier</param>
    /// <param name="responseData">Response data to inspect</param>
    /// <param name="options">Protocol-specific options</param>
    /// <returns>Dictionary of header names and values</returns>
    IReadOnlyDictionary<string, string> GetHeaders<TOptions>(
        string protocol,
        ResponseData responseData,
        TOptions options)
        where TOptions : class;

    /// <summary>
    /// Checks if a protocol is supported by this registry.
    /// </summary>
    /// <param name="protocol">Protocol identifier to check</param>
    /// <returns>True if the protocol is supported, false otherwise</returns>
    bool IsProtocolSupported(string protocol);
}