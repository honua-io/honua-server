using System.Collections.Immutable;
using Honua.Core.Configuration;
using Honua.Core.Features.Catalog.Domain;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Infrastructure.Response;
using Honua.Core.Features.Shared.Models;
using Honua.Server.Features.Infrastructure.Helpers;
using Honua.Server.Features.Infrastructure.Services;
using Microsoft.Extensions.Options;
using NetTopologySuite.Geometries;
using NetTopologySuite.IO;

namespace Honua.Server.Features.Infrastructure.Response;

/// <summary>
/// Implementation of unified response builder that prepares standardized response data
/// for protocol-specific serialization.
/// </summary>
internal sealed class ResponseBuilder : IResponseBuilder
{
    private readonly GeometryLimits _geometryLimits;
    private readonly ILogger<ResponseBuilder> _logger;

    public ResponseBuilder(IOptions<LimitsOptions> limitsOptions, ILogger<ResponseBuilder> logger)
    {
        _geometryLimits = limitsOptions?.Value?.Geometry ?? new GeometryLimits();
        _logger = logger;
    }

    /// <inheritdoc />
    public ValueTask<ResponseData> BuildFeatureCollectionAsync(
        QueryResult<Feature> queryResult,
        LayerDefinition layer,
        ResponseBuildOptions options,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(queryResult);
        ArgumentNullException.ThrowIfNull(layer);
        ArgumentNullException.ThrowIfNull(options);

        try
        {
            var effectiveLimits = CreateEffectiveLimits(options);
            var responseFeatures = ImmutableArray.CreateBuilder<ResponseFeature>(queryResult.Items.Length);

            foreach (var feature in queryResult.Items)
            {
                cancellationToken.ThrowIfCancellationRequested();

                var responseFeature = BuildResponseFeature(
                    feature,
                    layer,
                    options,
                    effectiveLimits);
                responseFeatures.Add(responseFeature);
            }

            var metadata = BuildResponseMetadata(queryResult, options);
            var pagination = BuildPaginationInfo(queryResult, options);
            var links = BuildResponseLinks(layer, options, pagination);

            var responseData = ResponseData.FeatureCollection(
                responseFeatures.ToImmutable(),
                layer,
                metadata,
                pagination,
                links,
                BuildProtocolMetadata(options));

            return ValueTask.FromResult(responseData);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error building feature collection response for layer {LayerId}", layer.Id);
            var errorResponse = ResponseData.Error(
                ResponseError.InternalError("Error building response", ex.Message));
            return ValueTask.FromResult(errorResponse);
        }
    }

    /// <inheritdoc />
    public ValueTask<ResponseData> BuildSingleFeatureAsync(
        Feature feature,
        LayerDefinition layer,
        ResponseBuildOptions options,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(feature);
        ArgumentNullException.ThrowIfNull(layer);
        ArgumentNullException.ThrowIfNull(options);

        try
        {
            cancellationToken.ThrowIfCancellationRequested();

            var effectiveLimits = CreateEffectiveLimits(options);
            var responseFeature = BuildResponseFeature(feature, layer, options, effectiveLimits);

            var metadata = new ResponseMetadata(
                TotalCount: 1,
                ReturnedCount: 1,
                HasMoreResults: false,
                Timestamp: DateTimeOffset.UtcNow);

            var links = BuildSingleFeatureLinks(layer, feature, options);

            var responseData = ResponseData.SingleFeature(
                responseFeature,
                layer,
                metadata,
                links,
                BuildProtocolMetadata(options));

            return ValueTask.FromResult(responseData);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error building single feature response for feature {FeatureId} in layer {LayerId}",
                feature.Id, layer.Id);
            var errorResponse = ResponseData.Error(
                ResponseError.InternalError("Error building response", ex.Message));
            return ValueTask.FromResult(errorResponse);
        }
    }

    /// <inheritdoc />
    public ResponseData BuildErrorResponse(ResponseError error, ResponseBuildOptions? options = null)
    {
        ArgumentNullException.ThrowIfNull(error);

        var metadata = new ResponseMetadata(
            Timestamp: DateTimeOffset.UtcNow,
            AdditionalMetadata: new Dictionary<string, object?>
            {
                ["ErrorCode"] = error.Code,
                ["StatusCode"] = error.StatusCode
            });

        return ResponseData.Error(
            error,
            metadata,
            BuildProtocolMetadata(options ?? new ResponseBuildOptions()));
    }

    /// <inheritdoc />
    public async IAsyncEnumerable<StreamingResponseChunk> BuildStreamingResponseAsync(
        IAsyncEnumerable<Feature> features,
        LayerDefinition layer,
        ResponseMetadata metadata,
        ResponseBuildOptions options,
        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(features);
        ArgumentNullException.ThrowIfNull(layer);
        ArgumentNullException.ThrowIfNull(metadata);
        ArgumentNullException.ThrowIfNull(options);

        var effectiveLimits = CreateEffectiveLimits(options);

        // Yield header chunk with metadata
        yield return new StreamingResponseChunk(
            StreamingChunkType.Header,
            metadata,
            new Dictionary<string, object?>
            {
                ["Layer"] = layer,
                ["Options"] = options,
                ["ProtocolMetadata"] = BuildProtocolMetadata(options)
            });

        // Stream features
        await foreach (var feature in features.WithCancellation(cancellationToken))
        {
            var responseFeature = BuildResponseFeature(feature, layer, options, effectiveLimits);
            yield return new StreamingResponseChunk(
                StreamingChunkType.Feature,
                responseFeature);
        }

        // Yield footer chunk
        yield return new StreamingResponseChunk(
            StreamingChunkType.Footer,
            new ResponseMetadata(
                Timestamp: DateTimeOffset.UtcNow,
                AdditionalMetadata: metadata.AdditionalMetadata));
    }

    private ResponseFeature BuildResponseFeature(
        Feature feature,
        LayerDefinition layer,
        ResponseBuildOptions options,
        GeometryLimits effectiveLimits)
    {
        var geometry = options.IncludeGeometry && feature.Geometry != null
            ? BuildResponseGeometry(feature.Geometry, layer, options, effectiveLimits)
            : null;

        var filteredAttributes = FilterAttributes(feature.Attributes, options, layer);
        var metadata = BuildFeatureMetadata(feature, options);

        return ResponseFeature.FromDomain(feature, geometry, metadata);
    }

    private ResponseGeometry? BuildResponseGeometry(
        byte[] wkbGeometry,
        LayerDefinition layer,
        ResponseBuildOptions options,
        GeometryLimits effectiveLimits)
    {
        try
        {
            var reader = WkbReaderCache.Get();
            var geometry = reader.Read(wkbGeometry);

            if (geometry == null || geometry.IsEmpty)
                return null;

            // Apply geometry processing
            geometry = GeometryOutputProcessor.ApplyLimits(geometry, effectiveLimits) ?? geometry;

            if (!options.IncludeZ || !options.IncludeM)
            {
                geometry = GeometryOutputProcessor.ApplyDimensionFilter(
                    geometry, options.IncludeZ, options.IncludeM);
            }

            // Create response geometry
            var envelope = BuildGeometryEnvelope(geometry);
            var processedWkb = new WKBWriter().Write(geometry);

            var responseGeometry = ResponseGeometry.FromWkb(
                processedWkb,
                geometry.GeometryType,
                options.OutputSrid ?? layer.SpatialReference.Wkid,
                HasZCoordinates(geometry),
                HasMCoordinates(geometry),
                envelope);

            return responseGeometry;
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to process geometry for feature, returning null");
            return null;
        }
    }

    private static GeometryEnvelope? BuildGeometryEnvelope(Geometry geometry)
    {
        if (geometry?.EnvelopeInternal is not { } envelope || envelope.IsNull)
            return null;

        return new GeometryEnvelope(
            envelope.MinX,
            envelope.MinY,
            envelope.MaxX,
            envelope.MaxY);
    }

    private static bool HasZCoordinates(Geometry geometry)
    {
        return geometry.CoordinateSequence?.Dimension > 2;
    }

    private static bool HasMCoordinates(Geometry geometry)
    {
        return geometry.CoordinateSequence?.Measures > 0;
    }

    private static ImmutableDictionary<string, object?> FilterAttributes(
        ImmutableDictionary<string, object?> attributes,
        ResponseBuildOptions options,
        LayerDefinition layer)
    {
        if (options.OutFields == null || options.OutFields.Length == 0 ||
            (options.OutFields.Length == 1 && options.OutFields[0] == "*"))
        {
            // Return all non-internal attributes
            return attributes.Where(kvp => !FeatureAttributeVisibility.IsInternalAttribute(kvp.Key))
                .ToImmutableDictionary(StringComparer.OrdinalIgnoreCase);
        }

        // Filter to requested fields
        var requestedFields = options.OutFields.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var filtered = ImmutableDictionary.CreateBuilder<string, object?>(StringComparer.OrdinalIgnoreCase);

        foreach (var kvp in attributes)
        {
            if (!FeatureAttributeVisibility.IsInternalAttribute(kvp.Key) &&
                requestedFields.Contains(kvp.Key))
            {
                filtered[kvp.Key] = kvp.Value;
            }
        }

        // Always include object ID field if it exists
        var objectIdField = layer.ObjectIdFieldName;
        if (!filtered.ContainsKey(objectIdField) && attributes.ContainsKey(objectIdField))
        {
            filtered[objectIdField] = attributes[objectIdField];
        }

        return filtered.ToImmutable();
    }

    private static ResponseMetadata BuildResponseMetadata(
        QueryResult<Feature> queryResult,
        ResponseBuildOptions options)
    {
        return new ResponseMetadata(
            TotalCount: queryResult.TotalCount,
            ReturnedCount: queryResult.Items.Length,
            HasMoreResults: queryResult.HasMoreResults,
            Timestamp: DateTimeOffset.UtcNow);
    }

    private static PaginationInfo? BuildPaginationInfo(
        QueryResult<Feature> queryResult,
        ResponseBuildOptions options)
    {
        if (!queryResult.HasMoreResults)
            return null;

        return new PaginationInfo(
            TotalEstimate: queryResult.TotalCount);
    }

    private static ImmutableArray<ResponseLink> BuildResponseLinks(
        LayerDefinition layer,
        ResponseBuildOptions options,
        PaginationInfo? pagination)
    {
        var links = ImmutableArray.CreateBuilder<ResponseLink>();

        if (options.BaseUrl != null)
        {
            // Self link
            var selfHref = pagination?.NextToken != null
                ? $"{options.BaseUrl}{options.RequestPath}?{BuildQueryString(options.QueryParameters)}"
                : $"{options.BaseUrl}{options.RequestPath}";

            links.Add(new ResponseLink("self", selfHref, "application/json"));

            // Next link for pagination
            if (pagination?.NextToken != null)
            {
                var nextParams = options.QueryParameters?.ToDictionary() ?? new Dictionary<string, string>();
                nextParams["token"] = pagination.NextToken;
                var nextHref = $"{options.BaseUrl}{options.RequestPath}?{BuildQueryString(nextParams)}";
                links.Add(new ResponseLink("next", nextHref, "application/json"));
            }
        }

        return links.ToImmutable();
    }

    private static ImmutableArray<ResponseLink> BuildSingleFeatureLinks(
        LayerDefinition layer,
        Feature feature,
        ResponseBuildOptions options)
    {
        var links = ImmutableArray.CreateBuilder<ResponseLink>();

        if (options.BaseUrl != null)
        {
            var selfHref = $"{options.BaseUrl}{options.RequestPath}";
            links.Add(new ResponseLink("self", selfHref, "application/json"));

            // Collection link
            var collectionHref = $"{options.BaseUrl}/collections/{layer.Name}/items";
            links.Add(new ResponseLink("collection", collectionHref, "application/json", "Feature Collection"));
        }

        return links.ToImmutable();
    }

    private static IReadOnlyDictionary<string, object?>? BuildFeatureMetadata(
        Feature feature,
        ResponseBuildOptions options)
    {
        var metadata = new Dictionary<string, object?>();

        // Add ETag if available
        if (feature.Attributes.TryGetValue("__etag", out var etag))
        {
            metadata["ETag"] = etag;
        }

        // Add last modified if available
        if (feature.Attributes.TryGetValue("__last_modified", out var lastModified))
        {
            metadata["LastModified"] = lastModified;
        }

        return metadata.Count > 0 ? metadata : null;
    }

    private static IReadOnlyDictionary<string, object?> BuildProtocolMetadata(ResponseBuildOptions options)
    {
        var metadata = new Dictionary<string, object?>
        {
            ["BuildTimestamp"] = DateTimeOffset.UtcNow
        };

        if (options.ProtocolOptions != null)
        {
            foreach (var kvp in options.ProtocolOptions)
            {
                metadata[kvp.Key] = kvp.Value;
            }
        }

        return metadata;
    }

    private GeometryLimits CreateEffectiveLimits(ResponseBuildOptions options)
    {
        return GeometryOutputProcessor.CreateEffectiveLimits(
            _geometryLimits,
            options.GeometryPrecision,
            options.MaxAllowableOffset,
            forceSimplify: options.MaxAllowableOffset > 0);
    }

    private static string BuildQueryString(IReadOnlyDictionary<string, string>? parameters)
    {
        if (parameters == null || parameters.Count == 0)
            return string.Empty;

        return string.Join("&", parameters.Select(kvp =>
            $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value)}"));
    }
}