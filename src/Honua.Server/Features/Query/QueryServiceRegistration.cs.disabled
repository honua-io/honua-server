using Honua.Core.Features.Query;
using Honua.Server.Features.FeatureServer.Models;
using Honua.Server.Features.FeatureServer.Services;
using Honua.Server.Features.OData.Services;
using Honua.Server.Features.OgcFeatures.Services;
using Honua.Server.Features.Wfs20.Services;

namespace Honua.Server.Features.Query;

/// <summary>
/// Extension methods for registering the unified query system and protocol adapters.
/// </summary>
public static class QueryServiceRegistration
{
    /// <summary>
    /// Registers the complete unified query system with all protocol adapters.
    /// </summary>
    /// <param name="services">Service collection</param>
    /// <returns>Service collection for chaining</returns>
    public static IServiceCollection AddUnifiedQuerySystem(this IServiceCollection services)
    {
        // Register core unified query services
        services.AddUnifiedQueryServices();

        // Register protocol-specific adapters
        services.AddQueryParameterAdapter<QueryParameters, GeoServicesQueryParameterAdapter>();
        services.AddQueryParameterAdapter<OgcFeaturesQueryParameters, OgcFeaturesQueryParameterAdapter>();
        // services.AddQueryParameterAdapter<Wfs20QueryParameters, Wfs20QueryParameterAdapter>(); // Disabled - adapter not available
        // services.AddQueryParameterAdapter<ODataQueryParameters, ODataQueryParameterAdapter>(); // Disabled - adapter not available

        // Configure the unified query service
        services.ConfigureUnifiedQueryService();

        return services;
    }

    /// <summary>
    /// Configures the unified query system during application startup.
    /// </summary>
    /// <param name="app">Application builder</param>
    /// <returns>Application builder for chaining</returns>
    public static IApplicationBuilder UseUnifiedQuerySystem(this IApplicationBuilder app)
    {
        // Configure the unified query service with registered adapters
        using var scope = app.ApplicationServices.CreateScope();
        scope.ServiceProvider.ConfigureUnifiedQueryService();

        return app;
    }

    /// <summary>
    /// Adds protocol-specific services that work with the unified query system.
    /// </summary>
    /// <param name="services">Service collection</param>
    /// <returns>Service collection for chaining</returns>
    public static IServiceCollection AddProtocolQueryServices(this IServiceCollection services)
    {
        // Register unified implementations of protocol services
        // services.AddScoped<IWfs20QueryService, UnifiedWfs20QueryService>(); // Disabled - implementation not available

        // Register any additional protocol-specific services needed by the adapters
        services.AddTransient<SpatialReferenceResolver>();

        return services;
    }

    /// <summary>
    /// Validates that all required services for the unified query system are registered.
    /// </summary>
    /// <param name="services">Service collection</param>
    /// <returns>Service collection for chaining</returns>
    public static IServiceCollection ValidateUnifiedQuerySystem(this IServiceCollection services)
    {
        // Add a service that validates the configuration at startup
        services.AddHostedService<UnifiedQuerySystemValidationService>();

        return services;
    }
}

/// <summary>
/// Background service that validates the unified query system configuration at startup.
/// </summary>
internal sealed class UnifiedQuerySystemValidationService : IHostedService
{
    private readonly IServiceProvider _serviceProvider;
    private readonly ILogger<UnifiedQuerySystemValidationService> _logger;

    public UnifiedQuerySystemValidationService(
        IServiceProvider serviceProvider,
        ILogger<UnifiedQuerySystemValidationService> logger)
    {
        _serviceProvider = serviceProvider;
        _logger = logger;
    }

    public Task StartAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var scope = _serviceProvider.CreateScope();
            var services = scope.ServiceProvider;

            // Verify core services are registered
            var queryProcessor = services.GetService<IQueryProcessor>();
            if (queryProcessor == null)
            {
                _logger.LogError("IQueryProcessor is not registered. Add services.AddUnifiedQueryServices()");
                throw new InvalidOperationException("IQueryProcessor is not registered.");
            }

            var unifiedQueryService = services.GetService<UnifiedQueryService>();
            if (unifiedQueryService == null)
            {
                _logger.LogError("UnifiedQueryService is not registered. Add services.AddUnifiedQueryServices()");
                throw new InvalidOperationException("UnifiedQueryService is not registered.");
            }

            // Verify adapters are registered
            var adapters = unifiedQueryService.GetRegisteredAdapters();
            if (adapters.Count == 0)
            {
                _logger.LogWarning("No query parameter adapters are registered. The unified query system will not be usable.");
            }
            else
            {
                _logger.LogInformation("Unified query system initialized with {AdapterCount} adapters: {Adapters}",
                    adapters.Count,
                    string.Join(", ", adapters.Values));
            }

            // Verify required dependencies
            var filterExpressionService = services.GetService<Core.Queries.Filters.IFilterExpressionService>();
            if (filterExpressionService == null)
            {
                _logger.LogError("IFilterExpressionService is not registered. This is required for query processing.");
                throw new InvalidOperationException("IFilterExpressionService is not registered.");
            }

            var featureReader = services.GetService<Core.Features.FeatureStore.Abstractions.IFeatureReader>();
            if (featureReader == null)
            {
                _logger.LogError("IFeatureReader is not registered. This is required for query execution.");
                throw new InvalidOperationException("IFeatureReader is not registered.");
            }

            _logger.LogInformation("Unified query system validation completed successfully");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Unified query system validation failed");
            throw;
        }

        return Task.CompletedTask;
    }

    public Task StopAsync(CancellationToken cancellationToken)
    {
        return Task.CompletedTask;
    }
}

/// <summary>
/// Extension methods for easy integration of the unified query system.
/// </summary>
public static class QuerySystemIntegrationExtensions
{
    /// <summary>
    /// Adds the complete unified query system with validation.
    /// This is the main entry point for enabling unified query processing.
    /// </summary>
    /// <param name="services">Service collection</param>
    /// <returns>Service collection for chaining</returns>
    public static IServiceCollection AddCompleteUnifiedQuerySystem(this IServiceCollection services)
    {
        return services
            .AddUnifiedQuerySystem()
            .AddProtocolQueryServices()
            .ValidateUnifiedQuerySystem();
    }

    /// <summary>
    /// Gets statistics about the unified query system for monitoring/diagnostics.
    /// </summary>
    /// <param name="serviceProvider">Service provider</param>
    /// <returns>Query system statistics</returns>
    public static QuerySystemStatistics GetQuerySystemStatistics(this IServiceProvider serviceProvider)
    {
        using var scope = serviceProvider.CreateScope();
        var services = scope.ServiceProvider;

        var unifiedQueryService = services.GetService<UnifiedQueryService>();
        var adapters = unifiedQueryService?.GetRegisteredAdapters() ?? new Dictionary<Type, string>();

        var queryProcessor = services.GetService<IQueryProcessor>();

        return new QuerySystemStatistics
        {
            IsConfigured = unifiedQueryService != null && queryProcessor != null,
            RegisteredAdapters = adapters.ToDictionary(kvp => kvp.Key.Name, kvp => kvp.Value),
            CoreServicesAvailable = new Dictionary<string, bool>
            {
                ["IQueryProcessor"] = services.GetService<IQueryProcessor>() != null,
                ["UnifiedQueryService"] = services.GetService<UnifiedQueryService>() != null,
                ["IFilterExpressionService"] = services.GetService<Core.Queries.Filters.IFilterExpressionService>() != null,
                ["IFeatureReader"] = services.GetService<Core.Features.FeatureStore.Abstractions.IFeatureReader>() != null
            }
        };
    }
}

/// <summary>
/// Statistics about the unified query system configuration.
/// </summary>
public sealed record QuerySystemStatistics
{
    /// <summary>
    /// Whether the unified query system is properly configured.
    /// </summary>
    public required bool IsConfigured { get; init; }

    /// <summary>
    /// Map of registered adapters (parameter type name -> protocol name).
    /// </summary>
    public required IReadOnlyDictionary<string, string> RegisteredAdapters { get; init; }

    /// <summary>
    /// Availability status of core services.
    /// </summary>
    public required IReadOnlyDictionary<string, bool> CoreServicesAvailable { get; init; }

    /// <summary>
    /// Gets a summary string of the query system status.
    /// </summary>
    /// <returns>Status summary</returns>
    public string GetStatusSummary()
    {
        if (!IsConfigured)
        {
            return "Unified query system is not properly configured";
        }

        var adapterCount = RegisteredAdapters.Count;
        var adapterList = string.Join(", ", RegisteredAdapters.Values);

        return $"Unified query system is configured with {adapterCount} adapters: {adapterList}";
    }
}