using System.Collections.Immutable;
using System.Globalization;
using Honua.Core.Features.Catalog.Domain;
using Honua.Core.Features.FeatureStore.Domain;
using Honua.Core.Features.Query;
using Honua.Core.Features.Shared.Models;
using Honua.Core.Queries.Filters;
using Honua.Server.Features.FeatureServer.Models;
using Microsoft.Extensions.Logging;

namespace Honua.Server.Features.FeatureServer.Services;

/// <summary>
/// Adapter that converts GeoServices QueryParameters to UnifiedQuery.
/// </summary>
public sealed class GeoServicesQueryParameterAdapter : IQueryParameterAdapter<QueryParameters>
{
    private readonly IFilterExpressionService _filterExpressionService;
    private readonly SpatialReferenceResolver _spatialReferenceResolver;
    private readonly ILogger<GeoServicesQueryParameterAdapter> _logger;

    public string ProtocolName => "GeoServices";

    public ProtocolLimits DefaultLimits => ProtocolLimits.GeoServices;

    public GeoServicesQueryParameterAdapter(
        IFilterExpressionService filterExpressionService,
        SpatialReferenceResolver spatialReferenceResolver,
        ILogger<GeoServicesQueryParameterAdapter> logger)
    {
        _filterExpressionService = filterExpressionService ?? throw new ArgumentNullException(nameof(filterExpressionService));
        _spatialReferenceResolver = spatialReferenceResolver ?? throw new ArgumentNullException(nameof(spatialReferenceResolver));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    public async Task<QueryAdapterResult> ConvertAsync(
        QueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken = default)
    {
        try
        {
            // Convert attribute filter
            var filter = await ConvertAttributeFilterAsync(parameters, layer);
            if (filter.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(filter.ErrorMessage);
            }

            // Convert spatial filter
            var spatialFilterResult = await ConvertSpatialFilterAsync(parameters, layer, cancellationToken);
            if (spatialFilterResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(spatialFilterResult.ErrorMessage);
            }

            // Convert temporal filter
            var temporalFilter = ConvertTemporalFilter(parameters);

            // Convert object IDs
            var objectIds = ConvertObjectIds(parameters);

            // Convert field selection
            var outFields = ConvertFieldSelection(parameters, layer);

            // Convert pagination
            var (offset, limit) = ConvertPagination(parameters);

            // Convert ordering
            var orderByResult = ConvertOrderBy(parameters, layer);
            if (orderByResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(orderByResult.ErrorMessage);
            }

            // Convert output CRS
            var outputCrsResult = await ConvertOutputCrsAsync(parameters, layer, cancellationToken);
            if (outputCrsResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(outputCrsResult.ErrorMessage);
            }

            // Convert aggregation
            var aggregationResult = ConvertAggregation(parameters, layer);
            if (aggregationResult.ErrorMessage != null)
            {
                return QueryAdapterResult.Failure(aggregationResult.ErrorMessage);
            }

            // Build query hints
            var hints = QueryHints.Create(
                preferStreaming: ShouldPreferStreaming(parameters),
                enableCaching: ShouldEnableCache(parameters),
                requireExactCount: parameters.ReturnCountOnly || !parameters.ReturnIdsOnly
            );

            // Create unified query
            var unifiedQuery = new UnifiedQuery
            {
                Filter = filter.Filter,
                SpatialFilter = spatialFilterResult.SpatialFilter,
                TemporalFilter = temporalFilter,
                ObjectIds = objectIds,
                OutFields = outFields,
                Offset = offset,
                Limit = limit,
                OrderBy = orderByResult.OrderBy,
                OutputCrs = outputCrsResult.OutputCrs,
                Aggregation = aggregationResult.Aggregation,
                Hints = hints
            };

            // Collect metadata for response formatting
            var metadata = new Dictionary<string, object>
            {
                ["returnGeometry"] = parameters.ReturnGeometry,
                ["returnCountOnly"] = parameters.ReturnCountOnly,
                ["returnIdsOnly"] = parameters.ReturnIdsOnly,
                ["returnExtentOnly"] = parameters.ReturnExtentOnly,
                ["f"] = parameters.F ?? "json"
            };

            if (parameters.GeometryPrecision.HasValue)
            {
                metadata["geometryPrecision"] = parameters.GeometryPrecision.Value;
            }

            if (parameters.MaxAllowableOffset.HasValue)
            {
                metadata["maxAllowableOffset"] = parameters.MaxAllowableOffset.Value;
            }

            return QueryAdapterResult.Success(unifiedQuery, metadata);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to convert GeoServices query parameters");
            return QueryAdapterResult.Failure("Invalid query parameters.");
        }
    }

    private async Task<(QueryFilter? Filter, string? ErrorMessage)> ConvertAttributeFilterAsync(
        QueryParameters parameters,
        LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(parameters.Where))
        {
            return (null, null);
        }

        var parseResult = _filterExpressionService.Parse(FilterLanguage.ArcGisSql, parameters.Where);
        if (!parseResult.IsSuccess)
        {
            return (null, parseResult.ErrorMessage ?? "Invalid where clause.");
        }

        var source = new FilterSource(parameters.Where, FilterLanguage.ArcGisSql, ProtocolName);
        var filter = QueryFilter.FromExpression(parseResult.Expression!, source);

        return (filter, null);
    }

    private async Task<(SpatialFilter? SpatialFilter, string? ErrorMessage)> ConvertSpatialFilterAsync(
        QueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(parameters.Geometry))
        {
            return (null, null);
        }

        try
        {
            // Parse geometry
            var geometryBytes = ParseGeometry(parameters.Geometry, parameters.GeometryType);
            if (geometryBytes == null)
            {
                return (null, "Invalid geometry format.");
            }

            // Resolve input SRID
            var inputSrid = await _spatialReferenceResolver.ResolveSridAsync(
                parameters.InSR, parameters.GeometrySpatialReference, cancellationToken);

            // Parse spatial relationship
            var spatialRelationship = ParseSpatialRelationship(parameters.SpatialRel);

            // Create spatial filter based on relationship type
            SpatialFilter spatialFilter;
            if (spatialRelationship == SpatialRelationship.WithinDistance && parameters.Distance.HasValue)
            {
                var unit = ParseDistanceUnit(parameters.Units);
                spatialFilter = SpatialFilter.CreateDistanceFilter(
                    geometryBytes,
                    parameters.Distance.Value,
                    unit,
                    withinDistance: true,
                    srid: inputSrid);
            }
            else
            {
                spatialFilter = SpatialFilter.Create(geometryBytes, spatialRelationship, inputSrid);
            }

            return (spatialFilter, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse spatial filter");
            return (null, "Invalid spatial filter parameters.");
        }
    }

    private TemporalFilter? ConvertTemporalFilter(QueryParameters parameters)
    {
        if (string.IsNullOrWhiteSpace(parameters.Time))
        {
            return null;
        }

        // Parse time parameter (simplified implementation)
        // Format: "startTime,endTime" or "startTime" for a single time
        var parts = parameters.Time.Split(',');
        DateTimeOffset? start = null, end = null;

        if (parts.Length >= 1 && !string.IsNullOrWhiteSpace(parts[0]))
        {
            if (DateTimeOffset.TryParse(parts[0], out var startTime))
            {
                start = startTime;
            }
        }

        if (parts.Length >= 2 && !string.IsNullOrWhiteSpace(parts[1]))
        {
            if (DateTimeOffset.TryParse(parts[1], out var endTime))
            {
                end = endTime;
            }
        }

        if (!start.HasValue && !end.HasValue)
        {
            return null;
        }

        return new TemporalFilter
        {
            PropertyName = "created_at", // Default temporal field
            PropertyType = TemporalPropertyType.DateTime,
            Start = start,
            End = end
        };
    }

    private ImmutableArray<long>? ConvertObjectIds(QueryParameters parameters)
    {
        if (string.IsNullOrWhiteSpace(parameters.ObjectIds))
        {
            return null;
        }

        var ids = new List<long>();
        foreach (var part in parameters.ObjectIds.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (long.TryParse(part.Trim(), out var id))
            {
                ids.Add(id);
            }
        }

        return ids.Count > 0 ? ids.ToImmutableArray() : null;
    }

    private ImmutableArray<string>? ConvertFieldSelection(QueryParameters parameters, LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(parameters.OutFields))
        {
            return null; // Return all fields
        }

        if (string.Equals(parameters.OutFields.Trim(), "*", StringComparison.Ordinal))
        {
            return null; // Return all fields
        }

        var fields = parameters.OutFields
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(f => f.Trim())
            .Where(f => !string.IsNullOrEmpty(f))
            .ToImmutableArray();

        return fields.Length > 0 ? fields : null;
    }

    private (int? Offset, int? Limit) ConvertPagination(QueryParameters parameters)
    {
        int? offset = null;
        int? limit = null;

        if (parameters.ResultOffset.HasValue && parameters.ResultOffset.Value > 0)
        {
            offset = parameters.ResultOffset.Value;
        }

        if (parameters.ResultRecordCount.HasValue && parameters.ResultRecordCount.Value > 0)
        {
            limit = parameters.ResultRecordCount.Value;
        }

        return (offset, limit);
    }

    private (ImmutableArray<OrderByClause>? OrderBy, string? ErrorMessage) ConvertOrderBy(
        QueryParameters parameters,
        LayerDefinition layer)
    {
        if (string.IsNullOrWhiteSpace(parameters.OrderByFields))
        {
            return (null, null);
        }

        try
        {
            var orderBy = OrderByParsing.ParseFeatureServerOrderBy(parameters.OrderByFields, layer);
            return (orderBy, null);
        }
        catch (Exception ex)
        {
            return (null, ex.Message);
        }
    }

    private async Task<(QueryCrs? OutputCrs, string? ErrorMessage)> ConvertOutputCrsAsync(
        QueryParameters parameters,
        LayerDefinition layer,
        CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(parameters.OutSR))
        {
            return (null, null);
        }

        try
        {
            var srid = await _spatialReferenceResolver.ResolveSridAsync(
                parameters.OutSR, null, cancellationToken);

            if (!srid.HasValue)
            {
                return (null, "Invalid output spatial reference.");
            }

            var outputCrs = QueryCrs.Create(srid.Value);
            return (outputCrs, null);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to resolve output spatial reference: {OutSR}", parameters.OutSR);
            return (null, "Invalid output spatial reference.");
        }
    }

    private (QueryAggregation? Aggregation, string? ErrorMessage) ConvertAggregation(
        QueryParameters parameters,
        LayerDefinition layer)
    {
        var hasStats = !string.IsNullOrWhiteSpace(parameters.OutStatistics);
        var hasGroupBy = !string.IsNullOrWhiteSpace(parameters.GroupByFieldsForStatistics);

        if (!hasStats && !hasGroupBy)
        {
            return (null, null);
        }

        try
        {
            ImmutableArray<StatisticDefinition>? statistics = null;
            if (hasStats)
            {
                statistics = StatisticParsing.ParseOutStatistics(parameters.OutStatistics, layer);
            }

            ImmutableArray<string>? groupByFields = null;
            if (hasGroupBy)
            {
                groupByFields = parameters.GroupByFieldsForStatistics
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(f => f.Trim())
                    .Where(f => !string.IsNullOrEmpty(f))
                    .ToImmutableArray();
            }

            var aggregation = QueryAggregation.Create(statistics, groupByFields, parameters.ReturnDistinctValues);
            return (aggregation, null);
        }
        catch (Exception ex)
        {
            return (null, ex.Message);
        }
    }

    private static bool ShouldPreferStreaming(QueryParameters parameters)
    {
        // Prefer streaming for large result sets without special formatting requirements
        return parameters.ResultRecordCount > 1000 &&
               !parameters.ReturnCountOnly &&
               !parameters.ReturnIdsOnly &&
               !parameters.ReturnExtentOnly &&
               string.IsNullOrWhiteSpace(parameters.OutStatistics);
    }

    private static bool ShouldEnableCache(QueryParameters parameters)
    {
        // Disable caching for operations that return metadata or have dynamic content
        return !parameters.ReturnCountOnly &&
               !parameters.ReturnExtentOnly &&
               string.IsNullOrWhiteSpace(parameters.OutStatistics);
    }

    private static byte[]? ParseGeometry(string geometry, string? geometryType)
    {
        // Simplified geometry parsing - in practice this would be more robust
        // This is a placeholder for actual geometry parsing logic
        if (string.IsNullOrWhiteSpace(geometry))
        {
            return null;
        }

        try
        {
            // Parse GeoJSON or Esri JSON geometry
            // Return WKB bytes
            // This is a simplified placeholder
            return Convert.FromBase64String(geometry);
        }
        catch
        {
            return null;
        }
    }

    private static SpatialRelationship ParseSpatialRelationship(string? spatialRel)
    {
        return spatialRel?.ToUpperInvariant() switch
        {
            "ESRISPATIALRELINTERSECTS" or "INTERSECTS" => SpatialRelationship.Intersects,
            "ESRISPATIALRELCONTAINS" or "CONTAINS" => SpatialRelationship.Contains,
            "ESRISPATIALRELWITHIN" or "WITHIN" => SpatialRelationship.Within,
            "ESRISPATIALRELOVERLAPS" or "OVERLAPS" => SpatialRelationship.Overlaps,
            "ESRISPATIALRELTOUCHES" or "TOUCHES" => SpatialRelationship.Touches,
            "ESRISPATIALRELCROSSES" or "CROSSES" => SpatialRelationship.Crosses,
            "ESRISPATIALRELENVELOPEINTERSECTS" => SpatialRelationship.EnvelopeIntersects,
            _ => SpatialRelationship.Intersects
        };
    }

    private static DistanceUnit ParseDistanceUnit(string? units)
    {
        return units?.ToUpperInvariant() switch
        {
            "ESRISRUNIT_METER" or "METERS" => DistanceUnit.Meters,
            "ESRISRUNIT_FOOT" or "FEET" => DistanceUnit.Feet,
            "ESRISRUNIT_KILOMETER" or "KILOMETERS" => DistanceUnit.Kilometers,
            "ESRISRUNIT_MILE" or "MILES" => DistanceUnit.Miles,
            _ => DistanceUnit.Meters
        };
    }
}

/// <summary>
/// Helper class for parsing statistics from GeoServices parameters.
/// </summary>
internal static class StatisticParsing
{
    public static ImmutableArray<StatisticDefinition> ParseOutStatistics(string outStatistics, LayerDefinition layer)
    {
        // Simplified statistics parsing
        // In practice this would parse the JSON array of statistic definitions
        var statistics = new List<StatisticDefinition>();

        // Placeholder implementation
        try
        {
            // Parse JSON array of statistics definitions
            // Each entry has: {"statisticType": "count", "onStatisticField": "field_name", "outStatisticFieldName": "alias"}
            // Return parsed statistics
        }
        catch
        {
            // Fallback to basic count
            statistics.Add(new StatisticDefinition
            {
                StatisticType = StatisticType.Count,
                OutStatisticFieldName = "count_all"
            });
        }

        return statistics.ToImmutableArray();
    }
}

/// <summary>
/// Helper class for parsing order by fields from GeoServices parameters.
/// </summary>
internal static class OrderByParsing
{
    public static ImmutableArray<OrderByClause> ParseFeatureServerOrderBy(string orderByFields, LayerDefinition layer)
    {
        var clauses = new List<OrderByClause>();

        foreach (var field in orderByFields.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmedField = field.Trim();
            if (string.IsNullOrEmpty(trimmedField))
                continue;

            var ascending = true;
            var fieldName = trimmedField;

            // Check for explicit ASC/DESC
            var parts = trimmedField.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 1)
            {
                fieldName = parts[0];
                if (parts[1].Equals("DESC", StringComparison.OrdinalIgnoreCase))
                {
                    ascending = false;
                }
            }

            // Find field type
            FieldType? fieldType = null;
            var layerField = layer.AttributeFields.FirstOrDefault(f =>
                string.Equals(f.Name, fieldName, StringComparison.OrdinalIgnoreCase));
            if (layerField != null)
            {
                fieldType = layerField.Type;
            }

            clauses.Add(new OrderByClause(fieldName, ascending, fieldType));
        }

        return clauses.ToImmutableArray();
    }
}