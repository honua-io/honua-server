{
  "AllowedHosts": "",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Honua.Server.Features.Infrastructure.Security": "Information"
    }
  },
  "SecurityHeaders": {
    "EnableHsts": true,
    "HstsMaxAge": 63072000,
    "HstsIncludeSubdomains": true,
    "HstsPreload": true,
    "Csp": {
      "PolicyType": "GeospatialApi",
      "AllowDevelopmentFeatures": false,
      "TrustedTileServers": [
        "*.openstreetmap.org",
        "api.mapbox.com",
        "*.tiles.mapbox.com",
        "server.arcgisonline.com"
      ],
      "TrustedCdns": [
        "cdnjs.cloudflare.com",
        "unpkg.com"
      ],
      "TrustedGeospatialApis": [
        "api.mapbox.com",
        "nominatim.openstreetmap.org"
      ],
      "ReportUri": "/csp-violation-report",
      "ReportOnly": false
    },
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableXssProtection": true,
    "CrossOriginOpenerPolicy": "same-origin",
    "CrossOriginEmbedderPolicy": "require-corp",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(), encrypted-media=(), fullscreen=(), picture-in-picture=()"
  }
}