{
  "Cors": {
    "AllowedOrigins": [],
    "DevelopmentOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ],
    "RestrictedOrigins": [],
    "AllowCredentials": false,
    "PreflightMaxAgeMinutes": 10
  },
  "SecurityHeaders": {
    "EnableHsts": true,
    "HstsMaxAge": 31536000,
    "HstsIncludeSubdomains": true,
    "HstsPreload": false,
    "Csp": {
      "PolicyType": "GeospatialApi",
      "AllowDevelopmentFeatures": false,
      "TrustedTileServers": [
        "*.openstreetmap.org",
        "*.tile.openstreetmap.org",
        "api.mapbox.com",
        "*.tiles.mapbox.com",
        "server.arcgisonline.com",
        "*.arcgis.com"
      ],
      "TrustedCdns": [
        "cdnjs.cloudflare.com",
        "unpkg.com",
        "cdn.jsdelivr.net"
      ],
      "TrustedGeospatialApis": [
        "api.mapbox.com",
        "nominatim.openstreetmap.org",
        "overpass-api.de"
      ],
      "ReportUri": "/csp-violation-report",
      "ReportOnly": false
    },
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnableXssProtection": true,
    "CrossOriginOpenerPolicy": "same-origin",
    "CrossOriginEmbedderPolicy": "require-corp",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(), encrypted-media=(), fullscreen=(), picture-in-picture=()"
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalRequestsPerMinute": 1000,
    "QueryRequestsPerMinute": 100,
    "UploadRequestsPerMinute": 10,
    "MetadataRequestsPerMinute": 200,
    "UseDistributedRateLimiting": true,
    "KeyPrefix": "honua:ratelimit:",
    "IncludeHeaders": true,
    "StatusCode": 429
  },
  "InputValidation": {
    "Enabled": true,
    "DetectSqlInjection": true,
    "DetectXss": true,
    "DetectCommandInjection": true,
    "DetectPathTraversal": true,
    "DetectLdapInjection": true,
    "DetectNullBytes": true,
    "DetectControlCharacters": true,
    "ValidateSuspiciousHeaders": false,
    "MaxParameterLength": 8192,
    "ExcludedPaths": [
      "/api/v1/import/upload",
      "/api/v1/raster/upload"
    ]
  },
  "Security": {
    "DisableHttpsRedirection": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Honua.Server.Features.Infrastructure.Security": "Information",
        "Honua.Server.Features.Infrastructure.Authentication": "Information",
        "Honua.Server.Features.Infrastructure.RateLimiting": "Information"
      }
    }
  }
}
