{
  "RateLimit": {
    "MaxRequestsPerWindow": 1000,
    "WindowSize": "00:10:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://admin.yourdomain.com",
      "https://app.yourdomain.com",
      "*.yourdomain.com"
    ],
    "RestrictedOrigins": [
      "https://admin.yourdomain.com"
    ],
    "AllowCredentials": false,
    "PreflightMaxAgeMinutes": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Honua.Server.Features.Infrastructure.Security": "Information",
        "Honua.Server.Features.Infrastructure.Authentication": "Information"
      }
    }
  }
}