{
  "openapi": "3.0.3",
  "info": {
    "title": "Honua OGC API Processes",
    "description": "OGC API Processes adapter over the Honua canonical geoprocessing runtime.",
    "version": "1.0.0"
  },
  "paths": {
    "/ogc/processes": {
      "get": {
        "summary": "OGC API Processes landing page",
        "operationId": "OgcProcessesLandingPage",
        "responses": {
          "200": {
            "description": "Landing page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LandingPage" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/conformance": {
      "get": {
        "summary": "OGC API Processes conformance declaration",
        "operationId": "OgcProcessesConformance",
        "responses": {
          "200": {
            "description": "Conformance declaration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConformanceDeclaration" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/processes": {
      "get": {
        "summary": "List available processes",
        "operationId": "OgcProcessesList",
        "responses": {
          "200": {
            "description": "Process list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProcessList" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/processes/{processId}": {
      "get": {
        "summary": "Get process description",
        "operationId": "OgcProcessDescription",
        "parameters": [
          {
            "name": "processId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Process description",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProcessDescription" }
              }
            }
          },
          "404": {
            "description": "No such process",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/processes/{processId}/execution": {
      "post": {
        "summary": "Execute a process",
        "operationId": "OgcProcessExecute",
        "parameters": [
          {
            "name": "processId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "Prefer",
            "in": "header",
            "description": "Use 'respond-async' for asynchronous execution",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Execute" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created (async)",
            "headers": {
              "Location": {
                "description": "URL of the job status endpoint",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusInfo" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          },
          "404": {
            "description": "No such process",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          },
          "501": {
            "description": "Synchronous execution not supported",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/jobs": {
      "get": {
        "summary": "List jobs",
        "operationId": "OgcProcessesJobList",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Job list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobList" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/jobs/{jobId}": {
      "get": {
        "summary": "Get job status",
        "operationId": "OgcProcessesJobStatus",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusInfo" }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Dismiss (cancel) a job",
        "operationId": "OgcProcessesDismissJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job dismissed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusInfo" }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          },
          "409": {
            "description": "Job in terminal state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          }
        }
      }
    },
    "/ogc/processes/jobs/{jobId}/results": {
      "get": {
        "summary": "Get job results",
        "operationId": "OgcProcessesJobResults",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Job results (document mode)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Results" }
              }
            }
          },
          "404": {
            "description": "No such job or results not available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exception" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LandingPage": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "ConformanceDeclaration": {
        "type": "object",
        "properties": {
          "conformsTo": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": { "type": "string" },
          "rel": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["href"]
      },
      "ProcessList": {
        "type": "object",
        "properties": {
          "processes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProcessSummary" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "ProcessSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "jobControlOptions": {
            "type": "array",
            "items": { "type": "string", "enum": ["async-execute", "dismiss"] }
          },
          "outputTransmission": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ProcessDescription": {
        "allOf": [
          { "$ref": "#/components/schemas/ProcessSummary" },
          {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": { "$ref": "#/components/schemas/InputDescription" }
              },
              "outputs": {
                "type": "object",
                "additionalProperties": { "$ref": "#/components/schemas/OutputDescription" }
              }
            }
          }
        ]
      },
      "InputDescription": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "schema": { "type": "object" }
        }
      },
      "OutputDescription": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "schema": { "type": "object" }
        }
      },
      "Execute": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "object",
            "additionalProperties": true
          },
          "response": {
            "type": "string",
            "enum": ["document"],
            "default": "document",
            "description": "Response mode. V1 only supports 'document'."
          }
        }
      },
      "StatusInfo": {
        "type": "object",
        "properties": {
          "processID": { "type": "string" },
          "jobID": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["accepted", "running", "successful", "failed", "dismissed"]
          },
          "message": { "type": "string" },
          "created": { "type": "string", "format": "date-time" },
          "updated": { "type": "string", "format": "date-time" },
          "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "JobList": {
        "type": "object",
        "properties": {
          "jobs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StatusInfo" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "Results": {
        "type": "object",
        "additionalProperties": true
      },
      "Exception": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
