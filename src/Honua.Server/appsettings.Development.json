{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5433;Database=honua_test;User Id=test;Password=test;Include Error Detail=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Honua.Server.Features.Infrastructure.Security": "Debug",
      "Honua.Postgres.Features.Infrastructure.Caching": "Debug"
    }
  },
  "SecurityHeaders": {
    "EnableHsts": false,
    "Csp": {
      "PolicyType": "GeospatialApi",
      "AllowDevelopmentFeatures": true,
      "TrustedTileServers": [
        "tile.openstreetmap.org",
        "*.tile.openstreetmap.org",
        "localhost:*",
        "127.0.0.1:*"
      ],
      "TrustedCdns": [
        "unpkg.com",
        "cdnjs.cloudflare.com",
        "localhost:*",
        "127.0.0.1:*"
      ],
      "TrustedGeospatialApis": [
        "localhost:*",
        "127.0.0.1:*",
        "*.localhost"
      ],
      "WebSocketUrls": [
        "ws://localhost:*",
        "wss://localhost:*"
      ],
      "ReportOnly": false
    }
  },
  "Limits": {
    "Query": {
      "MaxRecordCount": 2000,
      "DefaultRecordCount": 1000,
      "MaxOffset": 100000,
      "QueryTimeout": "00:00:30"
    },
    "Geometry": {
      "MaxVertices": 10000,
      "MaxPolygons": 100,
      "MaxCoordinateValue": 180.0
    },
    "Edits": {
      "MaxPayloadSize": 10485760,
      "MaxFeaturesPerRequest": 1000,
      "MaxAttachmentSize": 52428800
    },
    "Attachments": {
      "AllowedMimeTypes": "image/*,application/pdf,text/plain",
      "MaxFileCount": 10
    },
    "Tiles": {
      "MaxZoomLevel": 18,
      "CacheSize": 1073741824
    },
    "Connections": {
      "MaxConcurrent": 100,
      "RequestTimeout": "00:01:00"
    }
  },
  "Deployment": {
    "Mode": "SingleInstance"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalStorage": {
      "BasePath": "/tmp/honua-storage",
      "CreateDirectoryIfNotExists": true
    }
  },
  "Database": {
    "QueryCache": {
      "MaxCachedStatements": 50,
      "StatementLifetimeMinutes": 15,
      "MinExecutionsForCaching": 2,
      "EnableAutomaticCaching": true,
      "EnablePerformanceLogging": true,
      "CleanupIntervalMinutes": 5
    }
  },
  "Tracing": {
    "Enabled": true,
    "SamplingRatio": 1.0,
    "IncludeDbStatementText": true,
    "TraceHealthEndpoints": true,
    "ExportExceptionDetails": false,
    "RecordExceptionStackTraces": false,
    "MaxAttributesPerSpan": 256,
    "MaxEventsPerSpan": 256
  },
  "ControlPlane": {
    "ExecutionWorkloads": [
      {
        "WorkloadId": "geoprocessing-local",
        "Kind": "Geoprocessing",
        "TargetKind": "KubernetesJob",
        "Backend": "local",
        "WorkloadName": "Geoprocessing (local baseline)"
      }
    ]
  }
}
