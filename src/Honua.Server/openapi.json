{
  "openapi": "3.0.3",
  "info": {
    "title": "Honua OGC API Features",
    "description": "OGC API Features implementation for geospatial data access",
    "version": "1.0.0",
    "contact": {
      "name": "Honua Server"
    }
  },
  "servers": [
    {
      "url": "/ogc/features"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Get OGC API Features landing page",
        "description": "The landing page provides links to the API definition and other resources",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Landing page information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandingPage"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/conformance": {
      "get": {
        "summary": "Get OGC API Features conformance declaration",
        "description": "Conformance classes that this API conforms to",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conformance declaration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConformanceDeclaration"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "Get OGC API Features collections",
        "description": "Lists all available feature collections",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collections list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collections"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{collectionId}/items": {
      "get": {
        "summary": "Get features from a collection",
        "description": "Get features from a collection with optional filtering",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json, geojson, gml, xml, or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "gml",
                "xml",
                "html"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of features to return",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of features to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Bounding box filter (minx,miny,maxx,maxy or minx,miny,minz,maxx,maxy,maxz)",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 6
            }
          },
          {
            "name": "bbox-crs",
            "in": "query",
            "required": false,
            "description": "CRS for the bbox coordinates",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "crs",
            "in": "query",
            "required": false,
            "description": "Coordinate reference system URI for response geometry",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "required": false,
            "description": "Temporal filter (RFC 3339 instant or interval)",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "CQL2 filter expression",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter-lang",
            "in": "query",
            "required": false,
            "description": "Filter language (default cql2-text)",
            "schema": {
              "type": "string",
              "enum": [
                "cql2-text",
                "cql2-json"
              ]
            }
          },
          {
            "name": "filter-crs",
            "in": "query",
            "required": false,
            "description": "CRS for filter geometries",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "FeatureCollection",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              },
              "application/gml+xml;version=3.2": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Collection not found"
          }
        }
      },
      "post": {
        "summary": "Create a new feature in a collection",
        "description": "Add a new feature to the specified collection",
        "tags": [
          "OGC API Features",
          "Transactions"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/geo+json": {
              "schema": {
                "$ref": "#/components/schemas/GeoJsonFeature"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feature created",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeature"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Collection not found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/collections/{collectionId}": {
      "get": {
        "summary": "Get OGC API Features collection metadata",
        "description": "Get detailed metadata for a specific collection",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collection metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionInfo"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found"
          }
        }
      }
    },
    "/collections/{collectionId}/queryables": {
      "get": {
        "summary": "Get queryable properties for a collection",
        "description": "Get JSON Schema describing queryable properties for filtering",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "html"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Queryables schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryablesSchema"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found"
          }
        }
      }
    },
    "/collections/{collectionId}/items/{featureId}": {
      "get": {
        "summary": "Get a specific feature from a collection",
        "description": "Get a specific feature by its ID from a collection",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featureId",
            "in": "path",
            "required": true,
            "description": "Feature identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json, geojson, gml, xml, or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "gml",
                "xml",
                "html"
              ]
            }
          },
          {
            "name": "crs",
            "in": "query",
            "required": false,
            "description": "Coordinate reference system URI for response geometry",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feature",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeature"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeature"
                }
              },
              "application/gml+xml;version=3.2": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Feature not found"
          }
        }
      },
      "put": {
        "summary": "Update an existing feature",
        "description": "Replace an existing feature with new data",
        "tags": [
          "OGC API Features",
          "Transactions"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featureId",
            "in": "path",
            "required": true,
            "description": "Feature identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/geo+json": {
              "schema": {
                "$ref": "#/components/schemas/GeoJsonFeature"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feature updated",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeature"
                }
              }
            }
          },
          "201": {
            "description": "Feature created"
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Feature not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a feature from a collection",
        "description": "Remove a feature from the specified collection",
        "tags": [
          "OGC API Features",
          "Transactions"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featureId",
            "in": "path",
            "required": true,
            "description": "Feature identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Feature deleted"
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Feature not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LandingPage": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "ConformanceDeclaration": {
        "type": "object",
        "properties": {
          "conformsTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "Collections": {
        "type": "object",
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionInfo"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "CollectionInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "extent": {
            "$ref": "#/components/schemas/Extent"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "itemType": {
            "type": "string"
          },
          "crs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storageCrs": {
            "type": "string"
          }
        }
      },
      "FeatureCollection": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoJsonFeature"
            }
          },
          "numberMatched": {
            "type": "integer"
          },
          "numberReturned": {
            "type": "integer"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "timeStamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GeoJsonFeature": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "id": {},
          "geometry": {},
          "properties": {
            "type": "object"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "href",
          "rel"
        ]
      },
      "Extent": {
        "type": "object",
        "properties": {
          "spatial": {
            "$ref": "#/components/schemas/SpatialExtent"
          },
          "temporal": {
            "$ref": "#/components/schemas/TemporalExtent"
          }
        }
      },
      "SpatialExtent": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "TemporalExtent": {
        "type": "object",
        "properties": {
          "interval": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "QueryablesSchema": {
        "type": "object"
      }
    }
  }
}
