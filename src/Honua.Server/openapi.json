    "/collections/{collectionId}/items": {
      "get": {
        "summary": "Get features from a collection",
        "description": "Get features from a collection with optional filtering",
        "tags": [
          "OGC API Features"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Output format (json, geojson, gml, xml, csv, or html)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "gml",
                "xml",
                "csv",
                "html"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of features to return",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of features to skip",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Bounding box filter (minx,miny,maxx,maxy or minx,miny,minz,maxx,maxy,maxz)",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 6
            }
          },
          {
            "name": "bbox-crs",
            "in": "query",
            "required": false,
            "description": "CRS for the bbox coordinates",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "crs",
            "in": "query",
            "required": false,
            "description": "Coordinate reference system URI for response geometry",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "required": false,
            "description": "Temporal filter (RFC 3339 instant or interval)",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "CQL2 filter expression",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter-lang",
            "in": "query",
            "required": false,
            "description": "Filter language (default cql2-text)",
            "schema": {
              "type": "string",
              "enum": [
                "cql2-text",
                "cql2-json"
              ]
            }
          },
          {
            "name": "filter-crs",
            "in": "query",
            "required": false,
            "description": "CRS for filter geometries",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "FeatureCollection",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              },
              "application/gml+xml;version=3.2": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Collection not found"
          }
        }
      },
      "post": {
        "summary": "Create a new feature in a collection",
        "description": "Add a new feature to the specified collection",
        "tags": [
          "OGC API Features",
          "Transactions"
        ],
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/geo+json": {
              "schema": {
                "$ref": "#/components/schemas/GeoJsonFeature"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feature created",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeature"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Collection not found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/collections/{collectionId}/items/batch": {
      "post": {
        "summary": "Execute batch feature operations",
