  "components": {
    "schemas": {
      "Link": {
        "type": "object",
        "required": ["href", "rel"],
        "properties": {
          "href": { "type": "string" },
          "rel": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "templated": { "type": "boolean" },
          "hreflang": { "type": "string" }
        }
      },
      "LandingPage": {
        "type": "object",
        "required": ["title", "links"],
