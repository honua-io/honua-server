    "/tiles/{tileMatrixSetId}/{tileMatrix}/{tileRow}/{tileCol}": {
      "get": {
        "summary": "Dataset tile",
        "operationId": "tilesets.getTile",
        "parameters": [
          {
            "name": "tileMatrixSetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "tileMatrix",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "tileRow",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0 }
          },
          {
            "name": "tileCol",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0 }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Tile format (mvt or png)",
            "schema": {
              "type": "string",
              "enum": ["mvt", "png"]
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "subset",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "crs",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "subset-crs",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uri" }
          },
          {
            "name": "collections",
            "in": "query",
            "required": false,
            "description": "Comma-separated collection identifiers",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vector or raster tile",
            "content": {
              "application/vnd.mapbox-vector-tile": {
                "schema": { "type": "string", "format": "binary" }
              },
              "image/png": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "204": { "description": "No content" },
          "400": {
            "description": "Invalid tile matrix, tile coordinates, or query parameters",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "404": {
            "description": "Tile matrix set or requested collections not found",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          },
          "406": {
            "description": "Requested tile format is not acceptable",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" }
              }
            }
          }
        }
      }
    },
