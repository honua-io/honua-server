        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          },
          "extent": { "$ref": "#/components/schemas/Extent" },
          "itemType": { "type": "string" },
          "crs": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          },
          "storageCrs": { "type": "string", "format": "uri" }
        }
      },
      "Extent": {
        "type": "object",
        "properties": {
          "spatial": { "$ref": "#/components/schemas/SpatialExtent" },
          "temporal": { "$ref": "#/components/schemas/TemporalExtent" }
        }
      },
      "SpatialExtent": {
        "type": "object",
        "required": ["bbox"],
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" }
            }
          },
          "crs": { "type": "string", "format": "uri" }
        }
      },
      "TemporalExtent": {
        "type": "object",
        "required": ["interval"],
        "properties": {
          "interval": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "string", "nullable": true }
            }
          },
          "trs": { "type": "string" }
        }
      },
      "TileSetsList": {
        "type": "object",
        "required": ["tilesets"],
        "properties": {
          "tilesets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TileSetItem" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "TileSetItem": {
        "type": "object",
        "required": ["dataType", "crs", "tileMatrixSetId", "links"],
        "properties": {
          "title": { "type": "string" },
          "dataType": { "type": "string" },
          "crs": { "type": "string", "format": "uri" },
          "tileMatrixSetId": { "type": "string" },
          "tileMatrixSetURI": { "type": "string" },
          "tileMatrixSetLimits": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TileMatrixSetLimit" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "TileSet": {
        "type": "object",
