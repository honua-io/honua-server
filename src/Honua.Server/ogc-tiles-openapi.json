      }
    },
    "/ogc/tiles/tiles/{tileMatrixSetId}/{tileMatrix}/{tileRow}/{tileCol}": {
      "get": {
        "summary": "Dataset tile",
        "parameters": [
          {
            "name": "tileMatrixSetId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "tileMatrix",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "tileRow",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0 }
          },
          {
            "name": "tileCol",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0 }
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Tile format (mvt)",
            "schema": {
              "type": "string",
              "enum": ["mvt"]
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "subset",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "crs",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "subset-crs",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "collections",
            "in": "query",
            "required": false,
            "description": "Comma-separated collection identifiers",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vector tile",
            "content": {
              "application/vnd.mapbox-vector-tile": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "204": { "description": "No content" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/ogc/tiles/collections/{collectionId}/tiles": {
