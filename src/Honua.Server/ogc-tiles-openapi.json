        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "dataType": { "type": "string" },
          "crs": { "type": "string", "format": "uri" },
          "tileMatrixSetId": { "type": "string" },
          "tileMatrixSetURI": { "type": "string" },
          "tileMatrixSetLimits": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TileMatrixSetLimit" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          },
          "mediaTypes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "TileMatrixSetLimit": {
        "type": "object",
        "required": ["tileMatrix", "minTileRow", "maxTileRow", "minTileCol", "maxTileCol"],
        "properties": {
          "tileMatrix": { "type": "string" },
          "minTileRow": { "type": "integer", "minimum": 0 },
          "maxTileRow": { "type": "integer", "minimum": 0 },
          "minTileCol": { "type": "integer", "minimum": 0 },
          "maxTileCol": { "type": "integer", "minimum": 0 }
        }
      },
      "TileMatrixSetsList": {
        "type": "object",
        "required": ["tileMatrixSets"],
        "properties": {
          "tileMatrixSets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TileMatrixSetItem" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "TileMatrixSetItem": {
        "type": "object",
        "required": ["links"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "uri": { "type": "string" },
          "crs": { "type": "string", "format": "uri" },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "TileMatrixSetDefinition": {
        "type": "object",
        "required": ["crs", "tileMatrices"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "uri": { "type": "string" },
          "crs": { "type": "string", "format": "uri" },
          "wellKnownScaleSet": { "type": "string" },
          "tileMatrices": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TileMatrix" }
          }
        }
      },
      "TileMatrix": {
        "type": "object",
        "required": [
          "id",
          "scaleDenominator",
          "cellSize",
          "pointOfOrigin",
          "tileWidth",
          "tileHeight",
          "matrixWidth",
          "matrixHeight"
        ],
        "properties": {
          "id": { "type": "string" },
          "scaleDenominator": { "type": "number" },
          "cellSize": { "type": "number" },
          "pointOfOrigin": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          },
          "tileWidth": { "type": "integer" },
          "tileHeight": { "type": "integer" },
          "matrixWidth": { "type": "integer" },
          "matrixHeight": { "type": "integer" },
          "cornerOfOrigin": { "type": "string" }
        }
      }
    }
  }
}
