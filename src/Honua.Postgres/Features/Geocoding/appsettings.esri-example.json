{
  "Geocoding": {
    "Esri": {
      "Enabled": true,
      "Priority": 10,
      "BaseUrl": "https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer",

      // Option 1: API Key Authentication (recommended for most use cases)
      "ApiKey": "your-esri-api-key-here",

      // Option 2: OAuth Authentication (for enterprise scenarios)
      // "ClientId": "your-client-id",
      // "ClientSecret": "your-client-secret",
      // "TokenEndpoint": "https://www.arcgis.com/sharing/rest/oauth2/token",
      // "TokenCacheDurationMinutes": 55,

      "TimeoutSeconds": 30,
      "MaxResults": 10,
      "DefaultSpatialReference": 4326,
      "DefaultCountryCodes": null,
      "DefaultCountries": ["US", "CA"],

      "DefaultOutFields": [
        "Addr_type",
        "Country",
        "PlaceName",
        "Region",
        "Subregion",
        "City",
        "Postal",
        "AddNum",
        "StName",
        "StType",
        "District",
        "MetroArea",
        "Neighborhood",
        "LongLabel",
        "ShortLabel",
        "Match_addr"
      ],

      "DefaultLocator": null,
      "DefaultCategories": [
        "Address",
        "POI"
      ],

      "EnableSuggestions": true,
      "EnableBatchGeocoding": true,
      "MaxBatchSize": 1000,
      "UseCompression": true,
      "UserAgent": "Honua/1.0 (+https://honua.io) Esri-Provider",

      // Rate limiting (optional)
      "RateLimitRequestsPerSecond": 10.0,

      // Custom locators for specific operations (optional)
      "CustomLocators": {
        "address": "https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer",
        "poi": "https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer"
      }
    }
  }
}