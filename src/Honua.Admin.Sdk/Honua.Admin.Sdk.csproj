<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- NuGet Package Metadata -->
    <PackageId>Honua.Admin.Tools</PackageId>
    <Title>Honua Admin Tools</Title>
    <Description>Administrative tooling for Honua geospatial platform. Features service management, user administration, bulk operations, and Blazor UI integration for .NET applications.</Description>
    <Authors>Honua Project Contributors</Authors>
    <Copyright>Copyright (c) 2026 Honua Project Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/honua-project/honua-server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/honua-project/honua-server.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>geospatial;gis;admin;management;blazor;bulk-operations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Honua.Core/Honua.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Extensions for DI and HTTP -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />

    <!-- gRPC Client support -->
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />

    <!-- Blazor Components -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />

    <!-- File processing for bulk operations -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />

    <!-- Background processing -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.3" />

    <!-- Polly for resilience -->
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Honua.Admin.Sdk.Tests" />
  </ItemGroup>

</Project>