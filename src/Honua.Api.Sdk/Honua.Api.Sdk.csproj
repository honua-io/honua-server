<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1859;IDE0005;IDE0055</NoWarn>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- NuGet Package Metadata -->
    <PackageId>Honua.Core.Sdk</PackageId>
    <Title>Honua Core SDK</Title>
    <Description>Runtime .NET library for building production applications with Honua geospatial services. Features gRPC clients, feature queries, and mobile-ready spatial operations.</Description>
    <Authors>Honua Project Contributors</Authors>
    <Copyright>Copyright (c) 2026 Honua Project Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/honua-project/honua-server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/honua-project/honua-server.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>geospatial;gis;grpc;features;server;api;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Honua.Core/Honua.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Extensions for DI and HTTP -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />

    <!-- gRPC Client support -->
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.70.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />

    <!-- Connection pooling and resilience -->
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Honua.Api.Sdk.Tests" />
  </ItemGroup>

</Project>
