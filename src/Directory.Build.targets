<Project>

  <!-- Allow Mobile SDK builds to ignore documentation warnings -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Honua.Mobile.Sdk'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Also apply to dependencies when building mobile targets -->
  <PropertyGroup Condition="$(TargetFramework.Contains('android')) or $(TargetFramework.Contains('ios')) or $(TargetFramework.Contains('windows'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CA1873;IDE0073</WarningsNotAsErrors>
  </PropertyGroup>

</Project>