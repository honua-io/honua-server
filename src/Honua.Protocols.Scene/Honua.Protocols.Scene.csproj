<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      3D Tiles / OpenUSD Scene protocol assembly. Carved out of
      Honua.Protocols.Scene per the modularization Phase 1 plan.
      Its Infrastructure dependencies (Authentication, Caching, Helpers, Models,
      Validation) live in Honua.Hosting (audit-A1 / ADR-0044) and its scene
      dataset config/registry domain (SceneDatasetOptions, ConfigurationSceneDatasetRegistry)
      lives in Honua.Core. The protocol assembly may not ProjectReference
      Honua.Server (that's the cycle Phase 1 is solving).
    -->
    <!--
      Only AOT/trim warnings are suppressed at the project level: the source-
      generated System.Text.Json contexts and ASP.NET minimal-API hosting in
      this Web SDK assembly raise IL2026/IL3050/IL2104/IL3002/IL2075 that cannot
      be resolved in source without abandoning source-gen JSON, matching the
      sibling protocol assemblies (e.g. Honua.Protocols.Stac). Documentation
      (CS1591), unused-code (IDE0051/IDE0052), unnecessary-using (IDE0005), and
      API-design (CA*) warnings are NOT suppressed here — they are fixed at the
      root in source so warnings-as-errors stays meaningful.
    -->
    <NoWarn>$(NoWarn);IL2104;IL2026;IL3002;IL3050;IL2075</NoWarn>
    <RootNamespace>Honua.Protocols.Scene</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Core.Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\Honua.Geometry\Honua.Geometry.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.Scene\Honua.Scene.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Server" />
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.Scene.Tests" />
    <InternalsVisibleTo Include="Honua.TestKit" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
