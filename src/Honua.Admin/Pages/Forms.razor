@page "/forms"
@using Honua.Admin.Models
@using Honua.Admin.Services
@using Honua.Core.Features.Catalog.Abstractions
@inject IXlsFormService XlsFormService
@inject ILayerCatalog LayerCatalog
@* @inject IServiceCatalog ServiceCatalog *@
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>OpenRosa Form Designer - Honua Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <!-- Header -->
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudGrid AlignItems="Center">
                    <MudItem xs="8">
                        <MudText Typo="Typo.h4" GutterBottom="true">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                            OpenRosa Form Designer
                        </MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Create and manage XLSForm-compatible data collection forms for mobile field teams.
                            Industry-standard OpenRosa forms with modern gRPC delivery.
                        </MudText>
                    </MudItem>
                    <MudItem xs="4" Class="text-right">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  StartIcon="@Icons.Material.Filled.Add"
                                  OnClick="OpenCreateFormDialog">
                            New Form
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                  StartIcon="@Icons.Material.Filled.Upload"
                                  Class="ml-2"
                                  OnClick="OpenImportDialog">
                            Import Excel
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Forms List -->
        <MudItem xs="12">
            <MudDataGrid @ref="formsGrid"
                        Items="forms"
                        Filterable="true"
                        Sortable="true"
                        Elevation="2"
                        Loading="isLoading">

                <ToolBarContent>
                    <MudText Typo="Typo.h6">Forms (@forms.Count)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString"
                                 Placeholder="Search forms..."
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 IconSize="Size.Medium"
                                 Immediate="true"
                                 Class="mt-0" />
                </ToolBarContent>

                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Form Name" Sortable="true">
                        <CellTemplate>
                            <MudStack Row AlignItems="Center">
                                <MudIcon Icon="@GetStatusIcon(context.Item.Status)"
                                        Color="@GetStatusColor(context.Item.Status)" />
                                <MudText Typo="Typo.body2">
                                    <MudLink Href="@($"/forms/{context.Item.Id}")">
                                        @context.Item.Name
                                    </MudLink>
                                </MudText>
                            </MudStack>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Description" Title="Description" Sortable="false">
                        <CellTemplate>
                            <MudText Typo="Typo.caption">
                                @(string.IsNullOrEmpty(context.Item.Description) ? "No description" : context.Item.Description)
                            </MudText>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Status" Title="Status" Sortable="true">
                        <CellTemplate>
                            <MudChip Color="@GetStatusColor(context.Item.Status)"
                                    Size="Size.Small">
                                @context.Item.Status.ToString()
                            </MudChip>
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Version" Title="Version" Sortable="true" />

                    <PropertyColumn Property="x => x.ModifiedAt" Title="Modified" Sortable="true">
                        <CellTemplate>
                            <MudText Typo="Typo.caption">
                                @context.Item.ModifiedAt.ToString("MMM d, yyyy")
                            </MudText>
                        </CellTemplate>
                    </PropertyColumn>

                    <TemplateColumn Title="Layer">
                        <CellTemplate>
                            @if (!string.IsNullOrEmpty(context.Item.ServiceId))
                            {
                                <MudText Typo="Typo.caption">
                                    @context.Item.ServiceId / @context.Item.LayerId
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    No layer
                                </MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Actions" Sortable="false">
                        <CellTemplate>
                            <MudStack Row>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                             Size="Size.Small"
                                             OnClick="() => EditForm(context.Item)"
                                             Title="Edit Form" />

                                <MudIconButton Icon="@Icons.Material.Filled.Preview"
                                             Size="Size.Small"
                                             OnClick="() => PreviewForm(context.Item)"
                                             Title="Preview Form" />

                                @if (context.Item.Status == FormDeploymentStatus.Draft)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Publish"
                                                 Size="Size.Small"
                                                 Color="Color.Success"
                                                 OnClick="() => DeployForm(context.Item)"
                                                 Title="Deploy Form" />
                                }

                                <MudIconButton Icon="@Icons.Material.Filled.Analytics"
                                             Size="Size.Small"
                                             OnClick="() => ViewAnalytics(context.Item)"
                                             Title="View Analytics" />

                                <MudIconButton Icon="@Icons.Material.Filled.Download"
                                             Size="Size.Small"
                                             OnClick="() => ExportForm(context.Item)"
                                             Title="Export Excel" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                             Size="Size.Small"
                                             Color="Color.Error"
                                             OnClick="() => DeleteForm(context.Item)"
                                             Title="Delete Form" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="XlsForm" />
                </PagerContent>

            </MudDataGrid>
        </MudItem>

        <!-- Quick Stats -->
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="3">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudStack Row AlignItems="Center">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Large" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@forms.Count</MudText>
                                <MudText Typo="Typo.caption">Total Forms</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="3">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudStack Row AlignItems="Center">
                            <MudIcon Icon="@Icons.Material.Filled.Publish" Color="Color.Success" Size="Size.Large" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@forms.Count(f => f.Status == FormDeploymentStatus.Published)</MudText>
                                <MudText Typo="Typo.caption">Published</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="3">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudStack Row AlignItems="Center">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Large" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@forms.Count(f => f.Status == FormDeploymentStatus.Draft)</MudText>
                                <MudText Typo="Typo.caption">Drafts</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="3">
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudStack Row AlignItems="Center">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" Size="Size.Large" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@forms.Count(f => !string.IsNullOrEmpty(f.ServiceId))</MudText>
                                <MudText Typo="Typo.caption">Layer Forms</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<XlsForm> forms = new();
    private MudDataGrid<XlsForm> formsGrid = new();
    private string searchString = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadForms();
    }

    private async Task LoadForms()
    {
        isLoading = true;
        try
        {
            forms = await XlsFormService.GetFormsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading forms: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateFormDialog()
    {
        var dialog = await Dialog.ShowAsync<CreateFormDialog>("Create New Form");
        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is LayerFormTemplate template)
        {
            await CreateFormFromTemplate(template);
        }
    }

    private async Task CreateFormFromTemplate(LayerFormTemplate template)
    {
        try
        {
            var xlsForm = new XlsForm
            {
                Name = template.LayerName + " Data Collection",
                Description = template.Description,
                ServiceId = template.ServiceId,
                LayerId = template.LayerId,
                Survey = template.SuggestedSurvey
            };

            xlsForm.Settings.FormId = template.LayerName.Replace(" ", "_").ToLower();
            xlsForm.Settings.FormTitle = xlsForm.Name;

            await XlsFormService.SaveFormAsync(xlsForm);
            await LoadForms();

            Snackbar.Add("Form created successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating form: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenImportDialog()
    {
        // Implementation for Excel import would go here
        Snackbar.Add("Excel import feature coming soon!", Severity.Info);
    }

    private void EditForm(XlsForm form)
    {
        // Navigate to form designer page
        // Navigation.NavigateTo($"/forms/{form.Id}/edit");
        Snackbar.Add("Form designer opening soon!", Severity.Info);
    }

    private async Task PreviewForm(XlsForm form)
    {
        try
        {
            var preview = await XlsFormService.GeneratePreviewAsync(form.Id);

            var parameters = new DialogParameters
            {
                ["Form"] = form,
                ["Preview"] = preview
            };

            await Dialog.ShowAsync<FormPreviewDialog>("Form Preview", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Large });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating preview: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeployForm(XlsForm form)
    {
        try
        {
            var target = new FormDeploymentTarget { DeployToAll = true };
            var result = await XlsFormService.DeployFormAsync(form.Id, target);

            if (result.Success)
            {
                Snackbar.Add($"Form deployed to {result.SuccessfulDeployments} devices!", Severity.Success);
                await LoadForms();
            }
            else
            {
                Snackbar.Add($"Deployment failed: {result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deploying form: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewAnalytics(XlsForm form)
    {
        try
        {
            var analytics = await XlsFormService.GetFormAnalyticsAsync(form.Id, DateRange.LastMonth);

            var parameters = new DialogParameters { ["Analytics"] = analytics };
            await Dialog.ShowAsync<FormAnalyticsDialog>("Form Analytics", parameters);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading analytics: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportForm(XlsForm form)
    {
        try
        {
            var excelData = await XlsFormService.ExportToExcelAsync(form.Id);

            // In production, this would trigger file download
            Snackbar.Add("Excel export ready for download!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting form: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteForm(XlsForm form)
    {
        bool? confirm = await Dialog.ShowMessageBox(
            "Delete Form",
            $"Are you sure you want to delete '{form.Name}'? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await XlsFormService.DeleteFormAsync(form.Id);
                await LoadForms();
                Snackbar.Add("Form deleted successfully.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting form: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetStatusIcon(FormDeploymentStatus status)
    {
        return status switch
        {
            FormDeploymentStatus.Draft => Icons.Material.Filled.Edit,
            FormDeploymentStatus.Testing => Icons.Material.Filled.Science,
            FormDeploymentStatus.Published => Icons.Material.Filled.CheckCircle,
            FormDeploymentStatus.Archived => Icons.Material.Filled.Archive,
            FormDeploymentStatus.Error => Icons.Material.Filled.Error,
            _ => Icons.Material.Filled.Help
        };
    }

    private Color GetStatusColor(FormDeploymentStatus status)
    {
        return status switch
        {
            FormDeploymentStatus.Draft => Color.Warning,
            FormDeploymentStatus.Testing => Color.Info,
            FormDeploymentStatus.Published => Color.Success,
            FormDeploymentStatus.Archived => Color.Default,
            FormDeploymentStatus.Error => Color.Error,
            _ => Color.Default
        };
    }
}