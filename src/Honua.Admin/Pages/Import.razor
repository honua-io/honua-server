@page "/import"
@attribute [Authorize(Policy = AdminAuthorizationPolicies.AdminPolicy)]
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable

@inject IGeoservicesImportClient GeoservicesImportClient
@inject IFileImportClient FileImportClient
@inject ISnackbar Snackbar

<PageTitle>Import</PageTitle>

<MudStack Spacing="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4" HtmlTag="h1">Import</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadActiveJobsAsync"
                   Disabled="@_isLoadingJobs">
            Refresh jobs
        </MudButton>
    </MudStack>

    <MudText Typo="Typo.body2">
        Import datasets and external services into Honua.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2">ArcGIS service</MudText>

            <MudTextField T="string"
                          Label="Service URL"
                          Placeholder="https://example.com/arcgis/rest/services/YourService/FeatureServer"
                          Immediate="true"
                          Value="_serviceUrl"
                          ValueChanged="HandleServiceUrlChanged"
                          Error="@(!string.IsNullOrWhiteSpace(_serviceUrlError))"
                          ErrorText="@_serviceUrlError"
                          Disabled="@_isDiscovering"
                          data-testid="import-service-url" />

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="DiscoverAsync"
                           Disabled="@_isDiscovering"
                           data-testid="import-discover">
                    Discover
                </MudButton>
                @if (_isDiscovering)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                @if (_discoveryResponse is not null)
                {
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                        @_discoveryResponse.ServiceName
                    </MudChip>
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_discoveryError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_discoveryError</MudAlert>
            }

            @if (_discoveryResponse is not null)
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2">Service</MudText>
                        <MudText Typo="Typo.body2">@_discoveryResponse.ServiceName</MudText>
                        @if (!string.IsNullOrWhiteSpace(_discoveryResponse.Description))
                        {
                            <MudText Typo="Typo.caption">@_discoveryResponse.Description</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">Details</MudText>
                            <MudText Typo="Typo.body2">Layers: @_layers.Count</MudText>
                            <MudText Typo="Typo.body2">SRID: @(_discoveryResponse.SpatialReferenceWkid?.ToString() ?? "-")</MudText>
                            <MudText Typo="Typo.body2">Max records: @(_discoveryResponse.MaxRecordCount?.ToString("N0") ?? "-")</MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Layers</MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Text" OnClick="SelectAllLayers" Disabled="@(_layers.Count == 0)">
                        Select all
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ClearSelection" Disabled="@(_layers.Count == 0)">
                        Clear
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (_layers.Count == 0)
            {
                <MudText Typo="Typo.body2">Discover a service to list layers.</MudText>
            }
            else
            {
                <MudTable Items="_layers" Dense="true" Hover="true" data-testid="import-layers-table">
                    <HeaderContent>
                        <MudTh>Select</MudTh>
                        <MudTh>Layer</MudTh>
                        <MudTh>Geometry</MudTh>
                        <MudTh>Features (est)</MudTh>
                        <MudTh>Attachments</MudTh>
                        <MudTh>Target table</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Select">
                            <MudCheckBox T="bool"
                                         Value="@row.Selected"
                                         ValueChanged="@(value => SetLayerSelected(row, value))"
                                         Disabled="@_isStartingImport"
                                         data-testid="@($"import-layer-select-{row.Layer.Id}")" />
                        </MudTd>
                        <MudTd DataLabel="Layer">
                            <MudText Typo="Typo.body2">@row.Layer.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(row.Layer.Description))
                            {
                                <MudText Typo="Typo.caption">@row.Layer.Description</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Geometry">@FormatGeometry(row.Layer.GeometryType)</MudTd>
                        <MudTd DataLabel="Features (est)">@FormatCount(row.Layer.FeatureCount)</MudTd>
                        <MudTd DataLabel="Attachments">
                            @if (row.Layer.HasAttachments)
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">Yes</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">No</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Target table">
                            @{
                                var tableError = GetTableNameError(row);
                            }
                            <MudTextField T="string"
                                          Value="@row.TableName"
                                          ValueChanged="@(value => UpdateTableName(row, value))"
                                          Immediate="true"
                                          Margin="Margin.Dense"
                                          Placeholder="table_name"
                                          Error="@(!string.IsNullOrWhiteSpace(tableError))"
                                          ErrorText="@tableError"
                                          Disabled="@_isStartingImport"
                                          data-testid="@($"import-layer-table-{row.Layer.Id}")" />
                        </MudTd>
                        <MudTd>
                            @if (!string.IsNullOrWhiteSpace(row.StartError))
                            {
                                <MudTooltip Text="@row.StartError">
                                    <MudIconButton Icon="@Icons.Material.Filled.Error"
                                                   Color="Color.Error"
                                                   OnClick="@(async () => await RetryLayerAsync(row))"
                                                   Disabled="@_isStartingImport" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" @bind-Value="_overwriteExisting" Color="Color.Primary" Label="Overwrite existing tables" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSwitch T="bool" @bind-Value="_autoPublish" Color="Color.Primary" Label="Auto-publish layers" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(_selectionError))
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@_selectionError</MudAlert>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.FlexEnd">
                <MudText Typo="Typo.body2">Selected: @SelectedLayerCount</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="StartImportAsync"
                           Disabled="@(!CanStartImport)"
                           data-testid="import-start">
                    Start import
                </MudButton>
                @if (_isStartingImport)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2">File upload</MudText>
            <MudText Typo="Typo.body2">
                Upload GeoJSON and other supported formats directly into Honua.
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_fileImportError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_fileImportError</MudAlert>
            }

            <MudStack Spacing="1">
                <MudText Typo="Typo.caption">File</MudText>
                <InputFile OnChange="HandleFileSelected" data-testid="import-file-input" />
                @if (!string.IsNullOrWhiteSpace(_fileImportFileName))
                {
                    <MudText Typo="Typo.caption" data-testid="import-file-name">@_fileImportFileName</MudText>
                }
            </MudStack>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="Table name"
                                  Immediate="true"
                                  Value="_fileTableName"
                                  ValueChanged="HandleFileTableNameChanged"
                                  Error="@(!string.IsNullOrWhiteSpace(_fileTableError))"
                                  ErrorText="@_fileTableError"
                                  Disabled="@_isImportingFile"
                                  data-testid="import-file-table" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?"
                                     Label="Target SRID"
                                     Immediate="true"
                                     Value="_fileTargetSrid"
                                     ValueChanged="HandleFileTargetSridChanged"
                                     Disabled="@_isImportingFile"
                                     data-testid="import-file-target-srid" />
                </MudItem>
            </MudGrid>

            <MudSwitch T="bool"
                       @bind-Value="_fileOverwriteExisting"
                       Color="Color.Primary"
                       Label="Overwrite existing table" />

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="PreviewFileAsync"
                           Disabled="@(!CanPreviewFile)"
                           data-testid="import-file-preview">
                    Preview
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="StartFileImportAsync"
                           Disabled="@(!CanImportFile)"
                           data-testid="import-file-start">
                    Import file
                </MudButton>
                @if (_isPreviewingFile || _isImportingFile)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
            </MudStack>

            @if (_filePreview is not null)
            {
                <MudPaper Class="pa-3" Elevation="0" data-testid="import-file-preview-result">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2">Preview</MudText>
                            <MudText Typo="Typo.body2">Format: @_filePreview.Format</MudText>
                            <MudText Typo="Typo.body2">Features: @_filePreview.TotalFeatureCount</MudText>
                            <MudText Typo="Typo.body2">Detected SRID: @(_filePreview.DetectedSrid?.ToString() ?? "-")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (_filePreview.AvailableLayers.Length > 0)
                            {
                                <MudText Typo="Typo.subtitle2">Layers</MudText>
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    @foreach (var layer in _filePreview.AvailableLayers)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@layer</MudChip>
                                    }
                                </MudStack>
                            }
                        </MudItem>
                    </MudGrid>

                    @if (_filePreview.SampleProperties.Count > 0)
                    {
                        <MudTable Items="_filePreview.SampleProperties" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Field</MudTh>
                                <MudTh>Sample value</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="item">
                                <MudTd DataLabel="Field">@item.Key</MudTd>
                                <MudTd DataLabel="Sample value">@item.Value</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            }

            @if (_fileImportResult is not null)
            {
                <MudAlert Severity="@(_fileImportResult.Success ? Severity.Success : Severity.Error)"
                          Dense="true"
                          data-testid="import-file-result">
                    @if (_fileImportResult.Success)
                    {
                        <span>Imported @_fileImportResult.FeatureCount features into @_fileImportResult.TableName.</span>
                    }
                    else
                    {
                        <span>@(_fileImportResult.ErrorMessage ?? "File import failed.")</span>
                    }
                </MudAlert>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Import jobs</MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Text" OnClick="ClearCompletedJobs" Disabled="@(!HasCompletedJobs)">
                        Clear completed
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_jobsError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_jobsError</MudAlert>
            }

            <MudTable Items="JobList" Dense="true" Hover="true" data-testid="import-jobs-table">
                <HeaderContent>
                    <MudTh>Status</MudTh>
                    <MudTh>Layer</MudTh>
                    <MudTh>Target table</MudTh>
                    <MudTh>Progress</MudTh>
                    <MudTh>Started</MudTh>
                    <MudTh>Completed</MudTh>
                    <MudTh>Details</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Status">
                        <MudStack Spacing="0">
                            <MudChip T="string"
                                     Color="@GetStatusColor(context.Status)"
                                     Size="Size.Small"
                                     data-testid="@($"import-job-status-{context.JobId}")">
                                @FormatStatus(context.Status)
                            </MudChip>
                            @if (!string.IsNullOrWhiteSpace(context.CurrentPhase))
                            {
                                <MudText Typo="Typo.caption">@context.CurrentPhase</MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Layer">
                        <MudText Typo="Typo.body2">@GetLayerDisplayName(context)</MudText>
                        <MudText Typo="Typo.caption">@context.SourceServiceUrl</MudText>
                    </MudTd>
                    <MudTd DataLabel="Target table">@context.TableName</MudTd>
                    <MudTd DataLabel="Progress">
                        @if (TryGetProgressPercent(context, out var percent))
                        {
                            <MudProgressLinear Value="@percent" Color="Color.Primary" />
                            <MudText Typo="Typo.caption">@FormatProgress(context)</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">@FormatProgress(context)</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Started">@FormatTimestamp(context.StartedAt)</MudTd>
                    <MudTd DataLabel="Completed">@FormatTimestamp(context.CompletedAt)</MudTd>
                    <MudTd DataLabel="Details">
                        @if (!string.IsNullOrWhiteSpace(context.ErrorMessage))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@context.ErrorMessage</MudText>
                        }
                        @if (context.Warnings.Count > 0)
                        {
                            <MudText Typo="Typo.caption">Warnings: @context.Warnings.Count</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @if (IsActiveStatus(context.Status))
                        {
                            <MudTooltip Text="Cancel">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                               Color="Color.Warning"
                                               OnClick="@(async () => await CancelJobAsync(context))"
                                               Disabled="@IsJobActionBusy(context.JobId)"
                                               data-testid="@($"import-job-cancel-{context.JobId}")" />
                            </MudTooltip>
                        }
                        else if (context.Status is GeoservicesImportStatus.Failed or GeoservicesImportStatus.Cancelled)
                        {
                            <MudTooltip Text="Retry">
                                <MudIconButton Icon="@Icons.Material.Filled.Replay"
                                               Color="Color.Primary"
                                               OnClick="@(async () => await RetryJobAsync(context))"
                                               Disabled="@IsJobActionBusy(context.JobId)"
                                               data-testid="@($"import-job-retry-{context.JobId}")" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4">No import jobs yet.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private static readonly TimeSpan _pollInterval = TimeSpan.FromSeconds(4);
    private static readonly Regex _tableNamePattern = new("^[A-Za-z_][A-Za-z0-9_]*$", RegexOptions.CultureInvariant);
    private static readonly Regex _tableNameCleanup = new("[^A-Za-z0-9_]+", RegexOptions.CultureInvariant);

    private readonly List<LayerSelection> _layers = new();
    private readonly Dictionary<string, GeoservicesImportProgress> _jobProgress = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _jobActionsInProgress = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _pollingCts;
    private Task? _pollingTask;

    private GeoservicesDiscoverResponse? _discoveryResponse;
    private string? _serviceUrl;
    private string? _serviceUrlError;
    private string? _discoveryError;
    private string? _jobsError;
    private string? _selectionError;
    private string? _errorMessage;
    private bool _isDiscovering;
    private bool _isStartingImport;
    private bool _isLoadingJobs;
    private bool _overwriteExisting;
    private bool _autoPublish = true;
    private IBrowserFile? _fileImportFile;
    private string? _fileImportFileName;
    private string? _fileTableName;
    private string? _fileTableError;
    private FilePreviewResponse? _filePreview;
    private FileImportResult? _fileImportResult;
    private string? _fileImportError;
    private int? _fileSourceSrid;
    private int? _fileTargetSrid = 4326;
    private bool _fileOverwriteExisting;
    private bool _isPreviewingFile;
    private bool _isImportingFile;

    private int SelectedLayerCount => _layers.Count(layer => layer.Selected);

    private bool CanStartImport =>
        !_isStartingImport &&
        _discoveryResponse is not null &&
        SelectedLayerCount > 0 &&
        string.IsNullOrWhiteSpace(_selectionError);

    private IReadOnlyList<GeoservicesImportProgress> JobList => _jobProgress
        .Values
        .OrderByDescending(job => job.StartedAt)
        .ToArray();

    private bool HasCompletedJobs => _jobProgress.Values.Any(job => !IsActiveStatus(job.Status));

    private bool CanPreviewFile =>
        !_isPreviewingFile &&
        !_isImportingFile &&
        _fileImportFile is not null;

    private bool CanImportFile =>
        !_isImportingFile &&
        _fileImportFile is not null &&
        string.IsNullOrWhiteSpace(_fileTableError) &&
        !string.IsNullOrWhiteSpace(_fileTableName);

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveJobsAsync();
    }

    private async Task LoadActiveJobsAsync()
    {
        _isLoadingJobs = true;
        _jobsError = null;
        try
        {
            var result = await GeoservicesImportClient.ListJobsAsync();
            if (!result.Success || result.Data is null)
            {
                _jobsError = result.Message ?? "Failed to load import jobs.";
                return;
            }

            foreach (var job in result.Data.Jobs)
            {
                _jobProgress[job.JobId] = job;
            }

            if (_jobProgress.Values.Any(job => IsActiveStatus(job.Status)))
            {
                await EnsurePollingAsync();
            }
        }
        finally
        {
            _isLoadingJobs = false;
        }
    }

    private void HandleServiceUrlChanged(string value)
    {
        _serviceUrl = value;
        _serviceUrlError = null;
        _discoveryError = null;
        _discoveryResponse = null;
        _layers.Clear();
        _selectionError = null;
    }

    private async Task DiscoverAsync()
    {
        _errorMessage = null;
        _serviceUrlError = ValidateServiceUrl();
        if (!string.IsNullOrWhiteSpace(_serviceUrlError))
        {
            return;
        }

        _isDiscovering = true;
        _discoveryError = null;
        _discoveryResponse = null;
        _layers.Clear();
        _selectionError = null;

        try
        {
            var request = new GeoservicesDiscoverRequest
            {
                ServiceUrl = _serviceUrl?.Trim(),
                TimeoutSeconds = 30
            };

            var result = await GeoservicesImportClient.DiscoverAsync(request);
            if (!result.Success || result.Data is null)
            {
                _discoveryError = result.Message ?? "Failed to discover service.";
                return;
            }

            _discoveryResponse = result.Data;
            _layers.Clear();
            foreach (var layer in result.Data.Layers)
            {
                _layers.Add(new LayerSelection(layer, DefaultTableName(layer)));
            }
        }
        finally
        {
            _isDiscovering = false;
            RefreshSelectionState();
        }
    }

    private async Task StartImportAsync()
    {
        _selectionError = GetSelectionError();
        if (!string.IsNullOrWhiteSpace(_selectionError))
        {
            Snackbar.Add(_selectionError, Severity.Warning);
            return;
        }

        if (_discoveryResponse is null)
        {
            Snackbar.Add("Discover a service before starting an import.", Severity.Warning);
            return;
        }

        var selectedLayers = _layers.Where(layer => layer.Selected).ToList();
        if (selectedLayers.Count == 0)
        {
            Snackbar.Add("Select at least one layer to import.", Severity.Warning);
            return;
        }

        _isStartingImport = true;
        try
        {
            foreach (var layer in selectedLayers)
            {
                await QueueLayerImportAsync(layer, _discoveryResponse.ServiceUrl);
            }
        }
        finally
        {
            _isStartingImport = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        _fileImportFile = args.File;
        _fileImportFileName = _fileImportFile?.Name;
        _fileTableName = string.IsNullOrWhiteSpace(_fileTableName)
            ? DefaultTableName(_fileImportFileName)
            : _fileTableName;
        _fileTableError = ValidateFileTableName(_fileTableName);
        _filePreview = null;
        _fileImportResult = null;
        _fileImportError = null;
        _fileSourceSrid = null;
        _fileTargetSrid ??= 4326;
    }

    private void HandleFileTableNameChanged(string value)
    {
        _fileTableName = value;
        _fileTableError = ValidateFileTableName(value);
    }

    private void HandleFileTargetSridChanged(int? value)
    {
        _fileTargetSrid = value;
    }

    private async Task PreviewFileAsync()
    {
        if (_fileImportFile is null)
        {
            Snackbar.Add("Select a file to preview.", Severity.Warning);
            return;
        }

        _isPreviewingFile = true;
        _fileImportError = null;
        _fileImportResult = null;
        try
        {
            var result = await FileImportClient.PreviewAsync(_fileImportFile);
            if (!result.Success || result.Data is null)
            {
                _fileImportError = result.Message ?? "Failed to preview file.";
                return;
            }

            _filePreview = result.Data;
            _fileSourceSrid = result.Data.DetectedSrid;
            if (!_fileTargetSrid.HasValue)
            {
                _fileTargetSrid = result.Data.DetectedSrid ?? 4326;
            }
        }
        finally
        {
            _isPreviewingFile = false;
        }
    }

    private async Task StartFileImportAsync()
    {
        if (_fileImportFile is null)
        {
            Snackbar.Add("Select a file to import.", Severity.Warning);
            return;
        }

        _fileTableError = ValidateFileTableName(_fileTableName);
        if (!string.IsNullOrWhiteSpace(_fileTableError))
        {
            Snackbar.Add(_fileTableError, Severity.Warning);
            return;
        }

        _isImportingFile = true;
        _fileImportError = null;
        _fileImportResult = null;
        try
        {
            var result = await FileImportClient.UploadAsync(
                _fileImportFile,
                _fileTableName ?? string.Empty,
                _fileSourceSrid,
                _fileTargetSrid,
                _fileOverwriteExisting);

            if (!result.Success || result.Data is null)
            {
                _fileImportError = result.Message ?? "File import failed.";
                return;
            }

            _fileImportResult = result.Data;
            if (!_fileImportResult.Success)
            {
                _fileImportError = _fileImportResult.ErrorMessage ?? "File import failed.";
            }
        }
        finally
        {
            _isImportingFile = false;
        }
    }

    private async Task RetryLayerAsync(LayerSelection layer)
    {
        if (_discoveryResponse is null)
        {
            Snackbar.Add("Discover a service before retrying an import.", Severity.Warning);
            return;
        }

        await QueueLayerImportAsync(layer, _discoveryResponse.ServiceUrl);
    }

    private async Task QueueLayerImportAsync(LayerSelection layer, string serviceUrl)
    {
        layer.StartError = null;

        var request = new GeoservicesStartImportRequest
        {
            ServiceUrl = serviceUrl,
            LayerId = layer.Layer.Id,
            TableName = layer.TableName,
            OverwriteExisting = _overwriteExisting,
            AutoPublish = _autoPublish
        };

        await QueueImportAsync(request, layer);
    }

    private async Task QueueImportAsync(GeoservicesStartImportRequest request, LayerSelection? layer = null)
    {
        if (string.IsNullOrWhiteSpace(request.ServiceUrl))
        {
            const string message = "Service URL is required to start an import.";
            if (layer is not null)
            {
                layer.StartError = message;
            }

            Snackbar.Add(message, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(request.TableName))
        {
            const string message = "Table name is required to start an import.";
            if (layer is not null)
            {
                layer.StartError = message;
            }

            Snackbar.Add(message, Severity.Error);
            return;
        }

        var result = await GeoservicesImportClient.StartImportAsync(request);
        if (!result.Success || result.Data is null)
        {
            var message = result.Message ?? "Failed to start import.";
            if (layer is not null)
            {
                layer.StartError = message;
            }

            Snackbar.Add(message, Severity.Error);
            return;
        }

        await RefreshJobAsync(result.Data.JobId, request.ServiceUrl, request.LayerId, request.TableName);
        await EnsurePollingAsync();
    }

    private async Task RefreshJobAsync(string jobId, string? serviceUrl = null, int? layerId = null, string? tableName = null)
    {
        var result = await GeoservicesImportClient.GetJobStatusAsync(jobId);
        if (!result.Success || result.Data is null)
        {
            _jobsError = result.Message ?? "Failed to load import job status.";
            _jobProgress[jobId] = new GeoservicesImportProgress
            {
                JobId = jobId,
                Status = GeoservicesImportStatus.Queued,
                SourceServiceUrl = serviceUrl ?? string.Empty,
                SourceLayerId = layerId ?? 0,
                TableName = tableName ?? string.Empty,
                StartedAt = DateTimeOffset.UtcNow
            };
            return;
        }

        _jobProgress[jobId] = result.Data;
    }

    private async Task CancelJobAsync(GeoservicesImportProgress job)
    {
        if (!BeginJobAction(job.JobId))
        {
            return;
        }

        try
        {
            var result = await GeoservicesImportClient.CancelJobAsync(job.JobId);
            if (!result.Success)
            {
                Snackbar.Add(result.Message ?? "Failed to cancel import job.", Severity.Error);
                return;
            }

            await RefreshJobAsync(job.JobId, job.SourceServiceUrl, job.SourceLayerId, job.TableName);
        }
        finally
        {
            EndJobAction(job.JobId);
        }
    }

    private async Task RetryJobAsync(GeoservicesImportProgress job)
    {
        if (string.IsNullOrWhiteSpace(job.SourceServiceUrl))
        {
            Snackbar.Add("Missing service URL for retry.", Severity.Error);
            return;
        }

        if (!BeginJobAction(job.JobId))
        {
            return;
        }

        try
        {
            var request = new GeoservicesStartImportRequest
            {
                ServiceUrl = job.SourceServiceUrl,
                LayerId = job.SourceLayerId,
                TableName = job.TableName,
                OverwriteExisting = _overwriteExisting,
                AutoPublish = _autoPublish
            };

            await QueueImportAsync(request);
        }
        finally
        {
            EndJobAction(job.JobId);
        }
    }

    private void ClearCompletedJobs()
    {
        var completed = _jobProgress
            .Where(pair => !IsActiveStatus(pair.Value.Status))
            .Select(pair => pair.Key)
            .ToList();

        foreach (var jobId in completed)
        {
            _jobProgress.Remove(jobId);
        }
    }

    private void SelectAllLayers()
    {
        foreach (var layer in _layers)
        {
            layer.Selected = true;
        }

        RefreshSelectionState();
    }

    private void ClearSelection()
    {
        foreach (var layer in _layers)
        {
            layer.Selected = false;
        }

        RefreshSelectionState();
    }

    private void SetLayerSelected(LayerSelection layer, bool value)
    {
        layer.Selected = value;
        RefreshSelectionState();
    }

    private void UpdateTableName(LayerSelection layer, string value)
    {
        layer.TableName = value;
        RefreshSelectionState();
    }

    private void RefreshSelectionState()
    {
        _selectionError = GetSelectionError();
    }

    private string? GetSelectionError()
    {
        var selected = _layers.Where(layer => layer.Selected).ToList();
        if (selected.Count == 0)
        {
            return null;
        }

        foreach (var layer in selected)
        {
            if (string.IsNullOrWhiteSpace(layer.TableName))
            {
                return "Table names are required for selected layers.";
            }

            if (!IsValidTableName(layer.TableName))
            {
                return $"'{layer.TableName}' is not a valid table name.";
            }
        }

        var duplicate = selected
            .GroupBy(layer => layer.TableName.Trim(), StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(group => group.Count() > 1);

        if (duplicate is not null)
        {
            return $"Table name '{duplicate.Key}' is used by multiple selected layers.";
        }

        return null;
    }

    private string? GetTableNameError(LayerSelection layer)
    {
        if (!layer.Selected)
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(layer.TableName))
        {
            return "Table name is required.";
        }

        if (!IsValidTableName(layer.TableName))
        {
            return "Use letters, numbers, and underscores. Start with a letter or underscore.";
        }

        var isDuplicate = _layers
            .Where(item => item.Selected)
            .Count(item => string.Equals(item.TableName.Trim(), layer.TableName.Trim(), StringComparison.OrdinalIgnoreCase)) > 1;

        return isDuplicate ? "Table name duplicates another selection." : null;
    }

    private static string? ValidateFileTableName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Table name is required.";
        }

        if (!IsValidTableName(name))
        {
            return "Use letters, numbers, and underscores. Start with a letter or underscore.";
        }

        return null;
    }

    private static bool IsValidTableName(string name)
        => _tableNamePattern.IsMatch(name.Trim());

    private static string DefaultTableName(string? fileName)
    {
        var baseName = string.IsNullOrWhiteSpace(fileName)
            ? "import_data"
            : System.IO.Path.GetFileNameWithoutExtension(fileName);
        var sanitized = _tableNameCleanup.Replace(baseName ?? string.Empty, "_").Trim('_');
        if (string.IsNullOrWhiteSpace(sanitized))
        {
            sanitized = "import_data";
        }

        if (char.IsDigit(sanitized[0]))
        {
            sanitized = $"import_{sanitized}";
        }

        return sanitized.ToLowerInvariant();
    }

    private static string DefaultTableName(GeoservicesLayerSummary layer)
    {
        var candidate = string.IsNullOrWhiteSpace(layer.Name) ? $"layer_{layer.Id}" : layer.Name;
        var sanitized = _tableNameCleanup.Replace(candidate, "_").Trim('_');
        if (string.IsNullOrWhiteSpace(sanitized))
        {
            sanitized = $"layer_{layer.Id}";
        }

        if (char.IsDigit(sanitized[0]))
        {
            sanitized = $"layer_{sanitized}";
        }

        return sanitized.ToLowerInvariant();
    }

    private async Task EnsurePollingAsync()
    {
        if (_pollingTask is { IsCompleted: false })
        {
            return;
        }

        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
        _pollingCts = new CancellationTokenSource();
        _pollingTask = PollJobsAsync(_pollingCts.Token);
        await Task.CompletedTask;
    }

    private async Task PollJobsAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(_pollInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await UpdateActiveJobsAsync(cancellationToken);
                if (!_jobProgress.Values.Any(job => IsActiveStatus(job.Status)))
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation.
        }
    }

    private async Task UpdateActiveJobsAsync(CancellationToken cancellationToken)
    {
        var activeJobIds = _jobProgress
            .Values
            .Where(job => IsActiveStatus(job.Status))
            .Select(job => job.JobId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        if (activeJobIds.Length == 0)
        {
            return;
        }

        foreach (var jobId in activeJobIds)
        {
            var result = await GeoservicesImportClient.GetJobStatusAsync(jobId, cancellationToken);
            if (result.Success && result.Data is not null)
            {
                _jobProgress[jobId] = result.Data;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private static bool TryGetProgressPercent(GeoservicesImportProgress progress, out int percent)
    {
        percent = 0;

        if (progress.EstimatedTotalFeatures is > 0)
        {
            percent = Math.Clamp((int)Math.Round(progress.FeaturesProcessed * 100d / progress.EstimatedTotalFeatures.Value), 0, 100);
            return true;
        }

        if (progress.TotalBatches is > 0)
        {
            percent = Math.Clamp((int)Math.Round(progress.BatchesCompleted * 100d / progress.TotalBatches.Value), 0, 100);
            return true;
        }

        return false;
    }

    private static string FormatProgress(GeoservicesImportProgress progress)
    {
        if (progress.EstimatedTotalFeatures is > 0)
        {
            return $"{progress.FeaturesProcessed:N0} / {progress.EstimatedTotalFeatures.Value:N0} features";
        }

        if (progress.TotalBatches is > 0)
        {
            return $"{progress.BatchesCompleted:N0} / {progress.TotalBatches.Value:N0} batches";
        }

        return $"{progress.FeaturesProcessed:N0} features";
    }

    private static string FormatGeometry(string? geometryType)
        => string.IsNullOrWhiteSpace(geometryType) ? "-" : geometryType;

    private static string FormatCount(int? count)
        => count.HasValue ? count.Value.ToString("N0") : "-";

    private static string FormatTimestamp(DateTimeOffset? timestamp)
        => timestamp.HasValue ? timestamp.Value.ToLocalTime().ToString("g") : "-";

    private static string GetLayerDisplayName(GeoservicesImportProgress progress)
        => progress.SourceLayerName ?? $"Layer {progress.SourceLayerId}";

    private static string FormatStatus(GeoservicesImportStatus status)
        => status.ToString();

    private static Color GetStatusColor(GeoservicesImportStatus status)
        => status switch
        {
            GeoservicesImportStatus.Completed => Color.Success,
            GeoservicesImportStatus.Failed => Color.Error,
            GeoservicesImportStatus.Cancelled => Color.Warning,
            _ => Color.Info
        };

    private static bool IsActiveStatus(GeoservicesImportStatus status)
        => status is not (GeoservicesImportStatus.Completed or GeoservicesImportStatus.Failed or GeoservicesImportStatus.Cancelled);

    private bool BeginJobAction(string jobId)
        => _jobActionsInProgress.Add(jobId);

    private void EndJobAction(string jobId)
        => _jobActionsInProgress.Remove(jobId);

    private bool IsJobActionBusy(string jobId)
        => _jobActionsInProgress.Contains(jobId);

    private string? ValidateServiceUrl()
    {
        if (string.IsNullOrWhiteSpace(_serviceUrl))
        {
            return "Service URL is required.";
        }

        if (!Uri.TryCreate(_serviceUrl, UriKind.Absolute, out var uri) ||
            (uri.Scheme != "http" && uri.Scheme != "https"))
        {
            return "Enter a valid HTTP(S) service URL.";
        }

        return null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollingCts is not null)
        {
            _pollingCts.Cancel();
            _pollingCts.Dispose();
        }

        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
                // Ignore cancellation.
            }
        }
    }

    private sealed class LayerSelection
    {
        public LayerSelection(GeoservicesLayerSummary layer, string tableName)
        {
            Layer = layer;
            TableName = tableName;
        }

        public GeoservicesLayerSummary Layer { get; }
        public bool Selected { get; set; }
        public string TableName { get; set; }
        public string? StartError { get; set; }
    }
}
