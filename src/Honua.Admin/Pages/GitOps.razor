@page "/admin/gitops"
@attribute [Authorize]

@inject GitOpsAdminClient GitOpsClient
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Honua Admin | GitOps</PageTitle>

<div class="gitops-shell">
    <section class="hero">
        <div>
            <p class="eyebrow">GitOps Console</p>
            <h1>Track watched commits, compare manifests, and clear approval queues.</h1>
            <p class="hero-copy">
                This console surfaces the running GitOps loop from watch configuration through
                pending approvals and applied manifest history.
            </p>
        </div>
        <div class="hero-actions">
            <button class="action-button primary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
            <span class="feature-pill @GetFeatureTone()">@GetFeatureLabel()</span>
        </div>
    </section>

    @if (_error is not null)
    {
        <div class="banner error">@_error</div>
    }

    @if (_notice is not null)
    {
        <div class="banner notice">@_notice</div>
    }

    <section class="stats-grid" aria-label="GitOps summary">
        <article class="stat-card">
            <span class="stat-label">Pending approvals</span>
            <strong>@_pendingApprovals.Count</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Detected changes</span>
            <strong>@_changes.Count</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Applied changes</span>
            <strong>@_changes.Count(change => string.Equals(change.Status, "applied", StringComparison.OrdinalIgnoreCase))</strong>
        </article>
        <article class="stat-card">
            <span class="stat-label">Failed changes</span>
            <strong>@_changes.Count(change => string.Equals(change.Status, "failed", StringComparison.OrdinalIgnoreCase))</strong>
        </article>
    </section>

    <div class="workspace-grid">
        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>Watch Configuration</h2>
                    <p>Configure the source repository and how often the watcher polls for manifest changes.</p>
                </div>
                @if (_currentConfig?.LastPolledAt is not null)
                {
                    <span class="meta-pill">Last poll @_currentConfig.LastPolledAt.Value.ToLocalTime().ToString("g")</span>
                }
            </div>

            <EditForm Model="_form" OnValidSubmit="SaveWatchAsync">
                <div class="form-grid">
                    <label>
                        <span>Repository URL</span>
                        <InputText @bind-Value="_form.RepositoryUrl" class="text-input" />
                    </label>
                    <label>
                        <span>Branch</span>
                        <InputText @bind-Value="_form.Branch" class="text-input" />
                    </label>
                    <label>
                        <span>Manifest path</span>
                        <InputText @bind-Value="_form.ManifestPath" class="text-input" />
                    </label>
                    <label>
                        <span>Poll interval (seconds)</span>
                        <InputNumber @bind-Value="_form.PollIntervalSeconds" class="text-input" />
                    </label>
                </div>

                <div class="toggle-grid">
                    <label class="toggle-row">
                        <InputCheckbox @bind-Value="_form.Enabled" />
                        <span>Watcher enabled</span>
                    </label>
                    <label class="toggle-row">
                        <InputCheckbox @bind-Value="_form.ApprovalRequired" />
                        <span>Require approval before apply</span>
                    </label>
                </div>

                @if (_currentConfig is not null)
                {
                    <dl class="config-meta">
                        <div>
                            <dt>Configured by</dt>
                            <dd>@(_currentConfig.ConfiguredBy ?? "Unknown")</dd>
                        </div>
                        <div>
                            <dt>Last known commit</dt>
                            <dd>@(_currentConfig.LastKnownCommitSha ?? "Not polled yet")</dd>
                        </div>
                        <div>
                            <dt>Updated</dt>
                            <dd>@_currentConfig.UpdatedAt.ToLocalTime().ToString("f")</dd>
                        </div>
                    </dl>
                }

                <div class="form-actions">
                    <button class="action-button primary" type="submit" disabled="@_busy">
                        @(_currentConfig is null ? "Create watch" : "Save changes")
                    </button>
                    <button class="action-button secondary" type="button" @onclick="ResetForm" disabled="@_busy">Reset</button>
                    @if (_currentConfig is not null)
                    {
                        <button class="action-button ghost" type="button" @onclick="DeleteWatchAsync" disabled="@_busy">Remove watch</button>
                    }
                </div>
            </EditForm>
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>Approval Queue</h2>
                    <p>Review queued manifest changes and respond with an attributable reason.</p>
                </div>
            </div>

            @if (_pendingApprovals.Count == 0)
            {
                <p class="empty-state">No manifest changes are currently waiting for approval.</p>
            }
            else
            {
                <div class="approval-list">
                    @foreach (var approval in _pendingApprovals.OrderBy(item => item.CreatedAt))
                    {
                        <article class="approval-card">
                            <div class="approval-header">
                                <div>
                                    <span class="status-pill @GetApprovalTone(approval.Status)">@approval.Status</span>
                                    <h3>@approval.ManifestHash</h3>
                                </div>
                                <span class="timestamp">@approval.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <p class="approval-detail">@approval.RequestedReason</p>
                            <div class="approval-meta">
                                <span>@(approval.RequestedBy ?? "Unknown requester")</span>
                                <span>@approval.ResourceCount resource(s)</span>
                                <span>@(approval.ExpiresAt?.ToLocalTime().ToString("g") ?? "No expiry")</span>
                            </div>
                            <label class="decision-field">
                                <span>Decision reason</span>
                                <textarea
                                    class="text-area"
                                    value="@GetDecisionReason(approval.PendingId)"
                                    @oninput="args => SetDecisionReason(approval.PendingId, args.Value?.ToString())"></textarea>
                            </label>
                            <div class="decision-actions">
                                <button class="action-button primary" @onclick="() => ApproveAsync(approval)" disabled="@_busy">Approve</button>
                                <button class="action-button danger" @onclick="() => RejectAsync(approval)" disabled="@_busy">Reject</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>Change Timeline</h2>
                    <p>Inspect recent GitOps detections, apply outcomes, and queued approvals from the watched repository.</p>
                </div>
            </div>

            @if (_changes.Count == 0)
            {
                <p class="empty-state">No GitOps changes have been recorded yet.</p>
            }
            else
            {
                <div class="timeline">
                    @foreach (var change in _changes.OrderByDescending(item => item.DetectedAt))
                    {
                        <button
                            class="timeline-item @(change.ChangeId == _selectedChange?.ChangeId ? "selected" : null)"
                            @onclick="() => SelectChangeAsync(change)">
                            <div class="timeline-topline">
                                <span class="status-pill @GetChangeTone(change.Status)">@change.Status</span>
                                <span class="timestamp">@change.DetectedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <strong>@ShortCommit(change.CommitSha)</strong>
                            <p>@(change.CommitMessage ?? "No commit message")</p>
                            <div class="timeline-meta">
                                <span>@(change.CommitAuthor ?? "Unknown author")</span>
                                @if (!string.IsNullOrWhiteSpace(change.ApplySummary))
                                {
                                    <span>@change.ApplySummary</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(change.ErrorMessage))
                                {
                                    <span>@change.ErrorMessage</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="panel diff-panel">
            <div class="panel-header">
                <div>
                    <h2>Manifest Diff Viewer</h2>
                    <p>Compare the stored manifest snapshot before and after the selected GitOps change.</p>
                </div>
                @if (_selectedChange is not null)
                {
                    <span class="meta-pill">@ShortCommit(_selectedChange.CommitSha)</span>
                }
            </div>

            @if (_selectedDiff is null)
            {
                <p class="empty-state">Select a change to inspect its before and after manifest state.</p>
            }
            else
            {
                <div class="diff-grid">
                    <section>
                        <header class="diff-header">Before</header>
                        <pre class="code-panel">@FormatJson(_selectedDiff.Before)</pre>
                    </section>
                    <section>
                        <header class="diff-header">After</header>
                        <pre class="code-panel">@FormatJson(_selectedDiff.After)</pre>
                    </section>
                </div>
            }
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2>Approval History</h2>
                    <p>See recent approval decisions with operator attribution and timestamps.</p>
                </div>
            </div>

            @if (_approvalHistory.Count == 0)
            {
                <p class="empty-state">Approval history will appear here after manifest decisions are recorded.</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var approval in _approvalHistory
                        .OrderByDescending(item => item.DecidedAt ?? item.CreatedAt)
                        .Take(20))
                    {
                        <article class="history-row">
                            <div class="history-header">
                                <span class="status-pill @GetApprovalTone(approval.Status)">@approval.Status</span>
                                <span class="timestamp">@((approval.DecidedAt ?? approval.CreatedAt).ToLocalTime().ToString("g"))</span>
                            </div>
                            <strong>@approval.ManifestHash</strong>
                            <p>@(approval.DecisionReason ?? approval.RequestedReason ?? "No reason recorded.")</p>
                            <div class="history-meta">
                                <span>Requested by @(approval.RequestedBy ?? "Unknown")</span>
                                <span>Decision by @(approval.DecisionBy ?? "Pending")</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

