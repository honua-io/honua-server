@code {
    private static readonly JsonSerializerOptions PrettyJsonOptions = new() { WriteIndented = true };

    private GitOpsWatchConfigSaveRequest _form = new();
    private GitOpsWatchConfigModel? _currentConfig;
    private List<GitOpsChangeRecordModel> _changes = [];
    private List<ManifestPendingChangeModel> _pendingApprovals = [];
    private List<ManifestPendingChangeModel> _approvalHistory = [];
    private GitOpsChangeRecordModel? _selectedChange;
    private GitOpsChangeDiffModel? _selectedDiff;
    private readonly Dictionary<Guid, string> _decisionReasons = new();
    private bool _busy;
    private string? _error;
    private string? _notice;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(preserveSelection: false);
    }

    private async Task RefreshAsync()
    {
        await LoadAsync(preserveSelection: true);
    }

    private async Task LoadAsync(bool preserveSelection)
    {
        _busy = true;
        _error = null;

        try
        {
            var watchTask = GitOpsClient.GetWatchAsync();
            var changesTask = GitOpsClient.GetChangesAsync();
            var pendingTask = GitOpsClient.GetPendingApprovalsAsync();
            var historyTask = GitOpsClient.GetApprovalHistoryAsync();

            await Task.WhenAll(watchTask, changesTask, pendingTask, historyTask);

            _currentConfig = await watchTask;
            _changes = (await changesTask).OrderByDescending(change => change.DetectedAt).ToList();
            _pendingApprovals = (await pendingTask)
                .Where(item => string.Equals(item.Status, "pending", StringComparison.OrdinalIgnoreCase))
                .OrderBy(item => item.CreatedAt)
                .ToList();
            _approvalHistory = (await historyTask).OrderByDescending(item => item.DecidedAt ?? item.CreatedAt).ToList();

            PopulateForm(_currentConfig);

            if (!preserveSelection || _selectedChange is null)
            {
                _selectedChange = _changes.FirstOrDefault();
            }
            else
            {
                _selectedChange = _changes.FirstOrDefault(change => change.ChangeId == _selectedChange.ChangeId)
                    ?? _changes.FirstOrDefault();
            }

            _selectedDiff = _selectedChange is null
                ? null
                : await GitOpsClient.GetDiffAsync(_selectedChange.ChangeId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveWatchAsync()
    {
        _busy = true;
        _error = null;
        _notice = null;

        try
        {
            var creating = _currentConfig is null;
            _form.ConfiguredBy = await ResolveActorAsync();
            _currentConfig = await GitOpsClient.SaveWatchAsync(_form, _currentConfig is not null);
            _notice = creating ? "GitOps watch created." : "GitOps watch updated.";
            await LoadAsync(preserveSelection: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteWatchAsync()
    {
        if (_currentConfig is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;

        try
        {
            await GitOpsClient.DeleteWatchAsync();
            _currentConfig = null;
            _selectedChange = null;
            _selectedDiff = null;
            PopulateForm(null);
            _notice = "GitOps watch removed.";
            await LoadAsync(preserveSelection: false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetForm()
    {
        PopulateForm(_currentConfig);
        _notice = null;
        _error = null;
    }

    private async Task SelectChangeAsync(GitOpsChangeRecordModel change)
    {
        _busy = true;
        _error = null;

        try
        {
            _selectedChange = change;
            _selectedDiff = await GitOpsClient.GetDiffAsync(change.ChangeId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync(ManifestPendingChangeModel approval)
    {
        await ApplyDecisionAsync(approval, approve: true);
    }

    private async Task RejectAsync(ManifestPendingChangeModel approval)
    {
        await ApplyDecisionAsync(approval, approve: false);
    }

    private async Task ApplyDecisionAsync(ManifestPendingChangeModel approval, bool approve)
    {
        _busy = true;
        _error = null;
        _notice = null;

        try
        {
            var actor = await ResolveActorAsync();
            var reason = GetDecisionReason(approval.PendingId);

            if (approve)
            {
                await GitOpsClient.ApproveAsync(approval.PendingId, actor, reason);
                _notice = $"Approved manifest change {approval.ManifestHash}.";
            }
            else
            {
                await GitOpsClient.RejectAsync(approval.PendingId, actor, reason);
                _notice = $"Rejected manifest change {approval.ManifestHash}.";
            }

            _decisionReasons.Remove(approval.PendingId);
            await LoadAsync(preserveSelection: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<string?> ResolveActorAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        return user.Identity?.Name
            ?? user.FindFirst("name")?.Value
            ?? user.FindFirst("preferred_username")?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.FindFirst("sub")?.Value;
    }

    private void PopulateForm(GitOpsWatchConfigModel? config)
    {
        _form = config is null
            ? new GitOpsWatchConfigSaveRequest()
            : new GitOpsWatchConfigSaveRequest
            {
                RepositoryUrl = config.RepositoryUrl,
                Branch = config.Branch,
                ManifestPath = config.ManifestPath,
                PollIntervalSeconds = config.PollIntervalSeconds,
                ApprovalRequired = config.ApprovalRequired,
                Enabled = config.Enabled
            };
    }

    private string GetDecisionReason(Guid pendingId)
    {
        return _decisionReasons.TryGetValue(pendingId, out var reason)
            ? reason
            : string.Empty;
    }

    private void SetDecisionReason(Guid pendingId, string? reason)
    {
        _decisionReasons[pendingId] = reason ?? string.Empty;
    }

    private string GetFeatureLabel()
    {
        return _currentConfig switch
        {
            null => "Not configured",
            { Enabled: false } => "Watcher paused",
            _ => "Watching branch"
        };
    }

    private string GetFeatureTone()
    {
        return _currentConfig switch
        {
            null => "idle",
            { Enabled: false } => "paused",
            _ => "live"
        };
    }

    private static string GetApprovalTone(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "approved" => "approved",
            "pending" => "pending",
            "applying" => "applying",
            "rejected" => "rejected",
            "expired" => "expired",
            _ => "pending"
        };
    }

    private static string GetChangeTone(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "applied" => "applied",
            "pending_approval" => "pending_approval",
            "failed" => "failed",
            _ => "pending"
        };
    }

    private static string ShortCommit(string commitSha)
    {
        return commitSha.Length <= 8
            ? commitSha
            : commitSha[..8];
    }

    private static string FormatJson(JsonElement? json)
    {
        return json.HasValue
            ? JsonSerializer.Serialize(json.Value, PrettyJsonOptions)
            : "// no prior manifest recorded";
    }

    private static string FormatJson(JsonElement json)
    {
        return JsonSerializer.Serialize(json, PrettyJsonOptions);
    }
}
