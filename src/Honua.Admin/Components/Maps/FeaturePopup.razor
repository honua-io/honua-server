@if (HasAttributes)
{
    <div class="map-preview__overlay" data-testid="map-feature-popup">
        <MudPaper Class="pa-3" Elevation="4">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Feature attributes</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   OnClick="OnClose" />
                </MudStack>
                <MudTable Items="Attributes" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Field</MudTh>
                        <MudTh>Value</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Field">@context.Key</MudTd>
                        <MudTd DataLabel="Value">@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudPaper>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<KeyValuePair<string, string>>? Attributes { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool HasAttributes => Attributes is { Count: > 0 };
}
