@using Honua.Admin.Components.Layers

<EditForm EditContext="_editContext">
    <DataAnnotationsValidator />
    <MudForm @ref="_form">
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="Model.LayerName"
                                  Label="Layer name"
                                  Required="true"
                                  For="@(() => Model.LayerName)" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@Model.Schema"
                                  Label="Schema"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@Model.Table"
                                  Label="Table"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@Model.GeometryColumn"
                                  Label="Geometry column"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@Model.GeometryType"
                                  Label="Geometry type"
                                  Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int?" @bind-Value="Model.Srid"
                                     Label="SRID"
                                     Required="true"
                                     For="@(() => Model.Srid)" />
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-3" Elevation="0">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Value="Model.PrimaryKey" ValueChanged="OnPrimaryKeyChanged" Label="Primary key" Required="true">
                            @foreach (var option in PrimaryKeyOptions)
                            {
                                <MudSelectItem Value="@option.Name">@option.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSwitch T="bool" @bind-Value="Model.Enabled" Color="Color.Primary" Label="Enable layer after publish" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Fields</MudText>
                <MudTable Items="Model.Fields" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Publish</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Nullable</MudTh>
                        <MudTh>Max length</MudTh>
                        <MudTh>Primary key</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Publish">
                            <MudCheckBox T="bool" @bind-Value="row.IsSelected" />
                        </MudTd>
                        <MudTd DataLabel="Name">@row.Name</MudTd>
                        <MudTd DataLabel="Type">@row.DataType</MudTd>
                        <MudTd DataLabel="Nullable">@((row.IsNullable ? "Yes" : "No"))</MudTd>
                        <MudTd DataLabel="Max length">@row.MaxLength?.ToString() ?? "-"</MudTd>
                        <MudTd DataLabel="Primary key">@((row.IsPrimaryKey ? "Yes" : "No"))</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <ValidationSummary />

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" OnClick="OnCancel" Disabled="@IsBusy">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@IsBusy" data-testid="layer-publish-submit">Publish</MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
</EditForm>

@code {
    private MudForm? _form;
    private EditContext? _editContext;

    [Parameter, EditorRequired]
    public LayerPublishFormModel Model { get; set; } = new();

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<LayerPublishFormModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private IEnumerable<LayerFieldOption> PrimaryKeyOptions =>
        Model.Fields.Where(option => option.IsSelectablePrimaryKey);

    protected override void OnParametersSet()
    {
        if (_editContext == null || !ReferenceEquals(_editContext.Model, Model))
        {
            _editContext = new EditContext(Model);
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        var editContextValid = _editContext?.Validate() ?? false;
        await _form.Validate();

        if (_form.IsValid && editContextValid)
        {
            await OnSubmit.InvokeAsync(Model);
        }
    }

    private Task OnPrimaryKeyChanged(string? value)
    {
        Model.PrimaryKey = value;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var selectedField = Model.Fields.FirstOrDefault(item =>
                item.Name.Equals(value, StringComparison.OrdinalIgnoreCase));
            if (selectedField != null)
            {
                selectedField.IsSelected = true;
            }
        }

        return Task.CompletedTask;
    }
}
