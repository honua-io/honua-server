<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1716</NoWarn>
    <WarningsNotAsErrors>CA2009;IDE0073</WarningsNotAsErrors>
    <RootNamespace>Honua.Server.Features</RootNamespace>
    <!--
      Honua.Import is the data-ingest / migration HTTP surface carved out of
      Honua.Server: the Migration endpoints + job managers (ArcGIS / GeoServer /
      OGC API Features / WFS / coverage migration), the file-import upload
      plumbing (multipart parsing, streaming upload, network-address
      validation), and the raster-import endpoints. Namespaces are preserved
      (Honua.Server.Features.{Migration,Import,RasterImport,FileImport}) so the
      remaining Server consumers (Program.cs, Capabilities, Admin discovery,
      monitoring) keep compiling without a using-clause sweep.

      The provider-agnostic ingest DOMAIN (Core.Features.{Migration,Import,
      FileImport} — REST source clients, abstractions, evidence model) stays in
      Honua.Core because the storage providers (notably Honua.Postgres's
      StreamingFileImportService and migration sinks) consume it and must not
      pull this module's ASP.NET surface. The NTS file-format readers stay in
      Honua.Geometry for the same reason.

      Depends on Abstractions + Core + Geometry + Hosting + ServiceDefaults. It
      must NEVER reference Honua.Server (enforced by HonuaImportIsolationTests)
      nor any storage provider or protocol module.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Core.Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\Honua.Geometry\Honua.Geometry.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.ServiceDefaults\Honua.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migration / import / raster-import endpoints use API versioning. -->
    <PackageReference Include="Asp.Versioning.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Server" />
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Architecture.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
