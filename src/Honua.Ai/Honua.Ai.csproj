<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Honua.Ai is the carved-out AI surface (AiBuilder + Grounding +
      NlQuery + AnalysisContent) extracted from Honua.Server so the
      composition root no longer carries the deterministic-grounding
      engine, the OpenAI plan-provider client, the analysis-content
      durable store, and the AiBuilder fixture catalog. Namespaces are
      preserved (Honua.Server.Features.{AiBuilder,Grounding,NlQuery,
      AnalysisContent}) so Server's DI composition keeps compiling
      without a using-clause sweep — the same pattern Honua.Aws,
      Honua.Azure, and Honua.Jobs already use.

      The McpPlanAnalysisModels DTO surface moves here too because
      AiBuilder's FixturePlanAnalysisService is the producer of those
      wire-format objects; the Mcp PlanAnalysisTool stays in Server and
      reads them through the Honua.Ai project reference.
    -->
    <NoWarn>$(NoWarn);CS1591;IL2104;IL2026;IL3002;IL3050;CA1041;CA1000;CA1862;IDE0051;IDE0052;IDE0005;CA1844;IL2075</NoWarn>
    <RootNamespace>Honua.Ai</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Core.Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Honua.Core.csproj" />
    <!-- Grounding / AnalysisContent orchestrate geoprocessing jobs through
         IGeoprocessingJobService, which moved into Honua.Geoprocessing in the
         geoprocessing-split. Ai consumes that surface (it must never reference
         Honua.Server). Honua.Geoprocessing has no edge back to Ai, so this is
         acyclic. Matrix cell: (Ai, Geoprocessing) in ADR-0047. -->
    <ProjectReference Include="..\Honua.Geoprocessing\Honua.Geoprocessing.csproj" />
    <!-- The MCP geocode/route tools (#1597) are thin protocol adapters over the
         canonical IGeocodeCoordinatorService / IRoutingProvider pipelines that
         live in the Geocoding / Routing satellites. Neither satellite references
         Ai, so both edges are acyclic — mirrors the Protocols -> Routing edge
         the GeoServices NAServer adapter already uses. Matrix cells:
         (Ai, Geocoding) and (Ai, Routing) in ADR-0047. -->
    <ProjectReference Include="..\Honua.Geocoding\Honua.Geocoding.csproj" />
    <ProjectReference Include="..\Honua.Routing\Honua.Routing.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.Jobs\Honua.Jobs.csproj" />
    <ProjectReference Include="..\Honua.ServiceDefaults\Honua.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Asp.Versioning.Http drives the WithApiVersionSet / HasApiVersion
         extensions used by AnalysisContent and Spec grounding endpoints.
         Mirrors the Server csproj's existing reference. -->
    <PackageReference Include="Asp.Versioning.Http" />
    <!-- StackExchange.Redis is required by InMemoryAnalysisContentStore and
         by GroundingService for distributed-cache helpers. -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- AWS Bedrock (Claude) provider for the studio generation flows. The
         BedrockChatClientAdapter wraps the Converse API as a Microsoft.Extensions.AI
         IChatClient so the dashboard/report/workflow generators can run on cloud AI
         (no local Ollama/Qwen). Mirrors the honua-devops agent's Bedrock provider. -->
    <PackageReference Include="AWSSDK.BedrockRuntime" />
    <!-- Azure OpenAI / AI Foundry provider for the studio generation flows. Azure OpenAI is
         OpenAI-API-compatible, so only the deployment-routed URL and auth differ; Azure.Identity
         supplies Entra Managed-Identity tokens (the preferred Azure auth) for the
         AzureOpenAiStructuredGenerationClient. Confined to Honua.Ai exactly like the Bedrock SDK
         above, so Honua.Core / Honua.Hosting / Honua.Server stay SDK-free (CloudSdkIsolationTests). -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- AiBuilder fixture JSON catalog. Logical names preserved so
         AiBuilderFixtureCatalog.GetManifestResourceStream lookups keep
         resolving with the original Honua.Ai.AiBuilder.Fixtures.*
         resource ids. -->
    <EmbeddedResource Include="..\..\tests\fixtures\ai-builder\spatial-query-contract-v1.json"
                      LogicalName="Honua.Ai.AiBuilder.Fixtures.spatial-query-contract-v1.json" />
    <EmbeddedResource Include="..\..\tests\fixtures\ai-builder\operations-dashboard-contract-v1.json"
                      LogicalName="Honua.Ai.AiBuilder.Fixtures.operations-dashboard-contract-v1.json" />
    <EmbeddedResource Include="..\..\tests\fixtures\ai-builder\workflow-generation-contract-v1.json"
                      LogicalName="Honua.Ai.AiBuilder.Fixtures.workflow-generation-contract-v1.json" />
    <!-- Evidence-based feature catalog (#1946, ADR-0054). The committed,
         drift-gated artifact is embedded so the read-only MCP resource
         honua://catalog/features can serve it from a deployed server that has no
         repo checkout. The catalog is generated, never authored, and CI fails if
         the committed file drifts from the live API surface
         (FeatureCatalogDriftTests). -->
    <EmbeddedResource Include="..\..\docs\gis\data\feature-catalog.json"
                      LogicalName="Honua.Ai.Catalog.feature-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Server" />
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Architecture.Tests" />
    <InternalsVisibleTo Include="Honua.Ai.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
