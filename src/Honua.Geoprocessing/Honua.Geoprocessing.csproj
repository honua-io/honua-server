<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Honua.Geoprocessing is the carved-out geoprocessing subsystem extracted
      from Honua.Server.Features.Geoprocessing per ADR-0047. Carving this
      module out of Honua.Server is a prerequisite for the remaining Phase 1
      protocol extractions (OgcApi.Processes and GeoServices/GPServer), both
      of which currently pull Geoprocessing transitively through Honua.Server.

      Namespaces preserved (Honua.Server.Features.Geoprocessing.*) so the
      Server orchestration layer and the protocol-module consumers keep their
      using clauses unchanged. Mirrors the Honua.Jobs / Honua.Aws / Honua.Azure
      carve pattern.
    -->
    <NoWarn>$(NoWarn);CS1591;IL2104;IL2026;IL3002;IL3050;CA1041;CA1000;CA1862;IDE0051;IDE0052;IDE0005;CA1844;IL2075</NoWarn>
    <RootNamespace>Honua.Geoprocessing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Core.Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\Honua.Geometry\Honua.Geometry.csproj" />
    <ProjectReference Include="..\Honua.Hosting\Honua.Hosting.csproj" />
    <ProjectReference Include="..\Honua.Jobs\Honua.Jobs.csproj" />
    <ProjectReference Include="..\Honua.ServiceDefaults\Honua.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Packages required by the carved Geoprocessing surface. Grpc.AspNetCore
      and NetTopologySuite come transitively from Honua.Hosting / Honua.Geometry;
      Newtonsoft.Json and Npgsql come transitively from Honua.ServiceDefaults
      (via Aspire.Npgsql). The remaining direct refs are the executor / job-
      service dependencies that are not already in the transitive closure.
    -->
    <PackageReference Include="Geospatial.Grpc" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Geoprocessing.Tests" />
    <InternalsVisibleTo Include="Honua.Ai" />
    <InternalsVisibleTo Include="Honua.Server" />
    <InternalsVisibleTo Include="Honua.Server.Tests" />
    <InternalsVisibleTo Include="Honua.Architecture.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi.Tests" />
    <InternalsVisibleTo Include="Honua.Protocols.GeoServices" />
    <InternalsVisibleTo Include="Honua.Protocols.GeoServices.Tests" />
    <InternalsVisibleTo Include="Honua.Ai.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
