<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

    <!-- Multi-targeting for mobile platforms (iOS/Android require workloads) -->
    <TargetFrameworks Condition="'$(EnableMobileTargets)' == 'true'">net10.0;net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableMobileTargets)' != 'true'">net10.0</TargetFrameworks>

    <!-- NuGet Package Metadata -->
    <PackageId>Honua.Mobile.Sdk</PackageId>
    <Title>Honua Mobile SDK</Title>
    <Description>Cross-platform .NET MAUI SDK for mobile geospatial applications. Features offline-first architecture, native integrations, and field data collection capabilities.</Description>
    <Authors>Honua Project Contributors</Authors>
    <Copyright>Copyright (c) 2026 Honua Project Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/honua-project/honua-server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/honua-project/honua-server.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>geospatial;gis;mobile;maui;offline;field-data;xamarin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Honua.Core/Honua.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAUI and Mobile Platform Dependencies (conditional to avoid workload issues) -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.10" Condition="'$(EnableMobileTargets)' == 'true'" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.10" Condition="'$(EnableMobileTargets)' == 'true'" />

    <!-- Offline storage with SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />

    <!-- HTTP and gRPC for mobile -->
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />

    <!-- Progress reporting -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- Dependency injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!-- Android-specific packages -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.15.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <!-- iOS-specific packages -->
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <!-- Windows-specific packages -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Honua.Mobile.Sdk.Tests" />
  </ItemGroup>

</Project>