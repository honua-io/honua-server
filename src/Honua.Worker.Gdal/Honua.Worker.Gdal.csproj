<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>$(HonuaTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <!--
      The heavyweight worker is NOT cold-start sensitive, so it deliberately does
      NOT enable PublishAot (unlike the lean serving image). This keeps the GDAL
      CLI subprocess approach simple and avoids trim/AOT constraints on the
      worker-only code paths.
    -->
    <PublishAot>false</PublishAot>
    <!--
      docker/worker-gdal/Dockerfile publishes framework-dependent for one of these runtime
      identifiers so the image carries only its own platform's native libraries. Listing them
      here puts their package graphs in packages.lock.json, which the locked restore needs.
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!--
      The worker image restores from this project's packages.lock.json in locked mode, and CI
      does too, so the image only gets package contents whose hashes are recorded here. After
      changing a package version or project reference in its closure, regenerate the lock:
      dotnet restore src/Honua.Worker.Gdal/Honua.Worker.Gdal.csproj -p:RestoreForceEvaluate=true -p:RestoreLockedMode=false
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Honua.Worker.Gdal</RootNamespace>
    <AssemblyName>Honua.Worker.Gdal</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Worker.Gdal.Tests" />
    <InternalsVisibleTo Include="honua-gp" />
    <InternalsVisibleTo Include="Honua.Protocols.OgcApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Custom worker steps shipped alongside the published worker. These Python
      scripts are invoked via `python3` by the corresponding executors and run
      ONLY inside the GDAL worker image (they require the GDAL Python bindings +
      SciPy provided by docker/worker-gdal/Dockerfile). gdal_euclidean_allocation.py
      backs proximity.euclidean-allocation: stock gdal_proximity has no
      nearest-source allocation mode. Copied to the build/publish output so the
      runtime image's build-stage COPY includes them at /app/Scripts.
    -->
    <Content Include="Scripts\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      Reuses the durable job-execution substrate from Honua.Jobs (the shared
      JobExecutionService loop and the PostgreSQL job stores). The
      worker DELIBERATELY does NOT ProjectReference Honua.Server — ADR-0038's
      lean-worker boundary requires the worker image to ship only the substrate
      plus GDAL CLI shims, not the serving image's full ASP.NET / protocol /
      data-layer surface. GDAL is NOT referenced as a package — it is provided
      by the worker image base layer via the gdalwarp / ogr2ogr CLI tools.
    -->
    <ProjectReference Include="..\Honua.Core\Abstractions\Honua.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Honua.Core\Core\Honua.Core.csproj" />
    <ProjectReference Include="..\Honua.Jobs\Honua.Jobs.csproj" />
    <ProjectReference Include="..\Honua.Cloud\Aws\Honua.Aws.csproj" />
    <ProjectReference Include="..\Honua.Cloud\Azure\Honua.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting is provided by the Worker SDK. -->
    <!--
      Managed-only NTS dependencies used by the raster.clip / raster.zonal-statistics
      executors to convert the catalog's WKB clip boundary into an OGR-readable
      GeoJSON cutline file (gdalwarp's -cutline option does not accept inline WKB)
      and to enumerate inline zone-polygon GeoJSON features. No native dependencies
      are added; GDAL is reached via the worker image's CLI tools.
    -->
    <PackageReference Include="NetTopologySuite" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" />
  </ItemGroup>

</Project>
