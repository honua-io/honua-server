<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Honua.Geoprocessing.Cli</RootNamespace>
    <AssemblyName>honua-gp</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      GP Devkit dev tool (#2123). Packaged as a local dotnet tool (`honua gp`) for
      a sub-second, Redis-free geoprocessing dev loop. It is DELIBERATELY kept out
      of the AOT-published server surface: nothing in Honua.Server references this
      project, so the AOT publish (which targets only Honua.Server's transitive
      ProjectReferences) never pulls it in. The tool itself is NOT AOT-published.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>honua-gp-devkit</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Honua.Geoprocessing.Cli</PackageId>
    <Description>Local Honua geoprocessing runner, discovery, validation, and golden tests.</Description>
    <PublishAot>false</PublishAot>

    <!-- Console front-end intentionally writes to stdout/stderr. -->
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reuses the SAME managed IProcessExecutor set the serving host registers
      (via the internal AddGeoprocessing seam) plus the native GDAL executors
      (via the Redis-free AddGdalProcessExecutors seam), so `gp run` drives the
      real executor code path with no Redis/queue/job-store/control-plane.
    -->
    <ProjectReference Include="..\Honua.Geoprocessing\Honua.Geoprocessing.csproj" />
    <ProjectReference Include="..\Honua.Worker.Gdal\Honua.Worker.Gdal.csproj" />
    <!--
      GP Devkit P6 (#2127): the golden-file GP test SDK powers `honua gp test`,
      which discovers + runs the golden fixtures under samples/gp/ through the
      same headless runner `gp run` uses.
    -->
    <ProjectReference Include="..\Honua.Geoprocessing.Testing\Honua.Geoprocessing.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- honua-gp.yaml descriptor parsing for `release` (#6221); the devkit is not AOT-published. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The publish-command pipeline is internal; the offline unit tests exercise it directly. -->
    <InternalsVisibleTo Include="Honua.Geoprocessing.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      `honua-gp-devkit init` (#6217) copies the honua-samples GP templates byte for byte.
      They are embedded here together with their TEMPLATE-MANIFEST.json (per-file SHA-256),
      which GpCustomProjectScaffolder.VerifyEmbedded checks, so drift between the devkit and
      honua-samples trunk is a test failure, not a surprise. Keep the resource names as the
      template-relative paths.
    -->
    <Compile Remove="Templates\**" />
    <None Remove="Templates\**" />
    <EmbeddedResource Include="Templates\**\*" LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the matching local harness and SDK as source payload, independent of a server checkout.
         Explicit source globs exclude build output, credentials, caches and development fixtures. -->
    <EmbeddedResource Include="../../docker/worker-customcode-python/harness/honua_customcode_harness/*.py"
                      LogicalName="Toolchain/docker/worker-customcode-python/harness/honua_customcode_harness/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docker/worker-customcode-python/harness/pyproject.toml;../../docker/worker-customcode-python/harness/README.md"
                      LogicalName="Toolchain/docker/worker-customcode-python/harness/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docker/worker-customcode-dotnet/harness/src/**/*.cs;../../docker/worker-customcode-dotnet/harness/src/**/*.csproj"
                      Exclude="../../docker/worker-customcode-dotnet/harness/src/**/obj/**;../../docker/worker-customcode-dotnet/harness/src/**/bin/**"
                      LogicalName="Toolchain/docker/worker-customcode-dotnet/harness/src/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docker/worker-customcode-dotnet/harness/Directory.Build.props;../../docker/worker-customcode-dotnet/harness/Directory.Packages.props;../../docker/worker-customcode-dotnet/harness/NuGet.config"
                      LogicalName="Toolchain/docker/worker-customcode-dotnet/harness/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Toolchain/LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../scripts/gp/workspace.py;../../scripts/gp/workspace_scope.py;../../scripts/gp/workspace_service.py;../../scripts/gp/Dockerfile.workspace;../../scripts/gp/README.md;../../scripts/gp/qualify_workspace.py;../../scripts/gp/qualify_installed_workspace.py;../../scripts/gp/assemble_workspace_image.py;../../scripts/gp/default-workspace-wheels.json"
                      LogicalName="Workspace/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
