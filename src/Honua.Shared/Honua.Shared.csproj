<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Honua.Shared</PackageId>
    <Version>1.0.0</Version>
    <Description>Core .NET library for building applications with Honua geospatial services</Description>
    <Authors>Honua Project Contributors</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mikemcdougall/honua-core</RepositoryUrl>
    <PackageTags>geospatial;grpc;gis;mapping;spatial;mobile;maui;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies available on all platforms - match versions from Honua.Core -->
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Core.Api" Version="2.70.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <!-- Platform-specific dependencies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Server-specific packages -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('android')) OR $(TargetFramework.Contains('ios'))">
    <!-- Mobile-specific packages -->
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="../Honua.Core/Honua.Core.csproj" />
  </ItemGroup>

</Project>