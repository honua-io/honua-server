<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Temporarily disable warnings as errors to enable mobile SDK compilation -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Suppress specific warnings that are causing build failures -->
    <WarningsNotAsErrors>CS1591;CA1873;CA1848;CA2009;IDE0073</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Extensions for logging and configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Polly" Version="8.6.5" />

    <!-- NetTopologySuite geospatial file format support -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />

    <!-- gRPC and protocol buffer support -->
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0" PrivateAssets="All" />

    <!-- Geospatial gRPC protocols from standard -->
  </ItemGroup>

  <ItemGroup>
    <!-- Generate C# clients from standard gRPC geospatial protocol files -->
    <Protobuf Include="Transport/Proto/geospatial/v1/*.proto"
              GrpcServices="Client"
              ProtoRoot="Transport/Proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Core.Tests" />
    <InternalsVisibleTo Include="Honua.Postgres" />
  </ItemGroup>

</Project>
