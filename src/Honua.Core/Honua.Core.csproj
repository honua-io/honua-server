<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Documentation and analyzer cleanup is still in progress for this package. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsNotAsErrors>CS1591;CA1873;CA1848;CA2009;IDE0073</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Extensions for logging and configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Polly" Version="8.6.6" />

    <!-- NetTopologySuite geospatial file format support -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />

    <!-- gRPC and protocol buffer support -->
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0" PrivateAssets="All" />

    <!-- Geocoding provider dependencies -->
    <PackageReference Include="AWSSDK.LocationService" Version="4.0.3.17" />

    <!-- Geospatial gRPC protocols from standard -->
  </ItemGroup>

  <ItemGroup>
    <!-- Generate C# clients from standard gRPC geospatial protocol files -->
    <Protobuf Include="Transport/Proto/geospatial/v1/*.proto"
              GrpcServices="Both"
              ProtoRoot="Transport/Proto"
              AdditionalProtocArguments="--experimental_allow_proto3_optional" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Core.Tests" />
    <InternalsVisibleTo Include="Honua.Postgres" />
  </ItemGroup>

</Project>
