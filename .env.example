# Honua Server - Environment Configuration Template
# Copy this file to .env and customize for your environment
# See /api/admin/config for full configuration documentation

# =============================================================================
# DATABASE (Required)
# =============================================================================
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=honua;Username=postgres;Password=your_password_here

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable web admin interface
HONUA_ADMIN_UI=false

# Enable metrics and health endpoints
HONUA_OBSERVABILITY=false

# Enable OpenTelemetry distributed tracing
HONUA_OPENTELEMETRY=false

# Skip database migrations on startup
HONUA_SKIP_MIGRATIONS=false

# =============================================================================
# SECURITY
# =============================================================================
# Admin API password (required for admin endpoints in production)
HONUA_ADMIN_PASSWORD=

# Development authentication bypass (DO NOT USE IN PRODUCTION)
# HONUA_DEV_AUTH=dev-token

# =============================================================================
# CACHE (Redis)
# =============================================================================
Cache__Enabled=true
Cache__DefaultTtlSeconds=300
Cache__EnableFallback=true
Cache__FallbackMaxEntries=1000

# =============================================================================
# RATE LIMITING
# =============================================================================
RateLimit__MaxRequestsPerWindow=1000
RateLimit__WindowSize=00:10:00
RateLimit__TrustProxyHeaders=false

# =============================================================================
# CORS (add origins as needed)
# =============================================================================
# Cors__AllowedOrigins__0=https://myapp.example.com
# Cors__AllowedOrigins__1=https://admin.example.com
# Cors__AllowCredentials=false

# =============================================================================
# QUERY LIMITS
# =============================================================================
Limits__Query__MaxRecordCount=2000
Limits__Query__DefaultRecordCount=1000
Limits__Query__MaxOffset=1000000
Limits__Query__QueryTimeout=00:00:30

# =============================================================================
# GEOMETRY LIMITS
# =============================================================================
Limits__Geometry__MaxVerticesPerGeometry=100000
Limits__Geometry__MaxGeometrySize=10485760
Limits__Geometry__MaxCoordinatePrecision=8

# =============================================================================
# TILE OPTIONS
# =============================================================================
TileOptions__MaxFeaturesPerTile=10000
TileOptions__TileTimeoutSeconds=10
TileOptions__MaxZoom=22
TileOptions__MinZoom=0
