# Honua Server - Environment Configuration Template
# Copy this file to .env and customize for your environment
# See /api/v1/admin/config for full configuration documentation

# =============================================================================
# DATA SOURCE PROVIDER
# =============================================================================
# Select the backing provider: "postgres" (default), "duckdb" (read-only embedded)
# DataSource__Provider=postgres

# =============================================================================
# DATABASE — PostgreSQL (default provider)
# =============================================================================
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=honua;Username=postgres;Password=your_password_here

# =============================================================================
# DATABASE — DuckDB (read-only provider)
# =============================================================================
# Set DataSource__Provider=duckdb to activate. Layers and services are
# configured in appsettings.json under the "DuckDB" section.
# See docs/operator/duckdb-provider.md for full configuration reference.
# DuckDB__DatabasePath=/data/layers.duckdb
# DuckDB__ReadOnly=true
# DuckDB__SpatialExtensionPath=

# =============================================================================
# DATABASE — SQL Server (read-only additional provider)
# =============================================================================
# Plugs in alongside the primary backend; layers whose DataConnection resolves
# to provider 'sqlserver' (alias 'mssql') route to this implementation. Set
# SqlServer__Enabled=false to skip provider registration. See
# docs/operator/sqlserver-provider.md for full configuration reference.
# SqlServer__Enabled=true
# SqlServer__ConnectionString=Server=mssql.example.com,1433;Database=geo;User Id=honua;Password=changeme;Encrypt=True;TrustServerCertificate=False
# SqlServer__CommandTimeoutSeconds=60

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Serve the hosted STAC operations demo at /samples/stac-ops/
# Development/Test serves it by default. Custom Docker images must also be built with HONUA_INCLUDE_STAC_OPS_DEMO=true.
HONUA_SERVE_STAC_DEMO=true

# Enable metrics and health endpoints
HONUA_OBSERVABILITY=false

# Enable OpenTelemetry distributed tracing
HONUA_OPENTELEMETRY=false

# Native Prometheus scrape endpoint path
Observability__Prometheus__Path=/metrics

# Skip database migrations on startup
HONUA_SKIP_MIGRATIONS=false

# Console open-data / DCAT / STAC publication: anonymous /open-data and
# /open-data/catalog.json reads, DCAT/data.json export, and Console STAC
# publication controls. Default off; set OpenData__Enabled=true to opt this
# deployment in. A PostgreSQL deployment persists page and publication state in
# the durable open-data store automatically. See
# docs/contributor/open-data-publication-api.md for the full contract.
OpenData__Enabled=false
# Process-local fallback store for hosts that do not register a durable
# (PostgreSQL) open-data store — development/test or non-PostgreSQL providers.
# A PostgreSQL host always uses the durable store and ignores this flag.
OpenData__UseInMemoryStore=false

# =============================================================================
# RUNTIME LICENSING (optional)
# =============================================================================
# Empty/unset LicensePath runs Community mode. Configure trusted raw Ed25519
# public keys by license keyId to load signed JSON license envelopes.
# Licensing__LicensePath=/etc/honua/license.honua-license.json
# Licensing__TrustedKeys__honua-2026-q2=base64url:<32-byte-raw-ed25519-public-key>
# Licensing__AllowAdminUpload=false
# Licensing__ExpiryWarningDays=30

# =============================================================================
# SECURITY
# =============================================================================
# Admin API password (required for admin endpoints in production)
HONUA_ADMIN_PASSWORD=

# Native/admin client-certificate authentication (optional)
# Modes: Disabled, Optional, RequiredForNative, RequiredForAdmin, RequiredForEnvironment
# See docs/operator/client-certificate-authentication.md for trust-profile examples,
# forwarded-certificate proxy guidance, and response contracts.
# Authentication__ClientCertificates__Mode=Disabled
# Authentication__ClientCertificates__EnvironmentId=prod
# Authentication__ClientCertificates__ProtectedAdminPathPrefixes__0=/api/v1/admin
# Authentication__ClientCertificates__ProtectedGrpcServices__0=geospatial.v1.FeatureService
# Authentication__ClientCertificates__TrustProfiles__0__ProfileId=prod-native
# Authentication__ClientCertificates__TrustProfiles__0__EnvironmentId=prod
# Authentication__ClientCertificates__TrustProfiles__0__AcceptedIssuerSubjects__0=CN=Honua Prod Operator CA
# Authentication__ClientCertificates__TrustProfiles__0__RequireChainTrust=true
# Authentication__ClientCertificates__TrustProfiles__0__AllowedSanTypes__0=SanUri
# Authentication__ClientCertificates__TrustProfiles__0__PrincipalMappings__0__MappingId=prod-console-admin
# Authentication__ClientCertificates__TrustProfiles__0__PrincipalMappings__0__MatchType=SanUri
# Authentication__ClientCertificates__TrustProfiles__0__PrincipalMappings__0__MatchValue=spiffe://honua/prod/console-admin
# Authentication__ClientCertificates__TrustProfiles__0__PrincipalMappings__0__PrincipalId=native-prod-admin
# Authentication__ClientCertificates__TrustProfiles__0__PrincipalMappings__0__Roles__0=admin
# Authentication__ClientCertificates__ForwardedCertificate__Enabled=false
# Authentication__ClientCertificates__ForwardedCertificate__TrustedProxyNetworks__0=10.0.0.0/24

# Development authentication bypass (DO NOT USE IN PRODUCTION)
# The bypass ONLY activates when ALL of the following are true:
#   1. ASPNETCORE_ENVIRONMENT is exactly "Test" (NOT "Development", NOT "Staging")
#   2. HONUA_DEV_AUTH=true
#   3. HONUA_DEV_AUTH_ACK=i-understand-this-bypasses-auth
# In a Production deployment, HONUA_DEV_AUTH=true causes the server to refuse
# to start. A startup warning is emitted whenever bypass conditions are only
# partially satisfied so misconfiguration is never silent.
# HONUA_DEV_AUTH=true
# HONUA_DEV_AUTH_ACK=i-understand-this-bypasses-auth

# =============================================================================
# COMPLIANCE FRAMEWORK (SOC 2 / FedRAMP readiness)
# =============================================================================
# Defaults produce an "informational only" posture so a fresh deployment shows
# evidence gaps rather than asserting readiness. See
# docs/operator/compliance-framework.md for the full configuration reference.
# Compliance__Soc2ReadinessClaimed=true
# Compliance__FedRampReadinessClaimed=true
# Compliance__PrimaryRegion=us-gov-west-1
# Data residency — Enforced=true flips the policy view and dry-run endpoint
# verdict; it does NOT block real egress on its own (no production caller
# currently consults IDataResidencyPolicyProvider). Wire your egress guards
# and then set DependencyOverrides__DataResidencyAttested=true.
# Compliance__DataResidency__Enforced=false
# Compliance__DataResidency__PrimaryRegion=us-gov-west-1
# Compliance__DataResidency__AllowedRegions__0=us-gov-east-1
# Encryption posture — operator attestation for FIPS 140-2 host mode.
# Compliance__Encryption__FipsModeAttested=false
# Compliance__Encryption__Algorithms__0=aes-256-gcm
# Compliance__Encryption__Algorithms__1=pbkdf2-sha256-100000
# Dependency overrides — set only when capabilities come from sidecars rather
# than from this process. AuditLogConfigured and SsoConfigured auto-detect when
# unset; RbacConfigured, TransportEncryptionAttested, and DataResidencyAttested
# are operator attestations (the server cannot verify them and conservatively
# reports unsatisfied until you set them).
# Compliance__DependencyOverrides__AuditLogConfigured=
# Compliance__DependencyOverrides__SsoConfigured=
# Compliance__DependencyOverrides__RbacConfigured=
# Compliance__DependencyOverrides__TransportEncryptionAttested=
# Compliance__DependencyOverrides__DataResidencyAttested=

# =============================================================================
# CACHE (Redis)
# =============================================================================
ConnectionStrings__Redis=
# Docker Compose convenience variable (maps to ConnectionStrings__Redis)
HONUA_REDIS_URL=
Cache__Enabled=true
Cache__DefaultTtlSeconds=300
Cache__EnableFallback=true
Cache__FallbackMaxEntries=1000

# =============================================================================
# FILE STORAGE (optional S3-compatible, e.g. MinIO)
# =============================================================================
FileStorage__Provider=Local
FileStorage__AwsS3__BucketName=
FileStorage__AwsS3__Region=us-east-1
FileStorage__AwsS3__ServiceUrl=
FileStorage__AwsS3__ForcePathStyle=true
FileStorage__AwsS3__AccessKeyId=
FileStorage__AwsS3__SecretAccessKey=
# Docker Compose convenience variables (map to FileStorage__AwsS3__*)
HONUA_STORAGE_PROVIDER=
HONUA_S3_BUCKET=
HONUA_S3_REGION=
HONUA_S3_SERVICE_URL=
HONUA_S3_FORCE_PATH_STYLE=
HONUA_S3_ACCESS_KEY_ID=
HONUA_S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =============================================================================
# EDGE RATE LIMITING
# =============================================================================
# Application-level rate limiting is deferred for MVP.
# Enforce rate limits at your edge proxy/load balancer/WAF.

# =============================================================================
# CORS (add origins as needed)
# =============================================================================
# Cors__AllowedOrigins__0=https://myapp.example.com
# Cors__AllowedOrigins__1=https://admin.example.com
# Cors__AllowCredentials=false

# =============================================================================
# QUERY LIMITS
# =============================================================================
Limits__Query__MaxRecordCount=2000
Limits__Query__DefaultRecordCount=1000
Limits__Query__MaxOffset=1000000
Limits__Query__QueryTimeout=00:00:30

# =============================================================================
# GEOMETRY LIMITS
# =============================================================================
Limits__Geometry__MaxVerticesPerGeometry=100000
Limits__Geometry__MaxGeometrySize=10485760
Limits__Geometry__MaxCoordinatePrecision=8

# =============================================================================
# TILE OPTIONS
# =============================================================================
Limits__Tiles__MaxFeaturesPerTile=10000
Limits__Tiles__TileTimeout=00:00:10
Limits__Tiles__MaxTileZoom=22
Limits__Tiles__MinTileZoom=0
TileOptions__SimplifyZoom=10
TileOptions__CacheMaxAge=3600
TileOptions__TileExtent=4096
TileOptions__TileBuffer=256

# =============================================================================
# SCENE ACCESS ENVELOPE SIGNING (PROTECTED 3D TILES)
# =============================================================================
# HMAC-SHA256 signing for short-lived scene access envelopes that authorize
# CesiumJS-style nested asset cascades on protected 3D Tiles scenes. Required
# when at least one scene is configured with an AccessPolicy. Resolve from a
# secret store; rotating the key invalidates all outstanding tokens.
# Honua__SceneAccessSigning__SigningKey=
# Honua__SceneAccessSigning__TokenTtlMinutes=15
# Honua__SceneAccessSigning__RefreshAfterFractionOfTtl=0.5
