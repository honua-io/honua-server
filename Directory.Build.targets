<Project>
  <!-- Evaluate ownership after SDK/NuGet imports, rather than guessing from paths.
       Multi-targeted projects stay in the source pass conservatively. -->
  <Target Name="HonuaGetAnalyzerOwnership" Returns="@(_HonuaAnalyzerOwnership)">
    <ItemGroup>
      <_HonuaAnalyzerOwnership Include="$(MSBuildProjectFullPath)">
        <TestOnly Condition="'$(IsTestProject)' == 'true' and '$(TargetFrameworks)' == ''">true</TestOnly>
      </_HonuaAnalyzerOwnership>
    </ItemGroup>
  </Target>

  <!-- Both PR analyzer partitions compile the dependency graph; each owns diagnostics
       for one disjoint set. Unpartitioned builds keep their existing analyzer policy. -->
  <Target Name="HonuaSetAnalyzerPartition" BeforeTargets="_ComputeSkipAnalyzers"
          Condition="'$(HonuaAnalyzerPartition)' != ''">
    <PropertyGroup>
      <RunAnalyzers>true</RunAnalyzers>
      <RunAnalyzers Condition="'$(HonuaAnalyzerPartition)' == 'source' and '$(IsTestProject)' == 'true'">false</RunAnalyzers>
      <RunAnalyzers Condition="('$(HonuaAnalyzerPartition)' == 'tests' or '$(HonuaAnalyzerPartition)' == 'server-tests' or '$(HonuaAnalyzerPartition)' == 'other-tests') and '$(IsTestProject)' != 'true'">false</RunAnalyzers>
      <RunAnalyzers Condition="'$(HonuaAnalyzerPartition)' == 'server-tests' and '$(MSBuildProjectName)' != 'Honua.Server.Tests' and '$(MSBuildProjectName)' != 'Honua.Architecture.Tests'">false</RunAnalyzers>
      <RunAnalyzers Condition="'$(HonuaAnalyzerPartition)' == 'other-tests' and ('$(MSBuildProjectName)' == 'Honua.Server.Tests' or '$(MSBuildProjectName)' == 'Honua.Architecture.Tests')">false</RunAnalyzers>
    </PropertyGroup>
  </Target>

  <Target Name="ValidateHonuaAnalyzerPartition" BeforeTargets="PrepareForBuild"
          Condition="'$(HonuaAnalyzerPartition)' != '' and '$(HonuaAnalyzerPartition)' != 'all' and '$(HonuaAnalyzerPartition)' != 'source' and '$(HonuaAnalyzerPartition)' != 'tests' and '$(HonuaAnalyzerPartition)' != 'server-tests' and '$(HonuaAnalyzerPartition)' != 'other-tests'">
    <Error Text="Unknown HonuaAnalyzerPartition '$(HonuaAnalyzerPartition)'. Expected all, source, tests, server-tests or other-tests." />
  </Target>

  <!-- Suppress test-specific warnings after project properties are finalized. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' or '$(MSBuildProjectName)' == 'Honua.TestKit'">
    <NoWarn>$(NoWarn);CS1591;CA1041;CA1707;CA1816;CA1822;CA1869;CA1310;xUnit2021;xUnit1041;CS4014;CS0618;CS0612;CS1061;IDE0051;IDE0052;IDE0005</NoWarn>
  </PropertyGroup>

  <!-- Honua.Sdk.GeoServices (#4599) brings Microsoft.Extensions.Telemetry.Abstractions in transitively (via
       Microsoft.Extensions.Http.Resilience). Its buildTransitive props swap the Microsoft.Extensions.Logging
       [LoggerMessage] generator for its own Microsoft.Gen.Logging generator. This repository keeps the
       Microsoft.Extensions.Logging generator, so the Telemetry generators are removed rather than letting both
       implement every logging partial method (CS0757). -->
  <PropertyGroup>
    <DisableMicrosoftExtensionsLoggingSourceGenerator>false</DisableMicrosoftExtensionsLoggingSourceGenerator>
  </PropertyGroup>

  <Target Name="HonuaRemoveTelemetryAbstractionsGenerators" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_HonuaTelemetryAbstractionsAnalyzer
        Include="@(Analyzer)"
        Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.Extensions.Telemetry.Abstractions'" />
      <Analyzer Remove="@(_HonuaTelemetryAbstractionsAnalyzer)" />
    </ItemGroup>
  </Target>

  <!--
    HonuaUbuntuRuntimePublish is set by the Ubuntu (26.04, resolute) serving Dockerfiles.
    That base has no libsasl2.so.3, which the GSSAPI librdkafka.so needs,
    so a linux-x64 Ubuntu publish keeps centos8-librdkafka.so.
    linux-arm64 has no CentOS 8 build, and its librdkafka.so does not need sasl.
    alpine-librdkafka.so is musl. Other publishes keep every build: a host with
    libsasl2.so.3 needs the GSSAPI library, and a musl RID needs the Alpine one.
  -->
  <Target Name="RemoveUnloadedLibrdkafkaBuilds"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(HonuaUbuntuRuntimePublish)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.so' and '%(Filename)' == 'alpine-librdkafka'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'$(RuntimeIdentifier)' == 'linux-x64' and '%(Extension)' == '.so' and '%(Filename)' == 'librdkafka'" />
    </ItemGroup>
  </Target>

</Project>
