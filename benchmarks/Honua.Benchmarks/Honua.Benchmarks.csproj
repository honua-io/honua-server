<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Honua.Benchmarks</RootNamespace>
    <AssemblyName>Honua.Benchmarks</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!--
      BenchmarkDotNet relies on emitting/JITting per-benchmark host assemblies and
      bundles a handful of third-party packages whose XML docs and analyzers
      surface CS1591/IL/IDE/CA warnings that are not actionable in a benchmark
      harness. Suppress the noisy categories so the harness builds clean under
      the repo-wide TreatWarningsAsErrors policy without weakening it elsewhere.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1001;CA1707;CA1822;CA1812;CA1515;CA1062;CA2007;CA1869;IDE0005;IDE0051;IDE0052;IL2026;IL2104;IL3050;IL3002</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      AOT compatibility is intentionally disabled: BenchmarkDotNet generates
      runtime code per benchmark, which is incompatible with AOT. Benchmarks
      are a JIT-only harness used in CI/dev loops, not shipped artifacts.
    -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\..\src\Honua.Server\Honua.Server.csproj" />
    <ProjectReference Include="..\..\src\Honua.Postgres\Honua.Postgres.csproj" />
  </ItemGroup>

</Project>
