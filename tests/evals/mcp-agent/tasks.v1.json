  "tasks": [
    {
      "id": "disc-01",
      "category": "discovery_and_inspection",
      "prompt": "Discover server capabilities and list published parcel layers.",
      "required_tools": ["honua_list_capabilities", "honua_list_layers"],
      "forbidden_tools": ["honua_publish_service", "honua_execute_plan"],
      "expect_refusal": false,
      "max_output_bytes": 8192,
      "max_tool_calls": 4,
      "expected_assertions": [
        {"type": "tool_order", "tools": ["honua_list_capabilities", "honua_list_layers"]},
        {"type": "response_contains", "tool": "honua_list_capabilities", "field": "serverName", "expected": "honua"}
      ],
      "golden_trace": [
        {
          "tool": "honua_list_capabilities",
          "arguments": {},
          "response": {
            "isError": false,
            "structuredContent": {"serverName": "honua.operator.mcp", "protocols": ["mcp", "ogc-features"]}
          }
        },
        {
          "tool": "honua_list_layers",
          "arguments": {"filter": "parcel", "limit": 25},
          "response": {
            "isError": false,
            "structuredContent": {"totalCount": 1, "layers": [{"serviceId": "svc-parcels", "serviceLayerIndex": 0}]}
          }
        }
      ]
    },
    {
      "id": "disc-02",
