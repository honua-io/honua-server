    {
      "id": "spat-01",
      "category": "spatial_query_and_analytics",
      "prompt": "Inspect parcel schema, check how many R1 parcels exceed 2 acres, then fetch the first 20 attribute rows without geometry.",
      "required_tools": ["honua_describe_layer", "honua_query_features"],
      "forbidden_tools": ["honua_publish_service"],
      "expect_refusal": false,
      "max_output_bytes": 16384,
      "max_tool_calls": 5,
      "expected_assertions": [
        {"type": "tool_order", "tools": ["honua_describe_layer", "honua_query_features"]},
        {"type": "arg_equals", "tool": "honua_query_features", "arg": "returnCountOnly", "expected": true},
        {"type": "arg_equals", "tool": "honua_query_features", "arg": "returnGeometry", "expected": false}
      ],
      "golden_trace": [
        {
          "tool": "honua_describe_layer",
          "arguments": {"serviceId": "svc-parcels", "serviceLayerIndex": 0},
          "response": {
            "isError": false,
            "structuredContent": {"fields": [{"name": "zoning"}, {"name": "acreage"}]}
          }
        },
        {
          "tool": "honua_query_features",
          "arguments": {"serviceId": "svc-parcels", "serviceLayerIndex": 0, "where": "zoning = 'R1' AND acreage > 2", "returnCountOnly": true},
          "response": {
            "isError": false,
            "structuredContent": {"count": 47, "returnedCount": 0}
          }
        },
        {
          "tool": "honua_query_features",
          "arguments": {"serviceId": "svc-parcels", "serviceLayerIndex": 0, "where": "zoning = 'R1' AND acreage > 2", "limit": 20, "returnGeometry": false},
          "response": {
            "isError": false,
            "structuredContent": {"returnedCount": 20, "exceededTransferLimit": true, "nextCursor": "20"}
          }
        }
      ]
    },
