      "golden_trace": [
        {
          "tool": "honua_list_layers",
          "arguments": {"filter": "flood"},
          "response": {
            "isError": false,
            "structuredContent": {"totalCount": 1, "layers": [{"serviceId": "svc-hazards", "serviceLayerIndex": 2}]}
          }
