{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "draftId",
    "generation"
  ],
  "additionalProperties": false,
  "properties": {
    "draftId": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "changeNote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
