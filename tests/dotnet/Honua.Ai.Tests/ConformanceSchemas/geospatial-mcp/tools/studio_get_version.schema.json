{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "itemId",
    "versionId"
  ],
  "additionalProperties": false,
  "properties": {
    "itemId": {
      "type": "string",
      "format": "uuid",
      "description": "Studio content item id."
    },
    "versionId": {
      "type": "string",
      "format": "uuid",
      "description": "Saved version id."
    }
  }
}
