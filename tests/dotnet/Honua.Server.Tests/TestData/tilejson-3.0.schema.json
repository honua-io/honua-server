{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TileJSON 3.0.0",
  "type": "object",
  "required": ["tilejson", "tiles"],
  "properties": {
    "tilejson": {
      "type": "string",
      "pattern": "^3\\.0\\.0$"
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "attribution": { "type": "string" },
    "scheme": { "type": "string" },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "minzoom": { "type": "integer", "minimum": 0 },
    "maxzoom": { "type": "integer", "minimum": 0 },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "center": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "vector_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fields"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "minzoom": { "type": "integer", "minimum": 0 },
          "maxzoom": { "type": "integer", "minimum": 0 },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "style": { "type": "string" },
    "template": { "type": "string" },
    "legend": { "type": "string" },
    "grids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "data": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
