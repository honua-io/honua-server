<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep native dependency assets to the machine running this local pilot. -->
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <ProjectReference Include="../../../src/Honua.Protocols.OData/Honua.Protocols.OData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Honua.Protocols.OData.Tests/Source/ODataFeatureProviderResolverTests.cs" Link="Source/ODataFeatureProviderResolverTests.cs" />
    <Compile Include="../Honua.Protocols.OData.Tests/Source/ODataCloudNativeRegressionTests.cs" Link="Source/ODataCloudNativeRegressionTests.cs" />
    <Compile Include="../Honua.Protocols.OData.Tests/Source/ODataSearchServiceSqlTests.cs" Link="Source/ODataSearchServiceSqlTests.cs" />
  </ItemGroup>
</Project>
