<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Honua.Protocols.OData/Honua.Protocols.OData.csproj" />
    <ProjectReference Include="../../../src/Honua.Db/Postgres/Honua.Postgres.csproj" />
    <!-- Canonical SQL/manifest are linked, never copied or executed by this host.
         Provisioning belongs to the server-independent Postgres test fixture. -->
    <Compile Include="../../../src/Honua.Server/Startup/ServerCoreSchemaMigrations.cs" Link="Provisioning/ServerCoreSchemaMigrations.cs" />
    <EmbeddedResource Include="../../../src/Honua.Server/Migrations/*.sql" LogicalName="Honua.Server.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
