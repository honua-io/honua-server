{
  "name": "honua-feature-server-tests",
  "version": "1.0.0",
  "description": "Comprehensive Esri Feature Service integration tests for Honua Server",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:query": "vitest run feature-server/query",
    "test:matrix": "vitest run feature-server/query-matrix",
    "test:geometry": "vitest run feature-server/geometry-types",
    "test:edits": "vitest run feature-server/apply-edits",
    "test:metadata": "vitest run feature-server/metadata",
    "test:openlayers": "vitest run --dir openlayers",
    "test:openlayers:render": "npx playwright test --config openlayers/rendering/playwright.config.ts",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@turf/boolean-valid": "^7.0.0",
    "@turf/helpers": "^7.0.0",
    "@turf/turf": "^7.0.0",
    "ol": "^10.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
