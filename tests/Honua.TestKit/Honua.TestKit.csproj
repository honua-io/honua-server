<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core Testing -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />

    <!-- PostgreSQL/PostGIS -->
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Npgsql.NetTopologySuite" Version="10.0.1" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />

    <!-- Testcontainers -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.10.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.10.0" />

    <!-- xUnit -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />

    <!-- Assertion Libraries -->
    <PackageReference Include="FluentAssertions" Version="7.2.1" />
    <PackageReference Include="FluentAssertions.Json" Version="6.1.0" />

    <!-- YAML parsing -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />

    <!-- Data Generation -->
    <PackageReference Include="FsCheck" Version="3.3.2" />
    <PackageReference Include="FsCheck.Xunit" Version="3.3.2" />
    <PackageReference Include="AutoBogus" Version="2.13.1" />

    <!-- Performance Testing -->
    <PackageReference Include="NBomber" Version="6.2.0" />
    <PackageReference Include="NBomber.Http" Version="6.1.0" />

    <!-- HTTP Client for Contract Testing -->
    <PackageReference Include="WireMock.Net" Version="1.25.0" />

    <!-- JSON Schema Validation -->
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />

    <!-- Dependency overrides -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Honua.Server\Honua.Server.csproj" />
    <ProjectReference Include="..\..\src\Honua.Core\Honua.Core.csproj" />
    <ProjectReference Include="..\..\src\Honua.Postgres\Honua.Postgres.csproj" />
  </ItemGroup>

</Project>
