<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Source-generated configuration binding eliminates the reflection-based
      ConfigurationBinder.Bind / GetValue calls at every callsite. Safe project-wide.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!--
    Style-analyzer + XML-doc generation are expensive and not needed for the inner
    dev loop. Run them only on Release builds (and CI, which always builds Release)
    so `dotnet build -c Debug` stays snappy.
    GenerateDocumentationFile is required for IDE0005 (remove unused usings) to fire
    during build — gate it to the same condition so the two move together.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(ContinuousIntegrationBuild)' == 'true'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Test + benchmark projects don't need to run `dotnet pack`; suppressing the
    default `IsPackable` skips pack-related targets during restore/build.
  -->
  <PropertyGroup Condition="
      $(MSBuildProjectFullPath.Contains('/tests/'))
      OR $(MSBuildProjectFullPath.Contains('/benchmarks/'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!--
    Library-level IsAotCompatible was considered here to surface IL warnings in
    every shipped assembly but propagating [RequiresDynamicCode] annotations
    turned into a cascade (every caller of an AOT-unsafe config-binding helper
    also has to be annotated) with no runtime benefit because the Server's
    PublishAot=true already catches cross-assembly issues at publish time and
    the EnableConfigurationBindingGenerator above makes the common
    ConfigurationBinder.Bind / Configure<T> paths trim-safe at the source.
  -->
</Project>
